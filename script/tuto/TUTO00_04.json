{
 "file": "TUTO00_04.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "TUTO00_04:00A0",
   "jp": "探索について\nご説明いたします!",
   "en": ""
  },
  {
   "id": "TUTO00_04:00B5",
   "jp": "探索はゲーム中、\n集落を発見、占領して…",
   "en": ""
  },
  {
   "id": "TUTO00_04:00D3",
   "jp": "戦争に勝利した場合のみ\n行えます",
   "en": ""
  },
  {
   "id": "TUTO00_04:00EA",
   "jp": "探索は、領主を除く自軍\n配下ユニットの派遣︀により",
   "en": ""
  },
  {
   "id": "TUTO00_04:010D",
   "jp": "ダンジョン形式で\n展開します",
   "en": ""
  },
  {
   "id": "TUTO00_04:0120",
   "jp": "探索が成功すると\nアイテムを取得できます",
   "en": ""
  },
  {
   "id": "TUTO00_04:013B",
   "jp": "ただ戦意の低いキャラクター\nをクエストに向かわせると",
   "en": ""
  },
  {
   "id": "TUTO00_04:015A",
   "jp": "脱走してしまうことが\nあります",
   "en": ""
  },
  {
   "id": "TUTO00_04:016C",
   "jp": "また探索するエリアが\nそのターンの戦場から",
   "en": ""
  },
  {
   "id": "TUTO00_04:0186",
   "jp": "遠く離れている場合、探索に\n数ターンが必要となり…",
   "en": ""
  },
  {
   "id": "TUTO00_04:01A9",
   "jp": "派遣︀したキャラクターは\nその間使用できなくなります",
   "en": ""
  },
  {
   "id": "TUTO00_04:01C8",
   "jp": "以上が探索についての\n説明になります",
   "en": ""
  }
 ]
}
