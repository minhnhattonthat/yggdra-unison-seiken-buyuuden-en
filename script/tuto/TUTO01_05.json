 "strings": [
  {
   "id": "TUTO01_05:0070",
   "jp": "カードは毎回のプレイごとに\n1枚選択することが可能です",
   "en": ""
  },
  {
   "id": "TUTO01_05:0093",
   "jp": "カードの効果は強力なものが\n多いですが、逆に…",
   "en": ""
  },
  {
   "id": "TUTO01_05:00B1",
   "jp": "プレイヤーにとって不利に\nなるカードも存在します",
   "en": ""
  },
  {
   "id": "TUTO01_05:00CE",
   "jp": "カードは実際に発動するまで\nその効果はわかりません",
   "en": ""
  },
  {
   "id": "TUTO01_05:00EE",
   "jp": "唯一、戦争中に鑑定所と\nいう場所を訪れることで",
   "en": ""
  },
  {
   "id": "TUTO01_05:0111",
   "jp": "そのカードの正体を\n確認することができます",
   "en": ""
  },
  {
   "id": "TUTO01_05:012B",
   "jp": "またカードはそれぞれが\n独自の効果発動タイムを",
   "en": ""
  },
  {
   "id": "TUTO01_05:0149",
   "jp": "持っており、時間が来ると\n自動的に効果を発動します。",
   "en": ""
  }
 ]
