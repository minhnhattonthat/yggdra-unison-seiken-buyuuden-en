{
 "file": "TUTO00_05.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "TUTO00_05:00A0",
   "jp": "褒賞について\nご説明いたします!!",
   "en": ""
  },
  {
   "id": "TUTO00_05:00B6",
   "jp": "探索で手に入れた\nアイテムを「褒賞」として",
   "en": ""
  },
  {
   "id": "TUTO00_05:00D2",
   "jp": "自軍のユニットに\n与えることができます",
   "en": ""
  },
  {
   "id": "TUTO00_05:00E9",
   "jp": "このアイテムを渡すこと\nによって…",
   "en": ""
  },
  {
   "id": "TUTO00_05:00FC",
   "jp": "任意のユニットの戦意を\n回復することができます",
   "en": ""
  },
  {
   "id": "TUTO00_05:011A",
   "jp": "戦意が下がってしまうと\nHPが下がってしまったり…",
   "en": ""
  },
  {
   "id": "TUTO00_05:0136",
   "jp": "探索時に逃走しやすく\nなってしまいますので",
   "en": ""
  },
  {
   "id": "TUTO00_05:0151",
   "jp": "こまめに褒賞を与えるよう\n心がけててください",
   "en": ""
  },
  {
   "id": "TUTO00_05:016C",
   "jp": "戦意の回復量については\nユニットごとにアイテムの",
   "en": ""
  },
  {
   "id": "TUTO00_05:018A",
   "jp": "好みがあり、その嗜好により\n戦意の回復量が変化します",
   "en": ""
  },
  {
   "id": "TUTO00_05:01AF",
   "jp": "渡したアイテムが\n装備可能な場合は",
   "en": ""
  },
  {
   "id": "TUTO00_05:01C8",
   "jp": "装備させることができます。\n装備できないアイテムは",
   "en": ""
  },
  {
   "id": "TUTO00_05:01E6",
   "jp": "消費されますが、戦意のみ\n回復できる場合があります",
   "en": ""
  },
  {
   "id": "TUTO00_05:0208",
   "jp": "褒賞についての説明は\n以上になります!",
   "en": ""
  }
 ]
}
