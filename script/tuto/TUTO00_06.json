  {
   "id": "TUTO00_06:0070",
   "jp": "守将の捕縛について\nご説明いたします!!",
   "en": ""
  },
  {
   "id": "TUTO00_06:008B",
   "jp": "戦闘で各エリアの守将を\n倒すと…",
   "en": ""
  },
  {
   "id": "TUTO00_06:00A2",
   "jp": "その守将ユニットを\n捕縛できる場合があります",
   "en": ""
  },
  {
   "id": "TUTO00_06:00BF",
   "jp": "与えたダメージが大き過ぎる\nと守将は戦死してしまいます",
   "en": ""
  },
  {
   "id": "TUTO00_06:00E2",
   "jp": "しかし、適度のダメージ量で\nあれば…",
   "en": ""
