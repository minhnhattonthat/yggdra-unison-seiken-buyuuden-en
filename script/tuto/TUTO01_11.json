{
 "file": "TUTO01_11.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "TUTO01_11:00C0",
   "jp": "ユニゾンアタックについて\nご説明いたします!!",
   "en": ""
  },
  {
   "id": "TUTO01_11:00DA",
   "jp": "ユニゾンアタックとは、\n逆転を狙える強力な攻撃で",
   "en": ""
  },
  {
   "id": "TUTO01_11:00FA",
   "jp": "デュエルが通常1度の攻撃で\n終わるところを…",
   "en": ""
  },
  {
   "id": "TUTO01_11:0117",
   "jp": "周囲の味方ユニットの力を\n借りることで",
   "en": ""
  },
  {
   "id": "TUTO01_11:0131",
   "jp": "敵に追加ダメージを与える\nことのできる必殺技です",
   "en": ""
  },
  {
   "id": "TUTO01_11:0151",
   "jp": "発動方法は、インパクト\nサークルが表示されている間",
   "en": ""
  },
  {
   "id": "TUTO01_11:0172",
   "jp": "サークル内に入っている\n味方ユニットのナンバーを",
   "en": ""
  },
  {
   "id": "TUTO01_11:018F",
   "jp": "タッチペンで記入することで\n発動できます",
   "en": ""
  },
  {
   "id": "TUTO01_11:01A8",
   "jp": "これがユニゾンアタックに\nついての概要となります!",
   "en": ""
  },
  {
   "id": "TUTO01_11:01C4",
   "jp": "ユニットのナンバーとは\nデュエル発生直後に",
   "en": ""
  },
  {
   "id": "TUTO01_11:01DE",
   "jp": "各ユニットの上に表示される\n番号を指します",
   "en": ""
  },
  {
   "id": "TUTO01_11:01FB",
   "jp": "これを正しく記入する事で\n必殺技ユニゾンアタックを",
   "en": ""
  },
  {
   "id": "TUTO01_11:021C",
   "jp": "発動させることが\n可能となります",
   "en": ""
  },
  {
   "id": "TUTO01_11:0231",
   "jp": "またユニゾンアタック発動後\nにもサークルが発生しますが",
   "en": ""
  },
  {
   "id": "TUTO01_11:0252",
   "jp": "それに合わせてユニットの\nナンバーを記入することで",
   "en": ""
  },
  {
   "id": "TUTO01_11:026F",
   "jp": "連続してユニゾンアタックを\n発動させることができます",
   "en": ""
  },
  {
   "id": "TUTO01_11:028E",
   "jp": "このユニゾンアタックは\nプレイヤーのみ発動が可能で",
   "en": ""
  },
  {
   "id": "TUTO01_11:02AC",
   "jp": "CPUは発動できない\n必殺技となっております",
   "en": ""
  },
  {
   "id": "TUTO01_11:02C8",
   "jp": "ユニゾンアタックについて\n説明を終了いたします!!",
   "en": ""
  }
 ]
}
