  },
  {
   "id": "SPMES_WR:090E",
   "jp": "激戦の末…",
   "en": "After a fierce battle..."
  },
  {
   "id": "SPMES_WR:0917",
   "jp": "が敵を撃破し、\n",
   "en": " prevailed!\n"
