  {
   "id": "SPMES_WR:084C",
   "jp": "にて、\n疫病が発生した模様!",
   "en": ":\nA plague seems to have hit!"
  },
  {
   "id": "SPMES_WR:0861",
   "jp": "領民が病に倒れ、\n被害が出ているようです",
   "en": "People are falling ill; there\nseem to be victims."
  },
  {
   "id": "SPMES_WR:087D",
   "jp": "にて、\n地震が発生した模様!",
   "en": ":\nA quake seems to have hit!"
