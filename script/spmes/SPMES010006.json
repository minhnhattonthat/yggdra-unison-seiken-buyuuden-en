 "strings": [
  {
   "id": "SPMES010006:0160",
   "jp": "神を恐れるのならば…\n武器を捨てて投降したまえ!",
   "en": ""
  },
  {
   "id": "SPMES010006:017F",
   "jp": "嫌よ!　あたしたちにも\n信ずる神はあるのよ!",
   "en": ""
  },
  {
   "id": "SPMES010006:0198",
   "jp": "ああっ…!\nい、痛いよ…カナン……",
   "en": ""
  },
  {
   "id": "SPMES010006:01AB",
   "jp": "くっ…何故無益な抵抗をするんだ…",
   "en": ""
  },
  {
   "id": "SPMES010006:01C2",
   "jp": "そ、そんな…",
   "en": ""
  },
  {
   "id": "SPMES010006:01C9",
   "jp": "勝負はつきました。\nもう武器を置きなさい!",
   "en": ""
  },
  {
   "id": "SPMES010006:01E4",
   "jp": "あたしたちは…\n負けない!",
   "en": ""
  },
  {
   "id": "SPMES010006:01F3",
   "jp": "私としたことが…ふ、不覚!",
   "en": ""
  }
 ]
