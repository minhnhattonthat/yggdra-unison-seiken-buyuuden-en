 "strings": [
  {
   "id": "SPMES026036:0160",
   "jp": "おお、恐ろしや異端の呪い師!\n神よ、我を守りたまえ!",
   "en": ""
  },
  {
   "id": "SPMES026036:0182",
   "jp": "…神ですって?　私の前で\n神の話はやめて頂きましょう!",
   "en": ""
  },
  {
   "id": "SPMES026036:01A1",
   "jp": "ば…ばか…な……",
   "en": ""
  },
  {
   "id": "SPMES026036:01AA",
   "jp": "異端者め!\nこの世から消え去るがいい!",
   "en": ""
  },
  {
   "id": "SPMES026036:01C4",
   "jp": "ただの司教かと思えば…\n意外にやりますね",
   "en": ""
  },
  {
   "id": "SPMES026036:01DE",
   "jp": "異端者め!\n神の力…思い知ったか!",
   "en": ""
  },
  {
   "id": "SPMES026036:01F6",
   "jp": "おやおや?　もう終わりですか?\n残念ですね…フフフ……",
   "en": ""
  },
  {
   "id": "SPMES026036:0215",
   "jp": "か、神よ…異端者に罰を!",
   "en": ""
  }
 ]
