 "strings": [
  {
   "id": "SPMES036007:0160",
   "jp": "貴殿がこの争乱の元凶と見た!\n受けて立とう!",
   "en": ""
  },
  {
   "id": "SPMES036007:0180",
   "jp": "フフフ…貴方に私が倒せるのか…\n試してみましょう",
   "en": "Heh heh heh... Can you beat\nme...? Let us find out."
  },
  {
   "id": "SPMES036007:019D",
   "jp": "祖国に…ファンタジニア王国に\n栄光あれ……!",
   "en": ""
  },
  {
   "id": "SPMES036007:01BA",
   "jp": "私が目指す世界に…そのような国は\n存在しないのですよ?　フフフ…",
   "en": ""
  },
  {
   "id": "SPMES036007:01E2",
   "jp": "私としたことが…不覚!",
   "en": "How could I...? A blunder!"
  },
  {
   "id": "SPMES036007:01F0",
   "jp": "話になりませんね。\nその程度の力では……",
   "en": ""
  },
  {
   "id": "SPMES036007:0209",
   "jp": "こ…こん…な……",
   "en": "Th...this...\ncan't..."
  },
  {
   "id": "SPMES036007:0212",
   "jp": "騎士として生まれたからには…\n敗れるわけにはいかないのだ!",
   "en": ""
  }
 ]
}
