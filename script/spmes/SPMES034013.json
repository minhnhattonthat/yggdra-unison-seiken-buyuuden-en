{
 "file": "SPMES034013.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES034013:0160",
   "jp": "フン、貴様はただの雑魚とは\n違うようだな?",
   "en": ""
  },
  {
   "id": "SPMES034013:017B",
   "jp": "これ以上の傍若無人な振る舞い…\n認めるわけには参りません!",
   "en": ""
  },
  {
   "id": "SPMES034013:01A3",
   "jp": "ああっ……!",
   "en": "Aah...!"
  },
  {
   "id": "SPMES034013:01AA",
   "jp": "だが、俺とでは格が違い過ぎる!\n消えろ!",
   "en": ""
  },
  {
   "id": "SPMES034013:01C4",
   "jp": "焔帝…お見事です……",
   "en": ""
  },
  {
   "id": "SPMES034013:01D3",
   "jp": "それだけの力を持ちながら…\n悩しいものだ……",
   "en": ""
  },
  {
   "id": "SPMES034013:01ED",
   "jp": "何だとッ……!?",
   "en": "What...!?"
  },
  {
   "id": "SPMES034013:01F7",
   "jp": "わたくしたちも、これ以上\n敗れる訳にはいかないのです",
   "en": "We, too, cannot afford\nto lose any more."
  }
 ]
}
