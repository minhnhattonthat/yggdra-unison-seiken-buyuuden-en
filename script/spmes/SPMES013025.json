{
 "file": "SPMES013025.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES013025:0160",
   "jp": "わたくしたちの行く手を阻むとは…\n覚悟は出来ているようですね?",
   "en": ""
  },
  {
   "id": "SPMES013025:0186",
   "jp": "フッ…覚悟も何も……もとより\n我々もここを退くつもりは無い!",
   "en": ""
  },
  {
   "id": "SPMES013025:01AC",
   "jp": "…くっ……だめか",
   "en": ""
  },
  {
   "id": "SPMES013025:01B5",
   "jp": "わたくしたちも、これ以上\n敗れる訳にはいかないのです",
   "en": ""
  },
  {
   "id": "SPMES013025:01D4",
   "jp": "私が…負ける……か…",
   "en": ""
  },
  {
   "id": "SPMES013025:01E0",
   "jp": "無益な殺生はしたくありません。\n武器をお収めなさい",
   "en": ""
  },
  {
   "id": "SPMES013025:0201",
   "jp": "ああッ…!",
   "en": "Aah...!"
  },
  {
   "id": "SPMES013025:0207",
   "jp": "フッ…その程度では\n私は倒せないぞ?",
   "en": ""
  }
 ]
}
