   "en": ""
  },
  {
   "id": "SPMES018034:01B7",
   "jp": "もし、痛かったら…\nごめんなさい!",
   "en": ""
  },
  {
   "id": "SPMES018034:01CA",
   "jp": "さ…さすがは俺の妹…!\nさ、さらばだ……",
   "en": ""
  },
  {
   "id": "SPMES018034:01E1",
