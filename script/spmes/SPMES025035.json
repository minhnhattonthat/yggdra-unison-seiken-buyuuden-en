{
 "file": "SPMES025035.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES025035:0160",
   "jp": "ご婦人、悪いようにはしない。\n兵を退いてもらえないだろうか?",
   "en": ""
  },
  {
   "id": "SPMES025035:0184",
   "jp": "あらあら、お優しいのね。\nでも手加減は必要ありませんわよ?",
   "en": ""
  },
  {
   "id": "SPMES025035:01A8",
   "jp": "貴方のような殿方に討たれるのなら\n本望ですわ……",
   "en": ""
  },
  {
   "id": "SPMES025035:01C8",
   "jp": "勝利したというのに…\nこの苦い気分は何なのだ……?",
   "en": ""
  },
  {
   "id": "SPMES025035:01E8",
   "jp": "あらあら!　あたくしとしたことが\n不覚ですわ…",
   "en": ""
  },
  {
   "id": "SPMES025035:0202",
   "jp": "武器を収めたまえ!\n悪いようにはしない",
   "en": ""
  },
  {
   "id": "SPMES025035:021A",
   "jp": "あたくし、素敵な殿方には\n優しいんですのよ?",
   "en": ""
  },
  {
   "id": "SPMES025035:0236",
   "jp": "な、何という強さだ…\n貴方はいったい何者なのだ!?",
   "en": ""
  }
 ]
}
