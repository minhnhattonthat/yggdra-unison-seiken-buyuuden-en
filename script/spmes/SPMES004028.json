 "strings": [
  {
   "id": "SPMES004028:0180",
   "jp": "あら、あんたはいつかの\n戦乙女じゃないの",
   "en": ""
  },
  {
   "id": "SPMES004028:0198",
   "jp": "丁度いいわ。あの時の\nお返しをさせてもらおうじゃないの",
   "en": ""
  },
  {
   "id": "SPMES004028:01B8",
   "jp": "フン、やれるものなら\nやってみるがいい!",
   "en": ""
  },
  {
   "id": "SPMES004028:01CD",
   "jp": "…くっ!　ここまでなの!?",
   "en": ""
  },
  {
   "id": "SPMES004028:01DB",
   "jp": "…魔導師ごときに負けはしない!",
   "en": ""
  },
  {
   "id": "SPMES004028:01EF",
   "jp": "ちょっと油断しただけよ…!",
   "en": ""
  },
  {
   "id": "SPMES004028:01FF",
   "jp": "フン、強がりはやめろ!",
   "en": ""
  },
  {
   "id": "SPMES004028:020C",
   "jp": "どう?　少しは言うことを\n聞く気になったでしょ?",
   "en": ""
  },
  {
   "id": "SPMES004028:0229",
   "jp": "な、何だとッ…!?\nこの私が…こんな……",
   "en": ""
  }
 ]
