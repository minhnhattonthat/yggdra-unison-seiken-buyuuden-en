 "strings": [
  {
   "id": "SPMES030011:01A0",
   "jp": "わぁお!　らっきー♪\nウンディーネだわさ!",
   "en": ""
  },
  {
   "id": "SPMES030011:01B6",
   "jp": "ちょいそこのウンディーネ!\nパメラ様のモノにおなりなさい!",
   "en": ""
  },
  {
   "id": "SPMES030011:01D5",
   "jp": "人をモノ扱いするなんて、\n良くないよ?",
   "en": ""
  },
  {
   "id": "SPMES030011:01EC",
   "jp": "問答無用、天地無用、他言無用!\nとにかく、いっくわよ~!",
   "en": ""
  },
  {
   "id": "SPMES030011:0215",
   "jp": "お…お姉ちゃん……\nゴメンね……",
   "en": "S...Sis...\nSorry..."
  },
  {
   "id": "SPMES030011:0227",
   "jp": "ちょーっ!　死んだらパメラ様の\nモノにならないじゃないの~!",
   "en": ""
  },
  {
   "id": "SPMES030011:0248",
   "jp": "うわぁ~!\nこれ以上はダメみたい…",
   "en": "Waaah~!\nNietzsche can't go on..."
  },
  {
   "id": "SPMES030011:025C",
   "jp": "だーかーらー!　最初から\n大人しくしていればいいのよ",
   "en": ""
  },
  {
   "id": "SPMES030011:027B",
   "jp": "あ、あんた…なかなかやるじゃん。\nお、面白くなって来たわね……",
   "en": ""
  },
  {
   "id": "SPMES030011:029E",
   "jp": "それ、負けた時言うセリフじゃ\nないよ?",
   "en": ""
  }
 ]
