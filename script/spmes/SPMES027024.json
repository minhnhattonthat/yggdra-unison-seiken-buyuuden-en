{
 "file": "SPMES027024.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES027024:01A0",
   "jp": "アマレウス…戻って来てくれ!\nわしゃ、お前がいないと……",
   "en": ""
  },
  {
   "id": "SPMES027024:01C0",
   "jp": "ユベロン様…せめて一太刀で\n終わらせてあげますわ",
   "en": ""
  },
  {
   "id": "SPMES027024:01DE",
   "jp": "あれだけ愛を注ぎ込んだのに…\nそれがお前の答えなのか!?",
   "en": ""
  },
  {
   "id": "SPMES027024:0200",
   "jp": "…誰よりも愛していますわ……\nしかし、だからこそ……!",
   "en": ""
  },
  {
   "id": "SPMES027024:021E",
   "jp": "ユベロン様…\n貴方に討たれるのなら…本望です…",
   "en": ""
  },
  {
   "id": "SPMES027024:023C",
   "jp": "…アマレウス、逝かないでくれ!\nわしを置いて逝くのか!?",
   "en": ""
  },
  {
   "id": "SPMES027024:025C",
   "jp": "クッ…!\nやはりユベロン様を討つことなど…",
   "en": ""
  },
  {
   "id": "SPMES027024:0274",
   "jp": "思い直してくれ、アマレウスよ!",
   "en": ""
  },
  {
   "id": "SPMES027024:0286",
   "jp": "頼む、これ以上やられたら\nわしゃ、死んでしまう!",
   "en": ""
  },
  {
   "id": "SPMES027024:02A3",
   "jp": "…やはり私には貴方を討つことなど\n出来ませんわ……",
   "en": ""
  }
 ]
}
