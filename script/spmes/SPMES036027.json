{
 "file": "SPMES036027.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES036027:0160",
   "jp": "あ…悪魔だ!　く、来るな!\n来るんじゃない!　来ないでくれ!",
   "en": ""
  },
  {
   "id": "SPMES036027:0184",
   "jp": "悪魔などではありませんよ?\n勘違いされては困りますね。フフ…",
   "en": ""
  },
  {
   "id": "SPMES036027:01A8",
   "jp": "ヒィィー!\nわしゃ、死ぬのは嫌だぁぁぁ!",
   "en": ""
  },
  {
   "id": "SPMES036027:01BF",
   "jp": "ええい、騒がしい人ですね。\n消え去るが良いでしょう!",
   "en": ""
  },
  {
   "id": "SPMES036027:01DF",
   "jp": "た、助けてくれ!\nわしゃ、何も知らなかったんだ!",
   "en": ""
  },
  {
   "id": "SPMES036027:01FB",
   "jp": "そうでしょうね…フフフ……\n知らない方が身の為というものです",
   "en": ""
  },
  {
   "id": "SPMES036027:021E",
   "jp": "ハ…ハハハハ……み、見たか!\nわ、わしの強さ、思い知ったか!?",
   "en": ""
  },
  {
   "id": "SPMES036027:0242",
   "jp": "ば…ばか…な……",
   "en": ""
  }
 ]
}
