 "strings": [
  {
   "id": "SPMES008034:0160",
   "jp": "焔帝…あんたとは一度\n手合わせしてみたかったぜ!",
   "en": ""
  },
  {
   "id": "SPMES008034:017F",
   "jp": "貴様となら面白い\n勝負になりそうだ…来るがいい!",
   "en": ""
  },
  {
   "id": "SPMES008034:019F",
   "jp": "さすがは黒騎士…\n皆が恐れた男……",
   "en": ""
  },
  {
   "id": "SPMES008034:01B7",
   "jp": "いい思い出になったぜ!\n悪く思わんでくれよ、焔帝!",
   "en": ""
  },
  {
   "id": "SPMES008034:01D7",
   "jp": "ぬうッ!?",
   "en": ""
  },
  {
   "id": "SPMES008034:01DD",
   "jp": "おっと、そこまでにしないと\n命が無くなるぜ、焔帝さんよ!",
   "en": ""
  },
  {
   "id": "SPMES008034:01FE",
   "jp": "つ…強いじゃねぇかよ……",
   "en": ""
  },
  {
   "id": "SPMES008034:020C",
   "jp": "その程度では俺は倒せん!",
   "en": "That will not\nbe enough to defeat me!"
  }
 ]
}
