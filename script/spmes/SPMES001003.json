 "strings": [
  {
   "id": "SPMES001003:0180",
   "jp": "お姫様、悪いがオレ様と\n勝負してもらうゼ!",
   "en": ""
  },
  {
   "id": "SPMES001003:019C",
   "jp": "寄らば、斬ります!",
   "en": ""
  },
  {
   "id": "SPMES001003:01A8",
   "jp": "おお、怖ぇ!　でも\nその細腕で剣が扱えんのかぁ?",
   "en": ""
  },
  {
   "id": "SPMES001003:01C6",
   "jp": "きゃあっ…!",
   "en": ""
  },
  {
   "id": "SPMES001003:01CD",
   "jp": "しまった…\n力が入り過ぎちまったゼ!",
   "en": ""
  },
  {
   "id": "SPMES001003:01E3",
   "jp": "とっとと剣を捨てて降伏しな!\n悪いようにはしねぇからよ!",
   "en": ""
  },
  {
   "id": "SPMES001003:0205",
   "jp": "だ、誰が降伏するものですか!",
   "en": ""
  },
  {
   "id": "SPMES001003:0217",
   "jp": "兵をお退きなさい!\n貴方と戦う理由はありません",
   "en": ""
  },
  {
   "id": "SPMES001003:0236",
   "jp": "くっ…こっちにはあるんだよ!",
   "en": ""
  }
 ]
}
