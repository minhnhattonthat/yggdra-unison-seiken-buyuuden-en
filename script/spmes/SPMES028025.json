 "strings": [
  {
   "id": "SPMES028025:0180",
   "jp": "ロズウェル!　今度こそ\n決着をつけてあげるわ!",
   "en": ""
  },
  {
   "id": "SPMES028025:019C",
   "jp": "フッ…望むところだ、ロザリィよ",
   "en": ""
  },
  {
   "id": "SPMES028025:01AD",
   "jp": "悪いけど、本気で行かせて\nもらうわよ?",
   "en": ""
  },
  {
   "id": "SPMES028025:01C4",
   "jp": "…こ、ここまで…なのか……!",
   "en": ""
  },
  {
   "id": "SPMES028025:01D3",
   "jp": "悪く思わないで頂戴、\nロズウェル…",
   "en": ""
  },
  {
   "id": "SPMES028025:01E9",
   "jp": "くっ…やってくれたな!",
   "en": ""
  },
  {
   "id": "SPMES028025:01F5",
   "jp": "やっぱりあんたじゃ\nあたしの相手にならないわ",
   "en": ""
  },
  {
   "id": "SPMES028025:020E",
   "jp": "ちょっと油断しただけよ…!",
   "en": ""
  },
  {
   "id": "SPMES028025:021E",
   "jp": "フッ…その油断が命取りだと\nいうことを以後忘れぬことだな……",
   "en": ""
  }
 ]
}
