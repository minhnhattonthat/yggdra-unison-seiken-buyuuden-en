{
 "file": "SPMES036011.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES036011:0160",
   "jp": "貴方も、あの愚かなお姉さんの\n後を追わせてあげましょう!",
   "en": ""
  },
  {
   "id": "SPMES036011:0183",
   "jp": "お姉ちゃんのカタキ…\nニーチェ、取ってみせる!",
   "en": ""
  },
  {
   "id": "SPMES036011:019D",
   "jp": "お姉ちゃん……ゴメンね。\nカタキ取れなかったよ……",
   "en": ""
  },
  {
   "id": "SPMES036011:01B9",
   "jp": "彷徨える魂に安住の地など\nありませんよ?　フフフ……",
   "en": ""
  },
  {
   "id": "SPMES036011:01DA",
   "jp": "痛い痛いっ!\nすごく痛いっ!",
   "en": ""
  },
  {
   "id": "SPMES036011:01EC",
   "jp": "心配は要りません。\nすぐに楽にしてあげましょう…",
   "en": ""
  },
  {
   "id": "SPMES036011:0209",
   "jp": "ば…ばか…な……",
   "en": "Im...impossible..."
  },
  {
   "id": "SPMES036011:0212",
   "jp": "みんなのためにも…\nニーチェ、あなたを許さない!",
   "en": ""
  }
 ]
}
