 "strings": [
  {
   "id": "SPMES013012:0160",
   "jp": "今のわたくしたちは敵同士。\n手加減は無用です!",
   "en": ""
  },
  {
   "id": "SPMES013012:0181",
   "jp": "エメローネ様…",
   "en": ""
  },
  {
   "id": "SPMES013012:018A",
   "jp": "エメローネ様…\n残念です……",
   "en": ""
  },
  {
   "id": "SPMES013012:019C",
   "jp": "同胞を討つなど…\nあってはならないことなのに……",
   "en": ""
  },
  {
   "id": "SPMES013012:01B8",
   "jp": "さ、さすがはエメローネ様…",
   "en": ""
  },
  {
   "id": "SPMES013012:01C7",
   "jp": "無益な殺生はしたくありません。\n武器をお収めなさい",
   "en": ""
  },
  {
   "id": "SPMES013012:01E8",
   "jp": "貴方には敵わないのですね…\nイシーヌ……",
   "en": ""
  },
  {
   "id": "SPMES013012:0200",
   "jp": "エメローネ様!　これ以上は…\nどうか武器をお収めください!",
   "en": ""
  }
 ]
