   "en": ""
  },
  {
   "id": "SPMES022036:01A9",
   "jp": "ば…ばか…な……",
   "en": ""
  },
  {
   "id": "SPMES022036:01B2",
   "jp": "倒した…!?",
   "en": ""
  },
  {
   "id": "SPMES022036:01BA",
   "jp": "…手応えあった!?",
   "en": ""
  },
  {
   "id": "SPMES022036:01C6",
   "jp": "ただのアサシンだと…\n見くびっていましたよ……",
   "en": ""
  },
  {
   "id": "SPMES022036:01DF",
   "jp": "おや、どうしました?　先ほどの\n勢いは何処へ行ったのですか?",
   "en": ""
  },
  {
   "id": "SPMES022036:0202",
   "jp": "誰か…この人を止めて……",
   "en": ""
  }
 ]
