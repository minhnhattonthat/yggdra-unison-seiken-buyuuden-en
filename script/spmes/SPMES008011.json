{
 "file": "SPMES008011.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES008011:0180",
   "jp": "そこのウンディーネ!\n串焼きにしてやるぜ!",
   "en": "Hey, Undine!\nI'll roast ya on a skewer!"
  },
  {
   "id": "SPMES008011:0198",
   "jp": "この、ヤバン人!\nバカにすると痛い目にあうよ!",
   "en": "Barbarian! Mock Nietzsche\nand you'll get hurt!"
  },
  {
   "id": "SPMES008011:01B3",
   "jp": "ああ?　何か言ったか?",
   "en": "Huh? You say somethin'?"
  },
  {
   "id": "SPMES008011:01C1",
   "jp": "お姉ちゃん…\nゴメンね……",
   "en": "Sis...\nSorry..."
  },
  {
   "id": "SPMES008011:01D0",
   "jp": "クックック…ザマねぇな!",
   "en": "Kukuku... Serves ya right!"
  },
  {
   "id": "SPMES008011:01DD",
   "jp": "痛い痛いっ!",
   "en": "Owie owie!"
  },
  {
   "id": "SPMES008011:01E6",
   "jp": "どうした?\nもうお終いか?",
   "en": "What's wrong?\nDone already?"
  },
  {
   "id": "SPMES008011:01F5",
   "jp": "ニーチェ負けないよ!",
   "en": "Nietzsche won't lose!"
  },
  {
   "id": "SPMES008011:0201",
   "jp": "…この、調子に乗るんじゃねぇ……",
   "en": "...Why you...\nDon't get cocky..."
  }
 ]
}
