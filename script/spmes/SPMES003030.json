{
 "file": "SPMES003030.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES003030:01B0",
   "jp": "寄らば、斬ります!",
   "en": ""
  },
  {
   "id": "SPMES003030:01BC",
   "jp": "ちょーっ!?　イキナリ何よ!?\nおっかない王女様だわね!",
   "en": ""
  },
  {
   "id": "SPMES003030:01DD",
   "jp": "しかもソッチから仕掛けて来て\n寄らばってどういう了見よ~!?",
   "en": ""
  },
  {
   "id": "SPMES003030:0202",
   "jp": "限りあれば吹かねど花は散るものを\n心みじかき春の山風…",
   "en": ""
  },
  {
   "id": "SPMES003030:0226",
   "jp": "ごめんなさい…\nこうするより他に無かったのです…",
   "en": ""
  },
  {
   "id": "SPMES003030:0241",
   "jp": "…あんた、本当にそう思ってる?",
   "en": ""
  },
  {
   "id": "SPMES003030:0254",
   "jp": "ギブ、ギブアップ!　降参よ~",
   "en": ""
  },
  {
   "id": "SPMES003030:0265",
   "jp": "だから道を空けるように\n言ったのに……",
   "en": ""
  },
  {
   "id": "SPMES003030:027C",
   "jp": "言ってない、絶対言ってないって!\n寄らば、斬るって言ってたじゃん!",
   "en": ""
  },
  {
   "id": "SPMES003030:02A5",
   "jp": "しまった…!\n油断したわ!",
   "en": ""
  },
  {
   "id": "SPMES003030:02B5",
   "jp": "油断?　ノンノンノン♪\nパメラ様が強いだけよ?",
   "en": ""
  }
 ]
}
