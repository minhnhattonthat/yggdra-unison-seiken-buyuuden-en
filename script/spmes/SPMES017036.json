 "strings": [
  {
   "id": "SPMES017036:0180",
   "jp": "ガハハハ!　そこの怪しいやつ!\n脳天をカチ割ってやるわい!",
   "en": ""
  },
  {
   "id": "SPMES017036:01A2",
   "jp": "フフフ…貴方が私を倒すと?\nフフフ…ハハハハ!",
   "en": ""
  },
  {
   "id": "SPMES017036:01BD",
   "jp": "ば…ばか…な……",
   "en": ""
  },
  {
   "id": "SPMES017036:01C6",
   "jp": "ワシを誰だと思っとる!?\n盗賊王ドルト様だわい!",
   "en": ""
  },
  {
   "id": "SPMES017036:01E5",
   "jp": "おやおや、まさかこんなに\n強いとは思いませんでしたよ…",
   "en": ""
  },
  {
   "id": "SPMES017036:0203",
   "jp": "ガハハハ!　おめぇのような若造が\nワシに勝とうなど10年早いわい!",
   "en": ""
  },
  {
   "id": "SPMES017036:022A",
   "jp": "若造…ですか?　フフフ……\nそれはどうでしょうね…?",
   "en": ""
  },
  {
   "id": "SPMES017036:0247",
   "jp": "フフフ…どうしました?\n口ほどにもありませんね。フフフ…",
   "en": ""
  },
  {
   "id": "SPMES017036:0265",
   "jp": "のわっ!?　おめぇ何者だ!?",
   "en": ""
  }
 ]
