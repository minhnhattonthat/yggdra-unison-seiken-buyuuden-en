 "strings": [
  {
   "id": "SPMES003005:0160",
   "jp": "邪魔をする者は…\n誰であろうとも容赦はしません!",
   "en": ""
  },
  {
   "id": "SPMES003005:017F",
   "jp": "フン、小娘が…我らに\n勝てるとでも思っているのか?",
   "en": ""
  },
  {
   "id": "SPMES003005:019E",
   "jp": "ル…ルシエナ姉さん……\nごめんなさい…",
   "en": ""
  },
  {
   "id": "SPMES003005:01B3",
   "jp": "私にも譲れないものがあるのよ…",
   "en": ""
  },
  {
   "id": "SPMES003005:01C4",
   "jp": "なッ!　何故だ!?\nこんな小娘ごときに…",
   "en": ""
  },
  {
   "id": "SPMES003005:01DD",
   "jp": "勝負はつきました。\n武器をお捨てなさい!",
   "en": ""
  },
  {
   "id": "SPMES003005:01F7",
   "jp": "しまった…!\n油断したわ!",
   "en": ""
  },
  {
   "id": "SPMES003005:0207",
   "jp": "馬鹿な娘だ!　私に勝てると\n本気で思っていたのか?",
   "en": ""
  }
 ]
