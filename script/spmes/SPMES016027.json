 "strings": [
  {
   "id": "SPMES016027:0160",
   "jp": "金の匂いがするぞ~!?\n有り金全部出してもらおうか!",
   "en": ""
  },
  {
   "id": "SPMES016027:0182",
   "jp": "やめろ、よせ!　来るな!\nそちたちに渡す金など無い!",
   "en": ""
  },
  {
   "id": "SPMES016027:01A1",
   "jp": "ヒィィー!\nわしゃ、死ぬのは嫌だぁぁぁ!",
   "en": ""
  },
  {
   "id": "SPMES016027:01B8",
   "jp": "大人しく金を出してりゃ\nこんなことにはならなかったんだよ",
   "en": ""
  },
  {
   "id": "SPMES016027:01D9",
   "jp": "た、助けてくれ!\nわしゃ、死にたくない!",
   "en": ""
  },
  {
   "id": "SPMES016027:01F0",
   "jp": "おめえが金を出すうちは\n生かしといてやるよ",
   "en": ""
  },
  {
   "id": "SPMES016027:0209",
   "jp": "おのれッ!　やりおったなぁ!?",
   "en": ""
  },
  {
   "id": "SPMES016027:0219",
   "jp": "ハ…ハハハハ……み、見たか!\nわ、わしの強さ、思い知ったか!?",
   "en": ""
  }
 ]
}
