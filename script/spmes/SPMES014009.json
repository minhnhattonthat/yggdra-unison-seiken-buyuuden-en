{
 "file": "SPMES014009.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES014009:0160",
   "jp": "軍神ってのがどれ程のものか\n確かめてやるぜ!",
   "en": ""
  },
  {
   "id": "SPMES014009:017A",
   "jp": "貴殿が噂に聞くミラノ殿か…\n拙者が相手をしよう!",
   "en": ""
  },
  {
   "id": "SPMES014009:019C",
   "jp": "どうだっ!?",
   "en": ""
  },
  {
   "id": "SPMES014009:01A3",
   "jp": "ぬう…不覚……!",
   "en": ""
  },
  {
   "id": "SPMES014009:01AE",
   "jp": "拙者…陛下の期待を\n裏切る訳にはゆかぬ……",
   "en": ""
  },
  {
   "id": "SPMES014009:01CC",
   "jp": "だが、負けは負けだぜ?\nそれ以上はやめときな、爺さん!",
   "en": ""
  },
  {
   "id": "SPMES014009:01ED",
   "jp": "軍神って言われるだけのことは\nあるみてーだな…くそっ……",
   "en": ""
  },
  {
   "id": "SPMES014009:020C",
   "jp": "拙者、無益な殺生は本意ではない。\n武器を捨てられよ!",
   "en": ""
  }
 ]
}
