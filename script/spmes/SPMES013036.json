{
 "file": "SPMES013036.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES013036:0160",
   "jp": "貴方は…あの時の人間ですね?\nわたくしの民に手を掛けた……",
   "en": ""
  },
  {
   "id": "SPMES013036:0186",
   "jp": "フフフ…覚えていましたか……\n光栄ですよ、女王。フフフ……",
   "en": ""
  },
  {
   "id": "SPMES013036:01A9",
   "jp": "ば…ばか…な……\nこんな……",
   "en": ""
  },
  {
   "id": "SPMES013036:01B8",
   "jp": "消えて逝った者たちの無念…\nこれで果たせましょう……",
   "en": ""
  },
  {
   "id": "SPMES013036:01D9",
   "jp": "さすがは女王エメローネ…\nまさかこれ程までとは……",
   "en": ""
  },
  {
   "id": "SPMES013036:01F6",
   "jp": "貴方に褒められても\n嬉しくありませんよ、ネシア…",
   "en": ""
  },
  {
   "id": "SPMES013036:0213",
   "jp": "フフフ…どうしました?\n貴方の力はその程度なのですか?",
   "en": ""
  },
  {
   "id": "SPMES013036:0234",
   "jp": "何ということでしょう…\nここまで来ながら……",
   "en": ""
  }
 ]
}
