   "en": ""
  },
  {
   "id": "SPMES025036:01A8",
   "jp": "ば…ばか…な……",
   "en": ""
  },
  {
   "id": "SPMES025036:01B1",
   "jp": "どうした?\nもう終わりか?",
   "en": ""
  },
  {
   "id": "SPMES025036:01C0",
   "jp": "おやおや、まさかここまで\nやるとは思いませんでしたよ…",
   "en": ""
  },
  {
   "id": "SPMES025036:01DD",
   "jp": "フッ…それはこっちのセリフだ",
   "en": ""
  },
  {
   "id": "SPMES025036:01EC",
   "jp": "おやおや?　拍子抜けですね。\n期待外れでしたよ",
   "en": ""
  },
  {
   "id": "SPMES025036:020A",
   "jp": "くっ…やってくれたな!",
   "en": ""
  }
 ]
