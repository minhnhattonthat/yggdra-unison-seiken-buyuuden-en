   "en": ""
  },
  {
   "id": "SPMES009005:0179",
   "jp": "これも戦場の習︀い…\n手加減は出来ませぬぞ!",
   "en": ""
  },
  {
   "id": "SPMES009005:0197",
   "jp": "軍神には…勝てないのね……\n姉さん…ごめんなさい……",
   "en": ""
  },
  {
   "id": "SPMES009005:01B5",
   "jp": "戦乙女の散り様…\nしかと見届けましたぞ",
   "en": ""
  },
  {
   "id": "SPMES009005:01D0",
   "jp": "こ、こんなところで…",
   "en": ""
  },
  {
   "id": "SPMES009005:01DB",
   "jp": "そこまでだ!\n武器を収められよ!",
   "en": ""
  },
  {
   "id": "SPMES009005:01EF",
   "jp": "油断があったのか…\n拙者も老いたものだ……",
   "en": ""
  },
  {
   "id": "SPMES009005:020A",
   "jp": "もう充分よ。降伏なさい!",
   "en": ""
  }
 ]
