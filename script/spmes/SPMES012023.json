 "strings": [
  {
   "id": "SPMES012023:0160",
   "jp": "そこの女!\n邪魔立てすれば容赦はしない!",
   "en": "You there, woman! Interfere\nand I show no mercy!"
  },
  {
   "id": "SPMES012023:017B",
   "jp": "…………",
   "en": "..."
  },
  {
   "id": "SPMES012023:0180",
   "jp": "ふ…不覚……ッ!",
   "en": "A...a blunder...!"
  },
  {
   "id": "SPMES012023:018B",
   "jp": "未熟者め!\n己の無力を思い知るがいい!",
   "en": "Novice! Learn how\npowerless you are!"
  },
  {
   "id": "SPMES012023:01A7",
   "jp": "油断した…!?",
   "en": "I got careless...!?"
  },
  {
   "id": "SPMES012023:01B1",
   "jp": "何をしようとも無駄だ!",
   "en": "Whatever you do is futile!"
  },
  {
   "id": "SPMES012023:01C0",
   "jp": "効いたか……!?",
   "en": "Did that work...!?"
  },
  {
   "id": "SPMES012023:01CA",
   "jp": "くッ…!\n人間ごとき者たちに……",
   "en": "Ngh...!\nTo mere humans......"
  }
 ]
