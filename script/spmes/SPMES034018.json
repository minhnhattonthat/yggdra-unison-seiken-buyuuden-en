{
 "file": "SPMES034018.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES034018:0180",
   "jp": "エミリオ…遠慮はせぬ。\nお前も手加減は無用だ!",
   "en": ""
  },
  {
   "id": "SPMES034018:01A0",
   "jp": "お兄様…まさかお兄様と\n戦うことになるなんて…",
   "en": ""
  },
  {
   "id": "SPMES034018:01BD",
   "jp": "もし、痛かったら…\nごめんなさい!",
   "en": ""
  },
  {
   "id": "SPMES034018:01D0",
   "jp": "お兄様…嫌だよ……\nこんなの、もう……",
   "en": ""
  },
  {
   "id": "SPMES034018:01E7",
   "jp": "エミリオ…戦うことをやめられない\n俺を…許してくれ……",
   "en": ""
  },
  {
   "id": "SPMES034018:0206",
   "jp": "どうした、エミリオ。\nもう終わりなのか?",
   "en": ""
  },
  {
   "id": "SPMES034018:021C",
   "jp": "お兄様には…勝てないよ……",
   "en": ""
  },
  {
   "id": "SPMES034018:022D",
   "jp": "エミリオ…\n強くなったな……",
   "en": ""
  },
  {
   "id": "SPMES034018:023D",
   "jp": "お兄様、もうやめて!\nこれ以上戦ったら死んじゃうよ!",
   "en": ""
  }
 ]
}
