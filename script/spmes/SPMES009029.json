{
 "file": "SPMES009029.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES009029:0160",
   "jp": "ちょっと、軍神なんかと\n戦うなんて聞いてないわよ!?",
   "en": ""
  },
  {
   "id": "SPMES009029:017E",
   "jp": "これも戦場の習︀い…\nお覚悟召されよ!",
   "en": ""
  },
  {
   "id": "SPMES009029:0197",
   "jp": "あうっ!\nそ、そんな…",
   "en": ""
  },
  {
   "id": "SPMES009029:01A3",
   "jp": "勝負とはいえ…\nかつての仲間を斬るのは辛い……",
   "en": ""
  },
  {
   "id": "SPMES009029:01C1",
   "jp": "くっ…何てことなの……",
   "en": ""
  },
  {
   "id": "SPMES009029:01CE",
   "jp": "これ以上は手加減出来ぬ!\n武器を収められよ!",
   "en": ""
  },
  {
   "id": "SPMES009029:01EF",
   "jp": "相手が軍神でも…\nお礼は倍返しよ!",
   "en": ""
  },
  {
   "id": "SPMES009029:0207",
   "jp": "油断があったのか…\n拙者も老いたものだ……",
   "en": ""
  }
 ]
}
