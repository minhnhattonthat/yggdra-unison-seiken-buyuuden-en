   "en": ""
  },
  {
   "id": "SPMES025028:0222",
   "jp": "やっぱりあんたじゃ\nあたしの相手にならないわ",
   "en": ""
  },
  {
   "id": "SPMES025028:023B",
   "jp": "くっ…言ってくれる……",
   "en": ""
  }
 ]
