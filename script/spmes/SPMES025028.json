   "jp": "それで構わぬ!　行くぞ!",
   "en": ""
  },
  {
   "id": "SPMES025028:01CC",
   "jp": "…くっ!　ここまでなの!?",
   "en": ""
  },
  {
   "id": "SPMES025028:01DA",
