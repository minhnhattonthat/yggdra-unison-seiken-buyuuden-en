 "strings": [
  {
   "id": "SPMES017013:0160",
   "jp": "ほ、ウンディーネの女王か!\nこいつも高く売れそうだの!",
   "en": ""
  },
  {
   "id": "SPMES017013:0180",
   "jp": "わたくしたちを侮辱したこと…\n後悔させてあげましょう!",
   "en": ""
  },
  {
   "id": "SPMES017013:01A0",
   "jp": "ああっ……!",
   "en": ""
  },
  {
   "id": "SPMES017013:01A7",
   "jp": "おっといかん!\n力が入り過ぎてしまったかのう…",
   "en": ""
  },
  {
   "id": "SPMES017013:01C2",
   "jp": "盗賊王…お見事です……",
   "en": ""
  },
  {
   "id": "SPMES017013:01D3",
   "jp": "褒めてくれるとは…\n悪い気はせんのう!　ガハハハ!",
   "en": ""
  },
  {
   "id": "SPMES017013:01F0",
   "jp": "な、なかなかやるのう!",
   "en": ""
  },
  {
   "id": "SPMES017013:01FC",
   "jp": "わたくしたちも、これ以上\n敗れる訳にはいかないのです",
   "en": ""
  }
 ]
}
