   "en": ""
  },
  {
   "id": "SPMES035025:0184",
   "jp": "あらあら、お優しいのね。\nでも手加減は必要ありませんわよ?",
   "en": ""
  },
  {
   "id": "SPMES035025:01A8",
   "jp": "…くっ……だめか",
   "en": ""
  },
  {
   "id": "SPMES035025:01B1",
   "jp": "ごめんなさい…ついつい\n力が入り過ぎたみたいですわ……",
   "en": ""
  },
  {
   "id": "SPMES035025:01D0",
   "jp": "私が…負ける……か…",
   "en": ""
  },
  {
   "id": "SPMES035025:01DC",
   "jp": "大丈夫ですわ。貴方、頑張ったから\nご褒美に手当てをしてあげますわ♪",
   "en": ""
  },
  {
   "id": "SPMES035025:0209",
   "jp": "武器を収めたまえ!\n悪いようにはしない",
   "en": ""
  },
  {
   "id": "SPMES035025:0221",
   "jp": "あたくし、素敵な殿方には\n弱いんですのよ~",
   "en": ""
  }
 ]
