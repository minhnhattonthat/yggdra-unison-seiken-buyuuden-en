{
 "file": "SPMES022023.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES022023:0180",
   "jp": "ジルヴァ様…!",
   "en": ""
  },
  {
   "id": "SPMES022023:0189",
   "jp": "貴方は優秀な部下。いずれは\n私の跡を継いでもらいたかった…",
   "en": ""
  },
  {
   "id": "SPMES022023:01AE",
   "jp": "だから、一撃で終わらせてあげる",
   "en": ""
  },
  {
   "id": "SPMES022023:01C1",
   "jp": "フッ、私を負かすとは…\n強くなったな、エレナ……",
   "en": ""
  },
  {
   "id": "SPMES022023:01DC",
   "jp": "ジルヴァ様…!\n…どうか、お許しを……",
   "en": ""
  },
  {
   "id": "SPMES022023:01F2",
   "jp": "貴方だけは\n敵にしたくなかった…",
   "en": ""
  },
  {
   "id": "SPMES022023:0206",
   "jp": "ジルヴァ様…!\nどうか武器を…収めてください!",
   "en": ""
  },
  {
   "id": "SPMES022023:0222",
   "jp": "さすがはジルヴァ様……\n強い……",
   "en": ""
  },
  {
   "id": "SPMES022023:0235",
   "jp": "エレナ…貴方は優し過ぎる……\nそれが貴方の欠点…",
   "en": ""
  }
 ]
}
