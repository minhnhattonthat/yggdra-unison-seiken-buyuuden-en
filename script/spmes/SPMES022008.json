 "strings": [
  {
   "id": "SPMES022008:0180",
   "jp": "貴様…この黒騎士レオンを倒せると\n本気で思っているのか?",
   "en": ""
  },
  {
   "id": "SPMES022008:01A6",
   "jp": "…兄さん……\n私が兄さんを止めてみせる…!",
   "en": ""
  },
  {
   "id": "SPMES022008:01BF",
   "jp": "愚かな妹よ…せめてもの情けだ。\nこの兄が一撃で葬ってやろう!",
   "en": ""
  },
  {
   "id": "SPMES022008:01E5",
   "jp": "お前は本当に愚かな妹だぜ…\nぐ、ぐはぁっ…!",
   "en": ""
  },
  {
   "id": "SPMES022008:0201",
   "jp": "私は、兄さんを\n止められたのかしら…?",
   "en": ""
  },
  {
   "id": "SPMES022008:0217",
   "jp": "こ…この……ッ!?",
   "en": ""
  },
  {
   "id": "SPMES022008:0221",
   "jp": "…手応えあった!?",
   "en": ""
  },
  {
   "id": "SPMES022008:022D",
   "jp": "ダメ…やっぱり当てられない……!",
   "en": ""
  },
  {
   "id": "SPMES022008:023F",
   "jp": "エレナ、俺様に恥をかかせた罪は\n重いぜ…?",
   "en": ""
  }
 ]
