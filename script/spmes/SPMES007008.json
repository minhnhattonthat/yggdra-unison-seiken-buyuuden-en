{
 "file": "SPMES007008.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES007008:01A0",
   "jp": "黒騎士レオン!\nこのような所で会えるとは…",
   "en": ""
  },
  {
   "id": "SPMES007008:01BB",
   "jp": "誰かと思えばデュランじゃねぇか!\n貴様、まだ生きてやがったのか?",
   "en": ""
  },
  {
   "id": "SPMES007008:01E1",
   "jp": "貴殿の悪行の数々…\n騎士の風上にも置けん!　覚悟!",
   "en": ""
  },
  {
   "id": "SPMES007008:0207",
   "jp": "おもしれぇ、受けて立つぜ!",
   "en": ""
  },
  {
   "id": "SPMES007008:0217",
   "jp": "貴殿の悪行もここまでだ!\n黒騎士レオン!",
   "en": ""
  },
  {
   "id": "SPMES007008:0232",
   "jp": "ぐ、ぐはぁっ…!",
   "en": ""
  },
  {
   "id": "SPMES007008:023B",
   "jp": "て…てめぇ!\n腕を上げやがったな…",
   "en": ""
  },
  {
   "id": "SPMES007008:024F",
   "jp": "いつまでも同じ手が効くと思うな!\n黒騎士レオン!",
   "en": ""
  },
  {
   "id": "SPMES007008:026F",
   "jp": "ククク…どうした?\n最初の勢いは何処へ行ったんだ?",
   "en": ""
  },
  {
   "id": "SPMES007008:028E",
   "jp": "さ、さすがは黒騎士…",
   "en": ""
  }
 ]
}
