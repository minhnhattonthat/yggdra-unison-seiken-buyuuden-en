 "strings": [
  {
   "id": "SPMES023027:0160",
   "jp": "…覚悟ッ!",
   "en": ""
  },
  {
   "id": "SPMES023027:0168",
   "jp": "やめろ、よせ!　来るな!\n誰か…誰か参れ!　曲者じゃあ!",
   "en": ""
  },
  {
   "id": "SPMES023027:018B",
   "jp": "ヒィィー!\nわしゃ、死ぬのは嫌だぁぁぁ!",
   "en": ""
  },
  {
   "id": "SPMES023027:01A2",
   "jp": "最期までやかましい男…",
   "en": ""
  },
  {
   "id": "SPMES023027:01B1",
   "jp": "た、助けてくれ!\nわしゃ、死にたくない!",
   "en": ""
  },
  {
   "id": "SPMES023027:01C8",
   "jp": "安心しろ。貴様など\n殺す価値もない……",
   "en": ""
  },
  {
   "id": "SPMES023027:01E3",
   "jp": "…しまった!",
   "en": ""
  },
  {
   "id": "SPMES023027:01EA",
   "jp": "ハ…ハハハハ……み、見たか!\nわ、わしの強さ、思い知ったか!?",
   "en": ""
  }
 ]
}
