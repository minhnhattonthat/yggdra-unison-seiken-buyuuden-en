{
 "file": "SPMES036013.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES036013:0160",
   "jp": "戦乱を招くだけでは飽き足らず…\nまだ悪巧みを続ける気ですか?",
   "en": ""
  },
  {
   "id": "SPMES036013:0188",
   "jp": "フフフ…悪巧みとは……\n面白いことを言うお人だ……!",
   "en": ""
  },
  {
   "id": "SPMES036013:01A9",
   "jp": "無念ですが…どうやら\nここまでのようです……",
   "en": ""
  },
  {
   "id": "SPMES036013:01C2",
   "jp": "私に関わらなければ…もう少しだけ\n生き長らえたかも知れませんよ…?",
   "en": ""
  },
  {
   "id": "SPMES036013:01E9",
   "jp": "ああッ…!",
   "en": ""
  },
  {
   "id": "SPMES036013:01EF",
   "jp": "フフフ…無駄です。何者も\n私を止めることなど出来はしない…",
   "en": ""
  },
  {
   "id": "SPMES036013:0214",
   "jp": "ば…ばか…な……\nこんな……",
   "en": ""
  },
  {
   "id": "SPMES036013:0223",
   "jp": "死んでいった者たちの…\n恨みを思い知るが良いでしょう!",
   "en": ""
  }
 ]
}
