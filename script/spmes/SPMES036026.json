 "strings": [
  {
   "id": "SPMES036026:0160",
   "jp": "異端の呪い師め!\n神の怒りを思い知るがいい!",
   "en": ""
  },
  {
   "id": "SPMES036026:017E",
   "jp": "まだ神などという者に頼ろうと\n言うのですか?　愚かな……!",
   "en": ""
  },
  {
   "id": "SPMES036026:01A0",
   "jp": "か…神を恐れないと言うのか…",
   "en": ""
  },
  {
   "id": "SPMES036026:01B1",
   "jp": "それは私が復讐しようとしている\n者の名前なのですよ…フフフ……",
   "en": ""
  },
  {
   "id": "SPMES036026:01D6",
   "jp": "神の信徒を傷つけるとは\n何と罪深い…!",
   "en": ""
  },
  {
   "id": "SPMES036026:01F0",
   "jp": "フフフ…神、神と\nしつこい人ですね、貴方も…",
   "en": ""
  },
  {
   "id": "SPMES036026:020A",
   "jp": "ば…ばか…な……",
   "en": ""
  },
  {
   "id": "SPMES036026:0213",
   "jp": "異端者め!\n神の力…思い知ったか!",
   "en": ""
  }
 ]
}
