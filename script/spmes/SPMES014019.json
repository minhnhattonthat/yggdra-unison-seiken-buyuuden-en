  {
   "id": "SPMES014019:0180",
   "jp": "キリエ!　お前とは戦いたくねー!\nそこをどいてくれ!",
   "en": ""
  },
  {
   "id": "SPMES014019:019D",
   "jp": "ウチにも事情があるんだよ!\nミラノこそ、他へ行ってよ!",
   "en": ""
  },
  {
   "id": "SPMES014019:01BC",
   "jp": "そういうワケには\nいかねーんだよ!",
   "en": ""
  },
  {
   "id": "SPMES014019:01CE",
   "jp": "やっぱり…ミラノには\n勝てないのか…な……",
   "en": ""
  },
  {
   "id": "SPMES014019:01E5",
   "jp": "キリエの…バカ野郎……\n何で諦めねーんだよ…",
   "en": ""
  },
  {
   "id": "SPMES014019:0200",
   "jp": "アル!\nしっかり…",
   "en": ""
  },
  {
   "id": "SPMES014019:020A",
   "jp": "おい、もうやめとけ!\nお前を殺したくねーんだ!",
   "en": ""
  },
  {
   "id": "SPMES014019:0224",
   "jp": "ミラノ!　降参して!\nまた一緒にやろうよ。ね?",
   "en": ""
  },
  {
   "id": "SPMES014019:0240",
   "jp": "チキショー!\nやっぱり強いぜ…",
   "en": ""
  }
 ]
