 "strings": [
  {
   "id": "SPMES004020:0160",
   "jp": "レジスタンスの生き残りだな?\n我らに敵対する者は容赦しない!",
   "en": ""
  },
  {
   "id": "SPMES004020:0187",
   "jp": "ちぇっ!　こうなりゃ\n死なばもろともだ!",
   "en": ""
  },
  {
   "id": "SPMES004020:019D",
   "jp": "か…革命未だ成らず…",
   "en": ""
  },
  {
   "id": "SPMES004020:01AC",
   "jp": "そのようなもの…未来永劫\n達成されぬと知るがいい!",
   "en": ""
  },
  {
   "id": "SPMES004020:01CD",
   "jp": "貴様の実力はこの程度か?",
   "en": ""
  },
  {
   "id": "SPMES004020:01E0",
   "jp": "や、やったな!?",
   "en": ""
  },
  {
   "id": "SPMES004020:01E9",
   "jp": "僕たちの邪魔をしないでくれよ!",
   "en": ""
  },
  {
   "id": "SPMES004020:01FC",
   "jp": "おのれッ…レジスタンスごときに\n敗れるなど…末代までの恥!",
   "en": ""
  }
 ]
}
