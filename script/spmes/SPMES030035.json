 "strings": [
  {
   "id": "SPMES030035:01A0",
   "jp": "あらあら、誰かすごい勢いで\n来ましたわよ~?",
   "en": ""
  },
  {
   "id": "SPMES030035:01BA",
   "jp": "ハイハイ、そこ、ジャマよ~\nどいたどいた~!",
   "en": ""
  },
  {
   "id": "SPMES030035:01D1",
   "jp": "ごめんなさい。でも、ここを\n離れるわけにはいきませんの~",
   "en": ""
  },
  {
   "id": "SPMES030035:01EF",
   "jp": "な、何だか調子の狂う\nおばさんだわね…",
   "en": ""
  },
  {
   "id": "SPMES030035:0207",
   "jp": "ここまでのようですわ…\nごめんなさいね",
   "en": ""
  },
  {
   "id": "SPMES030035:021B",
   "jp": "うほっ!?　倒しちゃった…\nちょっと力が強すぎたかな~?",
   "en": ""
  },
  {
   "id": "SPMES030035:023B",
   "jp": "迎　撃　完　了　♪\nシャキーン!",
   "en": ""
  },
  {
   "id": "SPMES030035:0250",
   "jp": "あらあら!　あたくしとしたことが\n不覚ですわ…",
   "en": ""
  },
  {
   "id": "SPMES030035:026A",
   "jp": "あら、もうお仕舞いですの?\nもっと努力して頂かないと~",
   "en": ""
  },
  {
   "id": "SPMES030035:028B",
   "jp": "こ、これ以上努力したら\n死んじゃうってばさ!",
   "en": ""
  }
 ]
