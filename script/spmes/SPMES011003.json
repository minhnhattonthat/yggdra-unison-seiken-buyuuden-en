{
 "file": "SPMES011003.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES011003:0160",
   "jp": "ニーチェ、ここで立ち止まるわけに\nいかないの!",
   "en": "Nietzsche can't\nstop here!"
  },
  {
   "id": "SPMES011003:017A",
   "jp": "たとえ相手が誰であろうとも…\n寄らば、斬ります!",
   "en": "Whoever my foe may be...\nCome closer, and I strike!"
  },
  {
   "id": "SPMES011003:0198",
   "jp": "きゃあっ…!",
   "en": "Kyaah...!"
  },
  {
   "id": "SPMES011003:019F",
   "jp": "ゴメンなさい!\n力が入り過ぎちゃった…!",
   "en": "Sorry-sorry!\nNietzsche hit too hard...!"
  },
  {
   "id": "SPMES011003:01B7",
   "jp": "そ、そんな…",
   "en": "N-no..."
  },
  {
   "id": "SPMES011003:01BE",
   "jp": "ニーチェ、負けないよ♪",
   "en": "Nietzsche won't lose~!"
  },
  {
   "id": "SPMES011003:01CB",
   "jp": "痛い痛いっ!",
   "en": "Owie owie!"
  },
  {
   "id": "SPMES011003:01D4",
   "jp": "これ以上の抵抗は無駄です!\n兵をお退きなさい!",
   "en": "Further resistance is futile!\nWithdraw your troops!"
  }
 ]
}
