 "strings": [
  {
   "id": "SPMES026024:0160",
   "jp": "アマレウス!　あんな年寄りなど\n忘れて、私の配下に加わるがいい!",
   "en": ""
  },
  {
   "id": "SPMES026024:0186",
   "jp": "フフ…私を手に入れたいの?\nそれは出来ない相談ね。フフ……",
   "en": ""
  },
  {
   "id": "SPMES026024:01AA",
   "jp": "ユベロン様…\n申し訳……ございません",
   "en": ""
  },
  {
   "id": "SPMES026024:01C0",
   "jp": "おのれッ!　あくまでも\n私の下に入らないと言うのか…!?",
   "en": ""
  },
  {
   "id": "SPMES026024:01DF",
   "jp": "クッ…!",
   "en": ""
  },
  {
   "id": "SPMES026024:01E4",
   "jp": "さあ、今からでも間に合う!\n私の配下に加わるのだ!　フハハ!",
   "en": ""
  },
  {
   "id": "SPMES026024:0208",
   "jp": "フフフ…もう終わりなの?",
   "en": ""
  },
  {
   "id": "SPMES026024:0216",
   "jp": "そ、そんなに私が嫌いか…!?",
   "en": ""
  }
 ]
}
