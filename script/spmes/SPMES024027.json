{
 "file": "SPMES024027.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES024027:01A0",
   "jp": "ユベロン様…貴方には\n死んで頂きます……",
   "en": ""
  },
  {
   "id": "SPMES024027:01BA",
   "jp": "な、何故じゃアマレウス!?\nわしを討ってどうすると言うのだ?",
   "en": ""
  },
  {
   "id": "SPMES024027:01DD",
   "jp": "あれだけ愛を注ぎ込んだのに…\nそれがお前の答えなのか!?",
   "en": ""
  },
  {
   "id": "SPMES024027:01FF",
   "jp": "…誰よりも愛していますわ……\nしかし、だからこそ……!",
   "en": ""
  },
  {
   "id": "SPMES024027:021D",
   "jp": "ア…アマレ…ウス……",
   "en": ""
  },
  {
   "id": "SPMES024027:0228",
   "jp": "これで貴方は……\n私の心の中だけで生き続ける……",
   "en": ""
  },
  {
   "id": "SPMES024027:0247",
   "jp": "アマレウス…お前とは戦えん!\n参った!　降参する!",
   "en": ""
  },
  {
   "id": "SPMES024027:0266",
   "jp": "では、武器をお収めください。\nユベロン様…",
   "en": ""
  },
  {
   "id": "SPMES024027:0280",
   "jp": "クッ…!\nやはりユベロン様を討つことなど…",
   "en": ""
  },
  {
   "id": "SPMES024027:0298",
   "jp": "アマレウス…お前とは戦えん!\n後生じゃ。降参してくれ!",
   "en": ""
  }
 ]
}
