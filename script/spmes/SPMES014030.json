 "strings": [
  {
   "id": "SPMES014030:0160",
   "jp": "そこのヘンテコリンな魔導師!\nどかねーとケガするぜ!?",
   "en": ""
  },
  {
   "id": "SPMES014030:017F",
   "jp": "うほっ!?　見つかった!?\nあわわ…あわわ……",
   "en": ""
  },
  {
   "id": "SPMES014030:0198",
   "jp": "曇りなき心の月を先だてて\n浮世の闇を照らしてぞ行く…",
   "en": ""
  },
  {
   "id": "SPMES014030:01BB",
   "jp": "な、何だ?\n辞世の句ってヤツか?",
   "en": ""
  },
  {
   "id": "SPMES014030:01D0",
   "jp": "痛ったぁ~い!\nムチャクチャ痛い!",
   "en": ""
  },
  {
   "id": "SPMES014030:01E4",
   "jp": "これ以上抵抗すると\nもっと痛い目に遣うぜ?",
   "en": ""
  },
  {
   "id": "SPMES014030:0201",
   "jp": "うほっ!　パメラ様はァァァァ\n世界最強ォォォォォッ♪",
   "en": ""
  },
  {
   "id": "SPMES014030:0221",
   "jp": "分かったから、騒ぐんじゃねーよ…",
   "en": ""
  }
 ]
}
