 "strings": [
  {
   "id": "SPMES023005:0160",
   "jp": "ジルヴァ…貴様\n何のつもりだッ!?",
   "en": "Zilva... What do you\nthink you're doing!?"
  },
  {
   "id": "SPMES023005:0175",
   "jp": "アイギナ様…お覚悟を!",
   "en": "Aegina-sama... prepare\nyourself!"
  },
  {
   "id": "SPMES023005:0184",
   "jp": "ル…ルシエナ姉さん……\nごめんなさい…",
   "en": "S-Sister Luciana...\nI'm sorry..."
  },
  {
   "id": "SPMES023005:0199",
   "jp": "…………",
   "en": "..."
  },
  {
   "id": "SPMES023005:019E",
   "jp": "なッ!　何故だ!?\n何故勝てないんだ……",
   "en": "What?! Why?!\nWhy can't I win..."
  },
  {
   "id": "SPMES023005:01B8",
   "jp": "どうか、諦めて頂きたい……",
   "en": "I ask that you please\ngive up..."
  },
  {
   "id": "SPMES023005:01C8",
   "jp": "…しまった!",
   "en": "...Damn!"
  },
  {
   "id": "SPMES023005:01CF",
   "jp": "私は負けぬ!",
   "en": "I will not lose!"
  }
 ]
