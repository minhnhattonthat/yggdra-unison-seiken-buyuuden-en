{
 "file": "SPMES009004.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES009004:0160",
   "jp": "まさか貴殿と刃を交えることに\nなるとはな…お覚悟召されよ!",
   "en": ""
  },
  {
   "id": "SPMES009004:0185",
   "jp": "軍神が相手でも…\nここは退く訳にはいかないッ!",
   "en": ""
  },
  {
   "id": "SPMES009004:01A2",
   "jp": "さすがは軍神…\nアイギナ…ごめんなさい……",
   "en": ""
  },
  {
   "id": "SPMES009004:01B9",
   "jp": "戦乙女の散り様…\nしかと見届けましたぞ",
   "en": ""
  },
  {
   "id": "SPMES009004:01D4",
   "jp": "ぬかった…",
   "en": ""
  },
  {
   "id": "SPMES009004:01DA",
   "jp": "そこまでだ!\n武器を収められよ!",
   "en": ""
  },
  {
   "id": "SPMES009004:01EE",
   "jp": "油断があったのか…\n拙者も老いたものだ……",
   "en": ""
  },
  {
   "id": "SPMES009004:0209",
   "jp": "貴方は殺したくない。\n降伏なさい!",
   "en": ""
  }
 ]
}
