 "strings": [
  {
   "id": "SPMES010016:0160",
   "jp": "神をも恐れぬ不届き者め!\n覚悟するがいい!",
   "en": ""
  },
  {
   "id": "SPMES010016:017C",
   "jp": "ああ?　神が怖くて\n山賊が出来るかってんだ!",
   "en": ""
  },
  {
   "id": "SPMES010016:0198",
   "jp": "こ、子分ども…すまねぇ……",
   "en": "M-my boys... I'm sorry..."
  },
  {
   "id": "SPMES010016:01A8",
   "jp": "愚かな…",
   "en": ""
  },
  {
   "id": "SPMES010016:01AE",
   "jp": "ぐはッ…し、死ぬほどいてぇ…",
   "en": "Gwah... Hurts like hell..."
  },
  {
   "id": "SPMES010016:01BE",
   "jp": "降参するなら命は取らぬ!\n武器を捨てたまえ!",
   "en": ""
  },
  {
   "id": "SPMES010016:01DC",
   "jp": "か、神よ…\n申し訳ございません……",
   "en": ""
  },
  {
   "id": "SPMES010016:01F0",
   "jp": "おめえみたいな凝り固まった野郎に\n負けちゃいられねぇんだよ!",
   "en": ""
  }
 ]
