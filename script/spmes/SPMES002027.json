 "strings": [
  {
   "id": "SPMES002027:0160",
   "jp": "く、来るな!　来るんじゃない!\n来ないでくれ!",
   "en": ""
  },
  {
   "id": "SPMES002027:017B",
   "jp": "断るッ!\nそっちこそ、ここから立ち去れ!",
   "en": ""
  },
  {
   "id": "SPMES002027:0193",
   "jp": "ヒィィー!\nわしゃ、死ぬのは嫌だぁぁぁ!",
   "en": ""
  },
  {
   "id": "SPMES002027:01AA",
   "jp": "死にたくないのなら、\n最初から戦わなければいいんだ…",
   "en": ""
  },
  {
   "id": "SPMES002027:01C9",
   "jp": "た、助けてくれ!\nわしゃ、何も知らなかったんだ!",
   "en": ""
  },
  {
   "id": "SPMES002027:01E5",
   "jp": "うるさい!\nガタガタ騒ぐな!",
   "en": ""
  },
  {
   "id": "SPMES002027:01F5",
   "jp": "ハ…ハハハハ……み、見たか!\nわ、わしの強さ、思い知ったか!?",
   "en": ""
  },
  {
   "id": "SPMES002027:0219",
   "jp": "こ、こんな奴に負けるなんて…",
   "en": ""
  }
 ]
