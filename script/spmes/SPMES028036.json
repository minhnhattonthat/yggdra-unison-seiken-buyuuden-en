{
 "file": "SPMES028036.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES028036:0160",
   "jp": "おや?　貴方は白薔薇の領主。\nまだ生きていたとは……フフフ…",
   "en": ""
  },
  {
   "id": "SPMES028036:0187",
   "jp": "そうよ。あんたにお返しをしたくて\nここまで来たのよ?",
   "en": ""
  },
  {
   "id": "SPMES028036:01A4",
   "jp": "ば…ばか…な……",
   "en": "Im...impossible..."
  },
  {
   "id": "SPMES028036:01AD",
   "jp": "この程度では\n収まらないんだけどね…",
   "en": ""
  },
  {
   "id": "SPMES028036:01C3",
   "jp": "おやおや、まさかここまで\nやるとは思いませんでしたよ…",
   "en": ""
  },
  {
   "id": "SPMES028036:01E0",
   "jp": "まーた強がっちゃって…\n負けん気だけは人一倍あるのね",
   "en": ""
  },
  {
   "id": "SPMES028036:0201",
   "jp": "おやおや?　拍子抜けですね。\n期待外れでしたよ",
   "en": ""
  },
  {
   "id": "SPMES028036:021F",
   "jp": "ちょっと油断しただけよ…!",
   "en": ""
  }
 ]
}
