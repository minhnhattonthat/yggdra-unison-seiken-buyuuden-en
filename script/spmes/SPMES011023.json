 "strings": [
  {
   "id": "SPMES011023:0160",
   "jp": "ニーチェたちの邪魔しないで!",
   "en": "Don't get in the way of\nNietzsche and friends!"
  },
  {
   "id": "SPMES011023:0171",
   "jp": "覚悟は…出来ているようだな……!",
   "en": "You seem... prepared...!"
  },
  {
   "id": "SPMES011023:0186",
   "jp": "ふ…不覚……ッ!",
   "en": "A...a blunder...!"
  },
  {
   "id": "SPMES011023:0191",
   "jp": "だから邪魔しないでって\n言ったのに…",
   "en": "Nietzsche told you not\nto get in the way..."
  },
  {
   "id": "SPMES011023:01A7",
   "jp": "油断したか…",
   "en": "I got careless..."
  },
  {
   "id": "SPMES011023:01B0",
   "jp": "あれ?　もうダウンなの?",
   "en": "Huh? Down already?"
  },
  {
   "id": "SPMES011023:01BD",
   "jp": "痛い痛いっ!",
   "en": "Owie owie!"
  },
  {
   "id": "SPMES011023:01C6",
   "jp": "隙だらけだな…!",
   "en": "Wide open...!"
  }
 ]
