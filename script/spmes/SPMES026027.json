{
 "file": "SPMES026027.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES026027:0180",
   "jp": "もうあんたに用は無いんだよ!\nあんたの役目は終わったのさ!",
   "en": ""
  },
  {
   "id": "SPMES026027:01A3",
   "jp": "な、なんじゃと…わ、わしは\n利用されていただけなのか…!?",
   "en": ""
  },
  {
   "id": "SPMES026027:01C3",
   "jp": "おのれ、マルディムめ!\nゆ、許さんぞ!",
   "en": ""
  },
  {
   "id": "SPMES026027:01D8",
   "jp": "ヒィィー!\nわしゃ、死ぬのは嫌だぁぁぁ!",
   "en": ""
  },
  {
   "id": "SPMES026027:01EF",
   "jp": "これからは私の時代なんだよ!\nフハハハハ!",
   "en": ""
  },
  {
   "id": "SPMES026027:0207",
   "jp": "た、助けてくれ!\nわしゃ、死にたくない!",
   "en": ""
  },
  {
   "id": "SPMES026027:021E",
   "jp": "私の言うことをきくなら\n命だけは助けてやろう!",
   "en": ""
  },
  {
   "id": "SPMES026027:0239",
   "jp": "ハ…ハハハハ……み、見たか!\nわ、わしの強さ、思い知ったか!?",
   "en": ""
  },
  {
   "id": "SPMES026027:025D",
   "jp": "こっ…この老いぼれが……!",
   "en": ""
  }
 ]
}
