 "strings": [
  {
   "id": "SPMES023022:0180",
   "jp": "ジルヴァ様…\n何をするんです!?",
   "en": ""
  },
  {
   "id": "SPMES023022:0193",
   "jp": "貴方は優秀な人材…\n貴方だけは敵にしたくない……",
   "en": ""
  },
  {
   "id": "SPMES023022:01B5",
   "jp": "だから、こちらに来てもらう!",
   "en": ""
  },
  {
   "id": "SPMES023022:01C5",
   "jp": "に…兄さん…!",
   "en": ""
  },
  {
   "id": "SPMES023022:01CE",
   "jp": "しまった…!\n手加減出来なかった……!?",
   "en": ""
  },
  {
   "id": "SPMES023022:01E8",
   "jp": "さすがはジルヴァ様……\n強い……",
   "en": ""
  },
  {
   "id": "SPMES023022:01FB",
   "jp": "エレナ…今ならまだ間に合う。\nこっちへ来るんだ!",
   "en": ""
  },
  {
   "id": "SPMES023022:0218",
   "jp": "…しまった!　油断したか……",
   "en": ""
  },
  {
   "id": "SPMES023022:0229",
   "jp": "ジルヴァ様…!\nどうか武器を…収めてください!",
   "en": ""
  }
 ]
