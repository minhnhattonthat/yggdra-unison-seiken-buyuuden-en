{
 "file": "SPMES023022.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES023022:0180",
   "jp": "ジルヴァ様…\n何をするんです!?",
   "en": "Zilva-sama...\nWhat are you doing!?"
  },
  {
   "id": "SPMES023022:0193",
   "jp": "貴方は優秀な人材…\n貴方だけは敵にしたくない……",
   "en": "You are talented... You, I\ndo not want as an enemy..."
  },
  {
   "id": "SPMES023022:01B5",
   "jp": "だから、こちらに来てもらう!",
   "en": "So you're coming with me!"
  },
  {
   "id": "SPMES023022:01C5",
   "jp": "に…兄さん…!",
   "en": "B...brother...!"
  },
  {
   "id": "SPMES023022:01CE",
   "jp": "しまった…!\n手加減出来なかった……!?",
   "en": "Damn...!\nI couldn't hold back...!?"
  },
  {
   "id": "SPMES023022:01E8",
   "jp": "さすがはジルヴァ様……\n強い……",
   "en": "Zilva-sama, as ever...\nSo strong..."
  },
  {
   "id": "SPMES023022:01FB",
   "jp": "エレナ…今ならまだ間に合う。\nこっちへ来るんだ!",
   "en": "Elena... it's not too late.\nCome to my side!"
  },
  {
   "id": "SPMES023022:0218",
   "jp": "…しまった!　油断したか……",
   "en": "...Damn! Was I careless...?"
  },
  {
   "id": "SPMES023022:0229",
   "jp": "ジルヴァ様…!\nどうか武器を…収めてください!",
   "en": "Zilva-sama...! Please...\nlower your weapon!"
  }
 ]
}
