{
 "file": "SPMES027010.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES027010:0160",
   "jp": "ゴードン!　お前を倒さねば\nわしの身が危ういんじゃ。覚悟…!",
   "en": ""
  },
  {
   "id": "SPMES027010:0185",
   "jp": "ユベロン!　悪行の数々\n許す訳にはいかぬ!",
   "en": ""
  },
  {
   "id": "SPMES027010:01A0",
   "jp": "か…神よ……\nこれまでのようです…",
   "en": ""
  },
  {
   "id": "SPMES027010:01B2",
   "jp": "ど、どうだ?\n思い知ったか!?",
   "en": ""
  },
  {
   "id": "SPMES027010:01C4",
   "jp": "私としたことが…ふ、不覚!",
   "en": ""
  },
  {
   "id": "SPMES027010:01D4",
   "jp": "ハ…ハハハハ……み、見たか!\nわ、わしの強さ、思い知ったか!?",
   "en": ""
  },
  {
   "id": "SPMES027010:01F8",
   "jp": "降参しろ、枢機卿!\nさもなくば…",
   "en": ""
  },
  {
   "id": "SPMES027010:020E",
   "jp": "助けてくれ!　わしゃ本当は何も\n知らなかったんじゃぁぁ!",
   "en": ""
  }
 ]
}
