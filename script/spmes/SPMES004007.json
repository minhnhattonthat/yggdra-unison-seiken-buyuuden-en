{
 "file": "SPMES004007.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES004007:0160",
   "jp": "我らにも譲れないものがある。\n邪魔をするなら、容赦はしない!",
   "en": ""
  },
  {
   "id": "SPMES004007:0185",
   "jp": "威勢だけはいいようだな。\n王国の騎士よ!",
   "en": ""
  },
  {
   "id": "SPMES004007:01A0",
   "jp": "ファンタジニア王国に\n栄光あれ……!",
   "en": ""
  },
  {
   "id": "SPMES004007:01B7",
   "jp": "最期まで諦めの悪い奴だ!",
   "en": ""
  },
  {
   "id": "SPMES004007:01C9",
   "jp": "まだだ!　勝負はこれからだ!",
   "en": ""
  },
  {
   "id": "SPMES004007:01DA",
   "jp": "強がりもいい加減にしろ!\nもう、決着はついたんだ!",
   "en": ""
  },
  {
   "id": "SPMES004007:01F9",
   "jp": "おのれッ…王国の騎士ごときに\n敗れるなど…末代までの恥!",
   "en": ""
  },
  {
   "id": "SPMES004007:021E",
   "jp": "降参するならば、命は取らない。\n兵を退きたまえ!",
   "en": ""
  }
 ]
}
