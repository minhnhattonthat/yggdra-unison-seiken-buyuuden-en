{
 "file": "SPMES028004.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES028004:0160",
   "jp": "あら、あんた例の戦乙女じゃない。\n邪魔だから、そこをどいて頂戴",
   "en": ""
  },
  {
   "id": "SPMES028004:0188",
   "jp": "私が白薔薇の魔女風情の\n言うことに耳を貸すと思うのか?",
   "en": ""
  },
  {
   "id": "SPMES028004:01AF",
   "jp": "ア…アイギナ……\nごめんなさい…",
   "en": "A...Aegina...\nI'm sorry..."
  },
  {
   "id": "SPMES028004:01C0",
   "jp": "馬鹿ね、どいていれば\n死なずに済むものを…",
   "en": ""
  },
  {
   "id": "SPMES028004:01DA",
   "jp": "お、おのれ…よくも……",
   "en": "D-damn you... How dare..."
  },
  {
   "id": "SPMES028004:01E6",
   "jp": "どう?　少しは懲りたかしら?",
   "en": ""
  },
  {
   "id": "SPMES028004:01F7",
   "jp": "あつっ…やったわねぇ!",
   "en": ""
  },
  {
   "id": "SPMES028004:0203",
   "jp": "愚かな…\n私に勝てると思ったのか?",
   "en": "Fool... You thought\nyou could beat me?"
  }
 ]
}
