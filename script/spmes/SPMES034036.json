   "en": ""
  },
  {
   "id": "SPMES034036:01DB",
   "jp": "貴様ほどでは無いぞ。\nネシアよ…",
   "en": ""
  },
  {
   "id": "SPMES034036:01EF",
   "jp": "おやおや?　拍子抜けですね。\n焔帝がこの程度とは…フフフ……",
   "en": ""
  },
  {
   "id": "SPMES034036:0215",
   "jp": "くっ…何だとッ……!?",
   "en": ""
  }
 ]
