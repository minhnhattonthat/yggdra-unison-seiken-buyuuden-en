{
 "file": "SPMES013000.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES013000:0160",
   "jp": "剣士殿…\nお覚悟はよろしいですか?",
   "en": ""
  },
  {
   "id": "SPMES013000:0177",
   "jp": "女性を斬る趣味は持ち合わせて\nいないが…受けて立とう!",
   "en": ""
  },
  {
   "id": "SPMES013000:019C",
   "jp": "フローネ…済まない……",
   "en": "Flone... I'm sorry..."
  },
  {
   "id": "SPMES013000:01A9",
   "jp": "せめて安らかに…\nこの世を去るが良いでしょう……",
   "en": ""
  },
  {
   "id": "SPMES013000:01C6",
   "jp": "まさかこれ程までに\n強いとは…",
   "en": "I never imagined\nyou'd be this strong..."
  },
  {
   "id": "SPMES013000:01D8",
   "jp": "とうに覚悟は決めています…\nわたくしに後悔はありません",
   "en": ""
  },
  {
   "id": "SPMES013000:01F9",
   "jp": "ああッ…!",
   "en": "Aah...!"
  },
  {
   "id": "SPMES013000:01FF",
   "jp": "それ以上動かないでくれ。\n女性は斬りたくないんでね",
   "en": ""
  }
 ]
}
