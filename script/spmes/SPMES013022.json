{
 "file": "SPMES013022.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES013022:0160",
   "jp": "わたくしたちの行く手を阻むとは…\n覚悟は出来ているようですね?",
   "en": ""
  },
  {
   "id": "SPMES013022:0186",
   "jp": "これも任務なんです…",
   "en": "This is my mission..."
  },
  {
   "id": "SPMES013022:0193",
   "jp": "に、兄さん…",
   "en": ""
  },
  {
   "id": "SPMES013022:019B",
   "jp": "わたくしたちも、これ以上\n敗れる訳にはいかないのです",
   "en": ""
  },
  {
   "id": "SPMES013022:01BA",
   "jp": "くっ…私に隙があったのね?",
   "en": "Ngh... I left an opening?"
  },
  {
   "id": "SPMES013022:01C9",
   "jp": "無益な殺生はしたくありません。\n武器をお収めなさい",
   "en": ""
  },
  {
   "id": "SPMES013022:01EA",
   "jp": "ああッ…!",
   "en": "Aah...!"
  },
  {
   "id": "SPMES013022:01F0",
   "jp": "悪く思わないでください…\n…これも命令なんです",
   "en": "Please don't hold it against\nme... These are my orders."
  }
 ]
}
