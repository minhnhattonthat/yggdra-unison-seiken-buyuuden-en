{
 "file": "SPMES010026.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES010026:0160",
   "jp": "神をも恐れぬ不貞の輩どもめ!\n神罰を受けるがいい!",
   "en": ""
  },
  {
   "id": "SPMES010026:0180",
   "jp": "不貞の輩はそちらだ!\n貴様こそ覚悟するんだ!",
   "en": ""
  },
  {
   "id": "SPMES010026:019E",
   "jp": "し、神殿騎士ごときに…\nぐはぁっ……!",
   "en": ""
  },
  {
   "id": "SPMES010026:01B5",
   "jp": "神の御許で詫びるがいい!",
   "en": ""
  },
  {
   "id": "SPMES010026:01C5",
   "jp": "神の信徒を傷つけるとは\n何と罪深い…!",
   "en": ""
  },
  {
   "id": "SPMES010026:01DF",
   "jp": "貴様が神を信じているとは\n初耳だぞ、マルディム!",
   "en": ""
  },
  {
   "id": "SPMES010026:01FD",
   "jp": "どうだ!\n神の怒り、とくと味わうがいい!",
   "en": ""
  },
  {
   "id": "SPMES010026:0214",
   "jp": "私としたことが…ふ、不覚!",
   "en": "How could I...?\nA d-disgrace!"
  }
 ]
}
