 "strings": [
  {
   "id": "SPMES000003:0160",
   "jp": "女性を斬る趣味は持ち合わせて\nいないが…覚悟してもらおう!",
   "en": ""
  },
  {
   "id": "SPMES000003:0187",
   "jp": "たとえ何者であろうとも…\n寄らば、斬ります!",
   "en": ""
  },
  {
   "id": "SPMES000003:01A2",
   "jp": "…お父様、お母様…!",
   "en": ""
  },
  {
   "id": "SPMES000003:01B1",
   "jp": "死なせるつもりは\n無かったのだが……",
   "en": ""
  },
  {
   "id": "SPMES000003:01C6",
   "jp": "悪く思わないでくれ。\nこれも戦争だ…",
   "en": ""
  },
  {
   "id": "SPMES000003:01DD",
   "jp": "そんな…",
   "en": ""
  },
  {
   "id": "SPMES000003:01E2",
   "jp": "これ以上の抵抗は無駄です!\n兵をお退きなさい!",
   "en": ""
  },
  {
   "id": "SPMES000003:0202",
   "jp": "まいったな…どうも相手が\n女性だと本気を出せないんだ…",
   "en": ""
  }
 ]
}
