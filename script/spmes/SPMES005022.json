 "strings": [
  {
   "id": "SPMES005022:0160",
   "jp": "私の邪魔をするのなら\n誰であろうとも容赦はしないッ!",
   "en": ""
  },
  {
   "id": "SPMES005022:0180",
   "jp": "これも任務なんです…",
   "en": ""
  },
  {
   "id": "SPMES005022:018D",
   "jp": "に、兄さん…\nごめんなさい…",
   "en": ""
  },
  {
   "id": "SPMES005022:019D",
   "jp": "さすがは黒騎士の妹…\n手強い相手だった……",
   "en": ""
  },
  {
   "id": "SPMES005022:01BB",
   "jp": "くっ…私に隙があったのね?",
   "en": ""
  },
  {
   "id": "SPMES005022:01CA",
   "jp": "諦めろ!\nお前には私は倒せぬ!",
   "en": ""
  },
  {
   "id": "SPMES005022:01DD",
   "jp": "な、何だとッ…!?\n未熟なアサシンごときに……",
   "en": ""
  },
  {
   "id": "SPMES005022:01F8",
   "jp": "悪く思わないでください…\n…これも命令なんです",
   "en": ""
  }
 ]
}
