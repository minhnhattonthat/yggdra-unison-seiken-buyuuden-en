 "strings": [
  {
   "id": "SPMES036004:0160",
   "jp": "ネシア、貴様の野望…これ以上\n許すわけにはいかないッ!",
   "en": ""
  },
  {
   "id": "SPMES036004:0183",
   "jp": "貴方に許してもらおうなどとは\n思っていませんよ。フフフ…",
   "en": ""
  },
  {
   "id": "SPMES036004:01A4",
   "jp": "ア…アイギナ……\nごめんなさい…",
   "en": "A...Aegina...\nI'm sorry..."
  },
  {
   "id": "SPMES036004:01B5",
   "jp": "貴方たちなど…私にとって\nただの駒でしかないのですよ?",
   "en": ""
  },
  {
   "id": "SPMES036004:01D4",
   "jp": "貴様を…野放しにするな……ど…",
   "en": ""
  },
  {
   "id": "SPMES036004:01E8",
   "jp": "おやおや?　まだそのようなことを\n喋る余裕があるとは…フフフ",
   "en": ""
  },
  {
   "id": "SPMES036004:020A",
   "jp": "ば…ばか…な……",
   "en": "Im...impossible..."
  },
  {
   "id": "SPMES036004:0213",
   "jp": "貴様の好きなようには…\n断じてさせないッ!",
   "en": ""
  }
 ]
