{
 "file": "SPMES034009.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES034009:0160",
   "jp": "陛下…\n拙者とお手合わせ頂きたい!",
   "en": ""
  },
  {
   "id": "SPMES034009:0178",
   "jp": "貴様と刃を交えることになるとは…\nだが、遠慮はせぬ!　行くぞ!",
   "en": ""
  },
  {
   "id": "SPMES034009:019E",
   "jp": "ぬう、不覚…!",
   "en": ""
  },
  {
   "id": "SPMES034009:01A8",
   "jp": "しかし、さすがは軍神…\n見事な腕前だった……",
   "en": ""
  },
  {
   "id": "SPMES034009:01C4",
   "jp": "う…腕は鈍っておりませぬな……",
   "en": ""
  },
  {
   "id": "SPMES034009:01D6",
   "jp": "貴様と一緒にはしないで\nもらいたいものだ。バルドゥスよ!",
   "en": ""
  },
  {
   "id": "SPMES034009:01F7",
   "jp": "何だとッ……!?",
   "en": ""
  },
  {
   "id": "SPMES034009:0201",
   "jp": "まだまだ詰めが甘いですな。\n一瞬の隙が命取りですぞ、陛下",
   "en": ""
  }
 ]
}
