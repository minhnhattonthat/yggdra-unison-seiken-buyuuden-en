{
 "file": "SPMES000001.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES000001:0180",
   "jp": "腕は立ちそうだが…\nアンタに俺の剣が受けられるかな?",
   "en": ""
  },
  {
   "id": "SPMES000001:01A0",
   "jp": "オレ様にケンカを売るとは…\n覚悟は出来てるんだろうな!?",
   "en": ""
  },
  {
   "id": "SPMES000001:01C3",
   "jp": "チ、チクショウ…\nここまで…かよ……",
   "en": ""
  },
  {
   "id": "SPMES000001:01D6",
   "jp": "悪く思わないでくれ。\nこれも戦争だ…",
   "en": ""
  },
  {
   "id": "SPMES000001:01ED",
   "jp": "どうだい?\n実力の差が分かったかな?",
   "en": ""
  },
  {
   "id": "SPMES000001:0204",
   "jp": "や、やりやがったな…",
   "en": ""
  },
  {
   "id": "SPMES000001:020F",
   "jp": "これでも手加減したつもりだ。\n感謝して欲しいものだな!",
   "en": ""
  },
  {
   "id": "SPMES000001:0231",
   "jp": "俺の魔剣が敗れるとは…",
   "en": ""
  },
  {
   "id": "SPMES000001:0241",
   "jp": "ヘッ、拍子抜けだゼ!\n魔剣士さんよ!",
   "en": ""
  }
 ]
}
