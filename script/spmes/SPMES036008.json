{
 "file": "SPMES036008.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES036008:0160",
   "jp": "ハッ…こんな形で貴様に会えるとは\n驚きだぜ、ネシアよ!",
   "en": ""
  },
  {
   "id": "SPMES036008:0181",
   "jp": "ごたくは結構です。\n貴方には、消えてもらいましょう!",
   "en": ""
  },
  {
   "id": "SPMES036008:01A1",
   "jp": "こ、このキザ野郎め…\nグハッ……!",
   "en": ""
  },
  {
   "id": "SPMES036008:01B5",
   "jp": "貴方のような存在は新世界には\n相応しくありません。お消えなさい",
   "en": ""
  },
  {
   "id": "SPMES036008:01DF",
   "jp": "うぐ…な、何だ…とぉ……!?",
   "en": "Ugh... Wh...what...!?"
  },
  {
   "id": "SPMES036008:01EF",
   "jp": "少しは出来る者だと期待した\n私が馬鹿でしたか。フフフ…",
   "en": ""
  },
  {
   "id": "SPMES036008:0213",
   "jp": "こ…こん…な……",
   "en": "Th...this...\ncan't..."
  },
  {
   "id": "SPMES036008:021C",
   "jp": "俺様は昔から貴様のような\nキザな野郎が大嫌いなのさ!",
   "en": "The great me always hated\nsmug bastards like you!"
  }
 ]
}
