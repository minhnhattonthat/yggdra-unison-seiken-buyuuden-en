{
 "file": "SPMES035005.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES035005:0160",
   "jp": "貴様も死にたいのか!?\n愚かな女だ!",
   "en": ""
  },
  {
   "id": "SPMES035005:0178",
   "jp": "あらあら、過激な発言をする\nお嬢さんですわね!",
   "en": ""
  },
  {
   "id": "SPMES035005:0195",
   "jp": "ル…ルシエナ姉さん……\nごめんなさい…",
   "en": "L...Luciana, Sister...\nI'm sorry..."
  },
  {
   "id": "SPMES035005:01AA",
   "jp": "ごめんなさい…\n力が入り過ぎたみたいですわ……",
   "en": ""
  },
  {
   "id": "SPMES035005:01C5",
   "jp": "なッ!　何故だ!?\nこんな非戦闘員ごときに…",
   "en": ""
  },
  {
   "id": "SPMES035005:01E2",
   "jp": "あらまあ、何をおっしゃるの?\n主婦は毎日が戦いなのですわよ?",
   "en": ""
  },
  {
   "id": "SPMES035005:0207",
   "jp": "あらあら!　あたくしとしたことが\n不覚ですわ…",
   "en": ""
  },
  {
   "id": "SPMES035005:0221",
   "jp": "馬鹿な女だ!　主婦が私に勝てると\n本気で思っていたのか?",
   "en": ""
  }
 ]
}
