{
 "file": "SPMES036022.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES036022:0160",
   "jp": "フフフ…まだ任務とか、命令とか\n言い逃れをする気ですか?",
   "en": ""
  },
  {
   "id": "SPMES036022:0184",
   "jp": "今度は…私の意志で戦うんです。\n貴方を討つために……!",
   "en": ""
  },
  {
   "id": "SPMES036022:01A8",
   "jp": "に、兄さん…\nごめんなさい…",
   "en": "B-brother...\nI'm sorry..."
  },
  {
   "id": "SPMES036022:01B8",
   "jp": "貴方たちなど…私にとって\nただの駒でしかないのですよ?",
   "en": ""
  },
  {
   "id": "SPMES036022:01D7",
   "jp": "おや、どうしました?　先ほどの\n勢いは何処へ行ったのですか?",
   "en": ""
  },
  {
   "id": "SPMES036022:01FA",
   "jp": "誰か…この人を止めて……\nお願い……",
   "en": ""
  },
  {
   "id": "SPMES036022:0211",
   "jp": "こ…こん…な……",
   "en": ""
  },
  {
   "id": "SPMES036022:021A",
   "jp": "…手応えあった!?",
   "en": "...Did that land!?"
  }
 ]
}
