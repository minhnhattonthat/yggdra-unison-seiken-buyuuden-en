{
 "file": "SPMES007035.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES007035:0160",
   "jp": "ご婦人、武器を納めなさい!\n手荒なまねはしたくありません!",
   "en": ""
  },
  {
   "id": "SPMES007035:0185",
   "jp": "あらあら、お優しいのね。\nでも手加減は必要ありませんわよ?",
   "en": ""
  },
  {
   "id": "SPMES007035:01A9",
   "jp": "貴方に討たれるのなら…\n本望ですわ……",
   "en": ""
  },
  {
   "id": "SPMES007035:01C2",
   "jp": "くっ……\n死なせるには悩しい人物だった…",
   "en": ""
  },
  {
   "id": "SPMES007035:01DB",
   "jp": "あらあら!　あたくしとしたことが\n不覚ですわ…",
   "en": ""
  },
  {
   "id": "SPMES007035:01F5",
   "jp": "同郷のよしみです。\n武器を収められよ!",
   "en": ""
  },
  {
   "id": "SPMES007035:020E",
   "jp": "あたくし、素敵な殿方には\n優しいんですのよ?",
   "en": ""
  },
  {
   "id": "SPMES007035:022A",
   "jp": "な、何という強さだ…",
   "en": ""
  }
 ]
}
