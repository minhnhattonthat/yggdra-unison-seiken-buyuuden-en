{
 "file": "SPMES020004.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES020004:0140",
   "jp": "戦乙女のアイギナか…\nこうなりゃ死なばもろともだ!",
   "en": ""
  },
  {
   "id": "SPMES020004:015E",
   "jp": "馬鹿め!　死ぬのは\nお前一人で充分だ!",
   "en": ""
  },
  {
   "id": "SPMES020004:017A",
   "jp": "ル…ルシエナ姉さん……\nごめんなさい…",
   "en": ""
  },
  {
   "id": "SPMES020004:018F",
   "jp": "これも革命のためだ!\n悪く思わないでくれよ?",
   "en": ""
  },
  {
   "id": "SPMES020004:01AA",
   "jp": "なッ!　何故だ!?\nこんな雑魚ごときに…",
   "en": ""
  },
  {
   "id": "SPMES020004:01C3",
   "jp": "革命の精神を甘く見ないで\nもらいたいな!",
   "en": ""
  },
  {
   "id": "SPMES020004:01DD",
   "jp": "か…革命が……",
   "en": ""
  },
  {
   "id": "SPMES020004:01E7",
   "jp": "馬鹿め!　革命など\n本気で起こせると思っていたのか?",
   "en": ""
  }
 ]
}
