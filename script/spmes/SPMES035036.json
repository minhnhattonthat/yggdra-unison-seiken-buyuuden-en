 "strings": [
  {
   "id": "SPMES035036:0160",
   "jp": "ここは通せませんわよ?\n愛する皆さんのためにも…!",
   "en": ""
  },
  {
   "id": "SPMES035036:017D",
   "jp": "そうですか。では貴方にも\n消えて頂きましょう。フフフ…",
   "en": ""
  },
  {
   "id": "SPMES035036:019D",
   "jp": "ここまでのようですわ…\nごめんなさいね",
   "en": ""
  },
  {
   "id": "SPMES035036:01B1",
   "jp": "そのまま消え去るが良いでしょう…\n愚かな魂よ……フフフ…",
   "en": ""
  },
  {
   "id": "SPMES035036:01D3",
   "jp": "あらあら!　あたくしとしたことが\n不覚ですわ…",
   "en": ""
  },
  {
   "id": "SPMES035036:01ED",
   "jp": "フフフ…無駄です。何者も\n私を止めることなど出来はしない…",
   "en": ""
  },
  {
   "id": "SPMES035036:0212",
   "jp": "ば…ばか…な……",
   "en": ""
  },
  {
   "id": "SPMES035036:021B",
   "jp": "愛する者を守る主婦の底力…\n思い知って頂けましたわね?",
   "en": ""
  }
 ]
}
