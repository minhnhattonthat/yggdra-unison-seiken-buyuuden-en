 "strings": [
  {
   "id": "SPMES004009:0160",
   "jp": "貴方に恨みは無いが…\nこれも戦場の習︀い。お覚悟ッ!",
   "en": ""
  },
  {
   "id": "SPMES004009:0183",
   "jp": "まさか貴殿と刃を交えることに\nなるとはな…かかって参られよ!",
   "en": ""
  },
  {
   "id": "SPMES004009:01A7",
   "jp": "陛下が認めた戦乙女の力……\nみ…見届けましたぞ……",
   "en": ""
  },
  {
   "id": "SPMES004009:01C9",
   "jp": "死なすには悩しい…\n味方に欲しい人物だった……",
   "en": ""
  },
  {
   "id": "SPMES004009:01E8",
   "jp": "ぬう、不覚…!",
   "en": ""
  },
  {
   "id": "SPMES004009:01F2",
   "jp": "まさか、軍神に勝てるとは…",
   "en": ""
  },
  {
   "id": "SPMES004009:0202",
   "jp": "さ、さすがはバルドゥス殿…!",
   "en": ""
  },
  {
   "id": "SPMES004009:0212",
   "jp": "貴殿はかつての戦友。\n抵抗しなければ、命は保障しよう",
   "en": ""
  }
 ]
}
