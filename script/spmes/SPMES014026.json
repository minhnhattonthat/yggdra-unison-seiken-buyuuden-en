{
 "file": "SPMES014026.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES014026:0180",
   "jp": "オッサン!　手加減しねーぜ?",
   "en": ""
  },
  {
   "id": "SPMES014026:0192",
   "jp": "生意気な小僧だ。\n神よ、我に力を与え給え…",
   "en": ""
  },
  {
   "id": "SPMES014026:01B1",
   "jp": "信じてもいねーくせに\nカッコつけてんじゃねーよ!",
   "en": ""
  },
  {
   "id": "SPMES014026:01CB",
   "jp": "どうやら神様はお前には興味が\nねーみたいだぜ?",
   "en": ""
  },
  {
   "id": "SPMES014026:01E7",
   "jp": "異端者の分際で…!\nこ、この……ぐはぁっ!",
   "en": ""
  },
  {
   "id": "SPMES014026:0202",
   "jp": "き…貴様らは\n神の罰が恐ろしくないのか…!?",
   "en": ""
  },
  {
   "id": "SPMES014026:021D",
   "jp": "少なくともお前の罰は\n恐ろしくはねーぜ?",
   "en": ""
  },
  {
   "id": "SPMES014026:0236",
   "jp": "どうだ!?　神の怒り……\n思い知ったか!?",
   "en": ""
  },
  {
   "id": "SPMES014026:024F",
   "jp": "チクショー!　こんなヤツに\n負けるなんて……",
   "en": ""
  }
 ]
}
