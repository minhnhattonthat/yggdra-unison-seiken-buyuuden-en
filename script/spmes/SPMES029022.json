{
 "file": "SPMES029022.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES029022:0160",
   "jp": "黒騎士レオンの妹ね?\n相手にとって不足は無いわ!",
   "en": ""
  },
  {
   "id": "SPMES029022:0182",
   "jp": "こんな所で…最も危険な人物に\n出会ってしまったわ…!",
   "en": ""
  },
  {
   "id": "SPMES029022:01A5",
   "jp": "に、兄さん…",
   "en": ""
  },
  {
   "id": "SPMES029022:01AD",
   "jp": "キレた私を止められる相手は…\n結構いないものね!",
   "en": ""
  },
  {
   "id": "SPMES029022:01CB",
   "jp": "くっ…私に隙があったのね?",
   "en": ""
  },
  {
   "id": "SPMES029022:01DA",
   "jp": "隙も何も、貴方少し\nラックが低すぎじゃない?",
   "en": ""
  },
  {
   "id": "SPMES029022:01F7",
   "jp": "負けた…この私が……",
   "en": ""
  },
  {
   "id": "SPMES029022:0203",
   "jp": "悪く思わないでください…\n…これも命令なんです",
   "en": ""
  }
 ]
}
