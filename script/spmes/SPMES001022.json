{
 "file": "SPMES001022.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES001022:0160",
   "jp": "キヒヒ…女だからって\n容赦はしないゼ!?",
   "en": "Kihihi... Don't expect mercy\njust 'cause you're a girl!?"
  },
  {
   "id": "SPMES001022:0178",
   "jp": "私も…負けられないんです……",
   "en": "I... can't lose either..."
  },
  {
   "id": "SPMES001022:0188",
   "jp": "に…兄さん…!",
   "en": "B...brother...!"
  },
  {
   "id": "SPMES001022:0191",
   "jp": "ケッ、手間かけさせやがって…",
   "en": "Tch, makin' me work for it..."
  },
  {
   "id": "SPMES001022:01A2",
   "jp": "どうだ?\n恐れ入ったか?",
   "en": "How 'bout that?\nImpressed?"
  },
  {
   "id": "SPMES001022:01B1",
   "jp": "私に隙があったのね…?",
   "en": "I left an opening...?"
  },
  {
   "id": "SPMES001022:01BE",
   "jp": "…手応えあった!?",
   "en": "...Did that land!?"
  },
  {
   "id": "SPMES001022:01CA",
   "jp": "チ、チクショウ…\n油断したゼ!",
   "en": "D-dammit...\nGot careless!"
  }
 ]
}
