{
 "file": "SPMES035009.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES035009:0180",
   "jp": "祖父が抱えた積年の恨み…\n晴らさせて頂きますわよ?",
   "en": ""
  },
  {
   "id": "SPMES035009:01A2",
   "jp": "ご婦人!　拙者、無粋な真似は\n本意では無い。兵を退かれよ!",
   "en": ""
  },
  {
   "id": "SPMES035009:01CD",
   "jp": "あらあらお優しいのね。\nでも、手加減は要りませんわよ?",
   "en": ""
  },
  {
   "id": "SPMES035009:01EE",
   "jp": "そなた…まさかブライ殿の……?\nその強さ…血は争えませんな……",
   "en": ""
  },
  {
   "id": "SPMES035009:0212",
   "jp": "気付いていらっしゃったのね?\n軍神様……",
   "en": ""
  },
  {
   "id": "SPMES035009:022B",
   "jp": "な、何と……!?",
   "en": ""
  },
  {
   "id": "SPMES035009:0235",
   "jp": "油断は大敵ですわよ~?\n軍神様♪",
   "en": ""
  },
  {
   "id": "SPMES035009:024C",
   "jp": "あらあら!　あたくしとしたことが\n不覚ですわ…",
   "en": ""
  },
  {
   "id": "SPMES035009:0266",
   "jp": "拙者は無駄な殺生は好まぬ…\n抵抗しなければ、命は保障しよう",
   "en": ""
  }
 ]
}
