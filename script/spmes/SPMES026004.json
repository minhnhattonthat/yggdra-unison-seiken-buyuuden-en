 "strings": [
  {
   "id": "SPMES026004:0160",
   "jp": "おお、罪深き乙女よ!\n汝の魂を今ここに救わん…!",
   "en": ""
  },
  {
   "id": "SPMES026004:0181",
   "jp": "貴様に救ってもらうつもりなど\n毛頭無いッ!",
   "en": ""
  },
  {
   "id": "SPMES026004:019D",
   "jp": "ア…アイギナ……\nごめんなさい…",
   "en": ""
  },
  {
   "id": "SPMES026004:01AE",
   "jp": "何という気の毒な乙女だ…\n神の御許に召されるがいい……",
   "en": ""
  },
  {
   "id": "SPMES026004:01D2",
   "jp": "何たる屈辱ッ……\nこのような輩に敗れるとは……",
   "en": ""
  },
  {
   "id": "SPMES026004:01EF",
   "jp": "これが神のご意志だ!\n思い知るがいい!",
   "en": ""
  },
  {
   "id": "SPMES026004:0207",
   "jp": "か、神の信徒に\n何という振る舞いを…",
   "en": ""
  },
  {
   "id": "SPMES026004:021F",
   "jp": "貴様らの神など\n我らは知らぬ!",
   "en": ""
  }
 ]
}
