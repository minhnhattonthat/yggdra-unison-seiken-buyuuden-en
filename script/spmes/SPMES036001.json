 "strings": [
  {
   "id": "SPMES036001:0160",
   "jp": "テメェは野放しにできねぇ。\nこの場で斬り刻んでやるゼ!",
   "en": ""
  },
  {
   "id": "SPMES036001:0181",
   "jp": "フフフ…愚かな。\nならば消えるが良いでしょう!",
   "en": ""
  },
  {
   "id": "SPMES036001:019C",
   "jp": "や、やりやがったな…\nチクショウ……",
   "en": ""
  },
  {
   "id": "SPMES036001:01AF",
   "jp": "傭兵風情が私を倒そうなどと\n考えないことですね。フフフ…",
   "en": ""
  },
  {
   "id": "SPMES036001:01D2",
   "jp": "チ、チクショウ…\n油断したゼ!",
   "en": ""
  },
  {
   "id": "SPMES036001:01E4",
   "jp": "おやおや、私をこの場で\n斬り刻むのではなかったのですか?",
   "en": ""
  },
  {
   "id": "SPMES036001:0204",
   "jp": "ば…ばか…な……",
   "en": ""
  },
  {
   "id": "SPMES036001:020D",
   "jp": "どうした?\nザマぁねぇな!",
   "en": ""
  }
 ]
}
