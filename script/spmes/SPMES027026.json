 "strings": [
  {
   "id": "SPMES027026:0180",
   "jp": "よ、よくも今までわしを利用して\nくれたな、マルディム!",
   "en": ""
  },
  {
   "id": "SPMES027026:019F",
   "jp": "もうあんたに用は無いんだよ!\nあんたの役目は終わったのさ!",
   "en": ""
  },
  {
   "id": "SPMES027026:01C2",
   "jp": "おのれ、マルディムめ!\nゆ、許さんぞ!",
   "en": ""
  },
  {
   "id": "SPMES027026:01D7",
   "jp": "こ…こんな老いぼれに……",
   "en": ""
  },
  {
   "id": "SPMES027026:01E5",
   "jp": "た、倒したのか…!?\nハ、ハハハ…ハ……",
   "en": ""
  },
  {
   "id": "SPMES027026:01FB",
   "jp": "私が…負ける……?",
   "en": ""
  },
  {
   "id": "SPMES027026:0206",
   "jp": "ハ…ハハハハ……み、見たか!\nわ、わしの強さ、思い知ったか!?",
   "en": ""
  },
  {
   "id": "SPMES027026:022A",
   "jp": "いい加減にしろ!\nこの老いぼれが!",
   "en": ""
  },
  {
   "id": "SPMES027026:023F",
   "jp": "ヒィィー!　た、助けてくれ!\nわしゃ、悪気は無かったんじゃ!",
   "en": ""
  }
 ]
}
