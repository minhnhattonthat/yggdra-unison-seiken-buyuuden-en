 "strings": [
  {
   "id": "SPMES036028:0160",
   "jp": "おや?　貴方は白薔薇の領主。\nまだ生きていたとは……フフフ…",
   "en": ""
  },
  {
   "id": "SPMES036028:0187",
   "jp": "そうよ。あんたにお返しをしたくて\nここで待っていたのよ?",
   "en": ""
  },
  {
   "id": "SPMES036028:01A6",
   "jp": "…くっ!　ここまでなの!?",
   "en": ""
  },
  {
   "id": "SPMES036028:01B4",
   "jp": "貴方にはもう、用はありません。\nそのままお消えなさい……フフフ…",
   "en": ""
  },
  {
   "id": "SPMES036028:01D9",
   "jp": "おやおや?　拍子抜けですね。\n貴方の力はその程度でしたか…",
   "en": ""
  },
  {
   "id": "SPMES036028:01FF",
   "jp": "ちょっと油断しただけよ…!",
   "en": ""
  },
  {
   "id": "SPMES036028:020F",
   "jp": "どう?　少しは懲りたかしら?\nこれは今までのお返しよ?",
   "en": ""
  },
  {
   "id": "SPMES036028:022F",
   "jp": "ば…ばか…な……",
   "en": "Im...impossible..."
  }
 ]
}
