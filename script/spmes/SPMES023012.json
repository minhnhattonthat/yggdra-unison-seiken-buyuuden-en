 "strings": [
  {
   "id": "SPMES023012:0160",
   "jp": "人間風情が…\nここを通す訳にはいかない!",
   "en": "Lowly human... You shall\nnot pass through here!"
  },
  {
   "id": "SPMES023012:017B",
   "jp": "…………",
   "en": "..."
  },
  {
   "id": "SPMES023012:0180",
   "jp": "エ、エメローネ様…\n無力な私をお許しください……",
   "en": "E-Emelone-sama... Forgive\nme for being so powerless..."
  },
  {
   "id": "SPMES023012:019D",
   "jp": "仕留めた!?",
   "en": "Is it done!?"
  },
  {
   "id": "SPMES023012:01A6",
   "jp": "おのれ…人間風情が……",
   "en": "Curses... A mere human..."
  },
  {
   "id": "SPMES023012:01B6",
   "jp": "まだまだ未熟!",
   "en": "Still too green!"
  },
  {
   "id": "SPMES023012:01C0",
   "jp": "我らの邪魔をするな!",
   "en": "Do not stand in our way!"
  },
  {
   "id": "SPMES023012:01CE",
   "jp": "…しまった!",
   "en": "...Damn!"
  }
 ]
}
