 "strings": [
  {
   "id": "SPMES029009:0160",
   "jp": "まさか相手が軍神とはね…\nでも、もう後には退けないわ!",
   "en": ""
  },
  {
   "id": "SPMES029009:0181",
   "jp": "仕合うか。お相手致そう!",
   "en": ""
  },
  {
   "id": "SPMES029009:0193",
   "jp": "さすがは…ユーディ殿……",
   "en": ""
  },
  {
   "id": "SPMES029009:01A1",
   "jp": "もう、後には退けないのよ…\nバルドゥス殿……",
   "en": ""
  },
  {
   "id": "SPMES029009:01BB",
   "jp": "油断があったのか…\n拙者も老いたものだ……",
   "en": ""
  },
  {
   "id": "SPMES029009:01D6",
   "jp": "それ以上抵抗するなら\n手加減は出来ないわよ?",
   "en": ""
  },
  {
   "id": "SPMES029009:01F6",
   "jp": "これ以上は手加減出来ぬ!\n武器を収められよ!",
   "en": ""
  },
  {
   "id": "SPMES029009:0217",
   "jp": "くっ…何てことなの……",
   "en": ""
  }
 ]
