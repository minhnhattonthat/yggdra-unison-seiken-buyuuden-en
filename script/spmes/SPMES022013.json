 "strings": [
  {
   "id": "SPMES022013:0160",
   "jp": "手加減は無用です。\nかかってきなさい!",
   "en": ""
  },
  {
   "id": "SPMES022013:0179",
   "jp": "ごめんなさい…\nこれも命令なんです……",
   "en": ""
  },
  {
   "id": "SPMES022013:018F",
   "jp": "…弱き者は滅びゆく……\nこれも運命…なのでしょうね……",
   "en": "...The weak shall perish...\nPerhaps this, too, is fate..."
  },
  {
   "id": "SPMES022013:01B0",
   "jp": "悪く思わないでください…\n…これも任務なんです……",
   "en": ""
  },
  {
   "id": "SPMES022013:01CE",
   "jp": "…ああっ……!",
   "en": "...Aah...!"
  },
  {
   "id": "SPMES022013:01D6",
   "jp": "…手応えあった!?",
   "en": "...Did that land!?"
  },
  {
   "id": "SPMES022013:01E2",
   "jp": "あっ……",
   "en": ""
  },
  {
   "id": "SPMES022013:01E7",
   "jp": "貴方は…その優しさを捨てない限り\nわたくしには勝てませんよ?",
   "en": ""
  }
 ]
