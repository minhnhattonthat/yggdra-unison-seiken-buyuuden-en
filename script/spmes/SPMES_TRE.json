{
 "file": "SPMES_TRE.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES_TRE:0160",
   "jp": "よう、いらっしゃい!",
   "en": ""
  },
  {
   "id": "SPMES_TRE:016B",
   "jp": "あんた、ここは初めてかい?\nだったら、軽く説明してやるよ",
   "en": ""
  },
  {
   "id": "SPMES_TRE:018C",
   "jp": "探索ってのは、ようは宝探しさ。\nお宝には色々なものがあって…",
   "en": ""
  },
  {
   "id": "SPMES_TRE:01B2",
   "jp": "無事手に入れたら、きっとあんたの\n勢力の役に立つと思うよ",
   "en": ""
  },
  {
   "id": "SPMES_TRE:01D8",
   "jp": "さて…誰が探索に行くんだい?",
   "en": ""
  },
  {
   "id": "SPMES_TRE:01EA",
   "jp": "どこへ探索に行くんだい?",
   "en": ""
  },
  {
   "id": "SPMES_TRE:01F9",
   "jp": "他の誰かにも\n探索を行なわせるかい?",
   "en": ""
  },
  {
   "id": "SPMES_TRE:0210",
   "jp": "じゃあ、気をつけて行ってきなよ",
   "en": ""
  },
  {
   "id": "SPMES_TRE:0221",
   "jp": "そうか。\nまた寄ってくれよな!",
   "en": ""
  },
  {
   "id": "SPMES_TRE:0232",
   "jp": "残念だけど、今探索を行える\nユニットがいないみたいだな!",
   "en": ""
  },
  {
   "id": "SPMES_TRE:0254",
   "jp": "残念だけど、今探索を行える\n領土がないみたいだな!",
   "en": ""
  }
 ]
}
