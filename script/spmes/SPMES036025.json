 "strings": [
  {
   "id": "SPMES036025:0160",
   "jp": "おや?　貴方は黒薔薇の領主。\nまだ生きていたとは……フフフ…",
   "en": ""
  },
  {
   "id": "SPMES036025:0187",
   "jp": "お前には色々と思うところが\nあって、生き延びて来たのだ!",
   "en": ""
  },
  {
   "id": "SPMES036025:01AB",
   "jp": "…くっ……だめか",
   "en": ""
  },
  {
   "id": "SPMES036025:01B4",
   "jp": "貴方にはもう、用はありません。\nそのままお消えなさい……フフフ…",
   "en": ""
  },
  {
   "id": "SPMES036025:01D9",
   "jp": "私が…負ける……か…",
   "en": ""
  },
  {
   "id": "SPMES036025:01E5",
   "jp": "おやおや?　拍子抜けですね。\n貴方の力はその程度でしたか…",
   "en": ""
  },
  {
   "id": "SPMES036025:020B",
   "jp": "ば…ばか…な……",
   "en": "Im...impossible..."
  },
  {
   "id": "SPMES036025:0214",
   "jp": "フッ…私のことを\n侮り過ぎたようだな",
   "en": ""
  }
 ]
}
