  {
   "id": "SPMES031025:0193",
   "jp": "クケッ、ケーッケッケッケ!",
   "en": "Kukeh, keeh-kekekeke!"
  },
  {
   "id": "SPMES031025:01A1",
   "jp": "私が…負ける……か…",
