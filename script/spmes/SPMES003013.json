 "strings": [
  {
   "id": "SPMES003013:0180",
   "jp": "エメローネ女王!\n無駄な抵抗はやめてください!",
   "en": ""
  },
  {
   "id": "SPMES003013:019E",
   "jp": "このエメローネ、ウンディーネの\n長として一歩も引きはしません!",
   "en": ""
  },
  {
   "id": "SPMES003013:01C2",
   "jp": "わたくしの負けです…\n王女よ……",
   "en": ""
  },
  {
   "id": "SPMES003013:01D6",
   "jp": "…弱き者は滅びゆく……\nこれも運命…なのでしょうね……",
   "en": ""
  },
  {
   "id": "SPMES003013:01F7",
   "jp": "エメローネ女王…!",
   "en": ""
  },
  {
   "id": "SPMES003013:0203",
   "jp": "…ああっ……!",
   "en": ""
  },
  {
   "id": "SPMES003013:020B",
   "jp": "勝負はつきました。\nもう武器を置いてください!",
   "en": ""
  },
  {
   "id": "SPMES003013:0228",
   "jp": "…さすがはエメローネ女王……",
   "en": ""
  },
  {
   "id": "SPMES003013:0239",
   "jp": "今のわたくしたちは敵同士。\n手加減はしないと言ったはずです",
   "en": ""
  }
 ]
}
