   "jp": "これも任務なんです…",
   "en": "This is my mission..."
  },
  {
   "id": "SPMES022005:018B",
   "jp": "ル…ルシエナ姉さん……\nごめんなさい…",
   "en": "L...Luciana, Sister...\nI'm sorry..."
  },
  {
   "id": "SPMES022005:01A0",
   "jp": "悪く思わないでください…\n…これも任務なんです……",
   "en": ""
  },
  {
   "id": "SPMES022005:01BE",
   "jp": "…手応えあった!?",
   "en": "...Did that land!?"
  },
