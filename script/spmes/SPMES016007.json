 "strings": [
  {
   "id": "SPMES016007:0160",
   "jp": "罪も無い民を襲う不届き者め!\nここは通さん!",
   "en": ""
  },
  {
   "id": "SPMES016007:017F",
   "jp": "こっちだって食っていかなきゃ\nならねぇんだよ!　行くぜ!",
   "en": ""
  },
  {
   "id": "SPMES016007:019D",
   "jp": "祖国に…栄光あれ…!",
   "en": "Glory... to my homeland...!"
  },
  {
   "id": "SPMES016007:01AC",
   "jp": "バカめ!　死んじまったら\n国も何もねぇだろうが!",
   "en": ""
  },
  {
   "id": "SPMES016007:01C8",
   "jp": "この男…意外と手強い!",
   "en": ""
  },
  {
   "id": "SPMES016007:01D9",
   "jp": "子分どもの手前、簡単に負ける\nワケにはいかねぇんだよ!",
   "en": ""
  },
  {
   "id": "SPMES016007:01FC",
   "jp": "ぐはッ…し、死ぬほどいてぇ…",
   "en": "Gwah... Hurts like hell..."
  },
  {
   "id": "SPMES016007:020C",
   "jp": "降伏すれば手荒なマネはしない!",
   "en": ""
  }
 ]
