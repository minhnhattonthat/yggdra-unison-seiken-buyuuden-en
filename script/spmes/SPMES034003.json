 "strings": [
  {
   "id": "SPMES034003:0180",
   "jp": "王女よ!　まだおめおめと\n生き延びていたのか!?",
   "en": ""
  },
  {
   "id": "SPMES034003:019D",
   "jp": "焔帝ガルカーサ…!　両親の仇…\n貴方を討ちます!",
   "en": ""
  },
  {
   "id": "SPMES034003:01BE",
   "jp": "面白い!　では貴様の覚悟を\n見せてもらおう。行くぞ!",
   "en": ""
  },
  {
   "id": "SPMES034003:01E0",
   "jp": "お父様…お母様……",
   "en": ""
  },
  {
   "id": "SPMES034003:01EE",
   "jp": "王女よ…貴様の覚悟とは\nその程度のものだったのか?",
   "en": ""
  },
  {
   "id": "SPMES034003:0210",
   "jp": "な…何て強さなの……!?",
   "en": ""
  },
  {
   "id": "SPMES034003:021F",
   "jp": "その程度の力で俺を倒せると\n思うなッ!",
   "en": ""
  },
  {
   "id": "SPMES034003:0239",
   "jp": "諦めなさい、ガルカーサ!\n勝負はつきました",
   "en": ""
  },
  {
   "id": "SPMES034003:0252",
   "jp": "うぬぅ…力が……",
   "en": ""
  }
 ]
