 "strings": [
  {
   "id": "SPMES028013:0160",
   "jp": "そこのウンディーネ!\n悪いけど、道を空けて頂戴",
   "en": ""
  },
  {
   "id": "SPMES028013:017D",
   "jp": "ここをどくわけにはいきません。\nわたくしを倒してお行きなさい!",
   "en": ""
  },
  {
   "id": "SPMES028013:019E",
   "jp": "ああっ……!",
   "en": ""
  },
  {
   "id": "SPMES028013:01A5",
   "jp": "悪く思わないで欲しいわね。\nどかなかったあんたが悪いのよ?",
   "en": ""
  },
  {
   "id": "SPMES028013:01C7",
   "jp": "お、お見事です……",
   "en": ""
  },
  {
   "id": "SPMES028013:01D3",
   "jp": "降参するんなら、\n手出しはしないわよ?",
   "en": ""
  },
  {
   "id": "SPMES028013:01EB",
   "jp": "あんた…強いじゃない……",
   "en": ""
  },
  {
   "id": "SPMES028013:01F9",
   "jp": "わたくしたちも、これ以上\n敗れる訳にはいかないのです",
   "en": ""
  }
 ]
