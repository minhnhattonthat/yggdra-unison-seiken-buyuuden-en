   "en": ""
  },
  {
   "id": "SPMES011036:01A4",
   "jp": "フフフ…どうしました?\nかかって来ないのですか?",
   "en": ""
  },
  {
   "id": "SPMES011036:01BE",
   "jp": "お姉ちゃんのカタキ…\nニーチェ、取ってみせる!",
   "en": ""
  },
  {
   "id": "SPMES011036:01D8",
   "jp": "ば…ばか…な……\nこのような小娘に……",
   "en": ""
  },
  {
   "id": "SPMES011036:01EE",
   "jp": "お姉ちゃんのカタキ\n取ったよ!",
   "en": ""
  },
  {
   "id": "SPMES011036:0200",
   "jp": "ただのウンディーネだと…\n見くびっていましたよ……",
   "en": ""
  },
  {
   "id": "SPMES011036:021B",
   "jp": "ニーチェ、結構強いんだよ?",
   "en": ""
  },
  {
   "id": "SPMES011036:022C",
   "jp": "おや?　どうしました?\n貴方の力はその程度なのですか?",
   "en": ""
  },
  {
   "id": "SPMES011036:024D",
   "jp": "お姉ちゃん……",
   "en": ""
  }
 ]
