{
 "file": "SPMES016034.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES016034:0160",
   "jp": "若造!　誰だか知らねぇが\n金目のもん出してもらうぜ!",
   "en": ""
  },
  {
   "id": "SPMES016034:0182",
   "jp": "貴様…本当に俺のことを\n知らないのか!?",
   "en": ""
  },
  {
   "id": "SPMES016034:019D",
   "jp": "こんな雑魚…ごときに……\nぐはぁっ……!",
   "en": ""
  },
  {
   "id": "SPMES016034:01B4",
   "jp": "あ?　こいつ、まさか…!?",
   "en": ""
  },
  {
   "id": "SPMES016034:01C2",
   "jp": "何だとッ……!?\n山賊ごときに……",
   "en": ""
  },
  {
   "id": "SPMES016034:01D7",
   "jp": "実戦経験とハングリー精神の\n恐ろしさを思い知ったか!",
   "en": ""
  },
  {
   "id": "SPMES016034:01FA",
   "jp": "こ、こいつ強い…\nいったい何者なんだ……!?",
   "en": ""
  },
  {
   "id": "SPMES016034:0214",
   "jp": "フン、相手が誰だか確かめてから\nケンカを売るんだな!",
   "en": ""
  }
 ]
}
