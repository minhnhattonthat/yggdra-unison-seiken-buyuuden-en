{
 "file": "SPMES003036.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES003036:01A0",
   "jp": "貴方が諸悪の根源なのね!?\n覚悟なさい!",
   "en": ""
  },
  {
   "id": "SPMES003036:01BD",
   "jp": "その聖剣は元々は私のもの…\n返して貰いましょう!",
   "en": ""
  },
  {
   "id": "SPMES003036:01DC",
   "jp": "誰が渡すものですか!\n私はこの剣で貴方を討ちます!",
   "en": ""
  },
  {
   "id": "SPMES003036:01FC",
   "jp": "そうか。では、仕方ない…\n愚かなお嬢さんだ……",
   "en": ""
  },
  {
   "id": "SPMES003036:0218",
   "jp": "フフ…それが力、か……\n私の憎しみでさえも打ち砕く力…",
   "en": ""
  },
  {
   "id": "SPMES003036:0239",
   "jp": "貴方の野望もこれまでよ!\nネシア…",
   "en": ""
  },
  {
   "id": "SPMES003036:024F",
   "jp": "フ…フフフ……そうですか…\n…私の……負け…ですか……",
   "en": ""
  },
  {
   "id": "SPMES003036:026C",
   "jp": "抵抗しないのであれば\n命は取りません!",
   "en": ""
  },
  {
   "id": "SPMES003036:0284",
   "jp": "おや?　どうしました?\n貴方ほどの人物がこの程度とは……",
   "en": ""
  },
  {
   "id": "SPMES003036:02A7",
   "jp": "そ、そんな…",
   "en": "N-no..."
  }
 ]
}
