{
 "file": "SPMES022001.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES022001:0160",
   "jp": "ごめんなさい…\nこれも任務なんです……",
   "en": "I'm sorry...\nThis is my mission..."
  },
  {
   "id": "SPMES022001:0176",
   "jp": "キヒヒ…女だからって\n容赦はしないゼ!?",
   "en": "Kihihi... Don't expect mercy\njust 'cause you're a girl!?"
  },
  {
   "id": "SPMES022001:018E",
   "jp": "や、やりやがったな…",
   "en": "Y-ya did it now..."
  },
  {
   "id": "SPMES022001:0199",
   "jp": "これも命令なんです…",
   "en": "These are my orders..."
  },
  {
   "id": "SPMES022001:01A6",
   "jp": "…手応えあった!?",
   "en": "...Did that land!?"
  },
  {
   "id": "SPMES022001:01B2",
   "jp": "チ、チクショウ…\n油断したゼ!",
   "en": "D-dammit...\nGot careless!"
  },
  {
   "id": "SPMES022001:01C4",
   "jp": "私に隙があったのね…?",
   "en": "I left an opening...?"
  },
  {
   "id": "SPMES022001:01D1",
   "jp": "ケッ、手間かけさせやがって…",
   "en": "Tch, makin' me work for it..."
  }
 ]
}
