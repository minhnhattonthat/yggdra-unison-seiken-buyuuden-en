   "en": ""
  },
  {
   "id": "SPMES036005:0182",
   "jp": "疑うことを知らない愚かな者たち…\n本当に愚かですね。フフフ……",
   "en": ""
  },
  {
   "id": "SPMES036005:01A9",
   "jp": "ル…ルシエナ姉さん……\nごめんなさい…",
   "en": "L...Luciana, Sister...\nI'm sorry..."
  },
  {
   "id": "SPMES036005:01BE",
   "jp": "貴方たちなど…私にとって\nただの駒でしかないのですよ?",
   "en": ""
  },
  {
   "id": "SPMES036005:01DD",
   "jp": "…ま、待てッ…まだ決着は\nついて……い…ない……",
   "en": ""
  },
  {
   "id": "SPMES036005:01F9",
   "jp": "おやおや?　この期に及んで\n強がりですか…フフフ……",
   "en": ""
  },
  {
   "id": "SPMES036005:0217",
   "jp": "ば…ばか…な……",
   "en": "Im...impossible..."
  },
  {
   "id": "SPMES036005:0220",
   "jp": "フン、なめられたものだな!",
   "en": ""
  }
 ]
