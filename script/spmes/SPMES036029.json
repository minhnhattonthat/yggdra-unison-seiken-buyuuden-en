{
 "file": "SPMES036029.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES036029:0160",
   "jp": "おやおや?　宮廷魔術師はもう\n全滅したのかと思ってましたよ?",
   "en": ""
  },
  {
   "id": "SPMES036029:0187",
   "jp": "残念だったわね。最強最悪なのが\nここに生き残っていたのよ!",
   "en": ""
  },
  {
   "id": "SPMES036029:01AD",
   "jp": "…あうっ!　しまった…!",
   "en": ""
  },
  {
   "id": "SPMES036029:01BA",
   "jp": "フフフ…最強最悪などと言って\n口ほどにもありませんでしたね…",
   "en": ""
  },
  {
   "id": "SPMES036029:01DF",
   "jp": "くっ!\nやってくれるじゃない…!",
   "en": ""
  },
  {
   "id": "SPMES036029:01F0",
   "jp": "貴方たちなど…私にとって\nただの駒でしかないのですよ?",
   "en": ""
  },
  {
   "id": "SPMES036029:020F",
   "jp": "もう一回やりあってもいいわよ?\nどうせ私の勝ちでしょうけど",
   "en": ""
  },
  {
   "id": "SPMES036029:0230",
   "jp": "ば…ばか…な……",
   "en": "Im...impossible..."
  }
 ]
}
