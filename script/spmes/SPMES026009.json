{
 "file": "SPMES026009.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES026009:0160",
   "jp": "おお、鬼だ!　戦の鬼め!\n神罰を受けるがいい!",
   "en": ""
  },
  {
   "id": "SPMES026009:017D",
   "jp": "どなたか存ぜぬが…\n相手になってしんぜよう!",
   "en": ""
  },
  {
   "id": "SPMES026009:0197",
   "jp": "お…お見事……",
   "en": ""
  },
  {
   "id": "SPMES026009:01A1",
   "jp": "私には神がついておいでだ。\n何も恐れるものは無い!",
   "en": ""
  },
  {
   "id": "SPMES026009:01BE",
   "jp": "ぬう…なかなかのお手並み……",
   "en": ""
  },
  {
   "id": "SPMES026009:01CF",
   "jp": "全ては神のご意志によるもの。\n神を信ずる者は救われるであろう!",
   "en": ""
  },
  {
   "id": "SPMES026009:01F5",
   "jp": "な…何だと……この私が\n鬼に敗れるなど……",
   "en": ""
  },
  {
   "id": "SPMES026009:020E",
   "jp": "拙者は無駄な殺生は好まぬ…\n抵抗しなければ、命は保障しよう",
   "en": ""
  }
 ]
}
