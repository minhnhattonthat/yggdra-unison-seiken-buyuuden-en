 "strings": [
  {
   "id": "SPMES036014:0160",
   "jp": "お前が諸悪の根源だな?\n来い!　ぶっ飛ばしてやるぜ!",
   "en": ""
  },
  {
   "id": "SPMES036014:0182",
   "jp": "フフフ…私をぶっ飛ばす?\n面白い、試してみましょう!",
   "en": ""
  },
  {
   "id": "SPMES036014:01A1",
   "jp": "…チッ…マズったか!?\nみんな…後は頼んだぜ……",
   "en": ""
  },
  {
   "id": "SPMES036014:01BC",
   "jp": "悔いを残しながら…\nお消えなさい……フフフ…",
   "en": ""
  },
  {
   "id": "SPMES036014:01D6",
   "jp": "くそ…やはり強いぜ……",
   "en": ""
  },
  {
   "id": "SPMES036014:01E3",
   "jp": "良く頑張った方だと…\n言ってあげましょう。フフフ……",
   "en": ""
  },
  {
   "id": "SPMES036014:0203",
   "jp": "おらおらおらーッ!\nテメェだけは許さねーッ!",
   "en": ""
  },
  {
   "id": "SPMES036014:021B",
   "jp": "な…何故……何故…\nこの私が……",
   "en": ""
  }
 ]
