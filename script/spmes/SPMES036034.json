{
 "file": "SPMES036034.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "SPMES036034:0180",
   "jp": "おや?　焔帝。貴方の役目はもう\n終わったのですよ?",
   "en": ""
  },
  {
   "id": "SPMES036034:01A1",
   "jp": "いや、まだ残っているようだ。\n貴様を倒すという役目がな!",
   "en": ""
  },
  {
   "id": "SPMES036034:01C4",
   "jp": "フフフ…私を倒しますか。\nでは、試してみるが良いでしょう!",
   "en": ""
  },
  {
   "id": "SPMES036034:01E5",
   "jp": "フフフ…ハハハハ!\n愚かな…ハーッハッハッハ!",
   "en": ""
  },
  {
   "id": "SPMES036034:01FE",
   "jp": "む…無念だ……",
   "en": ""
  },
  {
   "id": "SPMES036034:0208",
   "jp": "おやおや?　拍子抜けですね。\n私を倒すのではなかったのですか?",
   "en": ""
  },
  {
   "id": "SPMES036034:022C",
   "jp": "くっ…何だとッ……!?",
   "en": ""
  },
  {
   "id": "SPMES036034:0239",
   "jp": "こ…こん…な……",
   "en": ""
  },
  {
   "id": "SPMES036034:0242",
   "jp": "これ以上、貴様の好きにはさせん!",
   "en": ""
  }
 ]
}
