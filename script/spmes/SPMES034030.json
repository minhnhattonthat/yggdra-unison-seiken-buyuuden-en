 "strings": [
  {
   "id": "SPMES034030:0180",
   "jp": "雑魚が…!\n思い知らせてやろう!",
   "en": ""
  },
  {
   "id": "SPMES034030:0195",
   "jp": "うほっ!　あの、ちょっと用を\n思い出したから…帰ってもいい?",
   "en": ""
  },
  {
   "id": "SPMES034030:01B8",
   "jp": "帰る…?\n貴様らに逃げ道など無い!",
   "en": ""
  },
  {
   "id": "SPMES034030:01D0",
   "jp": "すがすがし暴風のあと月清し…\nぐはぁっ!",
   "en": ""
  },
  {
   "id": "SPMES034030:01E9",
   "jp": "こいつ…まさか\n雑魚では無かったのか?",
   "en": ""
  },
  {
   "id": "SPMES034030:0200",
   "jp": "うきゃーッ!\n目から星が出たッ!",
   "en": ""
  },
  {
   "id": "SPMES034030:0214",
   "jp": "雑魚は大人しく\n引っ込んでいろ!",
   "en": ""
  },
  {
   "id": "SPMES034030:022B",
   "jp": "パメラ様、錐揉み反転ビィームッ!",
   "en": ""
  },
  {
   "id": "SPMES034030:0241",
   "jp": "何だとッ……!?\nこいつ、雑魚では無かったのか…",
   "en": ""
  }
 ]
}
