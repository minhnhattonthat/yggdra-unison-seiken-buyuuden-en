{
 "file": "MESSAGE066.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE066:03A0",
   "jp": "俺を怒らせない方がいいぜ?",
   "en": "Better not make\nme angry."
  },
  {
   "id": "MESSAGE066:03B1",
   "jp": "オレ様を恨まねぇでくれよな",
   "en": "No grudges against\nthe great me, y'hear?"
  },
  {
   "id": "MESSAGE066:03C1",
   "jp": "故郷のみんな…ごめん!",
   "en": "Everyone at home...\nI'm sorry!"
  },
  {
   "id": "MESSAGE066:03CF",
   "jp": "許せ…!",
   "en": "Forgive me...!"
  },
  {
   "id": "MESSAGE066:03D5",
   "jp": "すまない…",
   "en": "I'm sorry..."
  },
  {
   "id": "MESSAGE066:03DB",
   "jp": "やりすぎちゃったかも…",
   "en": "I may have\noverdone it..."
  },
  {
   "id": "MESSAGE066:03E7",
   "jp": "討ち取った…",
   "en": "I have slain them..."
  },
  {
   "id": "MESSAGE066:03F0",
   "jp": "俺様の機嫌を損ねた罰だ!",
   "en": "That's for pissin' off\nthe great me!"
  },
  {
   "id": "MESSAGE066:0403",
   "jp": "勝敗は時の運…",
   "en": "Victory rests on\nfortune's whim..."
  },
  {
   "id": "MESSAGE066:040F",
   "jp": "どうしてこうなっちゃった\nのかな…",
   "en": "How did it end up\nlike this...?"
  },
  {
   "id": "MESSAGE066:0421",
   "jp": "すまない…",
   "en": "I'm sorry..."
  },
  {
   "id": "MESSAGE066:0427",
   "jp": "ちくしょう…ひでえよ……",
   "en": "Damn it...\nthat's so cruel..."
  },
  {
   "id": "MESSAGE066:0434",
   "jp": "もしかして…\nちょっとやりすぎちゃった?",
   "en": "Did I maybe...\noverdo it a little?"
  },
  {
   "id": "MESSAGE066:0449",
   "jp": "だって、これは戦争だから…",
   "en": "I mean, this is\nwar, after all..."
  },
  {
   "id": "MESSAGE066:0459",
   "jp": "恨まないでくれな…",
   "en": "Don't hold a\ngrudge, okay..."
  },
  {
   "id": "MESSAGE066:0464",
   "jp": "文句は神様に言ってくれよ!",
   "en": "Complain to God,\nnot me!"
  },
  {
   "id": "MESSAGE066:0476",
   "jp": "…………",
   "en": ""
  },
  {
   "id": "MESSAGE066:047B",
   "jp": "戦場に情けは無用だ…",
   "en": "Mercy has no place\non the battlefield..."
  },
  {
   "id": "MESSAGE066:048B",
   "jp": "フフ…お気の毒様",
   "en": "Fufu... how very\nsad for you."
  },
  {
   "id": "MESSAGE066:0497",
   "jp": "神の御名を通して\n祈りを捧げよう…",
   "en": "In God's holy name,\nI shall pray for you..."
  },
  {
   "id": "MESSAGE066:04AE",
   "jp": "これが戦いなのよ",
   "en": "That's war for you."
  },
  {
   "id": "MESSAGE066:04B8",
   "jp": "ケケ、クケケケッ!",
   "en": "Keke, Kukekekeh!"
  },
  {
   "id": "MESSAGE066:04C2",
   "jp": "グォォォォーッ!",
   "en": "Groooooh!"
  },
  {
   "id": "MESSAGE066:04CB",
   "jp": "グワォォォォーグワォッ!",
   "en": "Grwaaaaa- Grwaoh!"
  },
  {
   "id": "MESSAGE066:04D8",
   "jp": "悲しいけど…これも\n戦争なのですわね……",
   "en": "It's sad... but this\nis war, isn't it..."
  }
 ]
}
