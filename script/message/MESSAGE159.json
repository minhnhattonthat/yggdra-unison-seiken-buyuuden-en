{
 "file": "MESSAGE159.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE159:0240",
   "jp": "王国の復権を目指して\n以後も精進しましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE159:0261",
   "jp": "だが、油断はならぬ。\n慎重に歩を進めよう",
   "en": ""
  },
  {
   "id": "MESSAGE159:027C",
   "jp": "ウンディーネの未来のために\n次回も頑張りましょう",
   "en": ""
  },
  {
   "id": "MESSAGE159:029B",
   "jp": "いい感じだな。\n次もこの調子でいこうぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE159:02B4",
   "jp": "次はもっと稼ぐぞぉ!\nおめぇらも気張れ!",
   "en": ""
  },
  {
   "id": "MESSAGE159:02CD",
   "jp": "バラ色の人生を築くために\n次も頑張るんじゃぞい!",
   "en": ""
  },
  {
   "id": "MESSAGE159:02ED",
   "jp": "我が黒薔薇の未来に\n栄光あれ!",
   "en": ""
  },
  {
   "id": "MESSAGE159:0305",
   "jp": "か…神がついておるから\nわしらは無敵じゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE159:031D",
   "jp": "白薔薇の旗の下、\n進撃を続けるわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE159:0337",
   "jp": "次回はもっと\nスゴイことするわよ~?",
   "en": ""
  },
  {
   "id": "MESSAGE159:034C",
   "jp": "我らの征戦は\nこれで終わりではないぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE159:0364",
   "jp": "更なる昇華を目指して…\n進んで行きましょう",
   "en": ""
  }
 ]
}
