{
 "file": "MESSAGE132.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE132:0480",
   "jp": "またアンタと顔を合わせる\nことになるとはな…",
   "en": "To think I'd face\nyou again..."
  },
  {
   "id": "MESSAGE132:0499",
   "jp": "思い上がるんじゃねぇぞ…!",
   "en": "Don't get cocky...!"
  },
  {
   "id": "MESSAGE132:04A9",
   "jp": "覚悟はできてるよ…",
   "en": "I'm ready for\nwhatever comes..."
  },
  {
   "id": "MESSAGE132:04B5",
   "jp": "辱めを受けるつもりは\nありません!",
   "en": "I will not submit\nto disgrace!"
  },
  {
   "id": "MESSAGE132:04C9",
   "jp": "陛下…情けは無用です……",
   "en": "Your Majesty... spare\nme your mercy......"
  },
  {
   "id": "MESSAGE132:04DA",
   "jp": "陛下…私は……",
   "en": "Your Majesty... I......"
  },
  {
   "id": "MESSAGE132:04E3",
   "jp": "好きにするといいわ…",
   "en": "Do as you like..."
  },
  {
   "id": "MESSAGE132:04EF",
   "jp": "情けは無用です",
   "en": "I need no mercy."
  },
  {
   "id": "MESSAGE132:04FA",
   "jp": "くっ…何のつもりだ!?",
   "en": "Tch... What're you\nplaying at!?"
  },
  {
   "id": "MESSAGE132:0507",
   "jp": "情けなど無用…",
   "en": "Spare me thy mercy..."
  },
  {
   "id": "MESSAGE132:0512",
   "jp": "くっ、このようなことが…!",
   "en": "Ngh, how could this...!"
  },
  {
   "id": "MESSAGE132:0520",
   "jp": "ごめんなさい…",
   "en": "I'm sorry..."
  },
  {
   "id": "MESSAGE132:0528",
   "jp": "…どのような仕打ちも\nお受け致します",
   "en": "...I will accept any\ntreatment you give."
  },
  {
   "id": "MESSAGE132:053F",
   "jp": "貴方の思うようになさい…",
   "en": "Do as you see fit..."
  },
  {
   "id": "MESSAGE132:054F",
   "jp": "お前、出世したな…",
   "en": "You've come up in\nthe world, huh..."
  },
  {
   "id": "MESSAGE132:055C",
   "jp": "…親分……",
   "en": "...Boss......"
  },
  {
   "id": "MESSAGE132:0564",
   "jp": "ワシを殺しても\n何もいいことはねぇぞ!?",
   "en": "Killin' me won't do\nya any good!?"
  },
  {
   "id": "MESSAGE132:057B",
   "jp": "あわわ…命ばかりは……",
   "en": "Eep... at least\nspare my life......"
  },
  {
   "id": "MESSAGE132:0588",
   "jp": "ごめんね、お兄様…",
   "en": "I'm sorry, Big\nBrother..."
  },
  {
   "id": "MESSAGE132:0594",
   "jp": "もう、好きにしなよ!",
   "en": "Fine, do what\nyou want!"
  },
  {
   "id": "MESSAGE132:05A0",
   "jp": "勝敗は時の運さ…",
   "en": "Win or lose, it's\nall luck..."
  },
  {
   "id": "MESSAGE132:05AD",
   "jp": "おいおい、マジかよ…",
   "en": "Whoa, whoa...\nSeriously?"
  },
  {
   "id": "MESSAGE132:05B8",
   "jp": "兄さん……",
   "en": "Brother......"
  },
  {
   "id": "MESSAGE132:05BF",
   "jp": "好きにするがいい…",
   "en": "Do as you will..."
  },
  {
   "id": "MESSAGE132:05CA",
   "jp": "くっ…認めないわよ……",
   "en": "Ngh... I won't\naccept this......"
  },
  {
   "id": "MESSAGE132:05D7",
   "jp": "貴様、何のつもりだ…!",
   "en": "You... what is the\nmeaning of this...!"
  },
  {
   "id": "MESSAGE132:05E6",
   "jp": "あの時の恩を忘れたと\nいうのか!?　愚か者が!",
   "en": "Forgotten the debt\nyou owe me!? Fool!"
  },
  {
   "id": "MESSAGE132:0603",
   "jp": "頼む、許してくれ!\nわしゃ、死ぬのは嫌じゃあ!",
   "en": "Mercy, I beg you! Oh,\nI don't want to die!"
  },
  {
   "id": "MESSAGE132:061F",
   "jp": "誰があんたなんかに…!",
   "en": "As if I'd ever bow\nto you...!"
  },
  {
   "id": "MESSAGE132:062C",
   "jp": "焔帝の名は飾りじゃないって\nことね…",
   "en": "Flame Emperor is no\nempty title, then..."
  },
  {
   "id": "MESSAGE132:0643",
   "jp": "イジめないでよぅ…",
   "en": "Don't bully meee..."
  },
  {
   "id": "MESSAGE132:064D",
   "jp": "ク…クワァ……ッ!",
   "en": "Ku... Kwaaah......!"
  },
  {
   "id": "MESSAGE132:0657",
   "jp": "グ…グオォォッ!?",
   "en": "Gr... Grooaah!?"
  },
  {
   "id": "MESSAGE132:0661",
   "jp": "グワォ…!",
   "en": "Grwah...!"
  },
  {
   "id": "MESSAGE132:0667",
   "jp": "好きにするがいい…",
   "en": "Do as you will..."
  },
  {
   "id": "MESSAGE132:0672",
   "jp": "あなたに勝てるとは\n思ってませんでしたわ",
   "en": "I never thought I\ncould beat you, dear."
  },
  {
   "id": "MESSAGE132:0689",
   "jp": "好きなようにするのが\n良いでしょう",
   "en": "Do as you please,\nthen."
  }
 ]
}
