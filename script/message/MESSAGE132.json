{
 "file": "MESSAGE132.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE132:0480",
   "jp": "またアンタと顔を合わせる\nことになるとはな…",
   "en": ""
  },
  {
   "id": "MESSAGE132:0499",
   "jp": "思い上がるんじゃねぇぞ…!",
   "en": ""
  },
  {
   "id": "MESSAGE132:04A9",
   "jp": "覚悟はできてるよ…",
   "en": ""
  },
  {
   "id": "MESSAGE132:04B5",
   "jp": "辱めを受けるつもりは\nありません!",
   "en": ""
  },
  {
   "id": "MESSAGE132:04C9",
   "jp": "陛下…情けは無用です……",
   "en": ""
  },
  {
   "id": "MESSAGE132:04DA",
   "jp": "陛下…私は……",
   "en": ""
  },
  {
   "id": "MESSAGE132:04E3",
   "jp": "好きにするといいわ…",
   "en": ""
  },
  {
   "id": "MESSAGE132:04EF",
   "jp": "情けは無用です",
   "en": ""
  },
  {
   "id": "MESSAGE132:04FA",
   "jp": "くっ…何のつもりだ!?",
   "en": ""
  },
  {
   "id": "MESSAGE132:0507",
   "jp": "情けなど無用…",
   "en": ""
  },
  {
   "id": "MESSAGE132:0512",
   "jp": "くっ、このようなことが…!",
   "en": ""
  },
  {
   "id": "MESSAGE132:0520",
   "jp": "ごめんなさい…",
   "en": ""
  },
  {
   "id": "MESSAGE132:0528",
   "jp": "…どのような仕打ちも\nお受け致します",
   "en": ""
  },
  {
   "id": "MESSAGE132:053F",
   "jp": "貴方の思うようになさい…",
   "en": ""
  },
  {
   "id": "MESSAGE132:054F",
   "jp": "お前、出世したな…",
   "en": ""
  },
  {
   "id": "MESSAGE132:055C",
   "jp": "…親分……",
   "en": ""
  },
  {
   "id": "MESSAGE132:0564",
   "jp": "ワシを殺しても\n何もいいことはねぇぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE132:057B",
   "jp": "あわわ…命ばかりは……",
   "en": ""
  },
  {
   "id": "MESSAGE132:0588",
   "jp": "ごめんね、お兄様…",
   "en": ""
  },
  {
   "id": "MESSAGE132:0594",
   "jp": "もう、好きにしなよ!",
   "en": ""
  },
  {
   "id": "MESSAGE132:05A0",
   "jp": "勝敗は時の運さ…",
   "en": ""
  },
  {
   "id": "MESSAGE132:05AD",
   "jp": "おいおい、マジかよ…",
   "en": ""
  },
  {
   "id": "MESSAGE132:05B8",
   "jp": "兄さん……",
   "en": ""
  },
  {
   "id": "MESSAGE132:05BF",
   "jp": "好きにするがいい…",
   "en": ""
  },
  {
   "id": "MESSAGE132:05CA",
   "jp": "くっ…認めないわよ……",
   "en": ""
  },
  {
   "id": "MESSAGE132:05D7",
   "jp": "貴様、何のつもりだ…!",
   "en": ""
  },
  {
   "id": "MESSAGE132:05E6",
   "jp": "あの時の恩を忘れたと\nいうのか!?　愚か者が!",
   "en": ""
  },
  {
   "id": "MESSAGE132:0603",
   "jp": "頼む、許してくれ!\nわしゃ、死ぬのは嫌じゃあ!",
   "en": ""
  },
  {
   "id": "MESSAGE132:061F",
   "jp": "誰があんたなんかに…!",
   "en": ""
  },
  {
   "id": "MESSAGE132:062C",
   "jp": "焔帝の名は飾りじゃないって\nことね…",
   "en": ""
  },
  {
   "id": "MESSAGE132:0643",
   "jp": "イジめないでよぅ…",
   "en": ""
  },
  {
   "id": "MESSAGE132:064D",
   "jp": "ク…クワァ……ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE132:0657",
   "jp": "グ…グオォォッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE132:0661",
   "jp": "グワォ…!",
   "en": ""
  },
  {
   "id": "MESSAGE132:0667",
   "jp": "好きにするがいい…",
   "en": ""
  },
  {
   "id": "MESSAGE132:0672",
   "jp": "あなたに勝てるとは\n思ってませんでしたわ",
   "en": ""
  },
  {
   "id": "MESSAGE132:0689",
   "jp": "好きなようにするのが\n良いでしょう",
   "en": ""
  }
 ]
