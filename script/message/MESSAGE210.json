{
 "file": "MESSAGE210.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE210:04F0",
   "jp": "これにしておこう",
   "en": ""
  },
  {
   "id": "MESSAGE210:04F9",
   "jp": "オレ様もたまには質素に\n…なんつってな!",
   "en": ""
  },
  {
   "id": "MESSAGE210:0511",
   "jp": "うーん、どこにでも\nありそうな感じするけど",
   "en": ""
  },
  {
   "id": "MESSAGE210:0528",
   "jp": "素朴でいいわね。\nこれにしましょう",
   "en": ""
  },
  {
   "id": "MESSAGE210:053C",
   "jp": "中身は\n期待できないだろうがな",
   "en": ""
  },
  {
   "id": "MESSAGE210:0550",
   "jp": "中身は\n期待できなさそうだがな",
   "en": ""
  },
  {
   "id": "MESSAGE210:0564",
   "jp": "珍しいものでは\n無さそうだけどね",
   "en": ""
  },
  {
   "id": "MESSAGE210:0577",
   "jp": "すべすべした\n手触りの箱ですね",
   "en": ""
  },
  {
   "id": "MESSAGE210:058A",
   "jp": "こんなボロ箱、持って帰る間\nに壊れちまうんじゃねぇか?",
   "en": ""
  },
  {
   "id": "MESSAGE210:05AB",
   "jp": "拙者には\nこのくらいがちょうどよいわ",
   "en": ""
  },
  {
   "id": "MESSAGE210:05C0",
   "jp": "素朴だが味わい深い箱だな…\n気に入った",
   "en": ""
  },
  {
   "id": "MESSAGE210:05DB",
   "jp": "この箱、なんだろ?",
   "en": ""
  },
  {
   "id": "MESSAGE210:05E6",
   "jp": "パッと見る限り、大した\n値打ちは無さそうだが…",
   "en": ""
  },
  {
   "id": "MESSAGE210:0604",
   "jp": "これを持ち\n帰ることにしましょう",
   "en": ""
  },
  {
   "id": "MESSAGE210:0617",
   "jp": "手頃な箱だな。\nこれにするか",
   "en": ""
  },
  {
   "id": "MESSAGE210:0629",
   "jp": "うーん、どう見ても\nフツーの箱だよなあ…?",
   "en": ""
  },
  {
   "id": "MESSAGE210:0641",
   "jp": "今回はハズレだぞい…",
   "en": ""
  },
  {
   "id": "MESSAGE210:064E",
   "jp": "ただの箱にしか\n見えないがのう…",
   "en": ""
  },
  {
   "id": "MESSAGE210:0661",
   "jp": "これを持って帰ろっと!",
   "en": ""
  },
  {
   "id": "MESSAGE210:066F",
   "jp": "イタッ!　木のササクレが\n指に刺さったー!",
   "en": ""
  },
  {
   "id": "MESSAGE210:0688",
   "jp": "あーあ、こんな場所まで\n足を運んだってのに…",
   "en": ""
  },
  {
   "id": "MESSAGE210:06A3",
   "jp": "こんな箱じゃ、\n宝は望めそうにねえなあ…",
   "en": ""
  },
  {
   "id": "MESSAGE210:06BB",
   "jp": "では、これで…",
   "en": ""
  },
  {
   "id": "MESSAGE210:06C3",
   "jp": "よし",
   "en": ""
  },
  {
   "id": "MESSAGE210:06C6",
   "jp": "あまり好みじゃないわ…",
   "en": ""
  },
  {
   "id": "MESSAGE210:06D3",
   "jp": "ほこりを\nかぶっているようだが…",
   "en": ""
  },
  {
   "id": "MESSAGE210:06E4",
   "jp": "フン、貧乏くさい木箱だな…",
   "en": ""
  },
  {
   "id": "MESSAGE210:06F6",
   "jp": "ひっ!?　む、虫が\nついとるではないか!",
   "en": ""
  },
  {
   "id": "MESSAGE210:070C",
   "jp": "微妙…",
   "en": ""
  },
  {
   "id": "MESSAGE210:0712",
   "jp": "この箱、表面の仕上げが\nなってないわ",
   "en": ""
  },
  {
   "id": "MESSAGE210:072A",
   "jp": "こんな木箱、パメラ様には\n釣り合わないわ~",
   "en": ""
  },
  {
   "id": "MESSAGE210:0745",
   "jp": "ケケッ!",
   "en": "Kekeh!"
  },
  {
   "id": "MESSAGE210:074A",
   "jp": "グォ~…",
   "en": ""
  },
  {
   "id": "MESSAGE210:074F",
   "jp": "グワォ~…",
   "en": ""
  },
  {
   "id": "MESSAGE210:0755",
   "jp": "もう、この地に用は無い",
   "en": ""
  },
  {
   "id": "MESSAGE210:0764",
   "jp": "この木目調が\nシックで良いですわね?",
   "en": ""
  },
  {
   "id": "MESSAGE210:077B",
   "jp": "フフフ…\nまあ、中身にもよりますね",
   "en": ""
  },
  {
   "id": "MESSAGE210:078F",
   "jp": "これでいいのか…?",
   "en": ""
  },
  {
   "id": "MESSAGE210:0799",
   "jp": "案外中身は立派かもね",
   "en": ""
  }
 ]
}
