{
 "file": "MESSAGE070.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE070:04C0",
   "jp": "焔帝の名は\nダテじゃない…か……",
   "en": "So the Flame Emperor\nlives up to his name..."
  },
  {
   "id": "MESSAGE070:04D4",
   "jp": "くそっ、オレ様負け犬かよ…",
   "en": "Damn... the great me,\na sorry loser...?"
  },
  {
   "id": "MESSAGE070:04E5",
   "jp": "モニカ…\n強くなったんだな……",
   "en": "Monica... you've\ngotten strong......"
  },
  {
   "id": "MESSAGE070:04F6",
   "jp": "何という…力なの……",
   "en": "Such... power..."
  },
  {
   "id": "MESSAGE070:0503",
   "jp": "認めん…認めんぞ……!",
   "en": "I won't accept...\nI won't accept this...!"
  },
  {
   "id": "MESSAGE070:0511",
   "jp": "ユグドラ、貴様…ッ!",
   "en": "Yggdra, you...!"
  },
  {
   "id": "MESSAGE070:051E",
   "jp": "カナンが無事なら…\nそれで……",
   "en": "If Canaan is safe...\nthat's enough......"
  },
  {
   "id": "MESSAGE070:0530",
   "jp": "お…お見事……",
   "en": "W-well done..."
  },
  {
   "id": "MESSAGE070:053A",
   "jp": "くっそおおぉぉぉッ!",
   "en": "Daaamn iiit!"
  },
  {
   "id": "MESSAGE070:0545",
   "jp": "むう、お、お見事…",
   "en": "Hmm... w-well\nfought..."
  },
  {
   "id": "MESSAGE070:0551",
   "jp": "おのれ、暗殺者め…",
   "en": "Curse you,\nassassin..."
  },
  {
   "id": "MESSAGE070:055E",
   "jp": "ニーチェ、まだまだだね…",
   "en": "Nietzsche still has\na long way to go..."
  },
  {
   "id": "MESSAGE070:056B",
   "jp": "流石はエメローネ様…",
   "en": "As expected of\nEmelone-sama..."
  },
  {
   "id": "MESSAGE070:0579",
   "jp": "流石はイシーヌ…",
   "en": "As expected of\nIshiene..."
  },
  {
   "id": "MESSAGE070:0584",
   "jp": "へへっ…いっちょまえに\n成長しやがって……",
   "en": "Heh... look at you,\nall grown up......"
  },
  {
   "id": "MESSAGE070:059C",
   "jp": "親分、やっぱり強ぇや…",
   "en": "Boss, you're\nstrong as ever..."
  },
  {
   "id": "MESSAGE070:05AB",
   "jp": "こんなお嬢ちゃんに…",
   "en": "Beaten by a little\nmissy like this..."
  },
  {
   "id": "MESSAGE070:05B7",
   "jp": "流石は神様じゃ…",
   "en": "Truly a god,\nthat one, heh..."
  },
  {
   "id": "MESSAGE070:05C3",
   "jp": "お兄様には…\nかなわないわ……",
   "en": "I'm no match...\nfor Big Brother......"
  },
  {
   "id": "MESSAGE070:05D5",
   "jp": "ちょ…ちょっとは\n手加減しなさいよ!",
   "en": "H-hey... go a little\neasier on me!"
  },
  {
   "id": "MESSAGE070:05EB",
   "jp": "細腕のくせに\n大したもんだな…",
   "en": "For such skinny\narms, not bad..."
  },
  {
   "id": "MESSAGE070:05FE",
   "jp": "ああっ、オイラの賞金が…",
   "en": "Aaah, my bounty..."
  },
  {
   "id": "MESSAGE070:060D",
   "jp": "兄さ…ん……",
   "en": "Broth...er......"
  },
  {
   "id": "MESSAGE070:0615",
   "jp": "見事だ…エレナ……",
   "en": "Well done...\nElena......"
  },
  {
   "id": "MESSAGE070:0621",
   "jp": "強いわね、貴方…",
   "en": "You're strong,\naren't you..."
  },
  {
   "id": "MESSAGE070:062D",
   "jp": "ふざけたことを…ッ!",
   "en": "Such insolence...!"
  },
  {
   "id": "MESSAGE070:0638",
   "jp": "な、何故私が負ける…?",
   "en": "H-how could I lose...?"
  },
  {
   "id": "MESSAGE070:0647",
   "jp": "と、年寄りに何という\n扱いを…",
   "en": "Wh-what a way to\ntreat an old man..."
  },
  {
   "id": "MESSAGE070:065B",
   "jp": "絶対に認めないわよ…",
   "en": "I'll never\naccept this..."
  },
  {
   "id": "MESSAGE070:0669",
   "jp": "さ、さすがだわ…",
   "en": "I-impressive..."
  },
  {
   "id": "MESSAGE070:0672",
   "jp": "も~やだ~!",
   "en": "Ughhh, no fair~!"
  },
  {
   "id": "MESSAGE070:0679",
   "jp": "ク…クワァ……ァ…",
   "en": "Ku... Kwaaa......a..."
  },
  {
   "id": "MESSAGE070:0683",
   "jp": "グォ…グオァ……ァ…",
   "en": "Gro... Groaa......a..."
  },
  {
   "id": "MESSAGE070:068E",
   "jp": "グワォ…グワォォォ~…ッ!",
   "en": "Grwao... Grwaooo~...!"
  },
  {
   "id": "MESSAGE070:069C",
   "jp": "さすがは我が妹だ…",
   "en": "As expected of\nmy sister..."
  },
  {
   "id": "MESSAGE070:06A8",
   "jp": "さすがは軍神様ですわ…",
   "en": "As expected of the\nmighty God of War..."
  },
  {
   "id": "MESSAGE070:06B6",
   "jp": "ば、ばかな…!?",
   "en": "I-impossible...?!"
  }
 ]
}
