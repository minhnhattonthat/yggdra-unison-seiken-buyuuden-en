{
 "file": "MESSAGE022.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE022:0640",
   "jp": "この剣に断てぬものなしッ!",
   "en": "There's nothing this\nsword can't cut!"
  },
  {
   "id": "MESSAGE022:0650",
   "jp": "誰だろうと容赦しないゼ!",
   "en": "No mercy, whoever\nya are!"
  },
  {
   "id": "MESSAGE022:0660",
   "jp": "民兵をなめるな!",
   "en": "Don't underestimate\nthe militia!"
  },
  {
   "id": "MESSAGE022:066B",
   "jp": "お受けなさい!",
   "en": "Receive this!"
  },
  {
   "id": "MESSAGE022:0674",
   "jp": "我が剣、受けてみよ!",
   "en": "Taste my sword!"
  },
  {
   "id": "MESSAGE022:0682",
   "jp": "息の根を止めてやろう!",
   "en": "I'll finish you off!"
  },
  {
   "id": "MESSAGE022:0691",
   "jp": "あたしは逃げたりしないわ!",
   "en": "I'm not running away!"
  },
  {
   "id": "MESSAGE022:06A0",
   "jp": "先手必勝!",
   "en": "The first strike wins!"
  },
  {
   "id": "MESSAGE022:06AA",
   "jp": "さあ、楽しくやろうぜ!",
   "en": "C'mon, let's have\nsome fun!"
  },
  {
   "id": "MESSAGE022:06B7",
   "jp": "お相手いたそう",
   "en": "I shall face thee."
  },
  {
   "id": "MESSAGE022:06C1",
   "jp": "聖騎士の槍、受けてみよ!",
   "en": "Face the lance of a\nholy knight!"
  },
  {
   "id": "MESSAGE022:06D3",
   "jp": "そこ、どいて!",
   "en": "Get out of the way!"
  },
  {
   "id": "MESSAGE022:06DB",
   "jp": "生きて帰れると思うな!",
   "en": "You won't leave\nhere alive!"
  },
  {
   "id": "MESSAGE022:06EA",
   "jp": "お覚悟を!",
   "en": "Prepare yourself!"
  },
  {
   "id": "MESSAGE022:06F2",
   "jp": "受けてみろってんだ!",
   "en": "Take this, why\ndon'tcha!"
  },
  {
   "id": "MESSAGE022:06FE",
   "jp": "突撃だーっ!",
   "en": "Chaaarge!"
  },
  {
   "id": "MESSAGE022:0707",
   "jp": "やっちまうぞぉ!",
   "en": "Let's get 'em!"
  },
  {
   "id": "MESSAGE022:0710",
   "jp": "脳天カチ割ってやるわい!",
   "en": "I'll crack yer skull\nopen, heh!"
  },
  {
   "id": "MESSAGE022:0720",
   "jp": "さあ、いくよ!",
   "en": "Here I go!"
  },
  {
   "id": "MESSAGE022:0728",
   "jp": "どかないとケガするよっ!",
   "en": "Move it or you'll\nget hurt!"
  },
  {
   "id": "MESSAGE022:0735",
   "jp": "いくぞ!",
   "en": "Let's go!"
  },
  {
   "id": "MESSAGE022:073A",
   "jp": "やっちまうぞ!",
   "en": "Let's do 'em in!"
  },
  {
   "id": "MESSAGE022:0742",
   "jp": "…覚悟!",
   "en": "...Prepare yourself!"
  },
  {
   "id": "MESSAGE022:0749",
   "jp": "消えろッ!",
   "en": "Vanish!"
  },
  {
   "id": "MESSAGE022:0750",
   "jp": "貴方に耐えられるかしら?",
   "en": "Can you endure this?"
  },
  {
   "id": "MESSAGE022:0760",
   "jp": "この力、受けられるか?",
   "en": "Can you withstand\nthis power?"
  },
  {
   "id": "MESSAGE022:076E",
   "jp": "異端者め、消えろ!",
   "en": "Heretic, be gone!"
  },
  {
   "id": "MESSAGE022:077C",
   "jp": "も、もうやけくそじゃ!",
   "en": "Oh, I-I'm goin'\nfor broke!"
  },
  {
   "id": "MESSAGE022:0788",
   "jp": "あたしの魔法を\nくらいなさい!",
   "en": "Taste my magic,\ndarling!"
  },
  {
   "id": "MESSAGE022:079A",
   "jp": "ふふっ、かかって来なさい!",
   "en": "Hmhm, come and\nget me!"
  },
  {
   "id": "MESSAGE022:07A9",
   "jp": "パメラ\n本気でいっきまーす!",
   "en": "Pamela's goin'\nall out for reeeal!"
  },
  {
   "id": "MESSAGE022:07BA",
   "jp": "ケケッ、クケケケーッ!",
   "en": "Kekeh, kukekekeeh!"
  },
  {
   "id": "MESSAGE022:07C6",
   "jp": "グォォォォォォォッ!",
   "en": "Grooooooogh!"
  },
  {
   "id": "MESSAGE022:07D1",
   "jp": "グワォォォォォォォッ!",
   "en": "Grwaooooooogh!"
  },
  {
   "id": "MESSAGE022:07DD",
   "jp": "死ねぇっ!",
   "en": "Die!"
  },
  {
   "id": "MESSAGE022:07E4",
   "jp": "手加減は出来ませんわよ?",
   "en": "I can't hold back,\nyou know?"
  },
  {
   "id": "MESSAGE022:07F6",
   "jp": "お消えなさい!",
   "en": "Kindly vanish!"
  },
  {
   "id": "MESSAGE022:07FF",
   "jp": "おらおらーッ!",
   "en": "C'mon, c'mooon!"
  },
  {
   "id": "MESSAGE022:0807",
   "jp": "逃がさないわよ!",
   "en": "You won't escape!"
  },
  {
   "id": "MESSAGE022:0811",
   "jp": "突撃だ!",
   "en": "Charge!"
  },
  {
   "id": "MESSAGE022:0818",
   "jp": "受けてみなさい!",
   "en": "Take this, if you can!"
  },
  {
   "id": "MESSAGE022:0822",
   "jp": "それ、いくぜ!",
   "en": "Here goes!"
  },
  {
   "id": "MESSAGE022:082A",
   "jp": "消えちゃいな!",
   "en": "Get lost!"
  },
  {
   "id": "MESSAGE022:0833",
   "jp": "攻撃開始!",
   "en": "Commence attack!"
  },
  {
   "id": "MESSAGE022:083D",
   "jp": "おどきなさい!",
   "en": "Step aside!"
  },
  {
   "id": "MESSAGE022:0845",
   "jp": "消えろ!",
   "en": "Disappear!"
  },
  {
   "id": "MESSAGE022:084B",
   "jp": "ぶっ飛ばして行くわよ!",
   "en": "I'll blow you away!"
  },
  {
   "id": "MESSAGE022:0858",
   "jp": "かわしてみよ!",
   "en": "Dodge this!"
  },
  {
   "id": "MESSAGE022:0860",
   "jp": "クケケッ!",
   "en": "Kukekeh!"
  },
  {
   "id": "MESSAGE022:0866",
   "jp": "グオォォォォォッ!",
   "en": "Grooooogh!"
  },
  {
   "id": "MESSAGE022:0870",
   "jp": "それッ!",
   "en": "Hyah!"
  },
  {
   "id": "MESSAGE022:0875",
   "jp": "くらいなさい!",
   "en": "Take this!"
  }
 ]
