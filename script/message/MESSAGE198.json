  {
   "id": "MESSAGE198:0640",
   "jp": "仕方ないが…\n行ってみるか",
   "en": ""
  },
  {
   "id": "MESSAGE198:0650",
   "jp": "気が乗らないが…\n行ってくるゼ……",
   "en": ""
  },
  {
   "id": "MESSAGE198:0664",
   "jp": "苦手な地形だけど…\n行ってきます",
   "en": ""
  },
  {
   "id": "MESSAGE198:0679",
   "jp": "難しそうな地形ね…\n大丈夫かしら…?",
   "en": ""
  },
  {
   "id": "MESSAGE198:0692",
   "jp": "気乗りしないが…\n行ってくるか……",
   "en": ""
  },
  {
   "id": "MESSAGE198:06A6",
   "jp": "気乗りしないが…\n待っているがいい",
   "en": ""
  },
  {
   "id": "MESSAGE198:06BB",
   "jp": "少し心配だけど…\n行くしかないわね……",
   "en": ""
  },
  {
   "id": "MESSAGE198:06D2",
   "jp": "…行って参ります",
   "en": ""
  },
  {
