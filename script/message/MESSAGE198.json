  },
  {
   "id": "MESSAGE198:078B",
   "jp": "ボクが行くの?\nめんどくさいよー…",
   "en": ""
  },
  {
   "id": "MESSAGE198:079D",
   "jp": "じゃあ…行ってくる",
   "en": ""
  },
  {
   "id": "MESSAGE198:07A7",
   "jp": "…行けばいいんだろ?",
   "en": ""
  },
  {
   "id": "MESSAGE198:07B2",
   "jp": "行きたくねぇなぁ…",
   "en": ""
  },
  {
   "id": "MESSAGE198:07BC",
