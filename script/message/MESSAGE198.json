   "en": ""
  },
  {
   "id": "MESSAGE198:08EF",
   "jp": "何も見つからなくても\n怒らないでくれよ…",
   "en": ""
  },
  {
   "id": "MESSAGE198:0907",
   "jp": "何か見つかる可能性は…\n低そうね……",
   "en": ""
  },
  {
   "id": "MESSAGE198:0920",
   "jp": "どうにも気が進まないが…",
   "en": ""
  },
  {
   "id": "MESSAGE198:092F",
   "jp": "…行かないとダメ?",
   "en": ""
  },
  {
   "id": "MESSAGE198:0939",
   "jp": "気が進まんな…",
   "en": ""
  },
  {
   "id": "MESSAGE198:0943",
   "jp": "ク、クケ…?",
   "en": ""
  },
  {
   "id": "MESSAGE198:094A",
