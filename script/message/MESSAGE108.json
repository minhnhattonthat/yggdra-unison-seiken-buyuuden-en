{
 "file": "MESSAGE108.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE108:04B0",
   "jp": "撤退するのも\n戦略のうち、ってね…",
   "en": "Retreat is part of\nstrategy, they say..."
  },
  {
   "id": "MESSAGE108:04C6",
   "jp": "チクショウ、一旦退くゼ!",
   "en": "Dammit, fallin' back\nfor now!"
  },
  {
   "id": "MESSAGE108:04D6",
   "jp": "退くしか無いのか…",
   "en": "Can we only\nretreat...?"
  },
  {
   "id": "MESSAGE108:04E2",
   "jp": "体勢を立て直します…",
   "en": "We will regroup..."
  },
  {
   "id": "MESSAGE108:04F1",
   "jp": "一旦退くぞ!",
   "en": "Fall back for now!"
  },
  {
   "id": "MESSAGE108:04FB",
   "jp": "退け!　後退するんだ!",
   "en": "Retreat! Fall back!"
  },
  {
   "id": "MESSAGE108:050A",
   "jp": "…ごめんなさい!",
   "en": "...I'm sorry!"
  },
  {
   "id": "MESSAGE108:0513",
   "jp": "…申し訳ありません",
   "en": "...My deepest\napologies."
  },
  {
   "id": "MESSAGE108:051F",
   "jp": "これで終わりだと思うな…!",
   "en": "Don't think this is\nover...!"
  },
  {
   "id": "MESSAGE108:052F",
   "jp": "もはやここまで…か",
   "en": "So it ends here...\ndoes it."
  },
  {
   "id": "MESSAGE108:0539",
   "jp": "くっ…体勢を立て直すぞ!",
   "en": "Ngh... We regroup!"
  },
  {
   "id": "MESSAGE108:054A",
   "jp": "ニーチェ、さがるね!",
   "en": "Nietzsche's backing\noff!"
  },
  {
   "id": "MESSAGE108:0555",
   "jp": "このままでは埒が明かない。\n一旦退くぞ…",
   "en": "This gets us nowhere.\nFall back for now..."
  },
  {
   "id": "MESSAGE108:056F",
   "jp": "…体勢を立て直します",
   "en": "...We shall regroup."
  },
  {
   "id": "MESSAGE108:057E",
   "jp": "分が悪いぜ…一時退却だ",
   "en": "Odds ain't good...\nfallin' back!"
  },
  {
   "id": "MESSAGE108:0590",
   "jp": "許してくだせえ…",
   "en": "Forgive me, please..."
  },
  {
   "id": "MESSAGE108:059A",
   "jp": "いちいち命賭けてたら\n体が持たねぇぞ…",
   "en": "Bettin' my life every\ntime? I'd be dead!"
  },
  {
   "id": "MESSAGE108:05B2",
   "jp": "面倒なことになる前に\n逃げるかのう!",
   "en": "Best scram 'fore it\ngets messy, eh!"
  },
  {
   "id": "MESSAGE108:05C9",
   "jp": "…ごめんね",
   "en": "...Sorry."
  },
  {
   "id": "MESSAGE108:05CF",
   "jp": "ウチの手には負えないよ…",
   "en": "This is too much for\nme..."
  },
  {
   "id": "MESSAGE108:05DE",
   "jp": "不本意だが…一時退却だ",
   "en": "I hate it, but...\nfall back!"
  },
  {
   "id": "MESSAGE108:05F1",
   "jp": "雲行きが怪しくなって\n来やがった。退却するぞ!",
   "en": "Things're lookin'\ngrim. Retreat!"
  },
  {
   "id": "MESSAGE108:060E",
   "jp": "申し訳…ありません……",
   "en": "I'm... terribly\nsorry..."
  },
  {
   "id": "MESSAGE108:061C",
   "jp": "…許せ",
   "en": "...Forgive me."
  },
  {
   "id": "MESSAGE108:0621",
   "jp": "後退するわ…",
   "en": "Falling back..."
  },
  {
   "id": "MESSAGE108:062A",
   "jp": "くっ…命拾いをしたな",
   "en": "Ngh... You got lucky."
  },
  {
   "id": "MESSAGE108:0637",
   "jp": "おのれ…一旦後退だ!",
   "en": "Curses... Fall back!"
  },
  {
   "id": "MESSAGE108:0646",
   "jp": "わしゃ一旦逃げるぞ!",
   "en": "I-I shall withdraw\nfor now, I shall!"
  },
  {
   "id": "MESSAGE108:0654",
   "jp": "今日のところは\n見逃してあげるわ…",
   "en": "I'll let you off for\ntoday, darling..."
  },
  {
   "id": "MESSAGE108:066A",
   "jp": "策を練り直すわよ!",
   "en": "Back to the drawing\nboard!"
  },
  {
   "id": "MESSAGE108:0677",
   "jp": "逃走用意~!",
   "en": "Ready to run~!"
  },
  {
   "id": "MESSAGE108:0682",
   "jp": "ケッ…クケッ……",
   "en": "Keh... kukeh..."
  },
  {
   "id": "MESSAGE108:068B",
   "jp": "グォ~ン……",
   "en": "Gwooon..."
  },
  {
   "id": "MESSAGE108:0692",
   "jp": "グワォ~ン……",
   "en": "Grwaooon..."
  },
  {
   "id": "MESSAGE108:069A",
   "jp": "引き潮だ!\n一時後退する!",
   "en": "The tide ebbs!\nWe fall back for now!"
  },
  {
   "id": "MESSAGE108:06AE",
   "jp": "守りを固めますわよ!",
   "en": "We'll shore up our\ndefense, dear!"
  },
  {
   "id": "MESSAGE108:06BB",
   "jp": "ここは一旦退くことに\nしましょうか…フフフ",
   "en": "Shall we withdraw\nfor now...? Heh heh..."
  },
  {
   "id": "MESSAGE108:06D4",
   "jp": "くそっ…一時退却だ",
   "en": "Damn... Fall back!"
  },
  {
   "id": "MESSAGE108:06E2",
   "jp": "体勢を立て直さないと…",
   "en": "We need to regroup..."
  }
 ]
}
