{
 "file": "MESSAGE014.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE014:0450",
   "jp": "借りを返してやるよ!",
   "en": "I'll pay you back!"
  },
  {
   "id": "MESSAGE014:045D",
   "jp": "これも仕事なんでな!",
   "en": "It's all part\no' the job!"
  },
  {
   "id": "MESSAGE014:046A",
   "jp": "みんな…許してくれ",
   "en": "Everyone...\nforgive me."
  },
  {
   "id": "MESSAGE014:0475",
   "jp": "手加減はしません…!\n誰であろうとも……",
   "en": "I will not hold back...!\nNo matter who......"
  },
  {
   "id": "MESSAGE014:048E",
   "jp": "出撃する…!",
   "en": "Moving out...!"
  },
  {
   "id": "MESSAGE014:0497",
   "jp": "出撃だ…!",
   "en": "We move out...!"
  },
  {
   "id": "MESSAGE014:049F",
   "jp": "戦うしか無いのね…",
   "en": "So we have to fight..."
  },
  {
   "id": "MESSAGE014:04AB",
   "jp": "では、出陣します…",
   "en": "Then I shall set out..."
  },
  {
   "id": "MESSAGE014:04B7",
   "jp": "誰だろうが容赦しねぇぜ!",
   "en": "No mercy,\nwhoever ya are!"
  },
  {
   "id": "MESSAGE014:04C7",
   "jp": "では…参る!",
   "en": "Then... I come!"
  },
  {
   "id": "MESSAGE014:04CF",
   "jp": "ニーチェ、いやだな…",
   "en": "Nietzsche doesn't\nlike this..."
  },
  {
   "id": "MESSAGE014:04DA",
   "jp": "では、出撃する",
   "en": "Then I move out."
  },
  {
   "id": "MESSAGE014:04E4",
   "jp": "まいります…!",
   "en": "I shall go...!"
  },
  {
   "id": "MESSAGE014:04EC",
   "jp": "辛い戦いだぜ…ちくしょー",
   "en": "This fight's rough...\nDammit."
  },
  {
   "id": "MESSAGE014:04FB",
   "jp": "ちくしょう、やったらぁ!",
   "en": "Dammit, fine, let's\ndo this!"
  },
  {
   "id": "MESSAGE014:0508",
   "jp": "これは守り神様の\n試練なんじゃ…",
   "en": "This must be the\nguardian god's trial..."
  },
  {
   "id": "MESSAGE014:051D",
   "jp": "行きたくないなあ…",
   "en": "I don't wanna go..."
  },
  {
   "id": "MESSAGE014:0527",
   "jp": "気が進まないけど…\nいくよっ!",
   "en": "My heart's not in it...\nbut here goes!"
  },
  {
   "id": "MESSAGE014:0539",
   "jp": "これも任務だからな!",
   "en": "It's my duty, after all!"
  },
  {
   "id": "MESSAGE014:0546",
   "jp": "これも仕事だよな…",
   "en": "It's all part of the\njob, right..."
  },
  {
   "id": "MESSAGE014:0552",
   "jp": "出撃します……",
   "en": "Moving out......"
  },
  {
   "id": "MESSAGE014:055C",
   "jp": "これも任務だ。出撃!",
   "en": "This is our mission.\nMove out!"
  },
  {
   "id": "MESSAGE014:056B",
   "jp": "フフ…仕方ないわね……",
   "en": "Fufu... it can't be\nhelped......"
  },
  {
   "id": "MESSAGE014:0579",
   "jp": "くっ…出撃する!",
   "en": "Ngh... moving out!"
  },
  {
   "id": "MESSAGE014:0584",
   "jp": "私が神の御許へ送って\n差し上げよう!",
   "en": "I'll gladly send you\nto meet God!"
  },
  {
   "id": "MESSAGE014:059C",
   "jp": "もう、どうにでもなれじゃ!",
   "en": "Oh, whatever\nhappens, happens!"
  },
  {
   "id": "MESSAGE014:05AA",
   "jp": "行くしかないようね…!",
   "en": "Seems I have no\nchoice but to go...!"
  },
  {
   "id": "MESSAGE014:05B6",
   "jp": "こうなったらもうヤケよ!",
   "en": "Fine, I'll just go\nfor broke!"
  },
  {
   "id": "MESSAGE014:05C3",
   "jp": "昨日の友は今日の敵ー!",
   "en": "Yesterday's friend is\ntoday's foe!"
  },
  {
   "id": "MESSAGE014:05D5",
   "jp": "ケケケ…",
   "en": "Kekeke..."
  },
  {
   "id": "MESSAGE014:05DA",
   "jp": "グォォ?",
   "en": "Grooh?"
  },
  {
   "id": "MESSAGE014:05DF",
   "jp": "グワォォ?",
   "en": "Grwaoh?"
  },
  {
   "id": "MESSAGE014:05E5",
   "jp": "これが戦争だ…いくぞ!",
   "en": "This is war...\nLet's go!"
  },
  {
   "id": "MESSAGE014:05F3",
   "jp": "戦いとは…\n非情なものですわね",
   "en": "Battle is...\nso heartless, isn't it."
  },
  {
   "id": "MESSAGE014:0606",
   "jp": "私は感情になど\n流されはしない…フフフ……",
   "en": "I am not swayed by\nfeelings... Heh heh..."
  }
 ]
}
