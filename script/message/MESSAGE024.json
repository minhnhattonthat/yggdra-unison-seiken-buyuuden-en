{
 "file": "MESSAGE024.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE024:04C0",
   "jp": "借りを返してやるよ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:04CD",
   "jp": "下っ端に負けてたまるかよ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:04DD",
   "jp": "残念だよ、モニカ…!",
   "en": ""
  },
  {
   "id": "MESSAGE024:04EA",
   "jp": "貴方には絶対に負けない!",
   "en": ""
  },
  {
   "id": "MESSAGE024:04FC",
   "jp": "覚悟はいいな、ユグドラ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:050B",
   "jp": "ユグドラ、覚悟はいいな!",
   "en": ""
  },
  {
   "id": "MESSAGE024:051A",
   "jp": "いいわ、全力で来なさい!",
   "en": ""
  },
  {
   "id": "MESSAGE024:052A",
   "jp": "御免!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0530",
   "jp": "焔帝と仕合えるとは光栄だ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0544",
   "jp": "失礼いたす!",
   "en": ""
  },
  {
   "id": "MESSAGE024:054D",
   "jp": "無駄だ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0554",
   "jp": "ゴメンなさい\nもう決めたの!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0564",
   "jp": "失礼しますッ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:056E",
   "jp": "お互い、手加減なしですよ?",
   "en": ""
  },
  {
   "id": "MESSAGE024:0580",
   "jp": "いいぜ、全力でこいよ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:058E",
   "jp": "親分、勝負であります!",
   "en": ""
  },
  {
   "id": "MESSAGE024:059E",
   "jp": "ほ~れほ~れ\nお返しするぜ、お嬢ちゃん!",
   "en": ""
  },
  {
   "id": "MESSAGE024:05B5",
   "jp": "畏れ多いが\nお返しさせてもらおうかの!",
   "en": ""
  },
  {
   "id": "MESSAGE024:05CC",
   "jp": "ボク、泣かないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:05D7",
   "jp": "それはこっちの台詞だよ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:05E6",
   "jp": "勝負はこれからだな!",
   "en": ""
  },
  {
   "id": "MESSAGE024:05F3",
   "jp": "くそっ!\n大人しくしろってんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0606",
   "jp": "ごめんなさい、兄さん…!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0614",
   "jp": "情けは無用!　きなさい!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0624",
   "jp": "お堅い人はタイプじゃないわ",
   "en": ""
  },
  {
   "id": "MESSAGE024:0634",
   "jp": "思い上がるな、未熟者が!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0646",
   "jp": "貴様にはもう用は無い!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0656",
   "jp": "こ、これは虐待じゃぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE024:0665",
   "jp": "バカ総帥のくせに生意気よ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0678",
   "jp": "遠慮はしないわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0684",
   "jp": "何だかわくわく\nしてきちゃった!",
   "en": ""
  },
  {
   "id": "MESSAGE024:0696",
   "jp": "クケックケケケッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE024:06A1",
   "jp": "グォッグォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:06A9",
   "jp": "グワォォォッグワォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:06B6",
   "jp": "勝負だ、エミリオ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:06C2",
   "jp": "お爺様に代わって\nお仕置きですわ!",
   "en": ""
  },
  {
   "id": "MESSAGE024:06D9",
   "jp": "その程度の力では\n私は倒せませんよ?",
   "en": ""
  }
 ]
}
