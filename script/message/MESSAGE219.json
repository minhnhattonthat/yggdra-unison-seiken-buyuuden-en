{
 "file": "MESSAGE219.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE219:0240",
   "jp": "この勢いで更なる勝利を\n目指しましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE219:025B",
   "jp": "治安を守るのが私の役目。\n更なる努力を約束しよう!",
   "en": ""
  },
  {
   "id": "MESSAGE219:027F",
   "jp": "答えを手に入れるまで…\nまだ旅は続くのですね……",
   "en": ""
  },
  {
   "id": "MESSAGE219:029D",
   "jp": "休んでるヒマはねーぜ!\nこのまま進撃だ!",
   "en": ""
  },
  {
   "id": "MESSAGE219:02B5",
   "jp": "やれば出来るもんだな。\nこのまま突っ走るぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE219:02D1",
   "jp": "この調子でワシらの神の\n教えを広めるぞい!",
   "en": ""
  },
  {
   "id": "MESSAGE219:02EB",
   "jp": "しかし、伝説の魔術復活は\n未だ果たせぬのだ…",
   "en": ""
  },
  {
   "id": "MESSAGE219:030A",
   "jp": "さ、更に収入を\n増やそうではないか!",
   "en": ""
  },
  {
   "id": "MESSAGE219:0321",
   "jp": "時々自分の能力が\n恐ろしくなるわね…",
   "en": ""
  },
  {
   "id": "MESSAGE219:033B",
   "jp": "まさかここまで長続き\nするとは意外だったわね",
   "en": ""
  },
  {
   "id": "MESSAGE219:0356",
   "jp": "勝負はまだ分からぬ。\n最後まで手綱を緩めるな!",
   "en": ""
  },
  {
   "id": "MESSAGE219:0376",
   "jp": "まだまだ…この程度では\n満足出来ませんね。フフ…",
   "en": ""
  }
 ]
}
