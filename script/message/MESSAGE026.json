   "en": ""
  },
  {
   "id": "MESSAGE026:04B3",
   "jp": "ひよっこには負けねえぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE026:04C2",
   "jp": "何じゃ、\nしゃきっとせんかい!",
   "en": ""
  },
  {
   "id": "MESSAGE026:04D3",
   "jp": "子供のくせに生意気ー!",
   "en": ""
  },
  {
   "id": "MESSAGE026:04E4",
   "jp": "勇気だけは認めてあげる!",
   "en": ""
  },
  {
   "id": "MESSAGE026:04F4",
   "jp": "賞金稼ぎには負けないぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE026:0505",
   "jp": "申し訳ありません、陛下…!",
   "en": ""
  },
  {
   "id": "MESSAGE026:0516",
