   "jp": "全力でかかってきなさい!",
   "en": ""
  },
  {
   "id": "MESSAGE026:0435",
   "jp": "お互い手加減なしよ!",
   "en": ""
  },
  {
   "id": "MESSAGE026:0444",
   "jp": "さすがは将軍ね…!",
   "en": ""
  },
  {
   "id": "MESSAGE026:0450",
   "jp": "その勝負、受けて立つ!",
   "en": ""
  },
  {
   "id": "MESSAGE026:0460",
   "jp": "欲望のままに生きて\n何が悪い!",
