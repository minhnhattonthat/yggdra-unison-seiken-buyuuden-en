{
 "file": "MESSAGE031.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE031:0640",
   "jp": "いい腕してるな、アンタ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:064E",
   "jp": "このままで済むと思うな!",
   "en": ""
  },
  {
   "id": "MESSAGE031:065D",
   "jp": "絶対に降参しないぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:066C",
   "jp": "お返しします!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0675",
   "jp": "私が相手をしてやろう!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0683",
   "jp": "邪魔だ、失せろ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:068F",
   "jp": "怖気づくと思ったら\n大間違いよ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:06A6",
   "jp": "退く訳にはいかぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:06B2",
   "jp": "息の根を止めてやるぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:06C1",
   "jp": "まだまだ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:06C7",
   "jp": "まだまだっ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:06CE",
   "jp": "ええーいっ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:06D5",
   "jp": "受けてみろッ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:06DE",
   "jp": "お返し致します",
   "en": ""
  },
  {
   "id": "MESSAGE031:06E8",
   "jp": "やりやがったな!?",
   "en": ""
  },
  {
   "id": "MESSAGE031:06F2",
   "jp": "みんなはひとりのためにー!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0700",
   "jp": "お返しするぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:070A",
   "jp": "くらうがよいわ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0713",
   "jp": "お返しだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:071B",
   "jp": "それっ、お返し!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0725",
   "jp": "受けてみろ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:072D",
   "jp": "ふさけやがって!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0736",
   "jp": "お返しします…!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0740",
   "jp": "情けなどかけぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:074A",
   "jp": "フフ、いつまで持つかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE031:0759",
   "jp": "図に乗るな、痴れ者が!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0769",
   "jp": "神罰を受けよ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0773",
   "jp": "わ、わしは無実じゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0780",
   "jp": "フン、やるじゃない!",
   "en": ""
  },
  {
   "id": "MESSAGE031:078B",
   "jp": "覚悟はいいかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE031:0797",
   "jp": "見かけで判断しないでよね!",
   "en": ""
  },
  {
   "id": "MESSAGE031:07A8",
   "jp": "クケックケックケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:07B3",
   "jp": "グォォォッグォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:07BD",
   "jp": "グワォォォッグワォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:07C9",
   "jp": "このままで済むと思うな!",
   "en": ""
  },
  {
   "id": "MESSAGE031:07D8",
   "jp": "おイタはいけませんわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE031:07E5",
   "jp": "邪魔をしないで\n頂きたいですね。フフフ…",
   "en": ""
  },
  {
   "id": "MESSAGE031:07FD",
   "jp": "よし、反撃だッ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0808",
   "jp": "それッ!　お返しよ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0814",
   "jp": "受けてみよッ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:081D",
   "jp": "やったわね!?",
   "en": ""
  },
  {
   "id": "MESSAGE031:0825",
   "jp": "やりやがったな?\nこんちくしょう!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0837",
   "jp": "手加減は一切しないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0848",
   "jp": "そりゃっ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:084E",
   "jp": "負けないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0856",
   "jp": "痴れ者が!",
   "en": ""
  },
  {
   "id": "MESSAGE031:085E",
   "jp": "やったわねー!　えいッ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:086B",
   "jp": "思い知れ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0873",
   "jp": "クケックケックケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:087E",
   "jp": "グォォォッグォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE031:0888",
   "jp": "ええい!",
   "en": ""
  },
  {
   "id": "MESSAGE031:088D",
   "jp": "このっ!",
   "en": ""
