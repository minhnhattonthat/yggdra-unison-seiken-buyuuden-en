{
 "file": "MESSAGE211.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE211:04F0",
   "jp": "ふむ、これがよさそうだな",
   "en": ""
  },
  {
   "id": "MESSAGE211:04FD",
   "jp": "選ぶのめんどくせぇし、\nこれでいいや",
   "en": ""
  },
  {
   "id": "MESSAGE211:0511",
   "jp": "こういう箱って、\n小さい時に憧れたよな",
   "en": ""
  },
  {
   "id": "MESSAGE211:0529",
   "jp": "手入れが行き届いている、\nこの箱にしましょう",
   "en": ""
  },
  {
   "id": "MESSAGE211:0544",
   "jp": "はずれ…\nということは無いと思うが",
   "en": ""
  },
  {
   "id": "MESSAGE211:0558",
   "jp": "はずれ…\nということは無いだろう",
   "en": ""
  },
  {
   "id": "MESSAGE211:056A",
   "jp": "まあ、上々ってとこね",
   "en": ""
  },
  {
   "id": "MESSAGE211:0577",
   "jp": "ふむ…そこそこ業物の\n箱のようです",
   "en": ""
  },
  {
   "id": "MESSAGE211:058C",
   "jp": "まあ、それなりの見栄えだな",
   "en": ""
  },
  {
   "id": "MESSAGE211:059C",
   "jp": "これを頂いてゆこうか",
   "en": ""
  },
  {
   "id": "MESSAGE211:05A8",
   "jp": "役立つ品物が\n入っていることを願おう",
   "en": ""
  },
  {
   "id": "MESSAGE211:05C1",
   "jp": "わあ~、\n何が入ってるのかな?",
   "en": ""
  },
  {
   "id": "MESSAGE211:05D3",
   "jp": "我ながら堅実な選択だな",
   "en": ""
  },
  {
   "id": "MESSAGE211:05E4",
   "jp": "力強い模様の箱ですね",
   "en": ""
  },
  {
   "id": "MESSAGE211:05F4",
   "jp": "ま、ハズレってことは\nねぇだろ",
   "en": ""
  },
  {
   "id": "MESSAGE211:0604",
   "jp": "うひょ~、\nこの箱カッコイイ!",
   "en": ""
  },
  {
   "id": "MESSAGE211:0615",
   "jp": "お宝のにおいがするぞい",
   "en": ""
  },
  {
   "id": "MESSAGE211:0622",
   "jp": "ワシにぴったりの\n模様がついた箱だのう",
   "en": ""
  },
  {
   "id": "MESSAGE211:0639",
   "jp": "落とさないように\nしなくっちゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE211:064B",
   "jp": "これって割と\nいい物なんじゃないかな?",
   "en": ""
  },
  {
   "id": "MESSAGE211:0661",
   "jp": "まあ、\n悪くはないんじゃないかな?",
   "en": ""
  },
  {
   "id": "MESSAGE211:0674",
   "jp": "今日のオイラセレクションは\n…これだ!",
   "en": ""
  },
  {
   "id": "MESSAGE211:068A",
   "jp": "これがよさそう…",
   "en": ""
  },
  {
   "id": "MESSAGE211:0693",
   "jp": "入手だ",
   "en": ""
  },
  {
   "id": "MESSAGE211:0699",
   "jp": "フフ、これならきっと…",
   "en": ""
  },
  {
   "id": "MESSAGE211:06A5",
   "jp": "可も無く不可も無く…\nといったところか",
   "en": ""
  },
  {
   "id": "MESSAGE211:06BE",
   "jp": "フッ、\nそれなりの価値はありそうだ",
   "en": ""
  },
  {
   "id": "MESSAGE211:06D2",
   "jp": "ひっ!　この箱、\nべとついているではないか!",
   "en": ""
  },
  {
   "id": "MESSAGE211:06EA",
   "jp": "この模様、ちょっと暑苦しい\n気がしないでも無いけど",
   "en": ""
  },
  {
   "id": "MESSAGE211:070A",
   "jp": "あら、品があっていいわね",
   "en": ""
  },
  {
   "id": "MESSAGE211:0718",
   "jp": "この箱、フツーすぎて\nつまんな~い",
   "en": ""
  },
  {
   "id": "MESSAGE211:072B",
   "jp": "ケッケッケ!",
   "en": "Keh-keh-keh!"
  },
  {
   "id": "MESSAGE211:0732",
   "jp": "グォォ!",
   "en": ""
  },
  {
   "id": "MESSAGE211:0737",
   "jp": "グワォォ!",
   "en": ""
  },
  {
   "id": "MESSAGE211:073D",
   "jp": "急ぎ、戦場に戻るぞ",
   "en": ""
  },
  {
   "id": "MESSAGE211:074B",
   "jp": "まぁ!　眩しい箱ですわね!",
   "en": ""
  },
  {
   "id": "MESSAGE211:075B",
   "jp": "無駄に眩い箱のようですね…\nフフフ…",
   "en": ""
  },
  {
   "id": "MESSAGE211:0772",
   "jp": "これなんか良さそうだが…",
   "en": ""
  },
  {
   "id": "MESSAGE211:0780",
   "jp": "箱は立派だけど…?",
   "en": ""
  }
 ]
}
