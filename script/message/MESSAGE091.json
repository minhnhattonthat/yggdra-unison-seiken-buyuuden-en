{
 "file": "MESSAGE091.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE091:04B0",
   "jp": "簡単にはやられんさ",
   "en": ""
  },
  {
   "id": "MESSAGE091:04BC",
   "jp": "急げ!　防御態勢だ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:04CC",
   "jp": "誰にも渡さない!",
   "en": ""
  },
  {
   "id": "MESSAGE091:04D7",
   "jp": "敵を食い止めましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE091:04E6",
   "jp": "貴様たちの行く場所は無いぞ",
   "en": ""
  },
  {
   "id": "MESSAGE091:04F9",
   "jp": "これ以上好き勝手はさせん!",
   "en": ""
  },
  {
   "id": "MESSAGE091:050C",
   "jp": "これ以上あんたたちの\n好きにはさせないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:0525",
   "jp": "ここで守りを固めるぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:0533",
   "jp": "甘いんだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:053B",
   "jp": "敵を中へ入れるでないぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:054B",
   "jp": "正義は我らと共にある!",
   "en": ""
  },
  {
   "id": "MESSAGE091:055B",
   "jp": "ぼーぎょするよ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:0564",
   "jp": "我らは退かぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:056E",
   "jp": "わたくしたちは\n一歩たりとも退きません",
   "en": ""
  },
  {
   "id": "MESSAGE091:0585",
   "jp": "お先に頂くぜ?",
   "en": ""
  },
  {
   "id": "MESSAGE091:058F",
   "jp": "もう、渡さねーっすよ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:059C",
   "jp": "ここは通れねぇぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:05A7",
   "jp": "入ってきたら\n脳天カチ割ってやるわい!",
   "en": ""
  },
  {
   "id": "MESSAGE091:05BF",
   "jp": "ここはボクたちのものだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:05CD",
   "jp": "入ってきたら\n痛い目を見るよ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:05E1",
   "jp": "このまま進撃だ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:05EC",
   "jp": "ここはオイラが貰うぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:05F9",
   "jp": "ここは渡しませんよ…",
   "en": ""
  },
  {
   "id": "MESSAGE091:0605",
   "jp": "他を当たるんだな",
   "en": ""
  },
  {
   "id": "MESSAGE091:0610",
   "jp": "痛い目に遣う前に\nお帰りなさい…",
   "en": ""
  },
  {
   "id": "MESSAGE091:0626",
   "jp": "失せるがいい!",
   "en": ""
  },
  {
   "id": "MESSAGE091:062F",
   "jp": "神は偉大なり!\nよってこの地は平定する!",
   "en": ""
  },
  {
   "id": "MESSAGE091:0649",
   "jp": "わしは何も悪くない!\n恨むなら神を恨め!",
   "en": ""
  },
  {
   "id": "MESSAGE091:0662",
   "jp": "他をあたって頂戴!",
   "en": ""
  },
  {
   "id": "MESSAGE091:066F",
   "jp": "ここは私がもらったわ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:067B",
   "jp": "ウフフ♪\nいっただきぃ~♪",
   "en": ""
  },
  {
   "id": "MESSAGE091:0689",
   "jp": "クケケ~ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:0690",
   "jp": "グォォォォゥン!",
   "en": ""
  },
  {
   "id": "MESSAGE091:0699",
   "jp": "グワォォォォゥン!",
   "en": ""
  },
  {
   "id": "MESSAGE091:06A3",
   "jp": "ここは渡さん!",
   "en": ""
  },
  {
   "id": "MESSAGE091:06AC",
   "jp": "上手くいきましたわ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:06B9",
   "jp": "私がここを手放すと\n本気で思っているのですか?",
   "en": ""
  },
  {
   "id": "MESSAGE091:06D6",
   "jp": "このまま前進するんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE091:06E4",
   "jp": "さあ、次はどう攻める?",
   "en": ""
  }
 ]
}
