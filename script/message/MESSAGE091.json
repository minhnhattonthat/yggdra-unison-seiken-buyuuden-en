{
 "file": "MESSAGE091.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE091:04B0",
   "jp": "簡単にはやられんさ",
   "en": "I won't go down easy."
  },
  {
   "id": "MESSAGE091:04BC",
   "jp": "急げ!　防御態勢だ!",
   "en": "Hurry! Defensive\nstance!"
  },
  {
   "id": "MESSAGE091:04CC",
   "jp": "誰にも渡さない!",
   "en": "We won't give it to\nanyone!"
  },
  {
   "id": "MESSAGE091:04D7",
   "jp": "敵を食い止めましょう!",
   "en": "Let us hold back the\nenemy!"
  },
  {
   "id": "MESSAGE091:04E6",
   "jp": "貴様たちの行く場所は無いぞ",
   "en": "There is nowhere for\nyou to go."
  },
  {
   "id": "MESSAGE091:04F9",
   "jp": "これ以上好き勝手はさせん!",
   "en": "I won't let you run\nwild any longer!"
  },
  {
   "id": "MESSAGE091:050C",
   "jp": "これ以上あんたたちの\n好きにはさせないわ!",
   "en": "You won't do as you\nplease any longer!"
  },
  {
   "id": "MESSAGE091:0525",
   "jp": "ここで守りを固めるぞ!",
   "en": "We hold our ground\nhere!"
  },
  {
   "id": "MESSAGE091:0533",
   "jp": "甘いんだよ!",
   "en": "Ya think it's that\neasy?"
  },
  {
   "id": "MESSAGE091:053B",
   "jp": "敵を中へ入れるでないぞ!",
   "en": "Let no enemy within!"
  },
  {
   "id": "MESSAGE091:054B",
   "jp": "正義は我らと共にある!",
   "en": "Justice is with us!"
  },
  {
   "id": "MESSAGE091:055B",
   "jp": "ぼーぎょするよ!",
   "en": "Nietzsche'll\ndee-fend!"
  },
  {
   "id": "MESSAGE091:0564",
   "jp": "我らは退かぬ!",
   "en": "We shall not retreat!"
  },
  {
   "id": "MESSAGE091:056E",
   "jp": "わたくしたちは\n一歩たりとも退きません",
   "en": "We shall not retreat\na single step."
  },
  {
   "id": "MESSAGE091:0585",
   "jp": "お先に頂くぜ?",
   "en": "I'll help myself first,\neh?"
  },
  {
   "id": "MESSAGE091:058F",
   "jp": "もう、渡さねーっすよ!",
   "en": "We ain't givin' it up\nno more!"
  },
  {
   "id": "MESSAGE091:059C",
   "jp": "ここは通れねぇぞ!",
   "en": "Ya ain't passin' here!"
  },
  {
   "id": "MESSAGE091:05A7",
   "jp": "入ってきたら\n脳天カチ割ってやるわい!",
   "en": "Come in and I'll crack\nyer skull, heh!"
  },
  {
   "id": "MESSAGE091:05BF",
   "jp": "ここはボクたちのものだよ!",
   "en": "This place is ours!"
  },
  {
   "id": "MESSAGE091:05CD",
   "jp": "入ってきたら\n痛い目を見るよ!",
   "en": "Come in and you'll\nget hurt!"
  },
  {
   "id": "MESSAGE091:05E1",
   "jp": "このまま進撃だ!",
   "en": "Keep advancing!"
  },
  {
   "id": "MESSAGE091:05EC",
   "jp": "ここはオイラが貰うぜ!",
   "en": "I'm takin' this place!"
  },
  {
   "id": "MESSAGE091:05F9",
   "jp": "ここは渡しませんよ…",
   "en": "I will not hand this\nover..."
  },
  {
   "id": "MESSAGE091:0605",
   "jp": "他を当たるんだな",
   "en": "Try somewhere else."
  },
  {
   "id": "MESSAGE091:0610",
   "jp": "痛い目に遣う前に\nお帰りなさい…",
   "en": "Go home before you\nget hurt..."
  },
  {
   "id": "MESSAGE091:0626",
   "jp": "失せるがいい!",
   "en": ""
  },
  {
   "id": "MESSAGE091:062F",
   "jp": "神は偉大なり!\nよってこの地は平定する!",
   "en": "God is great! Thus is\nthis land pacified!"
  },
  {
   "id": "MESSAGE091:0649",
   "jp": "わしは何も悪くない!\n恨むなら神を恨め!",
   "en": "I did nothing wrong!\nBlame God instead!"
  },
  {
   "id": "MESSAGE091:0662",
   "jp": "他をあたって頂戴!",
   "en": "Go try somewhere\nelse, darling!"
  },
  {
   "id": "MESSAGE091:066F",
   "jp": "ここは私がもらったわ!",
   "en": "This place is mine!"
  },
  {
   "id": "MESSAGE091:067B",
   "jp": "ウフフ♪\nいっただきぃ~♪",
   "en": "Ufufu~! Yoink~!"
  },
  {
   "id": "MESSAGE091:0689",
   "jp": "クケケ~ッ!",
   "en": "Kukeke~!"
  },
  {
   "id": "MESSAGE091:0690",
   "jp": "グォォォォゥン!",
   "en": "Grooooan!"
  },
  {
   "id": "MESSAGE091:0699",
   "jp": "グワォォォォゥン!",
   "en": "Grwaaaoon!"
  },
  {
   "id": "MESSAGE091:06A3",
   "jp": "ここは渡さん!",
   "en": "You shall not have it!"
  },
  {
   "id": "MESSAGE091:06AC",
   "jp": "上手くいきましたわ!",
   "en": "It went splendidly!"
  },
  {
   "id": "MESSAGE091:06B9",
   "jp": "私がここを手放すと\n本気で思っているのですか?",
   "en": "You truly think I'd\ngive this place up?"
  },
  {
   "id": "MESSAGE091:06D6",
   "jp": "このまま前進するんだ!",
   "en": "Keep moving\nforward!"
  },
  {
   "id": "MESSAGE091:06E4",
   "jp": "さあ、次はどう攻める?",
   "en": "Now, how do we\nattack next?"
  }
 ]
}
