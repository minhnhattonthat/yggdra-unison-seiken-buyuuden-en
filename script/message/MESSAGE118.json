{
 "file": "MESSAGE118.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE118:04B0",
   "jp": "残念だったな…\nま、これも運命だ",
   "en": ""
  },
  {
   "id": "MESSAGE118:04C5",
   "jp": "いくら守ってもムダだゼ?",
   "en": ""
  },
  {
   "id": "MESSAGE118:04D3",
   "jp": "残念だったな!",
   "en": "Too bad!"
  },
  {
   "id": "MESSAGE118:04DD",
   "jp": "これ以上の戦いは\n無意味です!",
   "en": "Further fighting is\nmeaningless!"
  },
  {
   "id": "MESSAGE118:04F3",
   "jp": "悪く思わないでもらおう",
   "en": ""
  },
  {
   "id": "MESSAGE118:0501",
   "jp": "悪く思わないでもらおう",
   "en": ""
  },
  {
   "id": "MESSAGE118:050F",
   "jp": "残念ね。諦めてちょうだい",
   "en": ""
  },
  {
   "id": "MESSAGE118:051F",
   "jp": "無駄な抵抗はやめられよ",
   "en": ""
  },
  {
   "id": "MESSAGE118:052F",
   "jp": "これで終わりだ!",
   "en": ""
  },
  {
   "id": "MESSAGE118:0539",
   "jp": "このような抵抗など…\n無駄なことじゃ",
   "en": ""
  },
  {
   "id": "MESSAGE118:0550",
   "jp": "拠点は陥落させた!",
   "en": ""
  },
  {
   "id": "MESSAGE118:055E",
   "jp": "うまく、いった?",
   "en": ""
  },
  {
   "id": "MESSAGE118:0567",
   "jp": "…制圧したぞ",
   "en": ""
  },
  {
   "id": "MESSAGE118:0570",
   "jp": "わたくしたちにも\n正義があるのです",
   "en": ""
  },
  {
   "id": "MESSAGE118:0584",
   "jp": "ま、こんなもんだろ",
   "en": "Eh, that'll do."
  },
  {
   "id": "MESSAGE118:058E",
   "jp": "悪いけど、もらったぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE118:059B",
   "jp": "これも仕事なんでな!",
   "en": "It's all part o' the\njob!"
  },
  {
   "id": "MESSAGE118:05A8",
   "jp": "これも仕事じゃ。\n悪く思うなよ!",
   "en": ""
  },
  {
   "id": "MESSAGE118:05BD",
   "jp": "さっさと諦めることね!",
   "en": ""
  },
  {
   "id": "MESSAGE118:05CA",
   "jp": "これで懲りたでしょ?",
   "en": ""
  },
  {
   "id": "MESSAGE118:05D6",
   "jp": "辛い戦いだったな…",
   "en": ""
  },
  {
   "id": "MESSAGE118:05E2",
   "jp": "オイラをなめるなよ!",
   "en": ""
  },
  {
   "id": "MESSAGE118:05ED",
   "jp": "…終わりました",
   "en": ""
  },
  {
   "id": "MESSAGE118:05F6",
   "jp": "己の愚かさを悔いることだ",
   "en": ""
  },
  {
   "id": "MESSAGE118:0606",
   "jp": "おイタが過ぎたようね?",
   "en": ""
  },
  {
   "id": "MESSAGE118:0613",
   "jp": "フン、愚か者が…",
   "en": ""
  },
  {
   "id": "MESSAGE118:061E",
   "jp": "神よ…迷える子羊を\n導き給え…",
   "en": ""
  },
  {
   "id": "MESSAGE118:0633",
   "jp": "はー、\n我を失ってしまったわい…",
   "en": ""
  },
  {
   "id": "MESSAGE118:0646",
   "jp": "ま、許してあげないことも\nないけど",
   "en": ""
  },
  {
   "id": "MESSAGE118:0659",
   "jp": "そこまでよ!",
   "en": ""
  },
  {
   "id": "MESSAGE118:0660",
   "jp": "あんたには工夫が\n足らないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE118:0673",
   "jp": "ケーッケッケッケ!",
   "en": "Keeh-kekekeh!"
  },
  {
   "id": "MESSAGE118:067D",
   "jp": "グォーッグォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE118:0687",
   "jp": "グワォーッグワォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE118:0693",
   "jp": "馬鹿なことを…",
   "en": "Foolishness..."
  },
  {
   "id": "MESSAGE118:069D",
   "jp": "どうか、恨まないで\nくださいね~",
   "en": ""
  },
  {
   "id": "MESSAGE118:06AF",
   "jp": "まあ、悪く思わないで\nくださいね。フフフ…",
   "en": ""
  },
  {
   "id": "MESSAGE118:06C7",
   "jp": "これが戦争なんだ",
   "en": ""
  },
  {
   "id": "MESSAGE118:06D2",
   "jp": "勝ったみたいね",
   "en": ""
  }
 ]
}
