{
 "file": "MESSAGE061.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE061:04F0",
   "jp": "あんたたちとは\n相容れそうに無いな…",
   "en": "Seems I can't see eye\nto eye with you lot..."
  },
  {
   "id": "MESSAGE061:0506",
   "jp": "キヒヒ…ザマねぇな?",
   "en": "Kihihi... serves\nya right, huh?"
  },
  {
   "id": "MESSAGE061:0511",
   "jp": "敵将を捕まえたぞ!",
   "en": "I caught the enemy\ngeneral!"
  },
  {
   "id": "MESSAGE061:051E",
   "jp": "許す訳にはいきません!",
   "en": "I cannot\nforgive this!"
  },
  {
   "id": "MESSAGE061:052C",
   "jp": "戦場の塵と消えるがいい",
   "en": "Vanish like dust on\nthe battlefield!"
  },
  {
   "id": "MESSAGE061:053C",
   "jp": "軟弱者に用は無い",
   "en": "I have no use for\nweaklings."
  },
  {
   "id": "MESSAGE061:054A",
   "jp": "あら、残念だったわね!",
   "en": "Oh, too bad for you!"
  },
  {
   "id": "MESSAGE061:0558",
   "jp": "諦めて降伏するんだ!",
   "en": "Give up and\nsurrender!"
  },
  {
   "id": "MESSAGE061:0566",
   "jp": "次に会った時は\n命は無いと思え!",
   "en": "Next time we meet,\nyou're dead meat!"
  },
  {
   "id": "MESSAGE061:057D",
   "jp": "やられはせぬ!",
   "en": "I shall not fall!"
  },
  {
   "id": "MESSAGE061:0585",
   "jp": "悔い改めよ",
   "en": "Repent!"
  },
  {
   "id": "MESSAGE061:058D",
   "jp": "わーい♪",
   "en": "Yaaay~!"
  },
  {
   "id": "MESSAGE061:0592",
   "jp": "敵将を捕まえたぞ!",
   "en": "I caught the enemy\ngeneral!"
  },
  {
   "id": "MESSAGE061:059F",
   "jp": "ここまでです",
   "en": "This is the end."
  },
  {
   "id": "MESSAGE061:05A6",
   "jp": "ざまぁみやがれってんだ!",
   "en": "Serves ya right!"
  },
  {
   "id": "MESSAGE061:05B3",
   "jp": "へっへーんだ!",
   "en": "Heh-heh-heeeh!"
  },
  {
   "id": "MESSAGE061:05BB",
   "jp": "へっへ\n賞金はワシらのもんだ!",
   "en": "Heh heh!\nThat bounty's ours!"
  },
  {
   "id": "MESSAGE061:05CD",
   "jp": "何じゃ、こんなもんか?",
   "en": "What, is that all,\nsonny?"
  },
  {
   "id": "MESSAGE061:05DA",
   "jp": "うんと後悔すればいいのよ!",
   "en": "Go on and regret\nit, big time!"
  },
  {
   "id": "MESSAGE061:05EA",
   "jp": "本気出せばこんなものよ!",
   "en": "This is me when I\nget serious!"
  },
  {
   "id": "MESSAGE061:05FA",
   "jp": "正義は勝つ!",
   "en": "Justice wins!"
  },
  {
   "id": "MESSAGE061:0604",
   "jp": "スッキリしたぜー!",
   "en": "Man, that\nfelt good!"
  },
  {
   "id": "MESSAGE061:060E",
   "jp": "任務完了です",
   "en": "Mission\naccomplished."
  },
  {
   "id": "MESSAGE061:0619",
   "jp": "さだめと知れ",
   "en": "Accept your fate."
  },
  {
   "id": "MESSAGE061:0621",
   "jp": "無駄よ…諦めなさいな",
   "en": "It's useless...\ngive up, dear."
  },
  {
   "id": "MESSAGE061:062F",
   "jp": "貴様の命運もここまでだ",
   "en": "Your fate ends here."
  },
  {
   "id": "MESSAGE061:063F",
   "jp": "地獄へ堕ちるが良い!",
   "en": "Down to hell\nwith you!"
  },
  {
   "id": "MESSAGE061:064E",
   "jp": "ば、バチが当たったんじゃ!",
   "en": "Th-that's Heaven's\npunishment, it is!"
  },
  {
   "id": "MESSAGE061:065D",
   "jp": "ああ、せいせいしたわ",
   "en": "Ahh, that felt\nwonderful!"
  },
  {
   "id": "MESSAGE061:0668",
   "jp": "それなりに楽しかったわよ",
   "en": "That was rather\nfun, you know."
  },
  {
   "id": "MESSAGE061:0676",
   "jp": "パメラ様は最強なのよ?",
   "en": "Pamela-sama is the\nstrongest, y'know?"
  },
  {
   "id": "MESSAGE061:0685",
   "jp": "クケーケケケケッ!",
   "en": "Kukeeekekekekeh!"
  },
  {
   "id": "MESSAGE061:068F",
   "jp": "グォォォォォッ!",
   "en": "Grooooogh!"
  },
  {
   "id": "MESSAGE061:0698",
   "jp": "グォォォォォッ!",
   "en": "Grooooogh!"
  },
  {
   "id": "MESSAGE061:06A1",
   "jp": "純粋な力こそ法となるのだ!",
   "en": "Pure power alone\nis the law!"
  },
  {
   "id": "MESSAGE061:06B3",
   "jp": "無駄な抵抗は\nおよしになってくださいな",
   "en": "Do stop resisting,\ndear. It's no use."
  },
  {
   "id": "MESSAGE061:06CB",
   "jp": "思っていたよりも\n簡単でしたね。フフフ…",
   "en": "That was easier than\nI expected. Heh heh..."
  },
  {
   "id": "MESSAGE061:06E3",
   "jp": "恐れいったか!",
   "en": "Humbled yet?!"
  },
  {
   "id": "MESSAGE061:06EC",
   "jp": "どう、少しは懲りた?",
   "en": "Well? Learned your\nlesson yet?"
  }
 ]
}
