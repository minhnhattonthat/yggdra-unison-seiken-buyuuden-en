{
 "file": "MESSAGE076.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE076:04C0",
   "jp": "腕がなまったかな…",
   "en": "Guess I've gotten\nrusty..."
  },
  {
   "id": "MESSAGE076:04CB",
   "jp": "オレ様が負けるなんて…",
   "en": "The great me, losin'?\nNo way..."
  },
  {
   "id": "MESSAGE076:04D9",
   "jp": "申し訳ありません…",
   "en": "I'm so sorry..."
  },
  {
   "id": "MESSAGE076:04E5",
   "jp": "ごめんなさい…\nもう、ダメ……",
   "en": "I am sorry...\nI cannot go on..."
  },
  {
   "id": "MESSAGE076:04F5",
   "jp": "くっ、この私を負かすとは…",
   "en": "Ngh, to think you\ncould defeat me..."
  },
  {
   "id": "MESSAGE076:0504",
   "jp": "くっ、この私が負けるなど…",
   "en": "Tch, that I should\nlose..."
  },
  {
   "id": "MESSAGE076:0513",
   "jp": "役に立てなかったわね…",
   "en": "I wasn't much help,\nwas I..."
  },
  {
   "id": "MESSAGE076:0521",
   "jp": "力…及びませんでした……",
   "en": "My strength...\nwas not enough..."
  },
  {
   "id": "MESSAGE076:0530",
   "jp": "この俺様が負けた…ッ!?",
   "en": "The great me...\nbeaten?!"
  },
  {
   "id": "MESSAGE076:0540",
   "jp": "拙者ともあろう者が…",
   "en": "That one such as\nI should fall..."
  },
  {
   "id": "MESSAGE076:054E",
   "jp": "申し訳ございません",
   "en": "I am deeply sorry."
  },
  {
   "id": "MESSAGE076:055A",
   "jp": "失敗しちゃった…",
   "en": "Nietzsche\nmessed up..."
  },
  {
   "id": "MESSAGE076:0565",
   "jp": "おのれ、油断したか…",
   "en": "Curses, I let my\nguard down..."
  },
  {
   "id": "MESSAGE076:0572",
   "jp": "わたくしとしたことが…",
   "en": "How unlike me..."
  },
  {
   "id": "MESSAGE076:057E",
   "jp": "すまねーな…",
   "en": "Sorry, guys..."
  },
  {
   "id": "MESSAGE076:0585",
   "jp": "もう戦えないであります…",
   "en": "I can't fight no\nmore, sir..."
  },
  {
   "id": "MESSAGE076:0593",
   "jp": "や、やられた…",
   "en": "Th-they got me..."
  },
  {
   "id": "MESSAGE076:059B",
   "jp": "し、信じられん…!",
   "en": "Unbelievable...!"
  },
  {
   "id": "MESSAGE076:05A6",
   "jp": "どうしてなの…!?",
   "en": "Why...?!"
  },
  {
   "id": "MESSAGE076:05B0",
   "jp": "うわったったっ!",
   "en": "Whoa-whoa-whoa!"
  },
  {
   "id": "MESSAGE076:05B9",
   "jp": "正義…敗れたり……",
   "en": "Justice...\nis defeated......"
  },
  {
   "id": "MESSAGE076:05C6",
   "jp": "またかよ…!",
   "en": "Not again...!"
  },
  {
   "id": "MESSAGE076:05CD",
   "jp": "申し訳…ありません……",
   "en": "I'm... terribly\nsorry..."
  },
  {
   "id": "MESSAGE076:05DB",
   "jp": "…すまない",
   "en": "...Forgive me."
  },
  {
   "id": "MESSAGE076:05E1",
   "jp": "私としたことが…",
   "en": "How careless\nof me..."
  },
  {
   "id": "MESSAGE076:05EA",
   "jp": "き、貴様…ッ!",
   "en": "Y-you...!"
  },
  {
   "id": "MESSAGE076:05F4",
   "jp": "神がお許しになる訳は無い!",
   "en": "God will never\nforgive this!"
  },
  {
   "id": "MESSAGE076:0605",
   "jp": "そ、そんな…",
   "en": "N-no..."
  },
  {
   "id": "MESSAGE076:060C",
   "jp": "出直した方がよさそうだわ…",
   "en": "I'd better regroup\nand try again..."
  },
  {
   "id": "MESSAGE076:061D",
   "jp": "み、認めないわよ…!",
   "en": "I-I won't accept\nthis...!"
  },
  {
   "id": "MESSAGE076:0629",
   "jp": "パメラ様、本気出さなきゃ\nただの人…",
   "en": "Even Pamela-sama is\nnormal if she slacks..."
  },
  {
   "id": "MESSAGE076:0641",
   "jp": "ケ…ケケケ~……",
   "en": "Ke... Kekekeh~..."
  },
  {
   "id": "MESSAGE076:064A",
   "jp": "グォ…グォォォ~……",
   "en": "Gruh... Gruoooh~......"
  },
  {
   "id": "MESSAGE076:0655",
   "jp": "グワォ…グワォォォ~……",
   "en": "Grwao...\nGrwaooo~......"
  },
  {
   "id": "MESSAGE076:0662",
   "jp": "何だと…!?",
   "en": "What...?!"
  },
  {
   "id": "MESSAGE076:066A",
   "jp": "主婦にだって\n時には間違いもありますわ",
   "en": "Even a housewife\nmakes mistakes, dear."
  },
  {
   "id": "MESSAGE076:0683",
   "jp": "ここまでですか…",
   "en": "So this is the end..."
  }
 ]
}
