{
 "file": "MESSAGE057.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE057:04C0",
   "jp": "理想だけでは\n革命は起こせない…か",
   "en": ""
  },
  {
   "id": "MESSAGE057:04D7",
   "jp": "捕らえたゼ、\nこのガイコツヤロー!",
   "en": ""
  },
  {
   "id": "MESSAGE057:04EA",
   "jp": "無礼をお許しくださいっ!",
   "en": ""
  },
  {
   "id": "MESSAGE057:04FA",
   "jp": "勝った…!?",
   "en": ""
  },
  {
   "id": "MESSAGE057:0502",
   "jp": "陛下…申し訳ありません",
   "en": ""
  },
  {
   "id": "MESSAGE057:0511",
   "jp": "陛下…残念です",
   "en": ""
  },
  {
   "id": "MESSAGE057:051C",
   "jp": "か…勝ったの!?",
   "en": ""
  },
  {
   "id": "MESSAGE057:0526",
   "jp": "敵将を捕らえたぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE057:0533",
   "jp": "命を取られなかっただけ\nマシと思え!",
   "en": ""
  },
  {
   "id": "MESSAGE057:0549",
   "jp": "敵将を…捕らえましたぞ",
   "en": ""
  },
  {
   "id": "MESSAGE057:0558",
   "jp": "相応の罰だ!",
   "en": ""
  },
  {
   "id": "MESSAGE057:0562",
   "jp": "ニーチェ、勝ったみたい…",
   "en": ""
  },
  {
   "id": "MESSAGE057:0570",
   "jp": "お前の覚悟はその程度か?",
   "en": ""
  },
  {
   "id": "MESSAGE057:0582",
   "jp": "想いとは\nときにはかないもの…",
   "en": ""
  },
  {
   "id": "MESSAGE057:0593",
   "jp": "気を抜いたら\nオレがやられちまうからな!",
   "en": ""
  },
  {
   "id": "MESSAGE057:05AA",
   "jp": "あ…姐さんに勝った!?",
   "en": ""
  },
  {
   "id": "MESSAGE057:05B8",
   "jp": "さーて、どうしてくれよう\nかのぉ?",
   "en": ""
  },
  {
   "id": "MESSAGE057:05CA",
   "jp": "ガハハハ!　さてさて\nどうしてくれようかのう?",
   "en": ""
  },
  {
   "id": "MESSAGE057:05E2",
   "jp": "王女なんて、名前だけね!",
   "en": ""
  },
  {
   "id": "MESSAGE057:05F3",
   "jp": "アンタには負けないよ、\n王女様!",
   "en": ""
  },
  {
   "id": "MESSAGE057:0608",
   "jp": "なかなかの腕前だったよ",
   "en": ""
  },
  {
   "id": "MESSAGE057:0616",
   "jp": "我ながらしびれるぜぃ!",
   "en": ""
  },
  {
   "id": "MESSAGE057:0623",
   "jp": "ジルヴァ様…!",
   "en": ""
  },
  {
   "id": "MESSAGE057:062C",
   "jp": "お許しを…",
   "en": ""
  },
  {
   "id": "MESSAGE057:0633",
   "jp": "申し訳ございません…",
   "en": ""
  },
  {
   "id": "MESSAGE057:0640",
   "jp": "身の程を知らぬ反逆者が…",
   "en": ""
  },
  {
   "id": "MESSAGE057:0653",
   "jp": "これが神のご意思だ",
   "en": ""
  },
  {
   "id": "MESSAGE057:065F",
   "jp": "そんな…アマレウス!",
   "en": ""
  },
  {
   "id": "MESSAGE057:066A",
   "jp": "主人に勝てると思ったの?",
   "en": ""
  },
  {
   "id": "MESSAGE057:067B",
   "jp": "もっと頭を使ったら?",
   "en": ""
  },
  {
   "id": "MESSAGE057:0688",
   "jp": "乱暴なウンディーネねぇ…",
   "en": ""
  },
  {
   "id": "MESSAGE057:0697",
   "jp": "クケッケケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE057:06A0",
   "jp": "グォォォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE057:06A8",
   "jp": "グワォォォォーグワォッ!!",
   "en": ""
  },
  {
   "id": "MESSAGE057:06B6",
   "jp": "ククッ、命運尽きたな!",
   "en": ""
  },
  {
   "id": "MESSAGE057:06C5",
   "jp": "これ以上の抵抗は\nおよしになって!",
   "en": ""
  },
  {
   "id": "MESSAGE057:06DB",
   "jp": "分かったでしょう?\n誰が頂点に立つべきか…",
   "en": ""
  }
 ]
}
