{
 "file": "MESSAGE028.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE028:0640",
   "jp": "くっ、なんの…!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0649",
   "jp": "オレ様を怒らせやがったな?",
   "en": ""
  },
  {
   "id": "MESSAGE028:0659",
   "jp": "ここで倒れる覚悟だ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0667",
   "jp": "まだ…やれます!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0670",
   "jp": "我が剣、ある限りは…!",
   "en": ""
  },
  {
   "id": "MESSAGE028:067F",
   "jp": "フン、笑わせてくれる…!",
   "en": ""
  },
  {
   "id": "MESSAGE028:068D",
   "jp": "怖くなんてないんだから!",
   "en": ""
  },
  {
   "id": "MESSAGE028:069B",
   "jp": "持ち得る全てでお返しする!",
   "en": ""
  },
  {
   "id": "MESSAGE028:06AD",
   "jp": "貴様も道連れにしてやるぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:06BF",
   "jp": "何の、この程度…",
   "en": ""
  },
  {
   "id": "MESSAGE028:06CB",
   "jp": "力が全てだと思うな!",
   "en": ""
  },
  {
   "id": "MESSAGE028:06D9",
   "jp": "絶対負けないもんっ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:06E7",
   "jp": "お前にこの痛みが分かるか!?",
   "en": ""
  },
  {
   "id": "MESSAGE028:06F9",
   "jp": "わたくしに\n後悔はありません!",
   "en": ""
  },
  {
   "id": "MESSAGE028:070B",
   "jp": "なめるんじゃねーよ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0716",
   "jp": "やられはしねえぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0720",
   "jp": "ワシらをなめおって…!",
   "en": ""
  },
  {
   "id": "MESSAGE028:072C",
   "jp": "ぬうっ、痛くないわい!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0739",
   "jp": "降参なんてしないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0746",
   "jp": "や、やってくれるじゃない!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0754",
   "jp": "一矢報いてやる!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0760",
   "jp": "いってーなぁ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0768",
   "jp": "…くっ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:076D",
   "jp": "まだまだ…!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0774",
   "jp": "フフ、楽しくなりそうね",
   "en": ""
  },
  {
   "id": "MESSAGE028:0781",
   "jp": "耐えてみせる…!",
   "en": ""
  },
  {
   "id": "MESSAGE028:078B",
   "jp": "くっ…何様のつもりだ!?",
   "en": ""
  },
  {
   "id": "MESSAGE028:079A",
   "jp": "や、やめろ、やめてくれー!",
   "en": ""
  },
  {
   "id": "MESSAGE028:07A8",
   "jp": "怯むと思ったら大間違いよ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:07BB",
   "jp": "そうよっ、本気で来なさい!",
   "en": ""
  },
  {
   "id": "MESSAGE028:07CC",
   "jp": "痛ったぁ~い!\n何すんのよ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:07DD",
   "jp": "ケ…ケケッ……!",
   "en": ""
  },
  {
   "id": "MESSAGE028:07E6",
   "jp": "グォォォ~ン…!",
   "en": ""
  },
  {
   "id": "MESSAGE028:07EF",
   "jp": "グワォォォ~ン…!",
   "en": ""
  },
  {
   "id": "MESSAGE028:07F9",
   "jp": "その罪、死を以って償え!",
   "en": ""
  },
  {
   "id": "MESSAGE028:080A",
   "jp": "主婦の底力…\n目に焼き付けてあげますわ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0826",
   "jp": "私は死を恐れたりは\nしませんよ?　フフフ…",
   "en": ""
  },
  {
   "id": "MESSAGE028:083E",
   "jp": "こんなの痛くねぇッ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:084A",
   "jp": "降参なんてしない!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0856",
   "jp": "この命など悩しくはないっ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0866",
   "jp": "こんなの、痛くないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0873",
   "jp": "いってぇなッ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:087B",
   "jp": "まだまだ戦えるよッ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0887",
   "jp": "負けてられるか!",
   "en": ""
  },
  {
   "id": "MESSAGE028:0891",
   "jp": "巻き返してみせるわ…!",
   "en": ""
  },
  {
   "id": "MESSAGE028:089F",
   "jp": "怯みはせぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:08A7",
   "jp": "絶対に諦めないんだから!",
   "en": ""
  },
  {
   "id": "MESSAGE028:08B7",
   "jp": "もとより、散る覚悟だッ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:08C7",
   "jp": "クケケ…ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:08CE",
   "jp": "グ、グオォォォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE028:08D8",
   "jp": "このままで済むと思うな!",
   "en": ""
  },
  {
   "id": "MESSAGE028:08E7",
   "jp": "なかなかやるじゃない!",
   "en": ""
  }
 ]
}
