 "strings": [
  {
   "id": "MESSAGE028:0640",
   "jp": "くっ、なんの…!",
   "en": "Ngh... not yet...!"
  },
  {
   "id": "MESSAGE028:0649",
   "jp": "オレ様を怒らせやがったな?",
   "en": "Ya went and ticked\noff the great me, eh?"
  },
  {
   "id": "MESSAGE028:0659",
   "jp": "ここで倒れる覚悟だ!",
   "en": "I'm ready to fall\nright here!"
  },
  {
   "id": "MESSAGE028:0667",
   "jp": "まだ…やれます!",
   "en": "I can... still fight!"
  },
  {
   "id": "MESSAGE028:0670",
   "jp": "我が剣、ある限りは…!",
   "en": "So long as I hold\nmy sword...!"
  },
  {
   "id": "MESSAGE028:067F",
   "jp": "フン、笑わせてくれる…!",
   "en": "Hmph, don't make\nme laugh...!"
  },
  {
   "id": "MESSAGE028:068D",
   "jp": "怖くなんてないんだから!",
   "en": "I'm not scared\nof you!"
  },
  {
   "id": "MESSAGE028:069B",
   "jp": "持ち得る全てでお返しする!",
   "en": "I shall repay this\nwith all I have!"
  },
  {
   "id": "MESSAGE028:06AD",
   "jp": "貴様も道連れにしてやるぜ!",
   "en": "I'm draggin' you\ndown with me!"
  },
  {
   "id": "MESSAGE028:06BF",
   "jp": "何の、この程度…",
   "en": "Pah, 'tis nothing..."
  },
  {
   "id": "MESSAGE028:06CB",
   "jp": "力が全てだと思うな!",
   "en": "Strength is not\neverything!"
  },
  {
   "id": "MESSAGE028:06D9",
   "jp": "絶対負けないもんっ!",
   "en": "Nietzsche will\nnever, ever lose!"
  },
  {
   "id": "MESSAGE028:06E7",
   "jp": "お前にこの痛みが分かるか!?",
   "en": "Do you know the\npain I feel!?"
  },
  {
   "id": "MESSAGE028:06F9",
   "jp": "わたくしに\n後悔はありません!",
   "en": "I have\nno regrets!"
  },
  {
   "id": "MESSAGE028:070B",
   "jp": "なめるんじゃねーよ!",
   "en": "Don't screw\nwith me!"
  },
  {
   "id": "MESSAGE028:0716",
   "jp": "やられはしねえぞ!",
   "en": "I ain't goin'\ndown!"
  },
  {
   "id": "MESSAGE028:0720",
   "jp": "ワシらをなめおって…!",
   "en": "Ya dare mock us...!"
  },
  {
   "id": "MESSAGE028:072C",
   "jp": "ぬうっ、痛くないわい!",
   "en": "Nngh! Didn't\nhurt a bit, heh!"
  },
  {
   "id": "MESSAGE028:0739",
   "jp": "降参なんてしないよ!",
   "en": "I'm not giving up!"
  },
  {
   "id": "MESSAGE028:0746",
   "jp": "や、やってくれるじゃない!",
   "en": "Wh-whoa, not bad!"
  },
  {
   "id": "MESSAGE028:0754",
   "jp": "一矢報いてやる!",
   "en": "I'll get one\nback at you!"
  },
  {
   "id": "MESSAGE028:0760",
   "jp": "いってーなぁ!",
   "en": "Owww, that hurt!"
  },
  {
   "id": "MESSAGE028:0768",
   "jp": "…くっ!",
   "en": "...Ngh!"
  },
  {
   "id": "MESSAGE028:076D",
   "jp": "まだまだ…!",
   "en": "Not yet...!"
  },
  {
   "id": "MESSAGE028:0774",
   "jp": "フフ、楽しくなりそうね",
   "en": "Fufu, this could\nget fun."
  },
  {
   "id": "MESSAGE028:0781",
   "jp": "耐えてみせる…!",
   "en": "I shall endure...!"
  },
  {
   "id": "MESSAGE028:078B",
   "jp": "くっ…何様のつもりだ!?",
   "en": "Ngh... who do you\nthink you are!?"
  },
  {
   "id": "MESSAGE028:079A",
   "jp": "や、やめろ、やめてくれー!",
   "en": "S-stop it,\nstop it, pleeease!"
  },
  {
   "id": "MESSAGE028:07A8",
   "jp": "怯むと思ったら大間違いよ!",
   "en": "If you think I'll\nflinch, think again!"
  },
  {
   "id": "MESSAGE028:07BB",
   "jp": "そうよっ、本気で来なさい!",
   "en": "That's it, come\nat me for real!"
  },
  {
   "id": "MESSAGE028:07CC",
   "jp": "痛ったぁ~い!\n何すんのよ!",
   "en": "Owwwie~!\nWhat was that for!"
  },
  {
   "id": "MESSAGE028:07DD",
   "jp": "ケ…ケケッ……!",
   "en": "Ke... Kekeh......!"
  },
  {
   "id": "MESSAGE028:07E6",
   "jp": "グォォォ~ン…!",
   "en": "Grooooo~n...!"
  },
  {
   "id": "MESSAGE028:07EF",
   "jp": "グワォォォ~ン…!",
   "en": "Grwaooo~n...!"
  },
  {
   "id": "MESSAGE028:07F9",
   "jp": "その罪、死を以って償え!",
   "en": "Atone for your\ncrime with death!"
  },
  {
   "id": "MESSAGE028:080A",
   "jp": "主婦の底力…\n目に焼き付けてあげますわ!",
   "en": "Witness the hidden\nmight of a housewife!"
  },
  {
   "id": "MESSAGE028:0826",
   "jp": "私は死を恐れたりは\nしませんよ?　フフフ…",
   "en": "I do not fear death,\nyou know. Heh heh..."
  },
  {
   "id": "MESSAGE028:083E",
   "jp": "こんなの痛くねぇッ!",
   "en": "This don't hurt!"
  },
  {
   "id": "MESSAGE028:084A",
   "jp": "降参なんてしない!",
   "en": "I won't surrender!"
  },
  {
   "id": "MESSAGE028:0856",
   "jp": "この命など悩しくはないっ!",
   "en": "I do not cling\nto my life!"
  },
  {
   "id": "MESSAGE028:0866",
   "jp": "こんなの、痛くないわ!",
   "en": "This doesn't\nhurt at all!"
  },
  {
   "id": "MESSAGE028:0873",
   "jp": "いってぇなッ!",
   "en": "Ow, damn it!"
  },
  {
   "id": "MESSAGE028:087B",
   "jp": "まだまだ戦えるよッ!",
   "en": "I can still fight!"
  },
  {
   "id": "MESSAGE028:0887",
   "jp": "負けてられるか!",
   "en": "I can't lose here!"
  },
  {
   "id": "MESSAGE028:0891",
   "jp": "巻き返してみせるわ…!",
   "en": "I'll turn this\naround...!"
  },
  {
   "id": "MESSAGE028:089F",
   "jp": "怯みはせぬ!",
   "en": "I shall not falter!"
  },
  {
   "id": "MESSAGE028:08A7",
   "jp": "絶対に諦めないんだから!",
   "en": "I'm never\ngiving up!"
  },
  {
   "id": "MESSAGE028:08B7",
   "jp": "もとより、散る覚悟だッ!",
   "en": "I was ready to\ndie from the start!"
  },
  {
   "id": "MESSAGE028:08C7",
   "jp": "クケケ…ッ!",
   "en": "Kukeke...!"
  },
  {
   "id": "MESSAGE028:08CE",
   "jp": "グ、グオォォォッ!",
   "en": "Gr-Grooooh!"
  },
  {
   "id": "MESSAGE028:08D8",
   "jp": "このままで済むと思うな!",
   "en": "Don't think this\nis over!"
  },
  {
   "id": "MESSAGE028:08E7",
   "jp": "なかなかやるじゃない!",
   "en": "Not bad at all!"
  }
 ]
