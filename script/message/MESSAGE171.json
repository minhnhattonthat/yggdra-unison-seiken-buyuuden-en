{
 "file": "MESSAGE171.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE171:0480",
   "jp": "まあ、帝国に支配されるより\nマシか…",
   "en": "Well, beats being\nruled by the Empire..."
  },
  {
   "id": "MESSAGE171:0497",
   "jp": "金さえ貰えりゃ、それで\nいーや…",
   "en": "As long as I get paid,\nwhatever..."
  },
  {
   "id": "MESSAGE171:04AA",
   "jp": "(くっ…正直に喜べない)",
   "en": "(Ugh... I can't\nhonestly be happy.)"
  },
  {
   "id": "MESSAGE171:04BA",
   "jp": "そ、そんな…",
   "en": "N-no..."
  },
  {
   "id": "MESSAGE171:04C1",
   "jp": "くっ…!",
   "en": "Ngh...!"
  },
  {
   "id": "MESSAGE171:04C6",
   "jp": "フン…!",
   "en": "Hmph...!"
  },
  {
   "id": "MESSAGE171:04CB",
   "jp": "(何なのよ、この展開は…)",
   "en": "(What kind of ending\nis this...?)"
  },
  {
   "id": "MESSAGE171:04DC",
   "jp": "何ということだ…!",
   "en": "How could this be...!"
  },
  {
   "id": "MESSAGE171:04E7",
   "jp": "あァ?　おいおい、こりゃあ\n何の冗談だよ!?",
   "en": "Huh? Hey, hey, what\nkinda joke is this!?"
  },
  {
   "id": "MESSAGE171:0501",
   "jp": "うぬ…\n無駄な血を流してしまったな",
   "en": "Hrmm...\nBlood shed in vain."
  },
  {
   "id": "MESSAGE171:0517",
   "jp": "何と後味の悪い…",
   "en": "What a bitter\naftertaste..."
  },
  {
   "id": "MESSAGE171:0524",
   "jp": "ニーチェ、こんなのやだよ…",
   "en": "Nietzsche doesn't\nlike this..."
  },
  {
   "id": "MESSAGE171:0532",
   "jp": "貴様には長たる者の資格など\n無い…!",
   "en": "You are unfit to lead\nanyone...!"
  },
  {
   "id": "MESSAGE171:054C",
   "jp": "このような…\n望まぬ戦いなど……",
   "en": "Such an unwanted\nwar as this..."
  },
  {
   "id": "MESSAGE171:055F",
   "jp": "ありえねぇ…",
   "en": "No freakin' way..."
  },
  {
   "id": "MESSAGE171:0566",
   "jp": "なーんか居場所が\nねえんだよなぁ…",
   "en": "Kinda feels like I\ndon't belong here..."
  },
  {
   "id": "MESSAGE171:057B",
   "jp": "…寝首をかかれんようにな?",
   "en": "...Watch yer back\nwhile ya sleep, eh?"
  },
  {
   "id": "MESSAGE171:058B",
   "jp": "せいぜい、三日天下で\n終わらんようにな…",
   "en": "Try not to make it a\nthree-day reign, eh..."
  },
  {
   "id": "MESSAGE171:05A4",
   "jp": "おうちに帰りたいよ…",
   "en": "I wanna go home..."
  },
  {
   "id": "MESSAGE171:05B0",
   "jp": "ちょっと!\nウチ、納得いかないんだけど",
   "en": "Hey!\nI don't buy this at all!"
  },
  {
   "id": "MESSAGE171:05C6",
   "jp": "革命、ここに破れたり…",
   "en": "Here, the revolution\nfails..."
  },
  {
   "id": "MESSAGE171:05D5",
   "jp": "オイラ、タダ働きかよ…",
   "en": "I worked for nothin'?"
  },
  {
   "id": "MESSAGE171:05E2",
   "jp": "…………",
   "en": "..."
  },
  {
   "id": "MESSAGE171:05E7",
   "jp": "なっ…!?",
   "en": "Wha...?!"
  },
  {
   "id": "MESSAGE171:05ED",
   "jp": "生意気ね…",
   "en": "How cheeky..."
  },
  {
   "id": "MESSAGE171:05F6",
   "jp": "まったく馬鹿げている…",
   "en": "Utterly absurd..."
  },
  {
   "id": "MESSAGE171:0604",
   "jp": "いつか神の裁きが\n下されよう…",
   "en": "God's judgment\nshall fall someday..."
  },
  {
   "id": "MESSAGE171:0615",
   "jp": "もう戦わずに済むなら\nそれでいいわい…",
   "en": "If the fightin's over,\nthat's fine by me..."
  },
  {
   "id": "MESSAGE171:062B",
   "jp": "ハァ?",
   "en": "Excuse me?"
  },
  {
   "id": "MESSAGE171:062F",
   "jp": "あまり調子に乗らない方が\nいいんじゃないかしら?",
   "en": "Best not get too\nfull of yourself, hm?"
  },
  {
   "id": "MESSAGE171:064C",
   "jp": "チョーありえな~い!",
   "en": "Like, totally\nno waaay!"
  },
  {
   "id": "MESSAGE171:0657",
   "jp": "ケッ!",
   "en": "Keh!"
  },
  {
   "id": "MESSAGE171:065B",
   "jp": "…グォ",
   "en": "...Gwo."
  },
  {
   "id": "MESSAGE171:065F",
   "jp": "…グワォ",
   "en": "...Grwao."
  },
  {
   "id": "MESSAGE171:0664",
   "jp": "くっ…\n強き力…か",
   "en": "Tch...\nStrength, is it..."
  },
  {
   "id": "MESSAGE171:0670",
   "jp": "ビギナーズラックという\nこともありますわね…",
   "en": "Beginner's luck\ndoes happen, dear..."
  },
  {
   "id": "MESSAGE171:0687",
   "jp": "この世界には予想出来ぬ\nこともままあるのですね…",
   "en": "This world is full of\nsurprises, it seems..."
  }
 ]
}
