 "strings": [
  {
   "id": "MESSAGE171:0480",
   "jp": "まあ、帝国に支配されるより\nマシか…",
   "en": ""
  },
  {
   "id": "MESSAGE171:0497",
   "jp": "金さえ貰えりゃ、それで\nいーや…",
   "en": ""
  },
  {
   "id": "MESSAGE171:04AA",
   "jp": "(くっ…正直に喜べない)",
   "en": ""
  },
  {
   "id": "MESSAGE171:04BA",
   "jp": "そ、そんな…",
   "en": ""
  },
  {
   "id": "MESSAGE171:04C1",
   "jp": "くっ…!",
   "en": ""
  },
  {
   "id": "MESSAGE171:04C6",
   "jp": "フン…!",
   "en": ""
  },
  {
   "id": "MESSAGE171:04CB",
   "jp": "(何なのよ、この展開は…)",
   "en": ""
  },
  {
   "id": "MESSAGE171:04DC",
   "jp": "何ということだ…!",
   "en": ""
  },
  {
   "id": "MESSAGE171:04E7",
   "jp": "あァ?　おいおい、こりゃあ\n何の冗談だよ!?",
   "en": ""
  },
  {
   "id": "MESSAGE171:0501",
   "jp": "うぬ…\n無駄な血を流してしまったな",
   "en": ""
  },
  {
   "id": "MESSAGE171:0517",
   "jp": "何と後味の悪い…",
   "en": ""
  },
  {
   "id": "MESSAGE171:0524",
   "jp": "ニーチェ、こんなのやだよ…",
   "en": ""
  },
  {
   "id": "MESSAGE171:0532",
   "jp": "貴様には長たる者の資格など\n無い…!",
   "en": ""
  },
  {
   "id": "MESSAGE171:054C",
   "jp": "このような…\n望まぬ戦いなど……",
   "en": ""
  },
  {
   "id": "MESSAGE171:055F",
   "jp": "ありえねぇ…",
   "en": ""
  },
  {
   "id": "MESSAGE171:0566",
   "jp": "なーんか居場所が\nねえんだよなぁ…",
   "en": ""
  },
  {
   "id": "MESSAGE171:057B",
   "jp": "…寝首をかかれんようにな?",
   "en": ""
  },
  {
   "id": "MESSAGE171:058B",
   "jp": "せいぜい、三日天下で\n終わらんようにな…",
   "en": ""
  },
  {
   "id": "MESSAGE171:05A4",
   "jp": "おうちに帰りたいよ…",
   "en": ""
  },
  {
   "id": "MESSAGE171:05B0",
   "jp": "ちょっと!\nウチ、納得いかないんだけど",
   "en": ""
  },
  {
   "id": "MESSAGE171:05C6",
   "jp": "革命、ここに破れたり…",
   "en": ""
  },
  {
   "id": "MESSAGE171:05D5",
   "jp": "オイラ、タダ働きかよ…",
   "en": ""
  },
  {
   "id": "MESSAGE171:05E2",
   "jp": "…………",
   "en": ""
  },
  {
   "id": "MESSAGE171:05E7",
   "jp": "なっ…!?",
   "en": ""
  },
  {
   "id": "MESSAGE171:05ED",
   "jp": "生意気ね…",
   "en": ""
  },
  {
   "id": "MESSAGE171:05F6",
   "jp": "まったく馬鹿げている…",
   "en": ""
  },
  {
   "id": "MESSAGE171:0604",
   "jp": "いつか神の裁きが\n下されよう…",
   "en": ""
  },
  {
   "id": "MESSAGE171:0615",
   "jp": "もう戦わずに済むなら\nそれでいいわい…",
   "en": ""
  },
  {
   "id": "MESSAGE171:062B",
   "jp": "ハァ?",
   "en": ""
  },
  {
   "id": "MESSAGE171:062F",
   "jp": "あまり調子に乗らない方が\nいいんじゃないかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE171:064C",
   "jp": "チョーありえな~い!",
   "en": ""
  },
  {
   "id": "MESSAGE171:0657",
   "jp": "ケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE171:065B",
   "jp": "…グォ",
   "en": ""
  },
  {
   "id": "MESSAGE171:065F",
   "jp": "…グワォ",
   "en": ""
  },
  {
   "id": "MESSAGE171:0664",
   "jp": "くっ…\n強き力…か",
   "en": ""
  },
  {
   "id": "MESSAGE171:0670",
   "jp": "ビギナーズラックという\nこともありますわね…",
   "en": ""
  },
  {
   "id": "MESSAGE171:0687",
   "jp": "この世界には予想出来ぬ\nこともままあるのですね…",
   "en": ""
  }
 ]
