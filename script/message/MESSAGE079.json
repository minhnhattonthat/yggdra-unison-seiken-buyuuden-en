{
 "file": "MESSAGE079.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE079:04C0",
   "jp": "あんたには…\n本当に世話になったよな?",
   "en": ""
  },
  {
   "id": "MESSAGE079:04D8",
   "jp": "けっ、身の程知らずが!",
   "en": ""
  },
  {
   "id": "MESSAGE079:04E7",
   "jp": "モニカ…ごめんな……",
   "en": ""
  },
  {
   "id": "MESSAGE079:04F2",
   "jp": "罰をお受けなさい!",
   "en": ""
  },
  {
   "id": "MESSAGE079:04FE",
   "jp": "出直してくるがいい!",
   "en": ""
  },
  {
   "id": "MESSAGE079:050B",
   "jp": "貴様になど負けはしない!",
   "en": ""
  },
  {
   "id": "MESSAGE079:051B",
   "jp": "許して、カナン…",
   "en": ""
  },
  {
   "id": "MESSAGE079:0525",
   "jp": "勝負…ありましたね",
   "en": ""
  },
  {
   "id": "MESSAGE079:0531",
   "jp": "ハッ…この程度か、焔帝殿?",
   "en": ""
  },
  {
   "id": "MESSAGE079:0544",
   "jp": "勝負あり申した",
   "en": ""
  },
  {
   "id": "MESSAGE079:054F",
   "jp": "勝負はあった。諦めよ",
   "en": ""
  },
  {
   "id": "MESSAGE079:055D",
   "jp": "女王様に勝った…",
   "en": ""
  },
  {
   "id": "MESSAGE079:056A",
   "jp": "エメローネ様!\n降伏してください!",
   "en": ""
  },
  {
   "id": "MESSAGE079:057F",
   "jp": "運命とは\nときに非情なもの…",
   "en": ""
  },
  {
   "id": "MESSAGE079:0592",
   "jp": "まだまだ甘いな!\nオレが鍛えなおしてやるぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE079:05AB",
   "jp": "お…親分に勝った!?",
   "en": ""
  },
  {
   "id": "MESSAGE079:05B9",
   "jp": "静かにすりゃあ\n手荒にはせんぞ?",
   "en": ""
  },
  {
   "id": "MESSAGE079:05CD",
   "jp": "こいつぁ驚きだ!\n神様を倒したぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE079:05E3",
   "jp": "お兄様に勝ったの…?",
   "en": ""
  },
  {
   "id": "MESSAGE079:05F1",
   "jp": "ウチ、強くなったでしょ?",
   "en": ""
  },
  {
   "id": "MESSAGE079:05FF",
   "jp": "僕にも意地があるからね",
   "en": ""
  },
  {
   "id": "MESSAGE079:060E",
   "jp": "今度こそ王女は頂いたぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE079:0620",
   "jp": "兄さん…!!",
   "en": ""
  },
  {
   "id": "MESSAGE079:0628",
   "jp": "さらばだ…エレナ",
   "en": ""
  },
  {
   "id": "MESSAGE079:0631",
   "jp": "貧乏人はお呼びじゃないのよ",
   "en": ""
  },
  {
   "id": "MESSAGE079:0643",
   "jp": "貴様は私には勝てん",
   "en": ""
  },
  {
   "id": "MESSAGE079:0650",
   "jp": "後のことは任せてもらおう",
   "en": ""
  },
  {
   "id": "MESSAGE079:065F",
   "jp": "わ、わしに勝てると\n思ったのか!?",
   "en": ""
  },
  {
   "id": "MESSAGE079:0673",
   "jp": "あたしにひざまずくといいわ",
   "en": ""
  },
  {
   "id": "MESSAGE079:0681",
   "jp": "あら、こんなものなの?",
   "en": ""
  },
  {
   "id": "MESSAGE079:068D",
   "jp": "ウンディーネは\nパメラ様のものよ♪",
   "en": ""
  },
  {
   "id": "MESSAGE079:06A0",
   "jp": "ケッ、ケーッケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE079:06AD",
   "jp": "グォォォォ!　グオァ!",
   "en": ""
  },
  {
   "id": "MESSAGE079:06B9",
   "jp": "グワォォォォ!　グワァ!",
   "en": ""
  },
  {
   "id": "MESSAGE079:06C6",
   "jp": "死んで名を残すがいい…",
   "en": ""
  },
  {
   "id": "MESSAGE079:06D5",
   "jp": "その武勇…\n歴史に残りますわよ",
   "en": ""
  },
  {
   "id": "MESSAGE079:06EA",
   "jp": "人間如き者が私に歯向かう\nなど…愚かなことです",
   "en": ""
  }
 ]
}
