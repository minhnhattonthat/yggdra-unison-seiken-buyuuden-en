{
 "file": "MESSAGE090.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE090:04B0",
   "jp": "進みたければ\n俺を倒していくんだな",
   "en": "To pass, you'll have\nto beat me first."
  },
  {
   "id": "MESSAGE090:04C5",
   "jp": "敵を阻止するゼ!",
   "en": "We'll stop the enemy,\ny'know!"
  },
  {
   "id": "MESSAGE090:04D1",
   "jp": "ここから出て行け!",
   "en": "Get out of here!"
  },
  {
   "id": "MESSAGE090:04DC",
   "jp": "ここで守りを固めます!",
   "en": "We will hold our\nground here!"
  },
  {
   "id": "MESSAGE090:04EA",
   "jp": "詰めが甘いな!",
   "en": "Your finish is\nsloppy!"
  },
  {
   "id": "MESSAGE090:04F4",
   "jp": "残念だったな!",
   "en": "Too bad!"
  },
  {
   "id": "MESSAGE090:04FE",
   "jp": "先には行かせないわ!",
   "en": "I won't let you go any\nfurther!"
  },
  {
   "id": "MESSAGE090:050A",
   "jp": "防御陣形だ!　急げ!",
   "en": "Defensive formation!\nHurry!"
  },
  {
   "id": "MESSAGE090:051A",
   "jp": "全員まとめて\nあの世に送ってやるぜ!",
   "en": "I'll send you all to the\nafterlife at once!"
  },
  {
   "id": "MESSAGE090:0531",
   "jp": "ここから先へは行かせぬ!",
   "en": "Thou shalt go no\nfurther!"
  },
  {
   "id": "MESSAGE090:053F",
   "jp": "敵は通さぬ!",
   "en": "No enemy shall pass!"
  },
  {
   "id": "MESSAGE090:0548",
   "jp": "ニーチェ、ここ守るよ!",
   "en": "Nietzsche will\nprotect this place!"
  },
  {
   "id": "MESSAGE090:0555",
   "jp": "一歩も退かぬ!",
   "en": "Not one step back!"
  },
  {
   "id": "MESSAGE090:0560",
   "jp": "先へは進ませません。\n引き返しなさい!",
   "en": "You shall advance no\nfurther. Turn back!"
  },
  {
   "id": "MESSAGE090:0578",
   "jp": "行かせてたまるかよ!",
   "en": "Like hell I'll let ya\nthrough!"
  },
  {
   "id": "MESSAGE090:0583",
   "jp": "進ませてたまるかっ!",
   "en": "Like I'd let ya pass!"
  },
  {
   "id": "MESSAGE090:058F",
   "jp": "ここはワシらの土地だぞぉ!",
   "en": "This here's our land,\nya hear!"
  },
  {
   "id": "MESSAGE090:059F",
   "jp": "ここは誰にも渡さん!",
   "en": "Nobody's takin' this,\nsonny!"
  },
  {
   "id": "MESSAGE090:05AC",
   "jp": "欲張りはダメなんだからね!",
   "en": "Being greedy is bad,\nyou know!"
  },
  {
   "id": "MESSAGE090:05BC",
   "jp": "ここはウチらがもらうよ!",
   "en": "We're takin' this one!"
  },
  {
   "id": "MESSAGE090:05C9",
   "jp": "よし、占領したぞ!",
   "en": "Alright, it's ours!"
  },
  {
   "id": "MESSAGE090:05D5",
   "jp": "よっしゃ!　占領!",
   "en": "Alright! Captured!"
  },
  {
   "id": "MESSAGE090:05E1",
   "jp": "先へは行かせません…!",
   "en": "I will not let you\npass...!"
  },
  {
   "id": "MESSAGE090:05EE",
   "jp": "進ませはしない",
   "en": "You will not advance."
  },
  {
   "id": "MESSAGE090:05F7",
   "jp": "無駄よ…",
   "en": "It's no use..."
  },
  {
   "id": "MESSAGE090:05FE",
   "jp": "簡単に進めると思うな!",
   "en": "Do not think you'll\npass so easily!"
  },
  {
   "id": "MESSAGE090:060E",
   "jp": "神が許さなくても私が許す!\nここは我らが頂く!",
   "en": "If God won't allow it,\nI will! This is ours!"
  },
  {
   "id": "MESSAGE090:062A",
   "jp": "ここはわしが占領するぞ…\nよ、よいな?",
   "en": "I'll capture this...\nTh-that's fine, yes?"
  },
  {
   "id": "MESSAGE090:0640",
   "jp": "あんたに渡す土地は無いわ!",
   "en": "There's no land here\nfor you!"
  },
  {
   "id": "MESSAGE090:0652",
   "jp": "遅かったわね!",
   "en": "You're too\nlate, you know!"
  },
  {
   "id": "MESSAGE090:065B",
   "jp": "キャッホー!\nいっただきぃ~♪",
   "en": "Yahoo! Yoink~!"
  },
  {
   "id": "MESSAGE090:066B",
   "jp": "クケケ~ッ!",
   "en": "Kukeke~!"
  },
  {
   "id": "MESSAGE090:0672",
   "jp": "グォォォォゥン!",
   "en": "Grooooan!"
  },
  {
   "id": "MESSAGE090:067B",
   "jp": "グワォォォォゥン!",
   "en": "Grwaaaoon!"
  },
  {
   "id": "MESSAGE090:0685",
   "jp": "我らは一歩も退かん!",
   "en": "We will not retreat a\nsingle step!"
  },
  {
   "id": "MESSAGE090:0694",
   "jp": "この調子ですわ",
   "en": "This is going nicely."
  },
  {
   "id": "MESSAGE090:069E",
   "jp": "ここは渡しませんよ?\nフフフ…",
   "en": "This is not yours to\ntake. Heh heh heh..."
  },
  {
   "id": "MESSAGE090:06AF",
   "jp": "よし、占領だ!",
   "en": "Alright, captured!"
  },
  {
   "id": "MESSAGE090:06B9",
   "jp": "させない!",
   "en": "Not on my watch!"
  }
 ]
}
