 "strings": [
  {
   "id": "MESSAGE147:03E0",
   "jp": "…承知しました",
   "en": ""
  },
  {
   "id": "MESSAGE147:03EA",
   "jp": "…分かりました",
   "en": ""
  },
  {
   "id": "MESSAGE147:03F3",
   "jp": "どうか生き延びてね…",
   "en": ""
  },
  {
   "id": "MESSAGE147:0400",
   "jp": "姉さん、どうか生き延びて…",
   "en": ""
  },
  {
   "id": "MESSAGE147:0411",
   "jp": "ありがとうね…",
   "en": ""
  },
  {
   "id": "MESSAGE147:0419",
   "jp": "また会うこともあるでしょう",
   "en": ""
  },
  {
   "id": "MESSAGE147:0428",
   "jp": "次に会った時が\n貴様の命日だ…!",
   "en": ""
  },
  {
   "id": "MESSAGE147:0440",
   "jp": "後悔なさいますな",
   "en": ""
  },
  {
   "id": "MESSAGE147:044B",
   "jp": "神罰を受けるがいい…!",
   "en": ""
  },
  {
   "id": "MESSAGE147:0459",
   "jp": "じゃーねー♪",
   "en": ""
  },
  {
   "id": "MESSAGE147:0460",
   "jp": "オレに用はねえってか…\nじゃあな",
   "en": ""
  },
  {
   "id": "MESSAGE147:0472",
   "jp": "ちくしょうめ…!",
   "en": ""
  },
  {
   "id": "MESSAGE147:047B",
   "jp": "くそう、覚えとれよ!",
   "en": ""
  },
  {
   "id": "MESSAGE147:0487",
   "jp": "子供の相手なんて\nしてられない!",
   "en": ""
  },
  {
   "id": "MESSAGE147:049C",
   "jp": "ウチを逃がしたこと\n後悔しないでよね!",
   "en": ""
  },
  {
   "id": "MESSAGE147:04B3",
   "jp": "覚えてろよ…",
   "en": ""
  },
  {
   "id": "MESSAGE147:04BB",
   "jp": "…承知致しました……",
   "en": ""
  },
  {
   "id": "MESSAGE147:04C9",
   "jp": "フフ…じゃあね",
   "en": ""
  },
  {
   "id": "MESSAGE147:04D1",
   "jp": "貴様の領土に住むなど\n吐き気がする…!",
   "en": ""
  },
  {
   "id": "MESSAGE147:04EC",
   "jp": "おのれ、この屈辱\n死ぬまで忘れんぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE147:0503",
   "jp": "命が助かれば\n文句は言わんぞ…",
   "en": ""
  },
  {
   "id": "MESSAGE147:0518",
   "jp": "あんたに指図されるより\n何倍もマシだわ!",
   "en": ""
  },
  {
   "id": "MESSAGE147:0531",
   "jp": "貴方になら協力してあげても\nよかったんだけどね…",
   "en": ""
  },
  {
   "id": "MESSAGE147:054E",
   "jp": "さんきゅー♪",
   "en": ""
  },
  {
   "id": "MESSAGE147:0555",
   "jp": "クケッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE147:055B",
   "jp": "グフォァァァッ!!!",
   "en": ""
  },
  {
   "id": "MESSAGE147:0566",
   "jp": "グワォッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE147:056D",
   "jp": "そうか…では、さらばだ!",
   "en": ""
  },
  {
   "id": "MESSAGE147:057A",
   "jp": "またお会いできると\nいいですわね…",
   "en": ""
  },
  {
   "id": "MESSAGE147:058D",
   "jp": "よろしいのですか?\n私を放逐しても…",
   "en": ""
  }
 ]
