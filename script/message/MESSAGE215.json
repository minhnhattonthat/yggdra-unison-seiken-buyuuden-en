{
 "file": "MESSAGE215.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE215:0240",
   "jp": "王国の興廃は\nこの一戦にあります!",
   "en": ""
  },
  {
   "id": "MESSAGE215:0258",
   "jp": "これ以上の愚行…\n神がお赦しでも私が許さぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE215:0274",
   "jp": "背後の脅威は\n絶たねばなりませんね…",
   "en": ""
  },
  {
   "id": "MESSAGE215:028C",
   "jp": "目障りな連中だぜ…\nよっしゃ!　蹴散らすぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE215:02A9",
   "jp": "ワシの堪忍袋の緒も\nそろそろ限界だぞぉ…",
   "en": ""
  },
  {
   "id": "MESSAGE215:02C4",
   "jp": "異教徒どもめ…\n思い知らせてくれるぞい!",
   "en": ""
  },
  {
   "id": "MESSAGE215:02DE",
   "jp": "敵はロザリィか…\n相手にとって不足は無いな",
   "en": ""
  },
  {
   "id": "MESSAGE215:02FA",
   "jp": "ゴードンのやつめ…\nわ、わしの力を見せてやるぞ",
   "en": ""
  },
  {
   "id": "MESSAGE215:0314",
   "jp": "ロズウェルが相手…\n面白い勝負になりそうね!",
   "en": ""
  },
  {
   "id": "MESSAGE215:0331",
   "jp": "ここを手に入れれば\nもう好き放題だわさ!",
   "en": ""
  },
  {
   "id": "MESSAGE215:034B",
   "jp": "大陸世界を統べるためにも\nこれは重要な一戦だ!",
   "en": ""
  },
  {
   "id": "MESSAGE215:036C",
   "jp": "正直申し上げましょう。\n貴方がたは邪魔なのです…",
   "en": ""
  }
 ]
}
