{
 "file": "MESSAGE011.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE011:0480",
   "jp": "戦うしか無いか…!",
   "en": ""
  },
  {
   "id": "MESSAGE011:048C",
   "jp": "キヒヒ…\nたっぷり斬り刻んでやるゼ!",
   "en": ""
  },
  {
   "id": "MESSAGE011:04A1",
   "jp": "絶対に倒してやる!",
   "en": ""
  },
  {
   "id": "MESSAGE011:04AE",
   "jp": "寄らば、斬ります!",
   "en": ""
  },
  {
   "id": "MESSAGE011:04BA",
   "jp": "たわけたことを…\n今に後悔させてやろう!",
   "en": ""
  },
  {
   "id": "MESSAGE011:04D2",
   "jp": "ふざけたことを…\n今に後悔させてやろう!",
   "en": ""
  },
  {
   "id": "MESSAGE011:04EA",
   "jp": "いいわ、\nかかって来なさいよ!",
   "en": ""
  },
  {
   "id": "MESSAGE011:04FB",
   "jp": "ここは我らの地。\n貴殿の好きにはさせん!",
   "en": ""
  },
  {
   "id": "MESSAGE011:0515",
   "jp": "こりゃあいいぜ!\nかかって来な!",
   "en": ""
  },
  {
   "id": "MESSAGE011:0527",
   "jp": "覚悟はできているので\nあろうな?",
   "en": ""
  },
  {
   "id": "MESSAGE011:053A",
   "jp": "今こそ勝負をつける時だ。\n受けて立とう!",
   "en": ""
  },
  {
   "id": "MESSAGE011:0555",
   "jp": "ニーチェたちの\n邪魔しないで!",
   "en": ""
  },
  {
   "id": "MESSAGE011:0567",
   "jp": "邪魔だ、出て行け!",
   "en": ""
  },
  {
   "id": "MESSAGE011:0574",
   "jp": "立ち去らないのであれば\nお相手するしかありませんね",
   "en": ""
  },
  {
   "id": "MESSAGE011:0592",
   "jp": "おう、決着つけてやるぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE011:05A1",
   "jp": "お前には負けねえぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE011:05AE",
   "jp": "ほっほー!\nコテンパンにしてくれるわ!",
   "en": ""
  },
  {
   "id": "MESSAGE011:05C2",
   "jp": "やるのか!?　面白い!\n相手になってやるわい!",
   "en": ""
  },
  {
   "id": "MESSAGE011:05DE",
   "jp": "絶対に負けないんだから!",
   "en": ""
  },
  {
   "id": "MESSAGE011:05EE",
   "jp": "ウチら、負けないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE011:05FA",
   "jp": "そっちからわざわざ\n出向いてくれるなんてな!",
   "en": ""
  },
  {
   "id": "MESSAGE011:0613",
   "jp": "オイラの本気を\n見せてやるぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE011:0626",
   "jp": "いざ…勝負です!",
   "en": ""
  },
  {
   "id": "MESSAGE011:0631",
   "jp": "今日こそ決着を\nつけようではないか!",
   "en": ""
  },
  {
   "id": "MESSAGE011:0648",
   "jp": "フフ…構わないわ。\n相手になるわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE011:065E",
   "jp": "やはりきたか…\n今日こそ決着をつけてやろう",
   "en": ""
  },
  {
   "id": "MESSAGE011:0678",
   "jp": "この異端め!\n神罰を受けるが良い!",
   "en": ""
  },
  {
   "id": "MESSAGE011:068F",
   "jp": "て、手加減はできんぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE011:069F",
   "jp": "望むところよ!\n勝負つけてやろうじゃない!",
   "en": ""
  },
  {
   "id": "MESSAGE011:06B8",
   "jp": "うふふ…面白い!\nやってやろうじゃないの!",
   "en": ""
  },
  {
   "id": "MESSAGE011:06D0",
   "jp": "きーっ!　このパメラ様に\n刃向かうなんて!",
   "en": ""
  },
  {
   "id": "MESSAGE011:06E9",
   "jp": "ケーッケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE011:06F3",
   "jp": "グォォォォォオッ!",
   "en": ""
  },
  {
   "id": "MESSAGE011:06FD",
   "jp": "グワォォォォォオッ!",
   "en": ""
  },
  {
   "id": "MESSAGE011:0708",
   "jp": "面白い。受けてやろう!",
   "en": ""
  },
  {
   "id": "MESSAGE011:0717",
   "jp": "困りますわ~\nきっと後悔しますわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE011:072D",
   "jp": "気の毒な人たちだ…\n感情に流されるなど…",
   "en": ""
  }
 ]
}
