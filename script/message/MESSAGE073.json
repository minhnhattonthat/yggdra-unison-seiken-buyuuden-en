{
 "file": "MESSAGE073.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE073:04F0",
   "jp": "これでよかったのかもな…",
   "en": "Maybe this was\nfor the best..."
  },
  {
   "id": "MESSAGE073:04FD",
   "jp": "チ、チクショウ…!",
   "en": "D-damn it...!"
  },
  {
   "id": "MESSAGE073:0507",
   "jp": "やっぱり俺は…",
   "en": "I guess I'm just..."
  },
  {
   "id": "MESSAGE073:0510",
   "jp": "諦めるしか無いの…?",
   "en": "Must I give up...?"
  },
  {
   "id": "MESSAGE073:051D",
   "jp": "何故…何故だ!?",
   "en": "Why... why?!"
  },
  {
   "id": "MESSAGE073:052A",
   "jp": "くっ…油断したか……!",
   "en": "Tch... I let my guard\ndown......!"
  },
  {
   "id": "MESSAGE073:0538",
   "jp": "何てことなの…",
   "en": "How could this\nhappen..."
  },
  {
   "id": "MESSAGE073:0541",
   "jp": "む、無念…!",
   "en": "I-I have failed...!"
  },
  {
   "id": "MESSAGE073:054A",
   "jp": "な、なんだとぉぉぉッ!?",
   "en": "Wh-whaaaat?!"
  },
  {
   "id": "MESSAGE073:0557",
   "jp": "むう、ふ…不覚!",
   "en": "Hmm, c-careless\nof me!"
  },
  {
   "id": "MESSAGE073:0562",
   "jp": "私が…負けるとは……",
   "en": "That I... would\nlose..."
  },
  {
   "id": "MESSAGE073:056E",
   "jp": "痛いよ~!",
   "en": "Owww, it hurts~!"
  },
  {
   "id": "MESSAGE073:0575",
   "jp": "ば…か…な…",
   "en": "Im...pos...sible..."
  },
  {
   "id": "MESSAGE073:057C",
   "jp": "皆の者…\nどうか無事で……",
   "en": "Everyone...\nplease stay safe..."
  },
  {
   "id": "MESSAGE073:058E",
   "jp": "こんなところで\n負けてる場合じゃねーぞ…!",
   "en": "Ain't no time to\nbe losin' here...!"
  },
  {
   "id": "MESSAGE073:05A7",
   "jp": "親分、お役に立てませんで…",
   "en": "Sorry I was no use,\nBoss..."
  },
  {
   "id": "MESSAGE073:05B9",
   "jp": "おめぇら…許してくれ……",
   "en": "You lot...\nforgive me..."
  },
  {
   "id": "MESSAGE073:05C7",
   "jp": "なかなかやるのう…!",
   "en": "Not bad, sonny...!"
  },
  {
   "id": "MESSAGE073:05D2",
   "jp": "お兄様、役に立てなくて\nごめんなさい…",
   "en": "Big Brother, sorry\nI was no help..."
  },
  {
   "id": "MESSAGE073:05EA",
   "jp": "あ、あれっ!?",
   "en": "Huh? Wha-?!"
  },
  {
   "id": "MESSAGE073:05F2",
   "jp": "くっ、どうすりゃいいんだ…",
   "en": "Ngh, what do I\ndo now..."
  },
  {
   "id": "MESSAGE073:0600",
   "jp": "うわっ!　しまった…",
   "en": "Whoa! Crap..."
  },
  {
   "id": "MESSAGE073:060B",
   "jp": "申し訳…ありません……",
   "en": "I'm... terribly\nsorry..."
  },
  {
   "id": "MESSAGE073:0619",
   "jp": "しくじったか…",
   "en": "I slipped up..."
  },
  {
   "id": "MESSAGE073:0621",
   "jp": "手の内を読まれた…?",
   "en": "My moves...\nwere read...?"
  },
  {
   "id": "MESSAGE073:062F",
   "jp": "もはやここまで…か……",
   "en": "So this... is\nthe end..."
  },
  {
   "id": "MESSAGE073:063B",
   "jp": "神罰が下るぞ…!",
   "en": "Divine punishment\nawaits you...!"
  },
  {
   "id": "MESSAGE073:0645",
   "jp": "な、何たることじゃあ!",
   "en": "Wh-what in\nheaven's name?!"
  },
  {
   "id": "MESSAGE073:0652",
   "jp": "し、信じられない…ッ!",
   "en": "I-I can't\nbelieve it...!"
  },
  {
   "id": "MESSAGE073:065F",
   "jp": "あ、ありえないわ…!",
   "en": "Th-this can't\nbe happening...!"
  },
  {
   "id": "MESSAGE073:066A",
   "jp": "あちゃー!",
   "en": "Whoopsie!"
  },
  {
   "id": "MESSAGE073:0670",
   "jp": "ケ…ケケ~……!",
   "en": "Ke... Kekeh~..."
  },
  {
   "id": "MESSAGE073:0679",
   "jp": "グォ…グォォォ~……!",
   "en": "Gro... Grooo~...!"
  },
  {
   "id": "MESSAGE073:0685",
   "jp": "グワォ…グワォォォ~……!",
   "en": "Grwao...\nGrwaooo~......!"
  },
  {
   "id": "MESSAGE073:0693",
   "jp": "この俺が負けるなど…ッ!",
   "en": "That I could lose...!"
  },
  {
   "id": "MESSAGE073:06A2",
   "jp": "困りますわ、こんな…",
   "en": "Oh dear, this\nwon't do..."
  },
  {
   "id": "MESSAGE073:06AE",
   "jp": "あ…ありえないことです…\nこんな……",
   "en": "Th-this is impossible...\nSuch a thing..."
  },
  {
   "id": "MESSAGE073:06C1",
   "jp": "油断した…",
   "en": "I got careless..."
  },
  {
   "id": "MESSAGE073:06C9",
   "jp": "まさかそんな…",
   "en": "No, it can't be..."
  }
 ]
}
