{
 "file": "MESSAGE086.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE086:0450",
   "jp": "都市を占領!\nさあ、この調子でいくぞ!",
   "en": "City captured! Let's\nkeep it up!"
  },
  {
   "id": "MESSAGE086:046A",
   "jp": "都市を占領したゼ",
   "en": "City's ours, y'know."
  },
  {
   "id": "MESSAGE086:0477",
   "jp": "都市を…おさえたぞ",
   "en": "We've... taken\nthe city."
  },
  {
   "id": "MESSAGE086:0483",
   "jp": "お願い、抵抗しないで…!",
   "en": "Please, do not\nresist...!"
  },
  {
   "id": "MESSAGE086:0493",
   "jp": "占領する…!",
   "en": "I shall take it...!"
  },
  {
   "id": "MESSAGE086:049C",
   "jp": "占領だ…!",
   "en": "It's ours...!"
  },
  {
   "id": "MESSAGE086:04A4",
   "jp": "ここをおさえれば\n有利になるはずよ…",
   "en": "Taking this should\ngive us the edge..."
  },
  {
   "id": "MESSAGE086:04B9",
   "jp": "ここが勝敗の分かれ目です…",
   "en": "This is where victory\nwill be decided..."
  },
  {
   "id": "MESSAGE086:04CB",
   "jp": "ここは俺様のものだ!",
   "en": "This place belongs\nto the great me!"
  },
  {
   "id": "MESSAGE086:04D8",
   "jp": "失礼いたす!",
   "en": "By your leave!"
  },
  {
   "id": "MESSAGE086:04E1",
   "jp": "…占領してもいいのかな?",
   "en": "...Is it okay\nto take this?"
  },
  {
   "id": "MESSAGE086:04F0",
   "jp": "慎重に進むんだ!",
   "en": "Advance with\ncaution!"
  },
  {
   "id": "MESSAGE086:04FC",
   "jp": "抵抗しないのであれば\n手出しはいたしません…!",
   "en": "Do not resist, and we\nshall not harm you...!"
  },
  {
   "id": "MESSAGE086:0518",
   "jp": "抵抗しないでくだせえ!",
   "en": "Don't resist, I'm\nbeggin' ya!"
  },
  {
   "id": "MESSAGE086:0526",
   "jp": "こうなりゃヤケだぞぉ!",
   "en": "Screw it, all or\nnothin' now!"
  },
  {
   "id": "MESSAGE086:0532",
   "jp": "ここはワシのもんじゃい!",
   "en": "This here's mine,\nsonny!"
  },
  {
   "id": "MESSAGE086:053F",
   "jp": "ここ、ボクたちがもらうよ!",
   "en": "We're taking this\nplace!"
  },
  {
   "id": "MESSAGE086:054D",
   "jp": "カンベンしてね!",
   "en": "Sorry 'bout this!"
  },
  {
   "id": "MESSAGE086:0556",
   "jp": "…みんな、ごめん!",
   "en": "...Sorry, everyone!"
  },
  {
   "id": "MESSAGE086:0560",
   "jp": "お先に頂くぜ!",
   "en": "I'll be takin' this first!"
  },
  {
   "id": "MESSAGE086:056A",
   "jp": "都市を…おさえました",
   "en": "The city... is secured."
  },
  {
   "id": "MESSAGE086:0577",
   "jp": "都市占領!",
   "en": "City captured!"
  },
  {
   "id": "MESSAGE086:0581",
   "jp": "フフ…悪く思わないでね……",
   "en": "Fufu... Don't take it\npersonally..."
  },
  {
   "id": "MESSAGE086:0591",
   "jp": "占領だ…!",
   "en": "It's ours...!"
  },
  {
   "id": "MESSAGE086:0599",
   "jp": "これは聖なる行いなのだ!\nよってこの地は平定する!",
   "en": "A holy deed! Thus is\nthis land pacified!"
  },
  {
   "id": "MESSAGE086:05B7",
   "jp": "お、大人しく渡すんじゃ!",
   "en": "H-hand it over\nquietly!"
  },
  {
   "id": "MESSAGE086:05C7",
   "jp": "ごめんね、ここはもらうわ!",
   "en": "Sorry, darling,\nthis is mine!"
  },
  {
   "id": "MESSAGE086:05D5",
   "jp": "もらったわよ!",
   "en": "It's mine!"
  },
  {
   "id": "MESSAGE086:05DD",
   "jp": "もらっちゃうわよ~!",
   "en": "I'm taking it~!"
  },
  {
   "id": "MESSAGE086:05E8",
   "jp": "クケ~ッ!",
   "en": "Kukeh~!"
  },
  {
   "id": "MESSAGE086:05EE",
   "jp": "グォォォゥン!",
   "en": "Groooan!"
  },
  {
   "id": "MESSAGE086:05F6",
   "jp": "グワォォォゥン!",
   "en": "Grwaaoon!"
  },
  {
   "id": "MESSAGE086:05FF",
   "jp": "ここが我らの生命線だ!",
   "en": "This is our lifeline!"
  },
  {
   "id": "MESSAGE086:060F",
   "jp": "知った土地ですから…\n奇襲成功ですわね!",
   "en": "I know this land, so\nour ambush worked!"
  },
  {
   "id": "MESSAGE086:062B",
   "jp": "ここで守りを固めましょう。\nフフフ…",
   "en": "We shall fortify here.\nHeh heh heh..."
  }
 ]
}
