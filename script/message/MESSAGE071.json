  {
   "id": "MESSAGE071:05D1",
   "jp": "油断していたかもな…",
   "en": "Guess I got\ncareless..."
  },
  {
   "id": "MESSAGE071:05DE",
   "jp": "ガキが、やってくれるぜ…",
   "en": ""
  },
  {
   "id": "MESSAGE071:05EB",
