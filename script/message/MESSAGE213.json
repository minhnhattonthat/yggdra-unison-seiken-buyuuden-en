{
 "file": "MESSAGE213.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE213:04F0",
   "jp": "フローネが喜びそうだな。\nこれにしよう",
   "en": ""
  },
  {
   "id": "MESSAGE213:0505",
   "jp": "趣味じゃねぇが、\nこれでいいや",
   "en": ""
  },
  {
   "id": "MESSAGE213:0517",
   "jp": "プレゼント…か",
   "en": ""
  },
  {
   "id": "MESSAGE213:051F",
   "jp": "ふふ、かわいらしい箱ね",
   "en": ""
  },
  {
   "id": "MESSAGE213:052C",
   "jp": "私には縁の無いものだな",
   "en": ""
  },
  {
   "id": "MESSAGE213:053A",
   "jp": "フン…",
   "en": ""
  },
  {
   "id": "MESSAGE213:053E",
   "jp": "横取りしちゃうみたいで\n悪いけど…ね",
   "en": ""
  },
  {
   "id": "MESSAGE213:0554",
   "jp": "プレゼント用の箱とは…\nちょっと気が引けますが……",
   "en": ""
  },
  {
   "id": "MESSAGE213:0572",
   "jp": "チッ、開けるのが\nめんどくさそうな箱だぜ",
   "en": ""
  },
  {
   "id": "MESSAGE213:0589",
   "jp": "まるで、\n孫への贈り物のようじゃな",
   "en": ""
  },
  {
   "id": "MESSAGE213:059E",
   "jp": "うまく言い表せないが…何か\n微笑ましい気持ちになるな",
   "en": ""
  },
  {
   "id": "MESSAGE213:05C0",
   "jp": "わあ~、かわいいリボン!　\nこれにしよーっと",
   "en": ""
  },
  {
   "id": "MESSAGE213:05D7",
   "jp": "フン、女々しい箱だな…",
   "en": ""
  },
  {
   "id": "MESSAGE213:05E6",
   "jp": "誰への贈り物\nだったのでしょうね…",
   "en": ""
  },
  {
   "id": "MESSAGE213:05FB",
   "jp": "この箱何でこんなにヒラヒラ\nなんだ?　…ま、いいか",
   "en": ""
  },
  {
   "id": "MESSAGE213:0617",
   "jp": "このヒラヒラした布きれが\n気になるんだ…",
   "en": ""
  },
  {
   "id": "MESSAGE213:062E",
   "jp": "ほ?　\n何じゃ、このヒラヒラは?",
   "en": ""
  },
  {
   "id": "MESSAGE213:0640",
   "jp": "こういうのを　ふあんしー\nと呼ぶのかのう?",
   "en": ""
  },
  {
   "id": "MESSAGE213:0657",
   "jp": "ボク、この箱が好き!",
   "en": ""
  },
  {
   "id": "MESSAGE213:0664",
   "jp": "こういうのって、あんまり\nガラじゃないんだけどね…",
   "en": ""
  },
  {
   "id": "MESSAGE213:067E",
   "jp": "うーん、持ち歩くのが\nちょっと恥ずかしいけど…",
   "en": ""
  },
  {
   "id": "MESSAGE213:0699",
   "jp": "オイラへのプレゼント\nだったってことで!",
   "en": ""
  },
  {
   "id": "MESSAGE213:06AE",
   "jp": "ふふ、かわいらしい…",
   "en": ""
  },
  {
   "id": "MESSAGE213:06B9",
   "jp": "…………",
   "en": ""
  },
  {
   "id": "MESSAGE213:06BE",
   "jp": "フフッ、\nかわいらしいラッピングね…",
   "en": ""
  },
  {
   "id": "MESSAGE213:06D1",
   "jp": "しかし、こんな物が\n役に立つのか?",
   "en": ""
  },
  {
   "id": "MESSAGE213:06E6",
   "jp": "フン、幼稚な箱だな…",
   "en": ""
  },
  {
   "id": "MESSAGE213:06F4",
   "jp": "…アマレウスに\nあげたいのう……",
   "en": ""
  },
  {
   "id": "MESSAGE213:0705",
   "jp": "こういうのも、\nたまにはいいわよね",
   "en": ""
  },
  {
   "id": "MESSAGE213:0717",
   "jp": "ちょっと子供っぽすぎる\n気もするけど",
   "en": ""
  },
  {
   "id": "MESSAGE213:072D",
   "jp": "パメラ様へのプレゼントが\nこんな所にあるなんて♪",
   "en": ""
  },
  {
   "id": "MESSAGE213:0748",
   "jp": "クケックケックケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE213:0753",
   "jp": "グォッ♪",
   "en": ""
  },
  {
   "id": "MESSAGE213:0758",
   "jp": "グワォッ♪",
   "en": ""
  },
  {
   "id": "MESSAGE213:075E",
   "jp": "実用性があるとは思えぬが…",
   "en": ""
  },
  {
   "id": "MESSAGE213:0770",
   "jp": "あらまあ、何て可愛らしい\n箱なのかしら~♪",
   "en": ""
  },
  {
   "id": "MESSAGE213:078A",
   "jp": "フフフ…私を馬鹿にして\nいるのですか?",
   "en": ""
  },
  {
   "id": "MESSAGE213:07A0",
   "jp": "これなんか贈り物っぽい\n感じだが…どうだろう?",
   "en": ""
  },
  {
   "id": "MESSAGE213:07BB",
   "jp": "これなんか、イケてるかもね",
   "en": ""
  }
 ]
}
