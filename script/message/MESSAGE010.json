{
 "file": "MESSAGE010.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE010:0480",
   "jp": "受けて立とう!",
   "en": ""
  },
  {
   "id": "MESSAGE010:048A",
   "jp": "ここは渡さねぇゼ!",
   "en": ""
  },
  {
   "id": "MESSAGE010:0495",
   "jp": "お互い、\n精一杯戦おうじゃないか!",
   "en": ""
  },
  {
   "id": "MESSAGE010:04AC",
   "jp": "仕方ありません。\nお受けしましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE010:04C2",
   "jp": "身の程知らずが…恥を知れ!",
   "en": ""
  },
  {
   "id": "MESSAGE010:04D5",
   "jp": "愚か者が…恥を知れ!",
   "en": ""
  },
  {
   "id": "MESSAGE010:04E4",
   "jp": "…わかったわ。\n相手してあげる!",
   "en": ""
  },
  {
   "id": "MESSAGE010:04F7",
   "jp": "どうしても仕合うと言うので\nあれば…受けて立とう!",
   "en": ""
  },
  {
   "id": "MESSAGE010:0516",
   "jp": "ククッ…\n面白くなりそうだぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE010:0528",
   "jp": "我らが誇りを賭け、\n受けて立とうぞ",
   "en": ""
  },
  {
   "id": "MESSAGE010:053F",
   "jp": "相手が誰であろうとも\nここは渡せぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE010:0556",
   "jp": "どうしてもやるの?",
   "en": ""
  },
  {
   "id": "MESSAGE010:0560",
   "jp": "我らの領土に何の用だ?\nさっさと出て行くがいい!",
   "en": ""
  },
  {
   "id": "MESSAGE010:057F",
   "jp": "残念ですが…わたくしたちも\n引き下がれないのです",
   "en": ""
  },
  {
   "id": "MESSAGE010:059B",
   "jp": "誰だろうが容赦しねぇぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE010:05AB",
   "jp": "戦いたくねえけど仕方ねえ!",
   "en": ""
  },
  {
   "id": "MESSAGE010:05BC",
   "jp": "おめえら、本気か?\nなら、仕方ねぇな!",
   "en": ""
  },
  {
   "id": "MESSAGE010:05D4",
   "jp": "誰でも相手になってやるわい",
   "en": ""
  },
  {
   "id": "MESSAGE010:05E5",
   "jp": "ふーん、あとで泣いても\n知らないから!",
   "en": ""
  },
  {
   "id": "MESSAGE010:05FB",
   "jp": "もう、仕方ないわね!",
   "en": ""
  },
  {
   "id": "MESSAGE010:0608",
   "jp": "昨日の仲間は今日の敵か…\n仕方ない、いくぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE010:0628",
   "jp": "何だよ、やんのか!?",
   "en": ""
  },
  {
   "id": "MESSAGE010:0634",
   "jp": "仕方ありません…勝負です!",
   "en": ""
  },
  {
   "id": "MESSAGE010:0646",
   "jp": "…いいだろう。\n勝負といこうか",
   "en": ""
  },
  {
   "id": "MESSAGE010:0658",
   "jp": "フフ…勇ましいわね……",
   "en": ""
  },
  {
   "id": "MESSAGE010:0665",
   "jp": "フン、面白い…\n返り討ちにしてくれる!",
   "en": ""
  },
  {
   "id": "MESSAGE010:067D",
   "jp": "神は全て見ておいでだ!",
   "en": ""
  },
  {
   "id": "MESSAGE010:068B",
   "jp": "誰じゃ!?\nわしの昼寝を邪魔するのは?",
   "en": ""
  },
  {
   "id": "MESSAGE010:06A4",
   "jp": "あんたが敵になるなんてね…\nかかってらっしゃい!",
   "en": ""
  },
  {
   "id": "MESSAGE010:06BE",
   "jp": "うふふ…誰だろうと\n相手になるわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE010:06D4",
   "jp": "マジ?　やるの?",
   "en": ""
  },
  {
   "id": "MESSAGE010:06DD",
   "jp": "ケーケケケ、ケケ?",
   "en": ""
  },
  {
   "id": "MESSAGE010:06E7",
   "jp": "グォ、グォォ!?",
   "en": ""
  },
  {
   "id": "MESSAGE010:06F0",
   "jp": "グワォ、グワォォ!?",
   "en": ""
  },
  {
   "id": "MESSAGE010:06FB",
   "jp": "愚かな…我らに勝てると\n思っているのか?",
   "en": ""
  },
  {
   "id": "MESSAGE010:0714",
   "jp": "あらまぁ、これはいったい\n何のつもりですの?",
   "en": ""
  },
  {
   "id": "MESSAGE010:072C",
   "jp": "私の実力を…\n知らないと見える",
   "en": ""
  }
 ]
}
