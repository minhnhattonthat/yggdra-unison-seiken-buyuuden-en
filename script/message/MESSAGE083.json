{
 "file": "MESSAGE083.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE083:0640",
   "jp": "すまないが、諦めてくれよ",
   "en": ""
  },
  {
   "id": "MESSAGE083:064E",
   "jp": "もうおしまいか?",
   "en": ""
  },
  {
   "id": "MESSAGE083:0657",
   "jp": "よし、倒したぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0661",
   "jp": "これ以上の戦いは\n無意味です!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0677",
   "jp": "フン、もう終わりか?",
   "en": ""
  },
  {
   "id": "MESSAGE083:0683",
   "jp": "さっきの勢いはどうした?",
   "en": ""
  },
  {
   "id": "MESSAGE083:0691",
   "jp": "貴方の負けよ",
   "en": ""
  },
  {
   "id": "MESSAGE083:069B",
   "jp": "これ以上はやめられよ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:06A9",
   "jp": "ククク…\nそれなりに楽しめたぜ",
   "en": ""
  },
  {
   "id": "MESSAGE083:06BA",
   "jp": "拙者の勝ちのようじゃの",
   "en": ""
  },
  {
   "id": "MESSAGE083:06C9",
   "jp": "信念の勝利だ",
   "en": ""
  },
  {
   "id": "MESSAGE083:06D4",
   "jp": "ここ、守るって決めたの!",
   "en": ""
  },
  {
   "id": "MESSAGE083:06E3",
   "jp": "心意気は認めてやろう",
   "en": ""
  },
  {
   "id": "MESSAGE083:06F2",
   "jp": "ここまでです",
   "en": ""
  },
  {
   "id": "MESSAGE083:06F9",
   "jp": "大人しくしやがれってんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0709",
   "jp": "俺だってやればできるぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0717",
   "jp": "どんなもんでぇ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0720",
   "jp": "ワシの勝ちじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:072A",
   "jp": "べーっだ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0730",
   "jp": "撃破したよ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0739",
   "jp": "まあ、そういうこった",
   "en": ""
  },
  {
   "id": "MESSAGE083:0744",
   "jp": "やる時はやるんだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0750",
   "jp": "任務…完了です",
   "en": ""
  },
  {
   "id": "MESSAGE083:075C",
   "jp": "任務完了",
   "en": ""
  },
  {
   "id": "MESSAGE083:0765",
   "jp": "フフ…残念だったわね……",
   "en": ""
  },
  {
   "id": "MESSAGE083:0774",
   "jp": "私に不可能など無い",
   "en": ""
  },
  {
   "id": "MESSAGE083:0782",
   "jp": "私には神がついているのだ",
   "en": ""
  },
  {
   "id": "MESSAGE083:078F",
   "jp": "全て神のご意思なんじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:079F",
   "jp": "思い知るといいわ",
   "en": ""
  },
  {
   "id": "MESSAGE083:07AA",
   "jp": "期待外れだったわね",
   "en": ""
  },
  {
   "id": "MESSAGE083:07B7",
   "jp": "力押しじゃ勝てないわよ~?",
   "en": "Brute force won't\nwin this, you know~?"
  },
  {
   "id": "MESSAGE083:07C8",
   "jp": "ケーケケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:07D0",
   "jp": "グォォォーン!",
   "en": ""
  },
  {
   "id": "MESSAGE083:07D8",
   "jp": "グワォォォーン!",
   "en": ""
  },
  {
   "id": "MESSAGE083:07E1",
   "jp": "思い上がるな!",
   "en": ""
  },
  {
   "id": "MESSAGE083:07EB",
   "jp": "主婦の本気…分かって\n頂けたかしら~?",
   "en": ""
  },
  {
   "id": "MESSAGE083:0805",
   "jp": "邪魔です",
   "en": ""
  },
  {
   "id": "MESSAGE083:080C",
   "jp": "ちょろいもんだぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0816",
   "jp": "勝負あったわね",
   "en": ""
  },
  {
   "id": "MESSAGE083:0820",
   "jp": "勝負あり!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0828",
   "jp": "どう?　まいったかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE083:0835",
   "jp": "俺様最強ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0840",
   "jp": "我ながら上出来っ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:084E",
   "jp": "思い知ったかい?",
   "en": ""
  },
  {
   "id": "MESSAGE083:0859",
   "jp": "貴方の命運もここまでね…",
   "en": ""
  },
  {
   "id": "MESSAGE083:086A",
   "jp": "全く、話にならんな",
   "en": ""
  },
  {
   "id": "MESSAGE083:0876",
   "jp": "うふふ、やったあ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0880",
   "jp": "フン、残念だったな",
   "en": ""
  },
  {
   "id": "MESSAGE083:088C",
   "jp": "ケーッケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:0896",
   "jp": "グワアァァァッ!",
   "en": ""
  },
  {
   "id": "MESSAGE083:089F",
   "jp": "勝負あったな!",
   "en": ""
  },
  {
   "id": "MESSAGE083:08A9",
   "jp": "負けたりしない!",
   "en": ""
  }
 ]
