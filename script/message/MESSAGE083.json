{
 "file": "MESSAGE083.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE083:0640",
   "jp": "すまないが、諦めてくれよ",
   "en": "Sorry, but you'll\nhave to give up."
  },
  {
   "id": "MESSAGE083:064E",
   "jp": "もうおしまいか?",
   "en": "Done already?"
  },
  {
   "id": "MESSAGE083:0657",
   "jp": "よし、倒したぞ!",
   "en": "Alright, I beat 'em!"
  },
  {
   "id": "MESSAGE083:0661",
   "jp": "これ以上の戦いは\n無意味です!",
   "en": "Further fighting is\nmeaningless!"
  },
  {
   "id": "MESSAGE083:0677",
   "jp": "フン、もう終わりか?",
   "en": "Hmph, finished\nalready?"
  },
  {
   "id": "MESSAGE083:0683",
   "jp": "さっきの勢いはどうした?",
   "en": "Where's that spirit\nfrom before?"
  },
  {
   "id": "MESSAGE083:0691",
   "jp": "貴方の負けよ",
   "en": "You lose."
  },
  {
   "id": "MESSAGE083:069B",
   "jp": "これ以上はやめられよ!",
   "en": "Stop this at once!"
  },
  {
   "id": "MESSAGE083:06A9",
   "jp": "ククク…\nそれなりに楽しめたぜ",
   "en": "Heh heh heh...\nThat was a fun one."
  },
  {
   "id": "MESSAGE083:06BA",
   "jp": "拙者の勝ちのようじゃの",
   "en": "Methinks the\nwin is mine."
  },
  {
   "id": "MESSAGE083:06C9",
   "jp": "信念の勝利だ",
   "en": "My convictions\nhave prevailed!"
  },
  {
   "id": "MESSAGE083:06D4",
   "jp": "ここ、守るって決めたの!",
   "en": "Nietzsche decided to\nprotect this place!"
  },
  {
   "id": "MESSAGE083:06E3",
   "jp": "心意気は認めてやろう",
   "en": "I shall acknowledge\nyour spirit."
  },
  {
   "id": "MESSAGE083:06F2",
   "jp": "ここまでです",
   "en": "This is the end."
  },
  {
   "id": "MESSAGE083:06F9",
   "jp": "大人しくしやがれってんだ!",
   "en": "Just settle down\nalready, dammit!"
  },
  {
   "id": "MESSAGE083:0709",
   "jp": "俺だってやればできるぞ!",
   "en": "See? I can do it\ntoo when I try!"
  },
  {
   "id": "MESSAGE083:0717",
   "jp": "どんなもんでぇ!",
   "en": "How d'ya like that!"
  },
  {
   "id": "MESSAGE083:0720",
   "jp": "ワシの勝ちじゃ!",
   "en": "The win's mine,\nsonny!"
  },
  {
   "id": "MESSAGE083:072A",
   "jp": "べーっだ!",
   "en": "Nyeeeh!"
  },
  {
   "id": "MESSAGE083:0730",
   "jp": "撃破したよ!",
   "en": "Took 'em down!"
  },
  {
   "id": "MESSAGE083:0739",
   "jp": "まあ、そういうこった",
   "en": "Well, that's how it is."
  },
  {
   "id": "MESSAGE083:0744",
   "jp": "やる時はやるんだよ!",
   "en": "When it counts, I\ndeliver!"
  },
  {
   "id": "MESSAGE083:0750",
   "jp": "任務…完了です",
   "en": "Mission...\naccomplished."
  },
  {
   "id": "MESSAGE083:075C",
   "jp": "任務完了",
   "en": "Mission complete."
  },
  {
   "id": "MESSAGE083:0765",
   "jp": "フフ…残念だったわね……",
   "en": "Fufu... Too bad..."
  },
  {
   "id": "MESSAGE083:0774",
   "jp": "私に不可能など無い",
   "en": "Nothing is\nimpossible for me."
  },
  {
   "id": "MESSAGE083:0782",
   "jp": "私には神がついているのだ",
   "en": "God is on my side."
  },
  {
   "id": "MESSAGE083:078F",
   "jp": "全て神のご意思なんじゃ!",
   "en": "It's all God's will!"
  },
  {
   "id": "MESSAGE083:079F",
   "jp": "思い知るといいわ",
   "en": "That'll teach you,\ndarling."
  },
  {
   "id": "MESSAGE083:07AA",
   "jp": "期待外れだったわね",
   "en": "What a letdown."
  },
  {
   "id": "MESSAGE083:07B7",
   "jp": "力押しじゃ勝てないわよ~?",
   "en": "Brute force won't\nwin this, you know~?"
  },
  {
   "id": "MESSAGE083:07C8",
   "jp": "ケーケケケッ!",
   "en": "Keh-kekekeh!"
  },
  {
   "id": "MESSAGE083:07D0",
   "jp": "グォォォーン!",
   "en": "Grooooan!"
  },
  {
   "id": "MESSAGE083:07D8",
   "jp": "グワォォォーン!",
   "en": "Grwaaaaagh!"
  },
  {
   "id": "MESSAGE083:07E1",
   "jp": "思い上がるな!",
   "en": "Don't flatter\nyourself!"
  },
  {
   "id": "MESSAGE083:07EB",
   "jp": "主婦の本気…分かって\n頂けたかしら~?",
   "en": "Do you understand a\nhousewife's might~?"
  },
  {
   "id": "MESSAGE083:0805",
   "jp": "邪魔です",
   "en": "You are in the way."
  },
  {
   "id": "MESSAGE083:080C",
   "jp": "ちょろいもんだぜ!",
   "en": "Piece of cake!"
  },
  {
   "id": "MESSAGE083:0816",
   "jp": "勝負あったわね",
   "en": "That settles it."
  },
  {
   "id": "MESSAGE083:0820",
   "jp": "勝負あり!",
   "en": "Match over!"
  },
  {
   "id": "MESSAGE083:0828",
   "jp": "どう?　まいったかしら?",
   "en": "Well? Have you had\nenough?"
  },
  {
   "id": "MESSAGE083:0835",
   "jp": "俺様最強ッ!",
   "en": "Nobody's stronger\nthan me!"
  },
  {
   "id": "MESSAGE083:0840",
   "jp": "我ながら上出来っ!",
   "en": "Nicely done,\nif I say so!"
  },
  {
   "id": "MESSAGE083:084E",
   "jp": "思い知ったかい?",
   "en": "Learned your lesson?"
  },
  {
   "id": "MESSAGE083:0859",
   "jp": "貴方の命運もここまでね…",
   "en": "Your luck ends here..."
  },
  {
   "id": "MESSAGE083:086A",
   "jp": "全く、話にならんな",
   "en": "Honestly, not even\nclose."
  },
  {
   "id": "MESSAGE083:0876",
   "jp": "うふふ、やったあ!",
   "en": "Ufufu, I did it!"
  },
  {
   "id": "MESSAGE083:0880",
   "jp": "フン、残念だったな",
   "en": "Hmph, too bad."
  },
  {
   "id": "MESSAGE083:088C",
   "jp": "ケーッケッケッケ!",
   "en": "Keeh-kekekeh!"
  },
  {
   "id": "MESSAGE083:0896",
   "jp": "グワアァァァッ!",
   "en": "Gwaaaagh!"
  },
  {
   "id": "MESSAGE083:089F",
   "jp": "勝負あったな!",
   "en": "That settles it!"
  },
  {
   "id": "MESSAGE083:08A9",
   "jp": "負けたりしない!",
   "en": "I won't lose!"
  }
 ]
}
