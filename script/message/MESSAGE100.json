{
 "file": "MESSAGE100.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE100:04B0",
   "jp": "やめておいた方がいいぜ?",
   "en": ""
  },
  {
   "id": "MESSAGE100:04BE",
   "jp": "これで守りきれるな!",
   "en": ""
  },
  {
   "id": "MESSAGE100:04CA",
   "jp": "ここは死守するぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:04D6",
   "jp": "一歩たりとも退くものですか",
   "en": ""
  },
  {
   "id": "MESSAGE100:04E7",
   "jp": "進ませはしない!",
   "en": ""
  },
  {
   "id": "MESSAGE100:04F1",
   "jp": "進ませてなるものか!",
   "en": ""
  },
  {
   "id": "MESSAGE100:04FD",
   "jp": "侵略者を止めるのよ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:050C",
   "jp": "ここは通さん!",
   "en": ""
  },
  {
   "id": "MESSAGE100:0515",
   "jp": "ここの通行料は貴様の命だ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:0528",
   "jp": "ここからは一歩も通さぬぞ",
   "en": ""
  },
  {
   "id": "MESSAGE100:0538",
   "jp": "皆を守るのが私の役目だ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:0549",
   "jp": "ここから出てって!",
   "en": ""
  },
  {
   "id": "MESSAGE100:0554",
   "jp": "敵の侵入を許すな!",
   "en": ""
  },
  {
   "id": "MESSAGE100:0562",
   "jp": "好き勝手はさせません",
   "en": ""
  },
  {
   "id": "MESSAGE100:0570",
   "jp": "取れるもんなら\n取ってみやがれってんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:0587",
   "jp": "ここは封鎖したぞ!\n出てけー!",
   "en": ""
  },
  {
   "id": "MESSAGE100:059A",
   "jp": "来るなら来てみやがれぃ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:05A9",
   "jp": "防御力アップじゃあ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:05B7",
   "jp": "通せんぼするよ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:05C1",
   "jp": "これで防御力アップだね!",
   "en": ""
  },
  {
   "id": "MESSAGE100:05D1",
   "jp": "守りきってみせる!",
   "en": ""
  },
  {
   "id": "MESSAGE100:05DC",
   "jp": "通れるもんなら通ってみろ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:05EC",
   "jp": "…死守してみせます!",
   "en": ""
  },
  {
   "id": "MESSAGE100:05F9",
   "jp": "フン、守りが甘いな!",
   "en": ""
  },
  {
   "id": "MESSAGE100:0606",
   "jp": "通りたい?\nフフ…無理でしょうけどね",
   "en": ""
  },
  {
   "id": "MESSAGE100:061C",
   "jp": "ここからは一歩も進ません!",
   "en": ""
  },
  {
   "id": "MESSAGE100:062D",
   "jp": "清廉なる神の使徒たちに\n聖なる守護を!",
   "en": ""
  },
  {
   "id": "MESSAGE100:0648",
   "jp": "こ、ここから入ってきては\nならんぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE100:065D",
   "jp": "ここを通すわけには\nいかないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:066F",
   "jp": "守備もぬかりなく…ね!",
   "en": ""
  },
  {
   "id": "MESSAGE100:067D",
   "jp": "柵、もーらいっ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:0687",
   "jp": "ケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:068E",
   "jp": "グォッグォッグォッ!!",
   "en": ""
  },
  {
   "id": "MESSAGE100:069A",
   "jp": "グワォッグワォッグワォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:06A8",
   "jp": "貴様らは通さん!",
   "en": ""
  },
  {
   "id": "MESSAGE100:06B4",
   "jp": "ここで食い止めますわ!",
   "en": ""
  },
  {
   "id": "MESSAGE100:06C2",
   "jp": "ここは通しませんよ?\nフフフ…",
   "en": ""
  },
  {
   "id": "MESSAGE100:06D3",
   "jp": "ここは通さない!",
   "en": ""
  },
  {
   "id": "MESSAGE100:06DD",
   "jp": "奪えるものなら\n奪ってみなさい!",
   "en": ""
  }
 ]
}
