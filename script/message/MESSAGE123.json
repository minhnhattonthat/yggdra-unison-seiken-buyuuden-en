   "en": "Now the enemy's as\ngood as helpless!"
  },
  {
   "id": "MESSAGE123:04F3",
   "jp": "我らの前に敵はいない!",
   "en": "None can stand\nbefore us!"
  },
  {
   "id": "MESSAGE123:0502",
   "jp": "おらおら、おとなしくしな!",
   "en": "C'mon, c'mon,\nsettle down!"
  },
  {
   "id": "MESSAGE123:0510",
   "jp": "拠点を制圧いたしましたぞ",
   "en": "The base is taken,\nI say!"
  },
  {
   "id": "MESSAGE123:0521",
   "jp": "我らの前に敵はいない!",
   "en": "None can stand\nbefore us!"
  },
  {
   "id": "MESSAGE123:0530",
   "jp": "ニーチェ、やる時はやるよ!",
   "en": "Nietzsche delivers\nwhen it counts!"
  },
  {
   "id": "MESSAGE123:053F",
   "jp": "うまくいったぞ!",
   "en": "Success!"
  },
  {
   "id": "MESSAGE123:0548",
   "jp": "わたくしたちの勝利です",
   "en": "The victory is ours."
  },
  {
   "id": "MESSAGE123:0556",
   "jp": "拠点は制圧したぜ!",
   "en": "Base is ours!"
  },
  {
   "id": "MESSAGE123:0564",
   "jp": "制圧したであります!",
   "en": "Base taken, sir!"
  },
  {
   "id": "MESSAGE123:0571",
   "jp": "ワシらは強いのお!",
   "en": "We're damn strong!"
  },
  {
   "id": "MESSAGE123:057C",
   "jp": "ワシのおかげじゃな!",
   "en": "All thanks\nto me, eh!"
  },
  {
   "id": "MESSAGE123:0587",
   "jp": "あなたたちの負けよ!",
   "en": "You lose!"
  },
  {
   "id": "MESSAGE123:0593",
   "jp": "エヘヘ、\nアルのおかげだよね♪",
   "en": "Ehehe,\nall thanks to Al~!"
  },
  {
   "id": "MESSAGE123:05A3",
   "jp": "拠点はおさえたぞ!",
   "en": "We've got the base!"
  },
  {
   "id": "MESSAGE123:05AF",
   "jp": "オイラもなかなかやるだろ?",
   "en": "Pretty good\nfor me, huh?"
  },
  {
   "id": "MESSAGE123:05BD",
   "jp": "制圧…しました!",
   "en": "It's... taken!"
  },
  {
   "id": "MESSAGE123:05C8",
   "jp": "観念することだ",
   "en": "Resign yourself."
  },
  {
   "id": "MESSAGE123:05D2",
   "jp": "フフ…おとなしくなさい",
   "en": "Fufu... be a good\nlittle thing now."
  },
  {
   "id": "MESSAGE123:05DE",
   "jp": "ここまでだ。諦めろ",
   "en": "It is over. Yield."
  },
  {
   "id": "MESSAGE123:05E9",
   "jp": "愚か者には神罰が下る…\nそれが条理であろう?",
   "en": "God punishes fools...\nas reason dictates."
  },
  {
   "id": "MESSAGE123:0605",
   "jp": "わ、わしには神が\nついておるからのう!",
   "en": "Wh-why, I've got\nGod on my side, heh!"
  },
  {
   "id": "MESSAGE123:0619",
   "jp": "敵地の制圧に成功したわ!",
   "en": "We've taken enemy\nground, darling!"
  },
  {
   "id": "MESSAGE123:062C",
   "jp": "あたしの策に\n抜かりは無いわ!",
   "en": "My plans never have\na single flaw!"
  },
  {
   "id": "MESSAGE123:063F",
   "jp": "パメラ様に不可能なんて\n無いのよ!",
   "en": "Nothing's impossible\nfor Pamela-sama!"
  },
  {
   "id": "MESSAGE123:0656",
   "jp": "ケーッケッケッケ!",
   "en": "Keeh-kekekeh!"
  },
  {
   "id": "MESSAGE123:0660",
   "jp": "グォーッグォーッ!",
   "en": "Groah! Groah!"
  },
  {
   "id": "MESSAGE123:066A",
   "jp": "グワォーッグワォーッ!",
   "en": "Grwaah! Grwaah!"
  },
  {
   "id": "MESSAGE123:0676",
   "jp": "この地は我らが頂いた!",
   "en": "This land is ours!"
  },
  {
   "id": "MESSAGE123:0685",
   "jp": "勝ったようですわね!",
   "en": "It seems we've won!"
  },
  {
   "id": "MESSAGE123:0691",
   "jp": "上手くいったようですね",
   "en": "That went well,\nit seems."
  }
 ]
