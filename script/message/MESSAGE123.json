 "strings": [
  {
   "id": "MESSAGE123:0480",
   "jp": "ここは制圧した。\n武器を捨ててくれ!",
   "en": "This place is taken.\nDrop your weapons!"
  },
  {
   "id": "MESSAGE123:0498",
   "jp": "これで勝ったようなもんだゼ",
   "en": "We as good as won,\ny'know!"
  },
  {
   "id": "MESSAGE123:04A7",
   "jp": "敵地を制圧しました!",
   "en": "Enemy land secured!"
  },
  {
   "id": "MESSAGE123:04B6",
   "jp": "拠点の制圧に成功しました!",
   "en": "We have taken\nthe base!"
  },
  {
   "id": "MESSAGE123:04CA",
   "jp": "作戦は成功だ!",
   "en": "The operation\nsucceeded!"
  },
  {
   "id": "MESSAGE123:04D6",
   "jp": "作戦は成功だ!",
   "en": "The operation\nsucceeded!"
  },
  {
