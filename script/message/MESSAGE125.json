 "strings": [
  {
   "id": "MESSAGE125:0480",
   "jp": "よし、拠点制圧だ",
   "en": "Good, base secured."
  },
  {
   "id": "MESSAGE125:048D",
   "jp": "拠点、占領したゼ!",
   "en": "Got the base, y'know!"
  },
  {
   "id": "MESSAGE125:049B",
   "jp": "敵地制圧です",
   "en": "Enemy ground taken."
  },
  {
   "id": "MESSAGE125:04A6",
   "jp": "これで敵軍は無力同然です",
   "en": "Now the enemy is\nall but powerless."
  },
  {
   "id": "MESSAGE125:04B9",
   "jp": "よし、制圧したぞ!",
   "en": "Good, it's taken!"
  },
  {
   "id": "MESSAGE125:04C5",
   "jp": "よし、やったぞ!",
   "en": "Good, we did it!"
  },
  {
   "id": "MESSAGE125:04CE",
   "jp": "たどり着いたわ!",
   "en": "We made it!"
  },
  {
   "id": "MESSAGE125:04D8",
   "jp": "この戦い、制しました",
   "en": "This battle is won."
  },
  {
   "id": "MESSAGE125:04E5",
   "jp": "おとなしく明け渡して\nもらうぜ!",
   "en": "Hand it over nice\nand quiet!"
  },
  {
   "id": "MESSAGE125:04F8",
   "jp": "占領いたしましたぞ",
   "en": "The land is ours,\nI say!"
  },
  {
   "id": "MESSAGE125:0504",
   "jp": "拠点を占領!",
   "en": "Base taken!"
  },
  {
   "id": "MESSAGE125:050F",
   "jp": "次も、この調子ね!",
   "en": "Let's keep it up\nnext time too!"
  },
  {
   "id": "MESSAGE125:051C",
   "jp": "拠点は制圧した",
   "en": "The base is secured."
  },
  {
   "id": "MESSAGE125:0528",
   "jp": "勝ちましたね",
   "en": "We have won."
  },
  {
   "id": "MESSAGE125:0530",
   "jp": "これでどうだ!",
   "en": "How d'ya like that!"
  },
  {
   "id": "MESSAGE125:0538",
   "jp": "制圧完了ですっ!",
   "en": "Base secured, sir!"
  },
  {
   "id": "MESSAGE125:0545",
   "jp": "さて、お宝でも漁るか",
   "en": "Now, let's dig up\nsome loot."
  },
  {
   "id": "MESSAGE125:0552",
   "jp": "金目のものでも探すかのう",
   "en": "Let's hunt for some\nvaluables, eh?"
  },
  {
   "id": "MESSAGE125:0562",
   "jp": "逆らわない方が身のためよ!",
   "en": "Don't resist, if you\nknow what's good!"
  },
  {
   "id": "MESSAGE125:0573",
   "jp": "勝ったみたいだね!",
   "en": "Looks like we won!"
  },
  {
   "id": "MESSAGE125:057E",
   "jp": "これで終わりだな!",
   "en": "That's the end of it!"
  },
  {
   "id": "MESSAGE125:0589",
   "jp": "よっしゃ、制圧したぜ!",
   "en": "Alright, took it!"
  },
  {
   "id": "MESSAGE125:0597",
   "jp": "制圧…しました",
   "en": "It is... taken."
  },
  {
   "id": "MESSAGE125:05A1",
   "jp": "これで終わりだ",
   "en": "This ends it."
  },
  {
   "id": "MESSAGE125:05AA",
   "jp": "抵抗するのはおやめなさい",
   "en": "Stop resisting, dear."
  },
  {
   "id": "MESSAGE125:05B9",
   "jp": "ここまでだ",
   "en": "This is the end."
  },
  {
   "id": "MESSAGE125:05BF",
   "jp": "我々には神がついているのだ",
   "en": "God is on our side."
  },
  {
   "id": "MESSAGE125:05CF",
   "jp": "ど、どうやら勝ったようじゃ",
   "en": "W-well, it seems\nwe won, heh."
  },
  {
   "id": "MESSAGE125:05DE",
   "jp": "勝負あったわね",
   "en": "That settles it."
  },
  {
   "id": "MESSAGE125:05E8",
   "jp": "こういうスリルも燃えるわ~",
   "en": "This kind of thrill\nfires me up~"
  },
  {
   "id": "MESSAGE125:05F7",
   "jp": "パメラ様、最強♪",
   "en": "Pamela-sama is the\nstrongest~!"
  },
  {
   "id": "MESSAGE125:0603",
   "jp": "ケーッケッケッケ!",
   "en": "Keeh-kekekeh!"
  },
  {
   "id": "MESSAGE125:060D",
   "jp": "グォーッグォーッ!",
   "en": "Groah! Groah!"
  },
  {
   "id": "MESSAGE125:0617",
   "jp": "グワォーッグワォーッ!",
   "en": "Grwaah! Grwaah!"
  },
  {
   "id": "MESSAGE125:0623",
   "jp": "これで終わりだ!",
   "en": "This is the end!"
  },
  {
   "id": "MESSAGE125:062D",
   "jp": "上手くいきましたわね!",
   "en": "That went\nnicely, dear!"
  },
  {
   "id": "MESSAGE125:063B",
   "jp": "勝負はつきました",
   "en": "The outcome is\ndecided."
  }
 ]
