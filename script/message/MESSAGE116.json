 "strings": [
  {
   "id": "MESSAGE116:0480",
   "jp": "君には期待していたんだが…\n残念だよ",
   "en": ""
  },
  {
   "id": "MESSAGE116:0498",
   "jp": "バカが!\n身の程を知りやがれ!",
   "en": ""
  },
  {
   "id": "MESSAGE116:04AB",
   "jp": "皇帝陛下…貴方の負けです",
   "en": ""
  },
  {
   "id": "MESSAGE116:04BE",
   "jp": "ここまでです",
   "en": ""
  },
  {
   "id": "MESSAGE116:04C5",
   "jp": "勝負ありましたね…陛下",
   "en": ""
  },
  {
   "id": "MESSAGE116:04D4",
   "jp": "陛下の負け…です",
   "en": ""
  },
  {
   "id": "MESSAGE116:04DF",
   "jp": "うそ…\nもしかして、勝ったの!?",
   "en": ""
  },
  {
   "id": "MESSAGE116:04F1",
   "jp": "己の行いを悔い改めよ!",
   "en": ""
  },
  {
   "id": "MESSAGE116:0500",
   "jp": "追いつめたぜ、エレナ!",
   "en": ""
  },
  {
   "id": "MESSAGE116:050D",
   "jp": "強敵であった",
   "en": ""
  },
  {
   "id": "MESSAGE116:0516",
   "jp": "口ほどにも無いな!",
   "en": ""
  },
  {
   "id": "MESSAGE116:0522",
   "jp": "これでよかったのかな…?",
   "en": ""
  },
  {
   "id": "MESSAGE116:052F",
   "jp": "気合が足りんぞ?",
   "en": ""
  },
  {
   "id": "MESSAGE116:053B",
   "jp": "よく頑張りました…",
   "en": ""
  },
  {
   "id": "MESSAGE116:0547",
   "jp": "詰めが甘いぜ、キリエ!",
   "en": ""
  },
  {
   "id": "MESSAGE116:0555",
   "jp": "姐さん、すまねえ!",
   "en": ""
  },
  {
   "id": "MESSAGE116:0560",
   "jp": "だからおめぇは\n出世できねぇんだぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE116:0576",
   "jp": "賞金はワシらのものじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE116:0585",
   "jp": "王女のくせに\nたいしたことないのね!",
   "en": ""
  },
  {
   "id": "MESSAGE116:059A",
   "jp": "王女様、悪く思わないでね!",
   "en": ""
  },
  {
   "id": "MESSAGE116:05AD",
   "jp": "手強い相手だったな",
   "en": ""
  },
  {
   "id": "MESSAGE116:05BB",
   "jp": "その髪の色、どっかで\n見たことあるんだよな…",
   "en": ""
  },
  {
   "id": "MESSAGE116:05D5",
   "jp": "ジルヴァ様…\n申し訳ありません",
   "en": ""
  },
  {
   "id": "MESSAGE116:05E8",
   "jp": "抵抗なさらないでください、\n皇帝陛下",
   "en": ""
  },
  {
   "id": "MESSAGE116:0600",
   "jp": "ユベロン様…お許しを……",
   "en": ""
  },
  {
   "id": "MESSAGE116:060F",
   "jp": "創造者にたてつこうなど\n考えぬことだ",
   "en": ""
  },
  {
   "id": "MESSAGE116:0626",
   "jp": "無様だな?　若造よ",
   "en": ""
  },
  {
   "id": "MESSAGE116:0634",
   "jp": "おお…か、神よ!",
   "en": ""
  },
  {
   "id": "MESSAGE116:063D",
   "jp": "主人に勝てると思ったの?",
   "en": ""
  },
  {
   "id": "MESSAGE116:064E",
   "jp": "貴方には策が足りないわね",
   "en": ""
  },
  {
   "id": "MESSAGE116:065F",
   "jp": "この時を待ってたわ~!",
   "en": ""
  },
  {
   "id": "MESSAGE116:066D",
