{
 "file": "MESSAGE051.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE051:04C0",
   "jp": "男の意地ってやつかな?",
   "en": "Call it a man's\npride?"
  },
  {
   "id": "MESSAGE051:04CF",
   "jp": "へっ、たいしたことねぇな!",
   "en": "Heh, that was\nnothin'!"
  },
  {
   "id": "MESSAGE051:04DD",
   "jp": "やりました!",
   "en": "Got 'em!"
  },
  {
   "id": "MESSAGE051:04E4",
   "jp": "やったわ!",
   "en": "I did it!"
  },
  {
   "id": "MESSAGE051:04EA",
   "jp": "我らの敵では無いな",
   "en": "No match for us."
  },
  {
   "id": "MESSAGE051:04F7",
   "jp": "我らに勝てると思ったか?",
   "en": "Thought you could\ndefeat us?"
  },
  {
   "id": "MESSAGE051:0507",
   "jp": "志は曲げられないの!",
   "en": "I won't bend my\nconvictions!"
  },
  {
   "id": "MESSAGE051:0514",
   "jp": "このまま進撃しましょう!",
   "en": "Let us press the\nattack!"
  },
  {
   "id": "MESSAGE051:0523",
   "jp": "邪魔なんだよ、虫けらども!",
   "en": "Outta my way,\nya maggots!"
  },
  {
   "id": "MESSAGE051:0534",
   "jp": "敵、撃破。\nこのまま進撃いたそう",
   "en": "Foe vanquished.\nLet us press onward."
  },
  {
   "id": "MESSAGE051:054A",
   "jp": "我が信念には勝てんぞ",
   "en": "None can overcome\nmy faith!"
  },
  {
   "id": "MESSAGE051:0559",
   "jp": "じゃーん!　やったよ!",
   "en": "Ta-daaa! Nietzsche\ndid it!"
  },
  {
   "id": "MESSAGE051:0565",
   "jp": "このまま蹴散らして前進だ!",
   "en": "Scatter them and\nadvance!"
  },
  {
   "id": "MESSAGE051:0577",
   "jp": "このまま突破しましょう",
   "en": "Let us break through."
  },
  {
   "id": "MESSAGE051:0585",
   "jp": "相手にならねーな!",
   "en": "Not even a\nchallenge!"
  },
  {
   "id": "MESSAGE051:0591",
   "jp": "今の見てくれやしたか?",
   "en": "Didja see that?!"
  },
  {
   "id": "MESSAGE051:059F",
   "jp": "おーおー、この程度か?",
   "en": "Ooh-hoo, that all ya\ngot?"
  },
  {
   "id": "MESSAGE051:05AD",
   "jp": "ガハハハ!　消えろい!",
   "en": "Gwahahaha! Scram!"
  },
  {
   "id": "MESSAGE051:05BA",
   "jp": "うーん、いい感じ!",
   "en": "Mmm, feeling good!"
  },
  {
   "id": "MESSAGE051:05C5",
   "jp": "はい、終ーわりっ!",
   "en": "Aaand done!"
  },
  {
   "id": "MESSAGE051:05D0",
   "jp": "革命の時は近づいている!",
   "en": "The revolution draws\nnear!"
  },
  {
   "id": "MESSAGE051:05E1",
   "jp": "オイラに任せろ!",
   "en": "Leave it to me!"
  },
  {
   "id": "MESSAGE051:05EB",
   "jp": "撃破しました…",
   "en": "I have defeated\nthem..."
  },
  {
   "id": "MESSAGE051:05F5",
   "jp": "このまま道を切り開くぞ!",
   "en": "We'll carve a path\nthrough!"
  },
  {
   "id": "MESSAGE051:0605",
   "jp": "痛い目に遣いたいようね?",
   "en": "Looks like you want\nto get hurt."
  },
  {
   "id": "MESSAGE051:0615",
   "jp": "邪魔をするなら敵とみなす",
   "en": "Stand in my way and\nyou are my enemy."
  },
  {
   "id": "MESSAGE051:0625",
   "jp": "貴様らの行き先は地獄だ!",
   "en": "You're all bound for\nHell!"
  },
  {
   "id": "MESSAGE051:0637",
   "jp": "じゃ、邪魔をするでない!",
   "en": "D-don't block this\nold man's way!"
  },
  {
   "id": "MESSAGE051:0646",
   "jp": "ま、当然よね!",
   "en": "Well, naturally!"
  },
  {
   "id": "MESSAGE051:0650",
   "jp": "どきなさい!",
   "en": "Step aside!"
  },
  {
   "id": "MESSAGE051:0657",
   "jp": "ザコやっつけた~♪",
   "en": "Beat the small fry~!"
  },
  {
   "id": "MESSAGE051:0661",
   "jp": "ケケーッ!",
   "en": "Kekeeeh!"
  },
  {
   "id": "MESSAGE051:0667",
   "jp": "グォーーーッ!",
   "en": "Grooooh!"
  },
  {
   "id": "MESSAGE051:066F",
   "jp": "グワォーーーッ!",
   "en": "Grwaooooh!"
  },
  {
   "id": "MESSAGE051:0678",
   "jp": "馬鹿めが!",
   "en": "Fool!"
  },
  {
   "id": "MESSAGE051:0680",
   "jp": "この身を盾に戦いますわ!",
   "en": "I'll shield them with\nmy own body!"
  },
  {
   "id": "MESSAGE051:0690",
   "jp": "思い知りましたか?\nフフフ…",
   "en": "Have you learned\nyour place? Heh heh..."
  }
 ]
}
