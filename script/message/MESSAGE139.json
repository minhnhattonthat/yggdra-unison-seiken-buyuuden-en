{
 "file": "MESSAGE139.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE139:0480",
   "jp": "どうやら、断れる空気では\n無いみたいだな…",
   "en": ""
  },
  {
   "id": "MESSAGE139:049A",
   "jp": "わ、分かった。協力するゼ",
   "en": ""
  },
  {
   "id": "MESSAGE139:04AA",
   "jp": "こんな俺でも\n力になれるなら…",
   "en": ""
  },
  {
   "id": "MESSAGE139:04BC",
   "jp": "…分かりました\nこんな私でよろしければ",
   "en": ""
  },
  {
   "id": "MESSAGE139:04D1",
   "jp": "フン…\nお前の頼みなら仕方ない……",
   "en": ""
  },
  {
   "id": "MESSAGE139:04E7",
   "jp": "フン…\nお前がそこまで言うのなら…",
   "en": ""
  },
  {
   "id": "MESSAGE139:04FB",
   "jp": "しょうがないわね…\nお供するわ",
   "en": ""
  },
  {
   "id": "MESSAGE139:050C",
   "jp": "…分かりました。\n協力しましょう",
   "en": ""
  },
  {
   "id": "MESSAGE139:0520",
   "jp": "フン…\n俺様の力が必要らしいな",
   "en": ""
  },
  {
   "id": "MESSAGE139:0535",
   "jp": "…分かり申した。\nでは、協力いたそう",
   "en": ""
  },
  {
   "id": "MESSAGE139:054C",
   "jp": "貴殿の思想には共感する…\n協力致しましょう",
   "en": ""
  },
  {
   "id": "MESSAGE139:056B",
   "jp": "じゃあ…ニーチェ協力する",
   "en": ""
  },
  {
   "id": "MESSAGE139:057A",
   "jp": "…分かった。\n私の力を貸してやろう",
   "en": ""
  },
  {
   "id": "MESSAGE139:058F",
   "jp": "…そこまでいうのであれば\n協力しましょう",
   "en": ""
  },
  {
   "id": "MESSAGE139:05A6",
   "jp": "お前の頼みなら仕方ねえ…\nついていってやるぜ",
   "en": ""
  },
  {
   "id": "MESSAGE139:05C1",
   "jp": "分かった。お供するぜ",
   "en": ""
  },
  {
   "id": "MESSAGE139:05CE",
   "jp": "分かった分かった。\nおめぇの下につこう",
   "en": ""
  },
  {
   "id": "MESSAGE139:05E4",
   "jp": "ワシも一度組んでみたいと\n思っておったのじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE139:0600",
   "jp": "しょうがないわね…\n仲良くしてあげる",
   "en": ""
  },
  {
   "id": "MESSAGE139:0615",
   "jp": "…仕方ないね。\nウチ、協力するよ",
   "en": ""
  },
  {
   "id": "MESSAGE139:062A",
   "jp": "これも何かの縁なのかもな…\nよろしく頼むよ",
   "en": ""
  },
  {
   "id": "MESSAGE139:0643",
   "jp": "そこまで言うなら…\nついてってやるよ",
   "en": ""
  },
  {
   "id": "MESSAGE139:0657",
   "jp": "分かりました…",
   "en": ""
  },
  {
   "id": "MESSAGE139:0660",
   "jp": "…承知した",
   "en": ""
  },
  {
   "id": "MESSAGE139:0668",
   "jp": "フフ…かまわないわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE139:0674",
   "jp": "仕方あるまい…\n了承した",
   "en": ""
  },
  {
   "id": "MESSAGE139:0685",
   "jp": "では、私が神の教えを\n紐解いて差し上げましょう",
   "en": ""
  },
  {
   "id": "MESSAGE139:06A2",
   "jp": "た、助かった…\n力になりますぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE139:06B5",
   "jp": "あんたの頼みなら\n聞いてあげてもいいわ…",
   "en": ""
  },
  {
   "id": "MESSAGE139:06CC",
   "jp": "まあ、いいわ…\n特別に協力してあげる",
   "en": ""
  },
  {
   "id": "MESSAGE139:06E3",
   "jp": "わぁお!　らっきー♪",
   "en": ""
  },
  {
   "id": "MESSAGE139:06EE",
   "jp": "ケーケケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE139:06F6",
   "jp": "グォォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE139:06FC",
   "jp": "グワォォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE139:0703",
   "jp": "…負けは負けだ。\n手を貸そう",
   "en": ""
  },
  {
   "id": "MESSAGE139:0716",
   "jp": "再びお役に立てるのなら…",
   "en": ""
  },
  {
   "id": "MESSAGE139:0726",
   "jp": "選択の余地は\n無さそうですね…",
   "en": ""
  }
 ]
}
