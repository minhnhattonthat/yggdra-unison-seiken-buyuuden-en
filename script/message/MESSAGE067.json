{
 "file": "MESSAGE067.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE067:04F0",
   "jp": "残念だよ…",
   "en": ""
  },
  {
   "id": "MESSAGE067:04F8",
   "jp": "何かスッキリしねぇが…",
   "en": ""
  },
  {
   "id": "MESSAGE067:0505",
   "jp": "これは戦い…仕方ないんだ",
   "en": ""
  },
  {
   "id": "MESSAGE067:0515",
   "jp": "あとには退けないんです",
   "en": ""
  },
  {
   "id": "MESSAGE067:0522",
   "jp": "まあまあの手応えだな",
   "en": ""
  },
  {
   "id": "MESSAGE067:052F",
   "jp": "手強かった…と言っておこう",
   "en": ""
  },
  {
   "id": "MESSAGE067:0540",
   "jp": "残念だけど、ここまでよ",
   "en": ""
  },
  {
   "id": "MESSAGE067:054E",
   "jp": "どうか恨まないで頂きたい",
   "en": ""
  },
  {
   "id": "MESSAGE067:055D",
   "jp": "ざまぁねぇな!",
   "en": ""
  },
  {
   "id": "MESSAGE067:0565",
   "jp": "これも戦の習いじゃ…",
   "en": ""
  },
  {
   "id": "MESSAGE067:0572",
   "jp": "神の導きがあらんことを…",
   "en": ""
  },
  {
   "id": "MESSAGE067:0580",
   "jp": "ニーチェ、頑張ったよ",
   "en": ""
  },
  {
   "id": "MESSAGE067:058D",
   "jp": "気の毒だが、仕方あるまい…",
   "en": ""
  },
  {
   "id": "MESSAGE067:059F",
   "jp": "無益な血を…\n流してしまった……",
   "en": ""
  },
  {
   "id": "MESSAGE067:05B4",
   "jp": "ちょっとやりすぎたか?",
   "en": ""
  },
  {
   "id": "MESSAGE067:05C0",
   "jp": "戦いに情けは無用なんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE067:05D1",
   "jp": "短い縁だったのぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE067:05DD",
   "jp": "ガハハハ!\n悪く思うなよ!",
   "en": ""
  },
  {
   "id": "MESSAGE067:05ED",
   "jp": "謝ったりしないんだから!",
   "en": ""
  },
  {
   "id": "MESSAGE067:05FB",
   "jp": "仕方なかったのよ",
   "en": ""
  },
  {
   "id": "MESSAGE067:0606",
   "jp": "革命には痛みがつきものだ…",
   "en": ""
  },
  {
   "id": "MESSAGE067:0617",
   "jp": "悪く思うなよな!",
   "en": ""
  },
  {
   "id": "MESSAGE067:0622",
   "jp": "討ち取り…ました……",
   "en": ""
  },
  {
   "id": "MESSAGE067:062F",
   "jp": "安らかに眠れ…",
   "en": ""
  },
  {
   "id": "MESSAGE067:0639",
   "jp": "安らかにお眠りなさい",
   "en": ""
  },
  {
   "id": "MESSAGE067:0646",
   "jp": "誰であろうと容赦はしない",
   "en": ""
  },
  {
   "id": "MESSAGE067:0656",
   "jp": "これも全て神のご意思だ!",
   "en": ""
  },
  {
   "id": "MESSAGE067:0666",
   "jp": "う、恨みっこ無しだぞ?",
   "en": ""
  },
  {
   "id": "MESSAGE067:0674",
   "jp": "恨まないで頂戴ね",
   "en": ""
  },
  {
   "id": "MESSAGE067:0680",
   "jp": "悪く思わないで欲しいわね",
   "en": ""
  },
  {
   "id": "MESSAGE067:0690",
   "jp": "ね、パメラ様を怒らせたら\n怖いでしょ?",
   "en": ""
  },
  {
   "id": "MESSAGE067:06A7",
   "jp": "ケケ、クケーケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE067:06B2",
   "jp": "グォォォォーグォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE067:06BD",
   "jp": "グワォォォォーグワォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE067:06CA",
   "jp": "馬鹿なことを…",
   "en": ""
  },
  {
   "id": "MESSAGE067:06D4",
   "jp": "ごめんなさいね~\n悪く思わないでくださいね~",
   "en": ""
  },
  {
   "id": "MESSAGE067:06ED",
   "jp": "貴方の役目はここまでです",
   "en": ""
  },
  {
   "id": "MESSAGE067:06FE",
   "jp": "恨みっこなしだ",
   "en": ""
  },
  {
   "id": "MESSAGE067:0707",
   "jp": "これが戦争なの",
   "en": ""
  }
 ]
}
