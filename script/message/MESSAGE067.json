{
 "file": "MESSAGE067.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE067:04F0",
   "jp": "残念だよ…",
   "en": "It's a shame..."
  },
  {
   "id": "MESSAGE067:04F8",
   "jp": "何かスッキリしねぇが…",
   "en": "Somethin' don't sit\nright, but..."
  },
  {
   "id": "MESSAGE067:0505",
   "jp": "これは戦い…仕方ないんだ",
   "en": "This is war... it\ncan't be helped."
  },
  {
   "id": "MESSAGE067:0515",
   "jp": "あとには退けないんです",
   "en": "I cannot turn\nback now."
  },
  {
   "id": "MESSAGE067:0522",
   "jp": "まあまあの手応えだな",
   "en": "Not a bad fight."
  },
  {
   "id": "MESSAGE067:052F",
   "jp": "手強かった…と言っておこう",
   "en": "Tough... I'll\ngrant you that."
  },
  {
   "id": "MESSAGE067:0540",
   "jp": "残念だけど、ここまでよ",
   "en": "Sorry, but this is\nas far as you go."
  },
  {
   "id": "MESSAGE067:054E",
   "jp": "どうか恨まないで頂きたい",
   "en": "I ask that you bear\nme no ill will."
  },
  {
   "id": "MESSAGE067:055D",
   "jp": "ざまぁねぇな!",
   "en": "Pathetic, ain't it!"
  },
  {
   "id": "MESSAGE067:0565",
   "jp": "これも戦の習いじゃ…",
   "en": "Such is the way\nof war..."
  },
  {
   "id": "MESSAGE067:0572",
   "jp": "神の導きがあらんことを…",
   "en": "May God guide you..."
  },
  {
   "id": "MESSAGE067:0580",
   "jp": "ニーチェ、頑張ったよ",
   "en": "Nietzsche did\nher best!"
  },
  {
   "id": "MESSAGE067:058D",
   "jp": "気の毒だが、仕方あるまい…",
   "en": "A pity, but it\ncannot be helped..."
  },
  {
   "id": "MESSAGE067:059F",
   "jp": "無益な血を…\n流してしまった……",
   "en": "I have shed...\nneedless blood..."
  },
  {
   "id": "MESSAGE067:05B4",
   "jp": "ちょっとやりすぎたか?",
   "en": "Guess I went a\nlittle overboard?"
  },
  {
   "id": "MESSAGE067:05C0",
   "jp": "戦いに情けは無用なんだ!",
   "en": "No mercy in a\nfight, see!"
  },
  {
   "id": "MESSAGE067:05D1",
   "jp": "短い縁だったのぉ!",
   "en": "Too bad we only\njust met, eh!"
  },
  {
   "id": "MESSAGE067:05DD",
   "jp": "ガハハハ!\n悪く思うなよ!",
   "en": ""
  },
  {
   "id": "MESSAGE067:05ED",
   "jp": "謝ったりしないんだから!",
   "en": "I'm not apologizing,\nso there!"
  },
  {
   "id": "MESSAGE067:05FB",
   "jp": "仕方なかったのよ",
   "en": "It couldn't be\nhelped!"
  },
  {
   "id": "MESSAGE067:0606",
   "jp": "革命には痛みがつきものだ…",
   "en": "Revolutions always\ncome with pain..."
  },
  {
   "id": "MESSAGE067:0617",
   "jp": "悪く思うなよな!",
   "en": ""
  },
  {
   "id": "MESSAGE067:0622",
   "jp": "討ち取り…ました……",
   "en": "Target...\neliminated..."
  },
  {
   "id": "MESSAGE067:062F",
   "jp": "安らかに眠れ…",
   "en": "Sleep peacefully..."
  },
  {
   "id": "MESSAGE067:0639",
   "jp": "安らかにお眠りなさい",
   "en": "Sleep peacefully,\ndarling."
  },
  {
   "id": "MESSAGE067:0646",
   "jp": "誰であろうと容赦はしない",
   "en": "I show no mercy,\nwhoever you are."
  },
  {
   "id": "MESSAGE067:0656",
   "jp": "これも全て神のご意思だ!",
   "en": "All this is God's\nwill!"
  },
  {
   "id": "MESSAGE067:0666",
   "jp": "う、恨みっこ無しだぞ?",
   "en": "N-no hard feelin's,\neh?"
  },
  {
   "id": "MESSAGE067:0674",
   "jp": "恨まないで頂戴ね",
   "en": "Do bear no grudge,\ndarling."
  },
  {
   "id": "MESSAGE067:0680",
   "jp": "悪く思わないで欲しいわね",
   "en": "I'd rather you didn't\ntake it personally."
  },
  {
   "id": "MESSAGE067:0690",
   "jp": "ね、パメラ様を怒らせたら\n怖いでしょ?",
   "en": "See? Pamela-sama's\nscary when mad!"
  },
  {
   "id": "MESSAGE067:06A7",
   "jp": "ケケ、クケーケケッ!",
   "en": "Keke, Kukeeekekeh!"
  },
  {
   "id": "MESSAGE067:06B2",
   "jp": "グォォォォーグォッ!",
   "en": "Grooooo- Groh!"
  },
  {
   "id": "MESSAGE067:06BD",
   "jp": "グワォォォォーグワォッ!",
   "en": "Grwaaaaa- Grwaoh!"
  },
  {
   "id": "MESSAGE067:06CA",
   "jp": "馬鹿なことを…",
   "en": "Foolishness..."
  },
  {
   "id": "MESSAGE067:06D4",
   "jp": "ごめんなさいね~\n悪く思わないでくださいね~",
   "en": "So sorry, dear~\nNo hard feelings~"
  },
  {
   "id": "MESSAGE067:06ED",
   "jp": "貴方の役目はここまでです",
   "en": "Your role ends here."
  },
  {
   "id": "MESSAGE067:06FE",
   "jp": "恨みっこなしだ",
   "en": "No grudges."
  },
  {
   "id": "MESSAGE067:0707",
   "jp": "これが戦争なの",
   "en": "This is war."
  }
 ]
}
