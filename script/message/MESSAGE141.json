{
 "file": "MESSAGE141.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE141:0480",
   "jp": "申し出はありがたいが…\n望まぬ戦いはこりごりなんだ",
   "en": ""
  },
  {
   "id": "MESSAGE141:049E",
   "jp": "お前らの下で働く気はねぇ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:04AF",
   "jp": "誰がお前になんか従うか!",
   "en": ""
  },
  {
   "id": "MESSAGE141:04BF",
   "jp": "私が協力するとでも\n思っているのですか?",
   "en": ""
  },
  {
   "id": "MESSAGE141:04D7",
   "jp": "冗談も休み休み言え!",
   "en": ""
  },
  {
   "id": "MESSAGE141:04E7",
   "jp": "貴様に使われるくらいなら\n命を絶つ方がマシだ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0505",
   "jp": "絶ッ対にイヤッ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0510",
   "jp": "捕虜になる気などない!",
   "en": ""
  },
  {
   "id": "MESSAGE141:051F",
   "jp": "100年早えんだよ、\nクズが!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0531",
   "jp": "軍門に下る気など無い",
   "en": ""
  },
  {
   "id": "MESSAGE141:0540",
   "jp": "神は見ておいでだ!\n与することなどできぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0558",
   "jp": "絶対イヤー!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0561",
   "jp": "断る!\nお前たちには従わぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0573",
   "jp": "わたくしにも\n譲れないものがあるのです",
   "en": ""
  },
  {
   "id": "MESSAGE141:0588",
   "jp": "寝ぼけたこと\n言ってんじゃねーよ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:059C",
   "jp": "誰がお前と一緒になんて\n戦うかよ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:05B3",
   "jp": "ムチャ言うな。おめぇらと\n組めるワケはねぇ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:05CC",
   "jp": "おめーらじゃワシを\n使いこなせんぞい",
   "en": ""
  },
  {
   "id": "MESSAGE141:05E0",
   "jp": "やだ!\n誰があなたなんかと!",
   "en": ""
  },
  {
   "id": "MESSAGE141:05F0",
   "jp": "アンタらの仲間になるなら\n死んだ方がマシだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:060C",
   "jp": "やなこった!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0613",
   "jp": "オイラにだって\n譲れないモノがあるんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0629",
   "jp": "お断りします…!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0633",
   "jp": "貴様に従う気など無い!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0644",
   "jp": "私の血の一滴に至るまで\n全てユベロン様のもの…",
   "en": ""
  },
  {
   "id": "MESSAGE141:0662",
   "jp": "寝言は寝てから言え…!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0672",
   "jp": "異端者とは組めぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0680",
   "jp": "い、嫌じゃ!\n戦いはもう嫌じゃあ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:0695",
   "jp": "ハァ?\nバカ言ってんじゃないわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:06A8",
   "jp": "私を使おうなんて\n一万年早いわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE141:06BF",
   "jp": "ぶっぶー!　お断りよ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:06CC",
   "jp": "ケッ、ペッペッ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:06D5",
   "jp": "グォォァァァ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:06DD",
   "jp": "グォォァァァ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:06E5",
   "jp": "この程度で思い上がるなッ!",
   "en": ""
  },
  {
   "id": "MESSAGE141:06F7",
   "jp": "お断りしますわ",
   "en": ""
  },
  {
   "id": "MESSAGE141:0700",
   "jp": "そうですね。フフフ…\nそれが賢明というものです",
   "en": ""
  }
 ]
}
