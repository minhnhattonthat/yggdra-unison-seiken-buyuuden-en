{
 "file": "MESSAGE168.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE168:04B0",
   "jp": "…マジ?",
   "en": ""
  },
  {
   "id": "MESSAGE168:04B5",
   "jp": "おっ?　こりゃ、出世街道\nまっしぐらってやつか?",
   "en": ""
  },
  {
   "id": "MESSAGE168:04D2",
   "jp": "皇帝陛下!　天下統一\nおめでとうございます!",
   "en": ""
  },
  {
   "id": "MESSAGE168:04EF",
   "jp": "やっと、平和が訪れるのね…",
   "en": ""
  },
  {
   "id": "MESSAGE168:0500",
   "jp": "更なる帝国の繁栄のため\n私も尽力いたします!",
   "en": ""
  },
  {
   "id": "MESSAGE168:051E",
   "jp": "全土統一、心よりお祝い\n申し上げます!",
   "en": ""
  },
  {
   "id": "MESSAGE168:053A",
   "jp": "ほんと!?\nやっと念願が叶ったのね!",
   "en": ""
  },
  {
   "id": "MESSAGE168:0550",
   "jp": "王国騎士として\n至福の極みに存じます!",
   "en": ""
  },
  {
   "id": "MESSAGE168:056C",
   "jp": "クックック…こりゃあいい。\n早速祝い酒にするか!",
   "en": ""
  },
  {
   "id": "MESSAGE168:0589",
   "jp": "陛下のお役に立てたのならば\n拙者、光栄にございます",
   "en": ""
  },
  {
   "id": "MESSAGE168:05AA",
   "jp": "思えば長い道のりだったな",
   "en": ""
  },
  {
   "id": "MESSAGE168:05BA",
   "jp": "女王様、おめでと~っ!!\nニーチェも嬉しいよ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:05D6",
   "jp": "親衛隊長イシーヌ、\nここに使命を全うしました!",
   "en": ""
  },
  {
   "id": "MESSAGE168:05F5",
   "jp": "皆には苦労をかけましたね",
   "en": ""
  },
  {
   "id": "MESSAGE168:0605",
   "jp": "最後に笑うのはオレだ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:0614",
   "jp": "さっすがですぜ親分!\nずっとついていきやす!",
   "en": ""
  },
  {
   "id": "MESSAGE168:062D",
   "jp": "おめぇらはワシの誇りだ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:063B",
   "jp": "これも全て守り神様の\nおかげじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:0650",
   "jp": "お兄様、おめでとうっ!!",
   "en": ""
  },
  {
   "id": "MESSAGE168:065F",
   "jp": "お疲れ様っ!　ミラノなら\nできるって信じてたよ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:067B",
   "jp": "今ここに革命は成された…\nやっと平和が訪れたんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:069C",
   "jp": "ひゃっほーい!　これで\n欲しかった靴が買えるぜぃ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:06B9",
   "jp": "…お祝い申し上げます",
   "en": ""
  },
  {
   "id": "MESSAGE168:06C7",
   "jp": "我らが帝国に、更なる栄光が\nあらんことを…",
   "en": ""
  },
  {
   "id": "MESSAGE168:06E3",
   "jp": "心よりお祝い申し上げます、\nユベロン様",
   "en": ""
  },
  {
   "id": "MESSAGE168:06FC",
   "jp": "当然の結果だ",
   "en": ""
  },
  {
   "id": "MESSAGE168:0707",
   "jp": "これこそが神の導き…\nそして正しき道なのだ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:0721",
   "jp": "か…神はすべてを\n見ておられるのじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:0736",
   "jp": "みんなには感謝してるわ。\nありがとね!",
   "en": ""
  },
  {
   "id": "MESSAGE168:074C",
   "jp": "お役に立てて何よりです、\n陛下",
   "en": ""
  },
  {
   "id": "MESSAGE168:0760",
   "jp": "カリスマ・クイーン、\nその名はパメラ様よっ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:0779",
   "jp": "ケーッケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:0783",
   "jp": "グォ!　グオォォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:078F",
   "jp": "グワォ!　グワオォォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE168:079D",
   "jp": "勝者こそが正義となるのだ",
   "en": ""
  },
  {
   "id": "MESSAGE168:07AE",
   "jp": "お疲れ様ですわ~♪\n明日も頑張ってくださいね~",
   "en": ""
  },
  {
   "id": "MESSAGE168:07CC",
   "jp": "全て想定内です",
   "en": ""
  },
  {
   "id": "MESSAGE168:07D8",
   "jp": "今後もこの勢いでいこう!",
   "en": ""
  },
  {
   "id": "MESSAGE168:07E8",
   "jp": "戦いは、まだまだこれから!",
   "en": ""
  }
 ]
}
