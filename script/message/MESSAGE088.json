{
 "file": "MESSAGE088.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE088:04B0",
   "jp": "進ませないよ…\nそういう命令なんでね",
   "en": ""
  },
  {
   "id": "MESSAGE088:04C6",
   "jp": "テメェらにくれてやる\n領土なんかねぇんだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:04DF",
   "jp": "侵略者は出て行け!",
   "en": ""
  },
  {
   "id": "MESSAGE088:04ED",
   "jp": "これ以上貴方たちの\n好きにはさせない!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0506",
   "jp": "貴様たちを排除する!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0515",
   "jp": "貴様たちに渡しはしない!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0525",
   "jp": "ここは渡さないわ!\n出ていって!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0538",
   "jp": "ここから出ていきたまえ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0546",
   "jp": "出ていかねえってんなら\n全員死んでもらうまでだ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0563",
   "jp": "そなたらに渡す\n土地など無い!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0577",
   "jp": "ここは渡さぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0580",
   "jp": "こっち来ないで!",
   "en": ""
  },
  {
   "id": "MESSAGE088:058A",
   "jp": "無駄だ、帰れ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0595",
   "jp": "ここを渡すわけには\nいきません",
   "en": ""
  },
  {
   "id": "MESSAGE088:05A6",
   "jp": "ここから出ていきやがれ!\n今すぐにだ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:05BC",
   "jp": "絶対に渡さねえっ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:05C9",
   "jp": "おめぇらには渡さねぇぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:05D7",
   "jp": "この都市は\nワシらのものじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:05E9",
   "jp": "ここから出てって!\nあんたたちなんかキライよ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0602",
   "jp": "さっさと出ていきなよ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:060F",
   "jp": "渡してたまるか!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0619",
   "jp": "ひゃっほーい!\nおれさま占領!",
   "en": ""
  },
  {
   "id": "MESSAGE088:062B",
   "jp": "ここは必ず守ります…!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0639",
   "jp": "ここを通りたくば\n私を倒していけ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:064D",
   "jp": "フフ…ここは渡さないわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE088:065C",
   "jp": "貴様に渡す土地など無い。\n失せろ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0675",
   "jp": "神の御心に則り\nこの地を平定する!",
   "en": ""
  },
  {
   "id": "MESSAGE088:068D",
   "jp": "か、神のご命令じゃ!\nわしを恨むな",
   "en": ""
  },
  {
   "id": "MESSAGE088:06A2",
   "jp": "あんたには絶対渡さないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:06B3",
   "jp": "渡さないわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:06BC",
   "jp": "ムフフ♪\nいっただきぃ~♪",
   "en": ""
  },
  {
   "id": "MESSAGE088:06CA",
   "jp": "クケケ~ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:06D1",
   "jp": "グォォォォゥン!!",
   "en": ""
  },
  {
   "id": "MESSAGE088:06DB",
   "jp": "グワォォォォゥン!!",
   "en": ""
  },
  {
   "id": "MESSAGE088:06E6",
   "jp": "無駄だ、去るがいい!",
   "en": ""
  },
  {
   "id": "MESSAGE088:06F4",
   "jp": "気の毒ですけど\nここは頂きますわね~♪",
   "en": ""
  },
  {
   "id": "MESSAGE088:070B",
   "jp": "無駄です。\nここより立ち去りなさい",
   "en": ""
  },
  {
   "id": "MESSAGE088:0721",
   "jp": "渡さないぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE088:0729",
   "jp": "ここは渡さない!",
   "en": ""
  }
 ]
