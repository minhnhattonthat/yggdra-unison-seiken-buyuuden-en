{
 "file": "MESSAGE017.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE017:0480",
   "jp": "俺の魔剣の出番だな!",
   "en": "Time for my magic\nsword to shine!"
  },
  {
   "id": "MESSAGE017:0490",
   "jp": "出撃するゼ!",
   "en": "Movin' out!"
  },
  {
   "id": "MESSAGE017:0499",
   "jp": "いくぞ!",
   "en": "Let's go!"
  },
  {
   "id": "MESSAGE017:049E",
   "jp": "出撃します!",
   "en": "I shall go forth!"
  },
  {
   "id": "MESSAGE017:04A7",
   "jp": "さっさと終わらせるか…",
   "en": "Let's finish this\nquickly..."
  },
  {
   "id": "MESSAGE017:04B4",
   "jp": "さっさと終わらせるぞ",
   "en": "We'll finish this\nquickly."
  },
  {
   "id": "MESSAGE017:04C0",
   "jp": "私の出番みたいね",
   "en": "Looks like it's my\nturn."
  },
  {
   "id": "MESSAGE017:04CB",
   "jp": "お任せください",
   "en": "Leave it to me."
  },
  {
   "id": "MESSAGE017:04D4",
   "jp": "暴れさせてもらうぜ!",
   "en": "Time to cut loose!"
  },
  {
   "id": "MESSAGE017:04E0",
   "jp": "拙者が参りましょう!",
   "en": "I shall go myself!"
  },
  {
   "id": "MESSAGE017:04EE",
   "jp": "では、私めにお任せを",
   "en": "Then leave it to your\nhumble servant."
  },
  {
   "id": "MESSAGE017:04FA",
   "jp": "ニーチェ行ってくるね!",
   "en": "Nietzsche's heading\nout!"
  },
  {
   "id": "MESSAGE017:0506",
   "jp": "出撃する!",
   "en": "Moving out!"
  },
  {
   "id": "MESSAGE017:050E",
   "jp": "まいりましょう",
   "en": "Let us go."
  },
  {
   "id": "MESSAGE017:0516",
   "jp": "よっしゃ、負けねーぜ!",
   "en": "Alright, I won't lose!"
  },
  {
   "id": "MESSAGE017:0523",
   "jp": "ちょっくら暴れてくるぞ!",
   "en": "I'm gonna go raise\na little hell!"
  },
  {
   "id": "MESSAGE017:0531",
   "jp": "ワシに任せてもらおうか",
   "en": "Leave it to me, eh."
  },
  {
   "id": "MESSAGE017:053E",
   "jp": "ワシの出番じゃな?",
   "en": "My turn, is it?"
  },
  {
   "id": "MESSAGE017:054A",
   "jp": "じゃあ、行ってくるね!",
   "en": "Okay, I'm off!"
  },
  {
   "id": "MESSAGE017:0556",
   "jp": "ウチ、頑張ってみる!",
   "en": "I'll give it my best!"
  },
  {
   "id": "MESSAGE017:0563",
   "jp": "任せといてくれ!",
   "en": "Leave it to me!"
  },
  {
   "id": "MESSAGE017:056D",
   "jp": "どれ、行ってくるか!",
   "en": "Well, off I go!"
  },
  {
   "id": "MESSAGE017:0578",
   "jp": "…出撃します!",
   "en": "...Moving out!"
  },
  {
   "id": "MESSAGE017:0582",
   "jp": "いくぞ!",
   "en": "Let's go!"
  },
  {
   "id": "MESSAGE017:0587",
   "jp": "いきますわよ…",
   "en": "Here I go..."
  },
  {
   "id": "MESSAGE017:058F",
   "jp": "これより出撃する!",
   "en": "We move out at once!"
  },
  {
   "id": "MESSAGE017:059B",
   "jp": "私が行くとしよう!",
   "en": "I shall go!"
  },
  {
   "id": "MESSAGE017:05A5",
   "jp": "あまり無理はできんぞ?",
   "en": "Don't push me too\nhard, eh?"
  },
  {
   "id": "MESSAGE017:05B3",
   "jp": "出撃するわよ!",
   "en": "Let's move out!"
  },
  {
   "id": "MESSAGE017:05BD",
   "jp": "いくわよ!",
   "en": "Let's go!"
  },
  {
   "id": "MESSAGE017:05C3",
   "jp": "出撃ね!",
   "en": "Time to move out!"
  },
  {
   "id": "MESSAGE017:05CA",
   "jp": "ケッケーッ!",
   "en": "Kekkeeh!"
  },
  {
   "id": "MESSAGE017:05D1",
   "jp": "グォォォーッ!",
   "en": "Groooogh!"
  },
  {
   "id": "MESSAGE017:05D9",
   "jp": "グワォォォーッ!",
   "en": "Grwaoooogh!"
  },
  {
   "id": "MESSAGE017:05E2",
   "jp": "出撃しよう",
   "en": "We move out."
  },
  {
   "id": "MESSAGE017:05EA",
   "jp": "行きますわよ?",
   "en": "Shall we go, then?"
  },
  {
   "id": "MESSAGE017:05F2",
   "jp": "出撃しましょう",
   "en": "Let us move out."
  }
 ]
}
