{
 "file": "MESSAGE062.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE062:04F0",
   "jp": "すまないが、諦めてくれよ",
   "en": "Sorry, but you'll\nhave to give up."
  },
  {
   "id": "MESSAGE062:04FE",
   "jp": "今日のオレ様は\n機嫌が悪いゼ!",
   "en": "The great me's in a\nfoul mood today!"
  },
  {
   "id": "MESSAGE062:0514",
   "jp": "よし、倒したぞ!",
   "en": "Alright, I beat 'em!"
  },
  {
   "id": "MESSAGE062:051E",
   "jp": "守将を捕らえたわ!",
   "en": "I've captured the\ncommander!"
  },
  {
   "id": "MESSAGE062:052B",
   "jp": "観念するがいい",
   "en": "Resign yourself."
  },
  {
   "id": "MESSAGE062:0535",
   "jp": "フッ、これでいい",
   "en": "Heh, that'll do."
  },
  {
   "id": "MESSAGE062:053E",
   "jp": "貴方の負けよ",
   "en": "You lose."
  },
  {
   "id": "MESSAGE062:0548",
   "jp": "命まで取るとは言わない\n諦めるんだ",
   "en": "I will not take your\nlife. Yield now."
  },
  {
   "id": "MESSAGE062:055E",
   "jp": "ククク…\nそれなりに楽しめたぜ",
   "en": "Heh heh heh...\nThat was a fun one."
  },
  {
   "id": "MESSAGE062:056F",
   "jp": "このような所で\n命を捨てることは無い",
   "en": "Cast not thy life\naway in such a place."
  },
  {
   "id": "MESSAGE062:0586",
   "jp": "信念の勝利だ",
   "en": "My convictions\nhave prevailed!"
  },
  {
   "id": "MESSAGE062:0591",
   "jp": "次も、この調子ね!",
   "en": "Let's keep it up\nnext time too!"
  },
  {
   "id": "MESSAGE062:059E",
   "jp": "敵将の身柄を確保したぞ",
   "en": "The enemy general\nis in our custody!"
  },
  {
   "id": "MESSAGE062:05B0",
   "jp": "降伏してください",
   "en": "Please, surrender."
  },
  {
   "id": "MESSAGE062:05BB",
   "jp": "ジャマすんじゃねーよ!",
   "en": "Quit gettin' in\nmy way!"
  },
  {
   "id": "MESSAGE062:05C7",
   "jp": "俺だってやればできるぞ!",
   "en": "See? I can do it\ntoo when I try!"
  },
  {
   "id": "MESSAGE062:05D5",
   "jp": "ほっほー!\n敵を捕まえたぞぉ!",
   "en": "Hohhooo!\nGot me an enemy!"
  },
  {
   "id": "MESSAGE062:05E7",
   "jp": "残念じゃったのう!",
   "en": "Tough luck, sonny!"
  },
  {
   "id": "MESSAGE062:05F3",
   "jp": "べーっだ!",
   "en": "Nyeeeh!"
  },
  {
   "id": "MESSAGE062:05F9",
   "jp": "ウチには勝てないよ!",
   "en": "You can't beat me!"
  },
  {
   "id": "MESSAGE062:0605",
   "jp": "勝ったみたいだな!",
   "en": "Looks like we won!"
  },
  {
   "id": "MESSAGE062:0610",
   "jp": "オイラもなかなかやるだろ?",
   "en": "Pretty good for me,\nhuh?"
  },
  {
   "id": "MESSAGE062:061E",
   "jp": "任務…完了です",
   "en": "Mission...\naccomplished."
  },
  {
   "id": "MESSAGE062:062A",
   "jp": "任務完了",
   "en": "Mission complete."
  },
  {
   "id": "MESSAGE062:0633",
   "jp": "フフ…頑張ったわね……",
   "en": "Fufu... you did\nwell, dear..."
  },
  {
   "id": "MESSAGE062:0641",
   "jp": "私に不可能など無い",
   "en": "Nothing is\nimpossible for me."
  },
  {
   "id": "MESSAGE062:064F",
   "jp": "これが神のご計画なのだ",
   "en": "This is God's plan."
  },
  {
   "id": "MESSAGE062:065D",
   "jp": "か、神はわしの味方じゃ!",
   "en": "G-God is on my\nside, ya hear!"
  },
  {
   "id": "MESSAGE062:066C",
   "jp": "思い知るといいわ",
   "en": "That'll teach you,\ndarling."
  },
  {
   "id": "MESSAGE062:0677",
   "jp": "期待外れだったわね",
   "en": "What a letdown."
  },
  {
   "id": "MESSAGE062:0684",
   "jp": "力押しじゃ勝てないわよ~?",
   "en": "Brute force won't\nwin this, you know~?"
  },
  {
   "id": "MESSAGE062:0695",
   "jp": "クケーケケケッ!",
   "en": "Kukeeekekekeh!"
  },
  {
   "id": "MESSAGE062:069E",
   "jp": "グォォォォォッ!",
   "en": "Grooooogh!"
  },
  {
   "id": "MESSAGE062:06A7",
   "jp": "グォォォォォッ!",
   "en": "Grooooogh!"
  },
  {
   "id": "MESSAGE062:06B0",
   "jp": "思い上がるな!",
   "en": "Don't flatter\nyourself!"
  },
  {
   "id": "MESSAGE062:06BA",
   "jp": "もう、諦めてくださいな",
   "en": "Now, do give up,\ndear."
  },
  {
   "id": "MESSAGE062:06C7",
   "jp": "思い上がりは…\n身を滅ぼしますよ?",
   "en": "Arrogance...\nwill be your ruin."
  },
  {
   "id": "MESSAGE062:06DD",
   "jp": "勝負あったな!",
   "en": "That settles it!"
  },
  {
   "id": "MESSAGE062:06E7",
   "jp": "諦めなさい!",
   "en": "Give it up!"
  }
 ]
}
