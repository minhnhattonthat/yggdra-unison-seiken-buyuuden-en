  {
   "id": "MESSAGE138:0240",
   "jp": "王国の復興のために\n手を貸しては頂けませんか?",
   "en": ""
  },
  {
   "id": "MESSAGE138:025F",
   "jp": "混沌の戦世を終わらせるため\n共に戦ってはくれまいか?",
   "en": ""
  },
  {
   "id": "MESSAGE138:0281",
   "jp": "貴方には見所があります。\n共に戦ってはくれませんか?",
   "en": ""
  },
  {
   "id": "MESSAGE138:02A2",
   "jp": "どうだ?　オレたちの仲間に\nならねーか?",
   "en": ""
  },
  {
   "id": "MESSAGE138:02B9",
   "jp": "どうだ?　ワシらと一緒に\n人生を楽しもうじゃねぇか",
   "en": ""
  },
  {
   "id": "MESSAGE138:02D8",
   "jp": "ワシの部下になれば\n人生バラ色間違い無しじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE138:02F7",
   "jp": "命令だ。\n我が黒薔薇に下れ",
   "en": ""
  },
  {
   "id": "MESSAGE138:030B",
   "jp": "か、金ならたくさんある…\nわしの下で働いてみんか?",
   "en": ""
  },
  {
   "id": "MESSAGE138:0327",
   "jp": "あたしの部下になりなさい。\nこれは命令よ",
   "en": ""
  },
  {
   "id": "MESSAGE138:033F",
   "jp": "パメラ様の手下になるなら\n許してあげる~♪",
   "en": ""
  },
  {
   "id": "MESSAGE138:0358",
   "jp": "貴様には見所がある。\n俺の下で働いてみぬか?",
   "en": ""
  },
  {
   "id": "MESSAGE138:0375",
   "jp": "貴方は…私の駒に\n相応しい存在です",
   "en": ""
  }
 ]
