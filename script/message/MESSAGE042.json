{
 "file": "MESSAGE042.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE042:0640",
   "jp": "調子が出なかったな…",
   "en": "Just not my day..."
  },
  {
   "id": "MESSAGE042:064E",
   "jp": "チ、チクショー…",
   "en": "D-dammit..."
  },
  {
   "id": "MESSAGE042:0657",
   "jp": "力が…出ない……",
   "en": "My strength... is\ngone......"
  },
  {
   "id": "MESSAGE042:0662",
   "jp": "諦めるしか無いの…?",
   "en": "Must I give up...?"
  },
  {
   "id": "MESSAGE042:066F",
   "jp": "お、おのれ…!",
   "en": "C-curse you...!"
  },
  {
   "id": "MESSAGE042:0677",
   "jp": "こ、これほどの力とは…!",
   "en": "S-such power...!"
  },
  {
   "id": "MESSAGE042:0685",
   "jp": "やっぱり…あたしは……",
   "en": "I knew it... I'm just......"
  },
  {
   "id": "MESSAGE042:0691",
   "jp": "油断したか…",
   "en": "I let my guard down..."
  },
  {
   "id": "MESSAGE042:069A",
   "jp": "ふ、ふざけやがって…",
   "en": "Th-the hell is this..."
  },
  {
   "id": "MESSAGE042:06A5",
   "jp": "拙者も詰めが\n甘かったようじゃ…",
   "en": "Methinks I faltered\nat the last..."
  },
  {
   "id": "MESSAGE042:06BA",
   "jp": "しまった…!",
   "en": "A mistake...!"
  },
  {
   "id": "MESSAGE042:06C1",
   "jp": "ま…負けちゃった……",
   "en": "Nietzsche... lost......"
  },
  {
   "id": "MESSAGE042:06CD",
   "jp": "ば、ばかな…",
   "en": "Im-impossible..."
  },
  {
   "id": "MESSAGE042:06D4",
   "jp": "わたくしとしたことが…",
   "en": "How unlike me..."
  },
  {
   "id": "MESSAGE042:06E0",
   "jp": "ゆ、油断しちまった…",
   "en": "D-damn, got sloppy..."
  },
  {
   "id": "MESSAGE042:06ED",
   "jp": "やられたーっ!",
   "en": "They got meee!"
  },
  {
   "id": "MESSAGE042:06F5",
   "jp": "ワシが負けるとは…",
   "en": "Gah, me... beaten..."
  },
  {
   "id": "MESSAGE042:0700",
   "jp": "ぐっ、侮っておったわい…",
   "en": "Ngh, I underestimated\nya, sonny..."
  },
  {
   "id": "MESSAGE042:070E",
   "jp": "ど、どうしよう…",
   "en": "Wh-what do I do..."
  },
  {
   "id": "MESSAGE042:0717",
   "jp": "根性足りなかったかな…",
   "en": "Guess I didn't have\nenough guts..."
  },
  {
   "id": "MESSAGE042:0726",
   "jp": "革命未だ成らず…",
   "en": "The revolution... isn't\ndone yet..."
  },
  {
   "id": "MESSAGE042:0733",
   "jp": "うお!　や、やられた!",
   "en": "Whoa! Th-they\ngot me!"
  },
  {
   "id": "MESSAGE042:073F",
   "jp": "任務を…果たせなかった……",
   "en": "I failed... my\nmission......"
  },
  {
   "id": "MESSAGE042:0750",
   "jp": "これも運命…か……",
   "en": "So this... is fate......"
  },
  {
   "id": "MESSAGE042:075C",
   "jp": "私としたことが…",
   "en": "How careless\nof me..."
  },
  {
   "id": "MESSAGE042:0765",
   "jp": "し、信じられん…!",
   "en": "Unbelievable...!"
  },
  {
   "id": "MESSAGE042:0770",
   "jp": "貴様に救いなど無いぞ…!",
   "en": "There is no salvation\nfor you...!"
  },
  {
   "id": "MESSAGE042:0781",
   "jp": "かか神様、どうかお助けを…",
   "en": "G-g-god, please\nsave me..."
  },
  {
   "id": "MESSAGE042:0791",
   "jp": "や、やってくれたわね…!",
   "en": "W-well, you've done it\nnow...!"
  },
  {
   "id": "MESSAGE042:079E",
   "jp": "あ、ありえないわ…!",
   "en": "Th-this can't\nbe happening...!"
  },
  {
   "id": "MESSAGE042:07A9",
   "jp": "是非も無し…",
   "en": "It cannot be helped..."
  },
  {
   "id": "MESSAGE042:07B3",
   "jp": "ケ…ケケ~……",
   "en": "Ke... Kekeh~......"
  },
  {
   "id": "MESSAGE042:07BB",
   "jp": "グォ…グォォォ~……",
   "en": "Gruh... Gruoooh~......"
  },
  {
   "id": "MESSAGE042:07C6",
   "jp": "グワォ…グワォォォ~……",
   "en": "Grwao...\nGrwaooo~......"
  },
  {
   "id": "MESSAGE042:07D3",
   "jp": "何だと…!?",
   "en": "What...?!"
  },
  {
   "id": "MESSAGE042:07DB",
   "jp": "一片の悔いもありませんわ…",
   "en": "I've not a single\nregret, dear..."
  },
  {
   "id": "MESSAGE042:07EC",
   "jp": "ま、まさかこんな…",
   "en": "S-surely not..."
  },
  {
   "id": "MESSAGE042:07F6",
   "jp": "だ、駄目だったか…!",
   "en": "N-no good after all...!"
  },
  {
   "id": "MESSAGE042:0803",
   "jp": "ま…負かされるなんて……",
   "en": "B... beaten......"
  },
  {
   "id": "MESSAGE042:0811",
   "jp": "こ…降参だ……",
   "en": "I... surrender......"
  },
  {
   "id": "MESSAGE042:081B",
   "jp": "う…嘘でしょ……",
   "en": "Th... this can't be......"
  },
  {
   "id": "MESSAGE042:0825",
   "jp": "な、何するんでぇ…っ",
   "en": "Wh-what're ya\ndoin'...!"
  },
  {
   "id": "MESSAGE042:0831",
   "jp": "こ、こんなことが…!",
   "en": "Th-this can't be...!"
  },
  {
   "id": "MESSAGE042:083C",
   "jp": "こ…降参だ……",
   "en": "I... surrender......"
  },
  {
   "id": "MESSAGE042:0846",
   "jp": "ま…負かされるなんて……",
   "en": "B... beaten......"
  },
  {
   "id": "MESSAGE042:0854",
   "jp": "ここまでか…",
   "en": "Is this the end..."
  },
  {
   "id": "MESSAGE042:085B",
   "jp": "そ、そんな…卑怯よ……",
   "en": "N-no... that's not\nfair......"
  },
  {
   "id": "MESSAGE042:0869",
   "jp": "むう、不覚…",
   "en": "Hmm, careless..."
  },
  {
   "id": "MESSAGE042:0872",
   "jp": "ケケ~…",
   "en": "Keke~..."
  },
  {
   "id": "MESSAGE042:0877",
   "jp": "グォォ…",
   "en": "Grooh..."
  },
  {
   "id": "MESSAGE042:087C",
   "jp": "くっ…!",
   "en": "Ngh...!"
  },
  {
   "id": "MESSAGE042:0881",
   "jp": "そんな…",
   "en": "No..."
  }
 ]
