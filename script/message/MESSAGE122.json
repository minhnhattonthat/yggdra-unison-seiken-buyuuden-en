{
 "file": "MESSAGE122.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE122:0450",
   "jp": "これなら手も足も\n出せないだろう!",
   "en": "Now they can't lift\na finger!"
  },
  {
   "id": "MESSAGE122:0465",
   "jp": "拠点、占領したゼ",
   "en": "Base is ours, y'know."
  },
  {
   "id": "MESSAGE122:0472",
   "jp": "勝負あった…!",
   "en": "It's decided...!"
  },
  {
   "id": "MESSAGE122:047C",
   "jp": "制圧したわ…",
   "en": "It's taken..."
  },
  {
   "id": "MESSAGE122:0485",
   "jp": "これも戦の習い…",
   "en": "Such is the way\nof war..."
  },
  {
   "id": "MESSAGE122:0490",
   "jp": "これも戦の習い…",
   "en": "Such is the way\nof war..."
  },
  {
   "id": "MESSAGE122:049B",
   "jp": "終わった…のね?",
   "en": "It's over... right?"
  },
  {
   "id": "MESSAGE122:04A5",
   "jp": "…拠点を占領しました",
   "en": "...The base is taken."
  },
  {
   "id": "MESSAGE122:04B4",
   "jp": "俺様に負けの文字はねぇ!",
   "en": "The great me don't\nknow the word 'lose'!"
  },
  {
   "id": "MESSAGE122:04C6",
   "jp": "…占領いたしましたぞ",
   "en": "...'Tis taken, I say."
  },
  {
   "id": "MESSAGE122:04D3",
   "jp": "ニーチェ、頑張ったよ",
   "en": "Nietzsche did\nher best!"
  },
  {
   "id": "MESSAGE122:04E0",
   "jp": "戦いとはいえ、これ以上は…",
   "en": "War or not, any\nmore than this..."
  },
  {
   "id": "MESSAGE122:04F1",
   "jp": "ここまで…です",
   "en": "That is... enough."
  },
  {
   "id": "MESSAGE122:04F9",
   "jp": "こんなの嬉しくねえよ…",
   "en": "This ain't no fun..."
  },
  {
   "id": "MESSAGE122:0506",
   "jp": "残念だが、おめぇらの\n負けだ!",
   "en": "Tough luck, but\nya lose!"
  },
  {
   "id": "MESSAGE122:0519",
   "jp": "潔く降参することじゃのう!",
   "en": "Best give up like\nmen, eh!"
  },
  {
   "id": "MESSAGE122:052A",
   "jp": "悪いけど、おとなしくしてね",
   "en": "Sorry, but behave\nyourselves, okay?"
  },
  {
   "id": "MESSAGE122:0539",
   "jp": "なんか複雑な気分だけどね…",
   "en": "I kinda feel mixed\nup about it, though..."
  },
  {
   "id": "MESSAGE122:054B",
   "jp": "抵抗をやめてくれ!",
   "en": "Stop resisting!"
  },
  {
   "id": "MESSAGE122:0557",
   "jp": "わりぃけど、\nここはオイラがもらうぜ!",
   "en": "Sorry, pal,\nthis place is mine!"
  },
  {
   "id": "MESSAGE122:056B",
   "jp": "制圧…しました……",
   "en": "It's... taken......"
  },
  {
   "id": "MESSAGE122:0577",
   "jp": "抵抗はやめよ!",
   "en": "Cease resisting!"
  },
  {
   "id": "MESSAGE122:0581",
   "jp": "これも任務なのよ…",
   "en": "It's all part of\nthe job..."
  },
  {
   "id": "MESSAGE122:058D",
   "jp": "終わった…か",
   "en": "So... it is over."
  },
  {
   "id": "MESSAGE122:0595",
   "jp": "神よ…迷える子羊を\n導き給え…",
   "en": "O God... guide this\nlost lamb..."
  },
  {
   "id": "MESSAGE122:05AA",
   "jp": "さ…さすがは神のご加護じゃ",
   "en": "Th-that's God's\nprotection for ya!"
  },
  {
   "id": "MESSAGE122:05BA",
   "jp": "ここまでよ…諦めて頂戴",
   "en": "That's enough...\nGive up, will you?"
  },
  {
   "id": "MESSAGE122:05C9",
   "jp": "作戦が甘いんじゃない?",
   "en": "Your plan was a bit\nnaive, wasn't it?"
  },
  {
   "id": "MESSAGE122:05D8",
   "jp": "まぁ、パメラ様には\n勝てないわよね!",
   "en": "Well, no one beats\nPamela-sama!"
  },
  {
   "id": "MESSAGE122:05ED",
   "jp": "ケーッケッケ!",
   "en": "Keeeh kekeke!"
  },
  {
   "id": "MESSAGE122:05F5",
   "jp": "グォ…ッ!",
   "en": "Grah...!"
  },
  {
   "id": "MESSAGE122:05FB",
   "jp": "グワォ、グワォォォーッ!",
   "en": "Grwah, grwaaaah!"
  },
  {
   "id": "MESSAGE122:0608",
   "jp": "これで終わりだ!",
   "en": "This is the end!"
  },
  {
   "id": "MESSAGE122:0612",
   "jp": "あまりこの土地を\n荒らさないでくださいな",
   "en": "Please don't trample\nthis land too much."
  },
  {
   "id": "MESSAGE122:062A",
   "jp": "これで終わりです…",
   "en": "This is the end..."
  }
 ]
}
