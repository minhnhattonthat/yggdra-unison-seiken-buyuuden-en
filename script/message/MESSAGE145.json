{
 "file": "MESSAGE145.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE145:0480",
   "jp": "この俺を逃がすなんてな…\nま、感謝するよ",
   "en": ""
  },
  {
   "id": "MESSAGE145:0499",
   "jp": "生意気なガキが…\n覚えてろよ!",
   "en": ""
  },
  {
   "id": "MESSAGE145:04AD",
   "jp": "モニカ…またな……",
   "en": ""
  },
  {
   "id": "MESSAGE145:04B7",
   "jp": "この屈辱…\n一生忘れないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE145:04CB",
   "jp": "了解しました…\n失礼いたします",
   "en": ""
  },
  {
   "id": "MESSAGE145:04DF",
   "jp": "承知しました…\n失礼いたします",
   "en": ""
  },
  {
   "id": "MESSAGE145:04F3",
   "jp": "そう…\nじゃあね、カナン…",
   "en": ""
  },
  {
   "id": "MESSAGE145:0501",
   "jp": "…承知致しました",
   "en": ""
  },
  {
   "id": "MESSAGE145:050D",
   "jp": "いつか…\nその首を取ってやるぜ……",
   "en": ""
  },
  {
   "id": "MESSAGE145:0521",
   "jp": "私めにこのような温情…\n感謝申し上げます",
   "en": ""
  },
  {
   "id": "MESSAGE145:053C",
   "jp": "…後悔するな!",
   "en": ""
  },
  {
   "id": "MESSAGE145:0546",
   "jp": "ニーチェのこと…\n許してくれてありがとう",
   "en": ""
  },
  {
   "id": "MESSAGE145:055C",
   "jp": "エメローネ様…\n残念です……",
   "en": ""
  },
  {
   "id": "MESSAGE145:056E",
   "jp": "これも運命なのでしょう…",
   "en": ""
  },
  {
   "id": "MESSAGE145:057D",
   "jp": "嫌な予感が的中したぜ…\nじゃあな",
   "en": ""
  },
  {
   "id": "MESSAGE145:0593",
   "jp": "さらばです、親分…",
   "en": ""
  },
  {
   "id": "MESSAGE145:059F",
   "jp": "お優しいこって…へっへ……",
   "en": ""
  },
  {
   "id": "MESSAGE145:05AE",
   "jp": "あ、ありがとうございます!",
   "en": ""
  },
  {
   "id": "MESSAGE145:05BC",
   "jp": "…わかった……",
   "en": ""
  },
  {
   "id": "MESSAGE145:05C4",
   "jp": "もういいよ!\nじゃあね、ミラノ!",
   "en": ""
  },
  {
   "id": "MESSAGE145:05D5",
   "jp": "革命の夢は捨てないぞ…",
   "en": ""
  },
  {
   "id": "MESSAGE145:05E5",
   "jp": "逃がしてくれるのか!?\nラッキー!",
   "en": ""
  },
  {
   "id": "MESSAGE145:05F8",
   "jp": "また…どこかで……",
   "en": ""
  },
  {
   "id": "MESSAGE145:0602",
   "jp": "もう会うことは\n無いだろう…",
   "en": ""
  },
  {
   "id": "MESSAGE145:0613",
   "jp": "そう。じゃあね、フフフ…",
   "en": ""
  },
  {
   "id": "MESSAGE145:0620",
   "jp": "この私を逃がしたこと…\n必ずや後悔させてやろう",
   "en": ""
  },
  {
   "id": "MESSAGE145:063C",
   "jp": "クク…きっと後悔しますぞ?",
   "en": ""
  },
  {
   "id": "MESSAGE145:064C",
   "jp": "に、逃がしてくれるのか?\n礼は言わんぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE145:0665",
   "jp": "あたしを逃がしたこと\n必ず後悔させてあげるわ…",
   "en": ""
  },
  {
   "id": "MESSAGE145:0681",
   "jp": "承知しました…",
   "en": ""
  },
  {
   "id": "MESSAGE145:068B",
   "jp": "うほっ!?\n逃がしてくれるの!?",
   "en": ""
  },
  {
   "id": "MESSAGE145:069D",
   "jp": "クケッ!?　ク…ケケ……",
   "en": ""
  },
  {
   "id": "MESSAGE145:06AA",
   "jp": "グ…グォッ?　グオァ!?",
   "en": ""
  },
  {
   "id": "MESSAGE145:06B7",
   "jp": "グワ…グワアアァァァッ!!",
   "en": ""
  },
  {
   "id": "MESSAGE145:06C5",
   "jp": "エミリオよ…\nもう会うことは無いだろう",
   "en": ""
  },
  {
   "id": "MESSAGE145:06DB",
   "jp": "それでは失礼致しますわ",
   "en": ""
  },
  {
   "id": "MESSAGE145:06EA",
   "jp": "さようなら。\nもう会うことは無いでしょう",
   "en": ""
  }
 ]
}
