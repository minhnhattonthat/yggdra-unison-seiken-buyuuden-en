{
 "file": "MESSAGE192.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE192:0640",
   "jp": "ちょっと大変そうだが…\n行ってみるとしよう",
   "en": ""
  },
  {
   "id": "MESSAGE192:0658",
   "jp": "マジかよ…\nまぁ、任せとけって!",
   "en": ""
  },
  {
   "id": "MESSAGE192:066A",
   "jp": "これはちょっと…\nいえ、行ってきます!",
   "en": ""
  },
  {
   "id": "MESSAGE192:067E",
   "jp": "難しそうな地形ね…\n大丈夫かしら…?",
   "en": ""
  },
  {
   "id": "MESSAGE192:0697",
   "jp": "少々時間を頂けるのなら…",
   "en": ""
  },
  {
   "id": "MESSAGE192:06A9",
   "jp": "少し時間を頂けますか?",
   "en": ""
  },
  {
   "id": "MESSAGE192:06B9",
   "jp": "上手く辿り着けるかしら?\n少し心配だわ…",
   "en": ""
  },
  {
   "id": "MESSAGE192:06D5",
   "jp": "どのような苦難も\n乗り越えてみせましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE192:06EF",
   "jp": "チッ…仕方ねぇな。\n行って来るぜ",
   "en": ""
  },
  {
   "id": "MESSAGE192:0703",
   "jp": "御意。ならば少々お時間を\n頂けますかな?",
   "en": ""
  },
  {
   "id": "MESSAGE192:071F",
   "jp": "これも試練…か",
   "en": ""
  },
  {
   "id": "MESSAGE192:0729",
   "jp": "ニーチェ、行ってみる…",
   "en": ""
  },
  {
   "id": "MESSAGE192:0735",
   "jp": "私が…行くのですね?\n分かりました……",
   "en": ""
  },
  {
   "id": "MESSAGE192:074A",
   "jp": "気は進みませんが…\nまいりましょう……",
   "en": ""
  },
  {
   "id": "MESSAGE192:0760",
   "jp": "やっかいだが…\nちょっと見てくるか!",
   "en": ""
  },
  {
   "id": "MESSAGE192:0774",
   "jp": "あー…まぁ、ちょっと\n見てくるでやんすよ!",
   "en": ""
  },
  {
   "id": "MESSAGE192:078B",
   "jp": "むむっ…\nまぁ、見てきてやるか!",
   "en": ""
  },
  {
   "id": "MESSAGE192:079D",
   "jp": "ぐ…まあいい。\nワシが見てきてやろう!",
   "en": ""
  },
  {
   "id": "MESSAGE192:07B2",
   "jp": "うーん…わかった。\nボク、行ってみるよ!",
   "en": ""
  },
  {
   "id": "MESSAGE192:07C7",
   "jp": "どこでも頑張って\n行ってくるよ",
   "en": ""
  },
  {
   "id": "MESSAGE192:07D9",
   "jp": "行ってみるか…",
   "en": ""
  },
  {
   "id": "MESSAGE192:07E1",
   "jp": "オイラが行くのか?\nま、しょうがねぇか…",
   "en": ""
  },
  {
   "id": "MESSAGE192:07F6",
   "jp": "…行って参ります",
   "en": ""
  },
  {
   "id": "MESSAGE192:0800",
   "jp": "…行って参りましょう",
   "en": ""
  },
  {
   "id": "MESSAGE192:080C",
   "jp": "承知致しました",
   "en": ""
  },
  {
   "id": "MESSAGE192:0817",
   "jp": "仕方ない。様子を見てくると\nしようか…",
   "en": ""
  },
  {
   "id": "MESSAGE192:0830",
   "jp": "これも神が与えし試練…\n勤んでお受けしましょう",
   "en": ""
  },
  {
   "id": "MESSAGE192:084D",
   "jp": "気は進まんが…仕方ない",
   "en": ""
  },
  {
   "id": "MESSAGE192:085D",
   "jp": "う~ん…そうねぇ……\nじゃあ、ちょっと見てくるわ",
   "en": ""
  },
  {
   "id": "MESSAGE192:0877",
   "jp": "お任せください",
   "en": ""
  },
  {
   "id": "MESSAGE192:0880",
   "jp": "パメラ様は逆境に\n強いのよ?",
   "en": ""
  },
  {
   "id": "MESSAGE192:0893",
   "jp": "クケックケ…",
   "en": ""
  },
  {
   "id": "MESSAGE192:089A",
   "jp": "グォー!?",
   "en": ""
  },
  {
   "id": "MESSAGE192:08A0",
   "jp": "グワォー!?",
   "en": ""
  },
  {
   "id": "MESSAGE192:08A7",
   "jp": "くっ…仕方あるまい",
   "en": ""
  },
  {
   "id": "MESSAGE192:08B3",
   "jp": "行けとおっしゃるのなら…\n仕方ありませんわ",
   "en": ""
  },
  {
   "id": "MESSAGE192:08CB",
   "jp": "…私が見て参りましょう",
   "en": ""
  },
  {
   "id": "MESSAGE192:08D9",
   "jp": "ご命令とあらば、\n行ってきましょう",
   "en": ""
  },
  {
   "id": "MESSAGE192:08ED",
   "jp": "…分かりました。\n行ってきます!",
   "en": ""
  },
  {
   "id": "MESSAGE192:08FF",
   "jp": "ご命令とあらば、\n行って参りましょう…",
   "en": ""
  },
  {
   "id": "MESSAGE192:0916",
   "jp": "…分かりました。\nでは、行ってきます!",
   "en": ""
  },
  {
   "id": "MESSAGE192:092B",
   "jp": "ヘイヘイ、行きゃあ\nいいんでしょう?",
   "en": ""
  },
  {
   "id": "MESSAGE192:093E",
   "jp": "ちょっと不安だけど…\n調べてくるよ",
   "en": ""
  },
  {
   "id": "MESSAGE192:0953",
   "jp": "あまり期待せずに\n待っていてください",
   "en": ""
  },
  {
   "id": "MESSAGE192:0969",
   "jp": "ハ…見て参ります",
   "en": ""
  },
  {
   "id": "MESSAGE192:0974",
   "jp": "…分かりました。\n見て参りましょう",
   "en": ""
  },
  {
   "id": "MESSAGE192:0989",
   "jp": "う…分かりました。\n行ってみます",
   "en": ""
  },
  {
   "id": "MESSAGE192:099B",
   "jp": "ご命令とあらば…\n行って参りましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE192:09B2",
   "jp": "クケックケ…",
   "en": ""
  },
  {
   "id": "MESSAGE192:09B9",
   "jp": "グォー!?",
   "en": ""
  },
  {
   "id": "MESSAGE192:09BF",
   "jp": "…難しい仕事ですが\n行ってきましょう",
   "en": ""
  },
  {
   "id": "MESSAGE192:09D5",
   "jp": "…分かりました。\nでは、行ってきます!",
   "en": ""
  }
 ]
