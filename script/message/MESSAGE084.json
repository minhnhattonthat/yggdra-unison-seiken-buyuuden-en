{
 "file": "MESSAGE084.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE084:0640",
   "jp": "まだやるかい?",
   "en": "Want some more?"
  },
  {
   "id": "MESSAGE084:0648",
   "jp": "その程度かよ!?",
   "en": "That all ya got?!"
  },
  {
   "id": "MESSAGE084:0653",
   "jp": "当然の報いだ!",
   "en": "You got what you\ndeserved!"
  },
  {
   "id": "MESSAGE084:065E",
   "jp": "退きはしません!",
   "en": "I will not retreat!"
  },
  {
   "id": "MESSAGE084:0668",
   "jp": "この程度で\n私を倒すつもりか?",
   "en": "You think this is\nenough to defeat me?"
  },
  {
   "id": "MESSAGE084:067B",
   "jp": "この程度で私を倒せると?",
   "en": "You think this can\nbeat me?"
  },
  {
   "id": "MESSAGE084:068B",
   "jp": "みんなを守れれば\nそれでいいの",
   "en": "If I can protect\neveryone, it's enough."
  },
  {
   "id": "MESSAGE084:069C",
   "jp": "この地から去るならば、\nこちらも手出しはしない",
   "en": "Leave this land, and\nwe will not attack."
  },
  {
   "id": "MESSAGE084:06B8",
   "jp": "フン…あばよ",
   "en": "Hmph... Later."
  },
  {
   "id": "MESSAGE084:06BF",
   "jp": "その腕前では…",
   "en": "With skill such as\nthine..."
  },
  {
   "id": "MESSAGE084:06C9",
   "jp": "ここまでだ!",
   "en": "This ends here!"
  },
  {
   "id": "MESSAGE084:06D0",
   "jp": "もうやめた方がいいよ!",
   "en": "You'd better stop\nnow!"
  },
  {
   "id": "MESSAGE084:06DD",
   "jp": "その名、きっと忘れぬ",
   "en": "I shall not forget\nthat name."
  },
  {
   "id": "MESSAGE084:06EA",
   "jp": "これ以上はおやめなさい",
   "en": ""
  },
  {
   "id": "MESSAGE084:06F8",
   "jp": "へっ、無駄だぜ!",
   "en": "Heh, it's no use!"
  },
  {
   "id": "MESSAGE084:0703",
   "jp": "いやっほーい!",
   "en": "Woo-hoooo!"
  },
  {
   "id": "MESSAGE084:070B",
   "jp": "ワシの強さ思い知ったかぁ?",
   "en": "Now ya know how\nstrong I am, eh?"
  },
  {
   "id": "MESSAGE084:071C",
   "jp": "ガハハハ、どうじゃ?",
   "en": "Gwahahaha, how's\nthat?"
  },
  {
   "id": "MESSAGE084:0727",
   "jp": "ボクをバカにするからだよ!",
   "en": "That's what you get\nfor mocking me!"
  },
  {
   "id": "MESSAGE084:0735",
   "jp": "やっつけたよ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:073D",
   "jp": "運も実力のうちだからね",
   "en": "Luck's part of skill,\ntoo, y'know."
  },
  {
   "id": "MESSAGE084:074C",
   "jp": "邪魔しやがるからだぜぃ!",
   "en": "That's what ya get\nfor gettin' in my way!"
  },
  {
   "id": "MESSAGE084:075B",
   "jp": "…目標を撃破しました",
   "en": "...Target eliminated."
  },
  {
   "id": "MESSAGE084:076A",
   "jp": "その程度なのか?",
   "en": "Is that all you've\ngot?"
  },
  {
   "id": "MESSAGE084:0775",
   "jp": "おうちに帰りなさいな",
   "en": "Run along home, dear."
  },
  {
   "id": "MESSAGE084:0781",
   "jp": "その心意気は認めよう",
   "en": "That spirit, I shall\nacknowledge."
  },
  {
   "id": "MESSAGE084:0790",
   "jp": "これが神のご計画なのだ",
   "en": ""
  },
  {
   "id": "MESSAGE084:079E",
   "jp": "わしは何も悪くない!",
   "en": "I've done nothing\nwrong, I tell you!"
  },
  {
   "id": "MESSAGE084:07AB",
   "jp": "さあ、次のお相手は\n誰かしら?",
   "en": "Now, who's my next\nopponent, I wonder?"
  },
  {
   "id": "MESSAGE084:07BF",
   "jp": "あら、もうおしまい?",
   "en": "Oh my, finished\nalready?"
  },
  {
   "id": "MESSAGE084:07CA",
   "jp": "あ~、すっきりした!",
   "en": "Ahh~, that felt great!"
  },
  {
   "id": "MESSAGE084:07D5",
   "jp": "ケーケケケッ!",
   "en": "Keh-kekekeh!"
  },
  {
   "id": "MESSAGE084:07DD",
   "jp": "グォォォーン!",
   "en": "Grooooan!"
  },
  {
   "id": "MESSAGE084:07E5",
   "jp": "グワォォォーン!",
   "en": "Grwaaaaagh!"
  },
  {
   "id": "MESSAGE084:07EE",
   "jp": "次は本気で来い!",
   "en": ""
  },
  {
   "id": "MESSAGE084:07FB",
   "jp": "専業主婦の力…\n見届けてくださいな",
   "en": "Witness a housewife's\npower, won't you?"
  },
  {
   "id": "MESSAGE084:0814",
   "jp": "当然の結果です。フフフ…",
   "en": "A natural outcome.\nHeh heh heh..."
  },
  {
   "id": "MESSAGE084:0825",
   "jp": "大人しくするんだな!",
   "en": "You'd best stay\ndown!"
  },
  {
   "id": "MESSAGE084:0832",
   "jp": "運が悪かったようね",
   "en": "Looks like your luck\nran out."
  },
  {
   "id": "MESSAGE084:083E",
   "jp": "我らの勝利だ!",
   "en": "Victory is ours!"
  },
  {
   "id": "MESSAGE084:0849",
   "jp": "あっけないものね?",
   "en": "Too easy, wasn't it?"
  },
  {
   "id": "MESSAGE084:0853",
   "jp": "諦めるんだな!",
   "en": "Give it up!"
  },
  {
   "id": "MESSAGE084:085C",
   "jp": "たいしたことないね!",
   "en": "You're nothing\nspecial!"
  },
  {
   "id": "MESSAGE084:0867",
   "jp": "まいったかい?",
   "en": "Had enough?"
  },
  {
   "id": "MESSAGE084:086F",
   "jp": "甘く見すぎよ",
   "en": "You took me too\nlightly."
  },
  {
   "id": "MESSAGE084:0878",
   "jp": "フン、出直してこい",
   "en": "Hmph, go try again."
  },
  {
   "id": "MESSAGE084:0884",
   "jp": "ザマ無いわねー!",
   "en": "How pathetic~!"
  },
  {
   "id": "MESSAGE084:088E",
   "jp": "愚かな…",
   "en": ""
  },
  {
   "id": "MESSAGE084:0894",
   "jp": "ケーケケケッ!",
   "en": "Keh-kekekeh!"
  },
  {
   "id": "MESSAGE084:089C",
   "jp": "グォォォーン!",
   "en": "Grooooan!"
  },
  {
   "id": "MESSAGE084:08A4",
   "jp": "ここから出て行くんだ!",
   "en": "Get out of here!"
  },
  {
   "id": "MESSAGE084:08B1",
   "jp": "出て行きなさい!",
   "en": "Leave at once!"
  }
 ]
}
