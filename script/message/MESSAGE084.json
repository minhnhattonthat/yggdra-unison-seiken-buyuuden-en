{
 "file": "MESSAGE084.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE084:0640",
   "jp": "まだやるかい?",
   "en": ""
  },
  {
   "id": "MESSAGE084:0648",
   "jp": "その程度かよ!?",
   "en": ""
  },
  {
   "id": "MESSAGE084:0653",
   "jp": "当然の報いだ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:065E",
   "jp": "退きはしません!",
   "en": ""
  },
  {
   "id": "MESSAGE084:0668",
   "jp": "この程度で\n私を倒すつもりか?",
   "en": ""
  },
  {
   "id": "MESSAGE084:067B",
   "jp": "この程度で私を倒せると?",
   "en": ""
  },
  {
   "id": "MESSAGE084:068B",
   "jp": "みんなを守れれば\nそれでいいの",
   "en": ""
  },
  {
   "id": "MESSAGE084:069C",
   "jp": "この地から去るならば、\nこちらも手出しはしない",
   "en": ""
  },
  {
   "id": "MESSAGE084:06B8",
   "jp": "フン…あばよ",
   "en": ""
  },
  {
   "id": "MESSAGE084:06BF",
   "jp": "その腕前では…",
   "en": ""
  },
  {
   "id": "MESSAGE084:06C9",
   "jp": "ここまでだ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:06D0",
   "jp": "もうやめた方がいいよ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:06DD",
   "jp": "その名、きっと忘れぬ",
   "en": ""
  },
  {
   "id": "MESSAGE084:06EA",
   "jp": "これ以上はおやめなさい",
   "en": ""
  },
  {
   "id": "MESSAGE084:06F8",
   "jp": "へっ、無駄だぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:0703",
   "jp": "いやっほーい!",
   "en": ""
  },
  {
   "id": "MESSAGE084:070B",
   "jp": "ワシの強さ思い知ったかぁ?",
   "en": ""
  },
  {
   "id": "MESSAGE084:071C",
   "jp": "ガハハハ、どうじゃ?",
   "en": ""
  },
  {
   "id": "MESSAGE084:0727",
   "jp": "ボクをバカにするからだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:0735",
   "jp": "やっつけたよ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:073D",
   "jp": "運も実力のうちだからね",
   "en": ""
  },
  {
   "id": "MESSAGE084:074C",
   "jp": "邪魔しやがるからだぜぃ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:075B",
   "jp": "…目標を撃破しました",
   "en": ""
  },
  {
   "id": "MESSAGE084:076A",
   "jp": "その程度なのか?",
   "en": ""
  },
  {
   "id": "MESSAGE084:0775",
   "jp": "おうちに帰りなさいな",
   "en": ""
  },
  {
   "id": "MESSAGE084:0781",
   "jp": "その心意気は認めよう",
   "en": ""
  },
  {
   "id": "MESSAGE084:0790",
   "jp": "これが神のご計画なのだ",
   "en": ""
  },
  {
   "id": "MESSAGE084:079E",
   "jp": "わしは何も悪くない!",
   "en": ""
  },
  {
   "id": "MESSAGE084:07AB",
   "jp": "さあ、次のお相手は\n誰かしら?",
   "en": ""
  },
  {
   "id": "MESSAGE084:07BF",
   "jp": "あら、もうおしまい?",
   "en": ""
  },
  {
   "id": "MESSAGE084:07CA",
   "jp": "あ~、すっきりした!",
   "en": ""
  },
  {
   "id": "MESSAGE084:07D5",
   "jp": "ケーケケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:07DD",
   "jp": "グォォォーン!",
   "en": ""
  },
  {
   "id": "MESSAGE084:07E5",
   "jp": "グワォォォーン!",
   "en": ""
  },
  {
   "id": "MESSAGE084:07EE",
   "jp": "次は本気で来い!",
   "en": ""
  },
  {
   "id": "MESSAGE084:07FB",
   "jp": "専業主婦の力…\n見届けてくださいな",
   "en": ""
  },
  {
   "id": "MESSAGE084:0814",
   "jp": "当然の結果です。フフフ…",
   "en": ""
  },
  {
   "id": "MESSAGE084:0825",
   "jp": "大人しくするんだな!",
   "en": ""
  },
  {
   "id": "MESSAGE084:0832",
   "jp": "運が悪かったようね",
   "en": ""
  },
  {
   "id": "MESSAGE084:083E",
   "jp": "我らの勝利だ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:0849",
   "jp": "あっけないものね?",
   "en": ""
  },
  {
   "id": "MESSAGE084:0853",
   "jp": "諦めるんだな!",
   "en": ""
  },
  {
   "id": "MESSAGE084:085C",
   "jp": "たいしたことないね!",
   "en": ""
  },
  {
   "id": "MESSAGE084:0867",
   "jp": "まいったかい?",
   "en": ""
  },
  {
   "id": "MESSAGE084:086F",
   "jp": "甘く見すぎよ",
   "en": ""
  },
  {
   "id": "MESSAGE084:0878",
   "jp": "フン、出直してこい",
   "en": ""
  },
  {
   "id": "MESSAGE084:0884",
   "jp": "ザマ無いわねー!",
   "en": ""
  },
  {
   "id": "MESSAGE084:088E",
   "jp": "愚かな…",
   "en": ""
  },
  {
   "id": "MESSAGE084:0894",
   "jp": "ケーケケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:089C",
   "jp": "グォォォーン!",
   "en": ""
  },
  {
   "id": "MESSAGE084:08A4",
   "jp": "ここから出て行くんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE084:08B1",
   "jp": "出て行きなさい!",
   "en": ""
  }
 ]
}
