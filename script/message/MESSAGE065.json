{
 "file": "MESSAGE065.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE065:0410",
   "jp": "う、討ち取った…",
   "en": "I-I killed 'em..."
  },
  {
   "id": "MESSAGE065:041B",
   "jp": "手元が狂った…!?",
   "en": "Did my hand slip...?!"
  },
  {
   "id": "MESSAGE065:0428",
   "jp": "アイギナ、ごめんね…!",
   "en": "Aegina, I'm sorry...!"
  },
  {
   "id": "MESSAGE065:0434",
   "jp": "そんな…\nルシエナ姉さんッ!",
   "en": "No...\nSister Luciana!"
  },
  {
   "id": "MESSAGE065:0444",
   "jp": "ごめん…ごめんね……",
   "en": "Sorry... I'm so\nsorry..."
  },
  {
   "id": "MESSAGE065:044F",
   "jp": "手強い相手だった…",
   "en": "A formidable foe..."
  },
  {
   "id": "MESSAGE065:045D",
   "jp": "ククク…\n最高の気分だぜ!",
   "en": "Heh heh heh...\nThis feels great!"
  },
  {
   "id": "MESSAGE065:046F",
   "jp": "敵ながら見事…",
   "en": "Though a foe, thou\nwert splendid..."
  },
  {
   "id": "MESSAGE065:047A",
   "jp": "運命を受け入れることだ",
   "en": "Accept your fate."
  },
  {
   "id": "MESSAGE065:048A",
   "jp": "わあ、すごいすごい!",
   "en": "Wow, amazing,\namazing!"
  },
  {
   "id": "MESSAGE065:0495",
   "jp": "やべっ、手元が狂ったか!?",
   "en": "Whoops, did my\nhand slip?!"
  },
  {
   "id": "MESSAGE065:04A6",
   "jp": "運が悪かったのぉ!",
   "en": "Tough luck, eh!"
  },
  {
   "id": "MESSAGE065:04B2",
   "jp": "その宝石はワシが頂くわい!",
   "en": "That gem's mine\nnow, heh!"
  },
  {
   "id": "MESSAGE065:04C3",
   "jp": "子供になんて負けないよーだ",
   "en": "Like I'd lose to\na kid! Nyeh!"
  },
  {
   "id": "MESSAGE065:04D4",
   "jp": "手加減はしなかったよ",
   "en": "I didn't hold back!"
  },
  {
   "id": "MESSAGE065:04E2",
   "jp": "残念だったな",
   "en": "Too bad."
  },
  {
   "id": "MESSAGE065:04EB",
   "jp": "……!!",
   "en": "...!!"
  },
  {
   "id": "MESSAGE065:04F0",
   "jp": "フフ…永遠を貴方にあげる",
   "en": "Fufu... I'll give\nyou eternity."
  },
  {
   "id": "MESSAGE065:0501",
   "jp": "私を愚弄した罰だ",
   "en": "That is the price\nof mocking me."
  },
  {
   "id": "MESSAGE065:050D",
   "jp": "フン…バカめ",
   "en": "Hmph... Fool."
  },
  {
   "id": "MESSAGE065:0514",
   "jp": "し、死んで詫びるんじゃな!",
   "en": "D-die and atone\nfor it, I say!"
  },
  {
   "id": "MESSAGE065:0524",
   "jp": "ふふ、さようなら",
   "en": "Hmhm, farewell."
  },
  {
   "id": "MESSAGE065:052D",
   "jp": "ふふふ…ちょっと燃えたわ",
   "en": "Ufufu... that got me\na little fired up."
  },
  {
   "id": "MESSAGE065:053B",
   "jp": "あ~ん、せっかくの\nウンディーネだったのに~!",
   "en": "Waaah, and she was\nsuch a nice Undine~!"
  },
  {
   "id": "MESSAGE065:0553",
   "jp": "ケケーッ!",
   "en": "Kekeeeh!"
  },
  {
   "id": "MESSAGE065:0559",
   "jp": "グォォォォーグォッ!!!",
   "en": "Grooooo- Groh!!!"
  },
  {
   "id": "MESSAGE065:0566",
   "jp": "グワォォォォーグワォッ!",
   "en": "Grwaaaaa- Grwaoh!"
  },
  {
   "id": "MESSAGE065:0573",
   "jp": "さらばだ、軍神よ…",
   "en": "Farewell,\nGod of War..."
  },
  {
   "id": "MESSAGE065:057E",
   "jp": "そうやって、あたくしの\n前から消えてしまうのね?",
   "en": "So you'll just vanish\nfrom my sight, dear?"
  },
  {
   "id": "MESSAGE065:0599",
   "jp": "そのまま、お消えなさい…\nフフフ…",
   "en": "Now, do fade away...\nHeh heh heh..."
  }
 ]
}
