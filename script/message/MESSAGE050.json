{
 "file": "MESSAGE050.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE050:04C0",
   "jp": "さあ、次は誰だ?",
   "en": "Alright, who's next?"
  },
  {
   "id": "MESSAGE050:04CB",
   "jp": "ザコは引っ込んでな!",
   "en": "Small fry, scram!"
  },
  {
   "id": "MESSAGE050:04D8",
   "jp": "撃破しました!",
   "en": "Enemy down!"
  },
  {
   "id": "MESSAGE050:04E2",
   "jp": "敵、撃破しました!",
   "en": "The enemy is\ndefeated!"
  },
  {
   "id": "MESSAGE050:04EF",
   "jp": "この程度、たやすいものだ",
   "en": "This much is child's\nplay."
  },
  {
   "id": "MESSAGE050:04FE",
   "jp": "この程度で負けはしない",
   "en": "I won't lose to the\nlikes of this."
  },
  {
   "id": "MESSAGE050:050D",
   "jp": "軽いわね!",
   "en": "Too easy!"
  },
  {
   "id": "MESSAGE050:0514",
   "jp": "敵、撃破しました!",
   "en": "The enemy is\ndefeated!"
  },
  {
   "id": "MESSAGE050:0521",
   "jp": "ザコに用はねえんだよ!",
   "en": "I got no time for\nsmall fry!"
  },
  {
   "id": "MESSAGE050:052E",
   "jp": "やりましたぞ",
   "en": "'Tis done."
  },
  {
   "id": "MESSAGE050:0535",
   "jp": "手を引きたまえ",
   "en": "Withdraw from this\nfight."
  },
  {
   "id": "MESSAGE050:053F",
   "jp": "やった!　やっつけたよ!",
   "en": "Yay! Nietzsche beat\nthem!"
  },
  {
   "id": "MESSAGE050:054C",
   "jp": "我らに勝てると\n本気で思っているのか?",
   "en": "Do you truly think\nyou can defeat us?"
  },
  {
   "id": "MESSAGE050:0565",
   "jp": "歩を進めましょう",
   "en": "Let us advance."
  },
  {
   "id": "MESSAGE050:0570",
   "jp": "へっ、出直してきやがれ!",
   "en": "Heh, come back when\nyou're ready!"
  },
  {
   "id": "MESSAGE050:057F",
   "jp": "やったでありますっ!",
   "en": "I did it, sir!"
  },
  {
   "id": "MESSAGE050:058A",
   "jp": "ほっほー!\nザコはどいてろぃ!",
   "en": "Hoho!\nScram, small fry!"
  },
  {
   "id": "MESSAGE050:059A",
   "jp": "死にたくなかったらどけぃ!",
   "en": "Outta my way if ya\nwanna live, sonny!"
  },
  {
   "id": "MESSAGE050:05A9",
   "jp": "はい、おしまい!",
   "en": "And that's that!"
  },
  {
   "id": "MESSAGE050:05B2",
   "jp": "やったぁ♪",
   "en": "Yaaay~!"
  },
  {
   "id": "MESSAGE050:05B8",
   "jp": "簡単に倒せると思うなよ",
   "en": "Don't think I'm easy\nto beat."
  },
  {
   "id": "MESSAGE050:05C8",
   "jp": "どんどんやっつけようぜ!",
   "en": "Let's keep knockin'\n'em down!"
  },
  {
   "id": "MESSAGE050:05D5",
   "jp": "勝利…しました",
   "en": "I... was victorious."
  },
  {
   "id": "MESSAGE050:05DF",
   "jp": "撃破だ",
   "en": "Target down."
  },
  {
   "id": "MESSAGE050:05E5",
   "jp": "フフ、これが裁きなのよ",
   "en": "Fufu... this is\njudgment."
  },
  {
   "id": "MESSAGE050:05F2",
   "jp": "私の敵では無いな",
   "en": "You are no match for\nme."
  },
  {
   "id": "MESSAGE050:05FD",
   "jp": "フン、光栄に思え",
   "en": "Hmph. Consider it an\nhonor."
  },
  {
   "id": "MESSAGE050:0609",
   "jp": "黙って通せば良いものを…",
   "en": "If only you'd just\nlet me pass..."
  },
  {
   "id": "MESSAGE050:0619",
   "jp": "ざっとこんなものよ",
   "en": "That's how it's done."
  },
  {
   "id": "MESSAGE050:0623",
   "jp": "ザコは下がっていなさい!",
   "en": "Small fry, stand\nback!"
  },
  {
   "id": "MESSAGE050:0630",
   "jp": "ザコ撃破~♪",
   "en": "Small fry, squashed~!"
  },
  {
   "id": "MESSAGE050:0639",
   "jp": "ケケーッ!",
   "en": "Kekeeeh!"
  },
  {
   "id": "MESSAGE050:063F",
   "jp": "グォーーーッ!",
   "en": "Grooooh!"
  },
  {
   "id": "MESSAGE050:0647",
   "jp": "グワォーーーッ!",
   "en": "Grwaooooh!"
  },
  {
   "id": "MESSAGE050:0650",
   "jp": "フン、愚かな…",
   "en": "Hmph. Fools..."
  },
  {
   "id": "MESSAGE050:0659",
   "jp": "時には愛する者のために…",
   "en": "Sometimes, for the\nones we love..."
  },
  {
   "id": "MESSAGE050:0669",
   "jp": "愚かな…",
   "en": "How foolish..."
  }
 ]
}
