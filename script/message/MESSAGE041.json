 "strings": [
  {
   "id": "MESSAGE041:0640",
   "jp": "くっ、いい腕前してるな…",
   "en": "Ngh... you're good..."
  },
  {
   "id": "MESSAGE041:064F",
   "jp": "つ、強えぇ…",
   "en": "D-damn, ya're tough..."
  },
  {
   "id": "MESSAGE041:0657",
   "jp": "何故…何故なんだよ!?",
   "en": "Why... why?!"
  },
  {
   "id": "MESSAGE041:0667",
   "jp": "し、しまった…",
   "en": "Oh, n-no..."
  },
  {
   "id": "MESSAGE041:066F",
   "jp": "くっ…油断したか……!",
   "en": "Tch... I let my guard\ndown......!"
