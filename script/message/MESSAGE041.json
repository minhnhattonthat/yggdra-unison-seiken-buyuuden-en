  },
  {
   "id": "MESSAGE041:07C6",
   "jp": "グワォ…グワォォォ~……",
   "en": "Grwao...\nGrwaooo~......"
  },
  {
   "id": "MESSAGE041:07D3",
   "jp": "ば…かな……",
