  {
   "id": "MESSAGE041:0708",
   "jp": "よ、予想外じゃ…",
   "en": "D-didn't see\nthat comin'..."
  },
  {
   "id": "MESSAGE041:0714",
   "jp": "ボクの力じゃ…\n足りないのかな…",
   "en": "Am I... not strong\nenough...?"
  },
  {
   "id": "MESSAGE041:0727",
   "jp": "ヘマしちゃった…",
   "en": "Aww, I goofed..."
  },
  {
   "id": "MESSAGE041:0730",
   "jp": "弓、尽きたり…",
   "en": "My arrows... are\nspent..."
  },
  {
   "id": "MESSAGE041:073A",
   "jp": "おいおい、またかよ…!",
   "en": "Aw c'mon, not\nagain...!"
