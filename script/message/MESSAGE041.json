   "jp": "私もまだまだ未熟…",
   "en": "I still have much to\nlearn..."
  },
  {
   "id": "MESSAGE041:06A5",
   "jp": "な、何故だ!?",
   "en": "Wh-why?!"
  },
  {
   "id": "MESSAGE041:06AF",
   "jp": "拙者を負かすとは…",
   "en": "To think thou hast\nbested me..."
  },
  {
   "id": "MESSAGE041:06BC",
   "jp": "敵を侮りすぎたか…",
   "en": "I underestimated my\nfoe..."
  },
  {
   "id": "MESSAGE041:06C8",
   "jp": "頑張ったのにな…",
   "en": "But Nietzsche tried\nso hard..."
  },
  {
   "id": "MESSAGE041:06D3",
   "jp": "くっ、しまった…!",
   "en": "Ngh, a blunder...!"
  },
  {
   "id": "MESSAGE041:06DD",
   "jp": "油断しました…",
   "en": "I was careless..."
  },
  {
   "id": "MESSAGE041:06E7",
   "jp": "くそっ、調子が出ねえ…",
   "en": "Damn, I'm off my\ngame..."
