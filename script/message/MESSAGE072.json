{
 "file": "MESSAGE072.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE072:0410",
   "jp": "さすがは将軍…",
   "en": "A general\nindeed..."
  },
  {
   "id": "MESSAGE072:041A",
   "jp": "さすが…\n戦い慣れているわね……",
   "en": "Impressive... you\nknow battle well..."
  },
  {
   "id": "MESSAGE072:042D",
   "jp": "私の負け…か……",
   "en": "So I've...\nlost......"
  },
  {
   "id": "MESSAGE072:0437",
   "jp": "私の負け、か…",
   "en": "So I lose..."
  },
  {
   "id": "MESSAGE072:0440",
   "jp": "さすがだわ…",
   "en": "Impressive..."
  },
  {
   "id": "MESSAGE072:0447",
   "jp": "流石は軍神…",
   "en": "Truly the\nGod of War..."
  },
  {
   "id": "MESSAGE072:0451",
   "jp": "お…おのれえぇぇぇッ!!",
   "en": "D-damn yoouuu!!"
  },
  {
   "id": "MESSAGE072:045E",
   "jp": "見事であったぞ…",
   "en": "Well fought,\nI say..."
  },
  {
   "id": "MESSAGE072:0469",
   "jp": "ここまでか…!",
   "en": "Is this the end...!"
  },
  {
   "id": "MESSAGE072:0471",
   "jp": "えーん、くやしいよ~!",
   "en": "Waaah, no fair~!"
  },
  {
   "id": "MESSAGE072:047D",
   "jp": "全く、大したおてんばだぜ…",
   "en": "Geez, what a\ntomboy..."
  },
  {
   "id": "MESSAGE072:048D",
   "jp": "こんなガキに…",
   "en": "To a brat like this..."
  },
  {
   "id": "MESSAGE072:0495",
   "jp": "こんな金ピカに負けるとは…",
   "en": "Beaten by this\ngilded peacock, heh..."
  },
  {
   "id": "MESSAGE072:04A5",
   "jp": "し、信じられない…!",
   "en": "I-I can't\nbelieve it...!"
  },
  {
   "id": "MESSAGE072:04B1",
   "jp": "ウチが引けをとるなんて…っ",
   "en": "Me, falling\nbehind...?!"
  },
  {
   "id": "MESSAGE072:04C0",
   "jp": "正義…敗れたり……",
   "en": "Justice...\nis defeated......"
  },
  {
   "id": "MESSAGE072:04CD",
   "jp": "陛…下……",
   "en": "Your... Majesty......"
  },
  {
   "id": "MESSAGE072:04D4",
   "jp": "予想外よ…",
   "en": "Unexpected..."
  },
  {
   "id": "MESSAGE072:04DD",
   "jp": "生意気なことを…!",
   "en": "Such impudence...!"
  },
  {
   "id": "MESSAGE072:04EA",
   "jp": "お、女ごときに…",
   "en": "B-by a mere woman..."
  },
  {
   "id": "MESSAGE072:04F4",
   "jp": "お前には色々と目をかけて\nやったではないか!?",
   "en": "Didn't I look out\nfor ya all this time?!"
  },
  {
   "id": "MESSAGE072:0510",
   "jp": "あ、ありえないわ…!",
   "en": "Th-this can't\nbe happening...!"
  },
  {
   "id": "MESSAGE072:051B",
   "jp": "し、信じられないわ…!",
   "en": "I-I can't\nbelieve this...!"
  },
  {
   "id": "MESSAGE072:0528",
   "jp": "うわーん、見逃して~",
   "en": "Waaah,\nlet me go~"
  },
  {
   "id": "MESSAGE072:0535",
   "jp": "ケ…ケケ~……",
   "en": "Ke... Kekeh~......"
  },
  {
   "id": "MESSAGE072:053D",
   "jp": "グォ…グォォォ~……!!",
   "en": "Gro... Groooh~......!!"
  },
  {
   "id": "MESSAGE072:054A",
   "jp": "グワォ…グワォォォ~……",
   "en": "Grwao...\nGrwaooo~......"
  },
  {
   "id": "MESSAGE072:0557",
   "jp": "まさか、これほどとは…!",
   "en": "I never expected\nsuch strength...!"
  },
  {
   "id": "MESSAGE072:0564",
   "jp": "あらあら~そんな\n恥ずかしいですわ~",
   "en": "Oh my, oh my~\nhow embarrassing~"
  },
  {
   "id": "MESSAGE072:0578",
   "jp": "貴方の何処にそのような\n力が…?",
   "en": "Where did you find\nsuch power...?"
  }
 ]
}
