{
 "file": "MESSAGE214.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE214:04C0",
   "jp": "これはすごいな…\nなんてまばゆい宝箱なんだ",
   "en": ""
  },
  {
   "id": "MESSAGE214:04D8",
   "jp": "あからさまに派手だと、\n逆に疑っちまうんだよナ…",
   "en": ""
  },
  {
   "id": "MESSAGE214:04F5",
   "jp": "これは、気をつけて\n運ばないとな",
   "en": ""
  },
  {
   "id": "MESSAGE214:0508",
   "jp": "見るからに豪華ね…\n何が入っているのかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE214:0524",
   "jp": "これなら間違いはあるまい",
   "en": ""
  },
  {
   "id": "MESSAGE214:0533",
   "jp": "この箱なら間違いはあるまい",
   "en": ""
  },
  {
   "id": "MESSAGE214:0544",
   "jp": "こんな豪華な箱、\n見たこと無いわ…",
   "en": ""
  },
  {
   "id": "MESSAGE214:055B",
   "jp": "これは価値がありそうですね",
   "en": ""
  },
  {
   "id": "MESSAGE214:056B",
   "jp": "ククッ、久々の大物だぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE214:057C",
   "jp": "ううむ…\nなんと豪奢な宝箱じゃ",
   "en": ""
  },
  {
   "id": "MESSAGE214:0590",
   "jp": "外見が如何に豪華であろうと\n中身も相応とは限らない…か",
   "en": ""
  },
  {
   "id": "MESSAGE214:05B7",
   "jp": "わあ~…この箱、\nキラキラしててきれい!",
   "en": ""
  },
  {
   "id": "MESSAGE214:05CD",
   "jp": "ギラギラしていて\n品の無い箱だな…",
   "en": ""
  },
  {
   "id": "MESSAGE214:05E2",
   "jp": "とても凝った箱ですね…\nこれにいたしましょう",
   "en": ""
  },
  {
   "id": "MESSAGE214:05FB",
   "jp": "へへっ、大物が入ってる\n予感がするぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE214:0614",
   "jp": "すっげー!\nこんなの見たことねぇや!",
   "en": ""
  },
  {
   "id": "MESSAGE214:0628",
   "jp": "うっひょー!\nこりゃあすげぇ宝箱だぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE214:063F",
   "jp": "うほお!\nこれを逃す手はないのう!",
   "en": ""
  },
  {
   "id": "MESSAGE214:0653",
   "jp": "なんか重たそうな箱だなあ…",
   "en": ""
  },
  {
   "id": "MESSAGE214:0663",
   "jp": "この箱、\nウチが触っていいのかな?",
   "en": ""
  },
  {
   "id": "MESSAGE214:0677",
   "jp": "この箱、\n壊れ物だったりしないよな?",
   "en": ""
  },
  {
   "id": "MESSAGE214:068D",
   "jp": "ひゃっほう!　これで\nオイラも大金持ちだぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE214:06A7",
   "jp": "任務完了…です",
   "en": ""
  },
  {
   "id": "MESSAGE214:06B3",
   "jp": "決まりだな",
   "en": ""
  },
  {
   "id": "MESSAGE214:06BA",
   "jp": "これで私の株も\n上がるというものね…",
   "en": ""
  },
  {
   "id": "MESSAGE214:06CF",
   "jp": "相当の物が\n入っているとみた",
   "en": ""
  },
  {
   "id": "MESSAGE214:06E2",
   "jp": "フッ、これぞ神のお導きだ",
   "en": ""
  },
  {
   "id": "MESSAGE214:06F0",
   "jp": "わしにぴったりの、\n気品あふれる箱じゃな!",
   "en": ""
  },
  {
   "id": "MESSAGE214:0709",
   "jp": "何だか無駄に\nゴージャスな箱ねぇ…",
   "en": ""
  },
  {
   "id": "MESSAGE214:071F",
   "jp": "ゴージャスだけど、\n何だか成金ぽくない?",
   "en": ""
  },
  {
   "id": "MESSAGE214:0737",
   "jp": "うほっ!?　ちょっとこれ、\nすごそうじゃない!?",
   "en": ""
  },
  {
   "id": "MESSAGE214:0750",
   "jp": "クケーッケッケッケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE214:075C",
   "jp": "グオオォォォ~ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE214:0766",
   "jp": "グワオオォォォ~ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE214:0771",
   "jp": "これなら期待できるであろう",
   "en": ""
  },
  {
   "id": "MESSAGE214:0781",
   "jp": "こういうの、ゴージャスって\n言うのかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE214:0798",
   "jp": "全ては中身が重要なのです。\nフフフ…",
   "en": ""
  }
 ]
}
