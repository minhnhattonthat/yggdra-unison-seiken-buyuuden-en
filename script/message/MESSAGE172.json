{
 "file": "MESSAGE172.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE172:0240",
   "jp": "本当の戦いはこれからね。\nさあ、参りましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE172:025C",
   "jp": "我らの輝かしい前途に\n神の祝福がありますよう…",
   "en": ""
  },
  {
   "id": "MESSAGE172:027A",
   "jp": "わたくしたちの未来に\n栄光と幸福があらんことを…",
   "en": ""
  },
  {
   "id": "MESSAGE172:0299",
   "jp": "オレは仲間を裏切らねぇ。\nみんな、ついてきてくれ!",
   "en": ""
  },
  {
   "id": "MESSAGE172:02B7",
   "jp": "一生遊んで暮らせるなんて\n夢のようだぞぉ!　へっへ!",
   "en": ""
  },
  {
   "id": "MESSAGE172:02D7",
   "jp": "ワシの伝説は終わらんぞい。\nさあ、行くとするかのう!",
   "en": ""
  },
  {
   "id": "MESSAGE172:02F5",
   "jp": "新たなる世界の民たちよ…\nこの私が栄華を約束しよう",
   "en": ""
  },
  {
   "id": "MESSAGE172:0317",
   "jp": "早速、わしにふさわしい\n宮殿を用意させねばのう!",
   "en": ""
  },
  {
   "id": "MESSAGE172:0336",
   "jp": "あたしは立ち止まらないわ。\nみんな、ついてきて頂戴!",
   "en": ""
  },
  {
   "id": "MESSAGE172:0355",
   "jp": "パメラ様の野望はまだまだ\n尽きないんだから…ウヒヒ♪",
   "en": ""
  },
  {
   "id": "MESSAGE172:0374",
   "jp": "我らは誰にも止められん!\nブロンガの世の幕開けだ!",
   "en": ""
  },
  {
   "id": "MESSAGE172:0394",
   "jp": "この力を以って…神々に\n復讐を成すとしましょう!",
   "en": ""
  }
 ]
}
