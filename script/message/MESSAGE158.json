{
 "file": "MESSAGE158.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE158:0240",
   "jp": "次の戦いも\nこの調子で頑張りましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE158:025A",
   "jp": "神のご加護のもと\n平和を勝ち取るのだ!",
   "en": ""
  },
  {
   "id": "MESSAGE158:0274",
   "jp": "一族の未来はわたくしたちの\n手にかかっているのです",
   "en": ""
  },
  {
   "id": "MESSAGE158:0293",
   "jp": "快進撃だぜ!\nこの勢いでいくぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE158:02A8",
   "jp": "次回の戦も\nこの勢いで頑張るぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE158:02C0",
   "jp": "いい気分じゃのう!\n次もこの調子で稼ぐぞい!",
   "en": ""
  },
  {
   "id": "MESSAGE158:02DD",
   "jp": "我々の進撃を\n止められる者などいないのだ",
   "en": ""
  },
  {
   "id": "MESSAGE158:02F8",
   "jp": "み…皆の者!\n次回も頑張ってくれ!",
   "en": ""
  },
  {
   "id": "MESSAGE158:0310",
   "jp": "この勢いで\nどんどん攻め落とすわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE158:0326",
   "jp": "野望は大きく持たなきゃね♪\n次もガンガンいくわよー!",
   "en": ""
  },
  {
   "id": "MESSAGE158:0346",
   "jp": "皆、よくぞ頑張った。\n我らの天下も近いであろう!",
   "en": ""
  },
  {
   "id": "MESSAGE158:0365",
   "jp": "みなさん、良く働いて\nくれましたね",
   "en": ""
  }
 ]
}
