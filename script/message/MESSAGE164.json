 "strings": [
  {
   "id": "MESSAGE164:0480",
   "jp": "まあ、行ってくるか…",
   "en": ""
  },
  {
   "id": "MESSAGE164:048B",
   "jp": "行きゃあいいんだろ?",
   "en": ""
  },
  {
   "id": "MESSAGE164:0496",
   "jp": "行ってみます",
   "en": ""
  },
  {
   "id": "MESSAGE164:049D",
   "jp": "…分かりました",
   "en": ""
  },
  {
   "id": "MESSAGE164:04A6",
   "jp": "貴様ごときに\n従わねばならんとは…",
   "en": ""
  },
  {
   "id": "MESSAGE164:04BB",
   "jp": "貴様に従うつもりは\n無いのだがな…",
   "en": ""
  },
  {
   "id": "MESSAGE164:04D1",
   "jp": "…分かったわ",
   "en": ""
  },
  {
   "id": "MESSAGE164:04D9",
   "jp": "行ってみましょうか…",
   "en": ""
  },
  {
   "id": "MESSAGE164:04E4",
   "jp": "俺様に指図するとは\n大した度胸だな?　ああ?",
   "en": ""
  },
  {
   "id": "MESSAGE164:0502",
   "jp": "…分かり申した",
   "en": ""
  },
  {
   "id": "MESSAGE164:050C",
   "jp": "では、行ってみましょう",
   "en": ""
  },
  {
   "id": "MESSAGE164:0518",
   "jp": "わかった…行ってくるよ",
   "en": ""
  },
  {
   "id": "MESSAGE164:0524",
   "jp": "私が行く必要があるのか?",
   "en": ""
  },
  {
   "id": "MESSAGE164:0533",
   "jp": "気は進みませんが…",
   "en": ""
  },
  {
   "id": "MESSAGE164:053F",
   "jp": "バックレてぇよ…",
   "en": ""
  },
  {
   "id": "MESSAGE164:0548",
   "jp": "ちぇっ、仕方ねえなあ…",
   "en": ""
  },
  {
   "id": "MESSAGE164:0556",
   "jp": "めんどくせぇが…",
   "en": ""
  },
  {
   "id": "MESSAGE164:055F",
   "jp": "ワシが行く必要があるのか?",
   "en": ""
  },
  {
   "id": "MESSAGE164:056F",
   "jp": "ボクが行くの?\nめんどくさいよー…",
   "en": ""
  },
  {
   "id": "MESSAGE164:0581",
   "jp": "サッと行ってくるよ",
   "en": ""
  },
  {
   "id": "MESSAGE164:058B",
   "jp": "行ってみるか…",
   "en": ""
  },
  {
   "id": "MESSAGE164:0593",
   "jp": "オイラが行くのかよ…",
   "en": ""
  },
  {
   "id": "MESSAGE164:059E",
   "jp": "…すぐに戻ります……",
   "en": ""
  },
  {
   "id": "MESSAGE164:05AA",
   "jp": "…では",
   "en": ""
  },
  {
   "id": "MESSAGE164:05AE",
   "jp": "…わかったわ",
   "en": ""
  },
  {
   "id": "MESSAGE164:05B5",
   "jp": "気は進まんが…見てきてやる",
   "en": ""
  },
  {
   "id": "MESSAGE164:05C6",
   "jp": "神の言葉が聞こえぬが…\n行くべきだろうか?",
   "en": ""
  },
  {
   "id": "MESSAGE164:05DF",
   "jp": "い…行けば良いんじゃろう?",
   "en": ""
  },
  {
   "id": "MESSAGE164:05EE",
   "jp": "何であたしが行かなきゃ\nいけないのよ…",
   "en": ""
  },
  {
   "id": "MESSAGE164:0603",
   "jp": "…私が行くの?",
   "en": ""
  },
  {
   "id": "MESSAGE164:060B",
   "jp": "行けばいいんでしょ?\nぶーぶー!",
   "en": ""
  },
  {
   "id": "MESSAGE164:061C",
   "jp": "クケ?",
   "en": ""
  },
  {
   "id": "MESSAGE164:0620",
   "jp": "グォ?",
   "en": ""
  },
  {
   "id": "MESSAGE164:0624",
   "jp": "グワォ?",
   "en": ""
  },
  {
   "id": "MESSAGE164:0629",
   "jp": "フン、くだらんな…",
   "en": ""
  },
  {
   "id": "MESSAGE164:0633",
   "jp": "行けとおっしゃるのなら…\n仕方ありませんわ",
   "en": ""
  },
  {
   "id": "MESSAGE164:064B",
   "jp": "恐らく無駄足になるかと…",
   "en": ""
  }
 ]
