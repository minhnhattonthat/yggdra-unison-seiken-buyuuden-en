{
 "file": "MESSAGE164.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE164:0480",
   "jp": "まあ、行ってくるか…",
   "en": "Well, guess I'll go..."
  },
  {
   "id": "MESSAGE164:048B",
   "jp": "行きゃあいいんだろ?",
   "en": "Fine, I'll go, okay?"
  },
  {
   "id": "MESSAGE164:0496",
   "jp": "行ってみます",
   "en": "I'll go take a look."
  },
  {
   "id": "MESSAGE164:049D",
   "jp": "…分かりました",
   "en": "...I understand."
  },
  {
   "id": "MESSAGE164:04A6",
   "jp": "貴様ごときに\n従わねばならんとは…",
   "en": "To think I must obey\nthe likes of you..."
  },
  {
   "id": "MESSAGE164:04BB",
   "jp": "貴様に従うつもりは\n無いのだがな…",
   "en": "I've no intention\nof obeying you..."
  },
  {
   "id": "MESSAGE164:04D1",
   "jp": "…分かったわ",
   "en": "...All right."
  },
  {
   "id": "MESSAGE164:04D9",
   "jp": "行ってみましょうか…",
   "en": "I suppose I shall go..."
  },
  {
   "id": "MESSAGE164:04E4",
   "jp": "俺様に指図するとは\n大した度胸だな?　ああ?",
   "en": "Bossin' ME around?\nBig guts, huh? Huh?"
  },
  {
   "id": "MESSAGE164:0502",
   "jp": "…分かり申した",
   "en": "...So be it."
  },
  {
   "id": "MESSAGE164:050C",
   "jp": "では、行ってみましょう",
   "en": "Then I shall go."
  },
  {
   "id": "MESSAGE164:0518",
   "jp": "わかった…行ってくるよ",
   "en": "Okay... I'll go."
  },
  {
   "id": "MESSAGE164:0524",
   "jp": "私が行く必要があるのか?",
   "en": "Must I really go?"
  },
  {
   "id": "MESSAGE164:0533",
   "jp": "気は進みませんが…",
   "en": "I am reluctant, but..."
  },
  {
   "id": "MESSAGE164:053F",
   "jp": "バックレてぇよ…",
   "en": "I wanna bail..."
  },
  {
   "id": "MESSAGE164:0548",
   "jp": "ちぇっ、仕方ねえなあ…",
   "en": "Tch, guess I got\nno choice..."
  },
  {
   "id": "MESSAGE164:0556",
   "jp": "めんどくせぇが…",
   "en": "What a pain, but..."
  },
  {
   "id": "MESSAGE164:055F",
   "jp": "ワシが行く必要があるのか?",
   "en": "Does it gotta\nbe me, eh?"
  },
  {
   "id": "MESSAGE164:056F",
   "jp": "ボクが行くの?\nめんどくさいよー…",
   "en": "I have to go?\nWhat a paaain..."
  },
  {
   "id": "MESSAGE164:0581",
   "jp": "サッと行ってくるよ",
   "en": "Be back in a flash!"
  },
  {
   "id": "MESSAGE164:058B",
   "jp": "行ってみるか…",
   "en": "Guess I'll go..."
  },
  {
   "id": "MESSAGE164:0593",
   "jp": "オイラが行くのかよ…",
   "en": "Me? Seriously..."
  },
  {
   "id": "MESSAGE164:059E",
   "jp": "…すぐに戻ります……",
   "en": "...I'll return shortly..."
  },
  {
   "id": "MESSAGE164:05AA",
   "jp": "…では",
   "en": "...Then I go."
  },
  {
   "id": "MESSAGE164:05AE",
   "jp": "…わかったわ",
   "en": "...Fine."
  },
  {
   "id": "MESSAGE164:05B5",
   "jp": "気は進まんが…見てきてやる",
   "en": "I'm not keen...\nbut I'll look."
  },
  {
   "id": "MESSAGE164:05C6",
   "jp": "神の言葉が聞こえぬが…\n行くべきだろうか?",
   "en": "God's voice is silent...\nShould I go?"
  },
  {
   "id": "MESSAGE164:05DF",
   "jp": "い…行けば良いんじゃろう?",
   "en": "I-I just have\nto go, eh?"
  },
  {
   "id": "MESSAGE164:05EE",
   "jp": "何であたしが行かなきゃ\nいけないのよ…",
   "en": "Why do I have to go,\nof all people..."
  },
  {
   "id": "MESSAGE164:0603",
   "jp": "…私が行くの?",
   "en": "...Me? Go?"
  },
  {
   "id": "MESSAGE164:060B",
   "jp": "行けばいいんでしょ?\nぶーぶー!",
   "en": "Fine, I'll go!\nBoo, boo!"
  },
  {
   "id": "MESSAGE164:061C",
   "jp": "クケ?",
   "en": "Keh?"
  },
  {
   "id": "MESSAGE164:0620",
   "jp": "グォ?",
   "en": "Gwo?"
  },
  {
   "id": "MESSAGE164:0624",
   "jp": "グワォ?",
   "en": "Grwao?"
  },
  {
   "id": "MESSAGE164:0629",
   "jp": "フン、くだらんな…",
   "en": "Hmph, how tedious..."
  },
  {
   "id": "MESSAGE164:0633",
   "jp": "行けとおっしゃるのなら…\n仕方ありませんわ",
   "en": "If you insist I go...\nI suppose I must."
  },
  {
   "id": "MESSAGE164:064B",
   "jp": "恐らく無駄足になるかと…",
   "en": "I suspect it will be\na wasted trip..."
  }
 ]
}
