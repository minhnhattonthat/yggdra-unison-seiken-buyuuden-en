{
 "file": "MESSAGE173.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE173:0560",
   "jp": "よし、ここは押さえたぞ!",
   "en": "Right, this spot's\nsecured!"
  },
  {
   "id": "MESSAGE173:056E",
   "jp": "ヘッ!　これでこの勝負\n頂きだゼ!",
   "en": "Heh! This fight's\nin the bag now!"
  },
  {
   "id": "MESSAGE173:0583",
   "jp": "やった!　\nこれで怖いもの無しだ!",
   "en": "Yes!\nNow we fear nothing!"
  },
  {
   "id": "MESSAGE173:0597",
   "jp": "これで戦いを有利に\n展開できるわ!",
   "en": "This will give us the\nupper hand in battle!"
  },
  {
   "id": "MESSAGE173:05AE",
   "jp": "ここは我が軍が頂く!",
   "en": "This belongs\nto our army!"
  },
  {
   "id": "MESSAGE173:05BC",
   "jp": "ここは我ら帝国が頂く!",
   "en": "The Empire\nclaims this!"
  },
  {
   "id": "MESSAGE173:05CC",
   "jp": "占領したわ!\nこれならいけそうね!",
   "en": "Captured! This looks\npromising!"
  },
  {
   "id": "MESSAGE173:05E0",
   "jp": "占領しました!",
   "en": "It is captured!"
  },
  {
   "id": "MESSAGE173:05EA",
   "jp": "この程度…楽勝だぜ!",
   "en": "This? Easy pickin's!"
  },
  {
   "id": "MESSAGE173:05F9",
   "jp": "ここは我らが占領した。\n兵を退くが良い!",
   "en": "We have taken this.\nWithdraw thy troops!"
  },
  {
   "id": "MESSAGE173:0614",
   "jp": "このまま追撃に移る!",
   "en": "Now we press the\npursuit!"
  },
  {
   "id": "MESSAGE173:0622",
   "jp": "ここ、も~らいっ♪",
   "en": "This one's miiine~!"
  },
  {
   "id": "MESSAGE173:062C",
   "jp": "今のうちにここを確保だ!",
   "en": "Secure this place\nwhile we can!"
  },
  {
   "id": "MESSAGE173:063C",
   "jp": "ここを使わせる訳には\nまいりません…!",
   "en": "I cannot let you\nuse this...!"
  },
  {
   "id": "MESSAGE173:0652",
   "jp": "おらおら、甘いんだよ!",
   "en": "Hey hey! Way\ntoo soft!"
  },
  {
   "id": "MESSAGE173:065F",
   "jp": "占領するでやんすよ!",
   "en": "Takin' it over, yessir!"
  },
  {
   "id": "MESSAGE173:066C",
   "jp": "そりゃあ!\n山賊の力を見せてやるぞぉ!",
   "en": "Hyaaah!\nFeel brigand power!"
  },
  {
   "id": "MESSAGE173:0684",
   "jp": "盗賊の力を見せてやるぞい!\nそりゃあ!",
   "en": "Feel bandit might, eh!\nHyaaah!"
  },
  {
   "id": "MESSAGE173:069C",
   "jp": "ボクたちの\n邪魔しないでよね!",
   "en": "Don't get in\nour way!"
  },
  {
   "id": "MESSAGE173:06AE",
   "jp": "ここはゲットしたよ♪",
   "en": "Got this one~!"
  },
  {
   "id": "MESSAGE173:06B9",
   "jp": "よし、これさえあれば…",
   "en": "Alright, with this..."
  },
  {
   "id": "MESSAGE173:06C5",
   "jp": "ひゃっほーい!\nここは頂きだぜ!",
   "en": "Yahooo!\nThis is mine!"
  },
  {
   "id": "MESSAGE173:06D7",
   "jp": "…占領しました",
   "en": "...Captured."
  },
  {
   "id": "MESSAGE173:06E1",
   "jp": "ここは我が軍が頂いた!",
   "en": "Our army has\ntaken this!"
  },
  {
   "id": "MESSAGE173:06F0",
   "jp": "欲しければ奪ってみなさいな",
   "en": "If you want it, try\ntaking it, dear."
  },
  {
   "id": "MESSAGE173:0700",
   "jp": "ここは我が黒薔薇が頂いた!",
   "en": "My Black Rose\nclaims this!"
  },
  {
   "id": "MESSAGE173:0713",
   "jp": "ここは神のご計画のため\n清めて使わせてもらう!",
   "en": "For God's plan, I'll\npurify this and use it!"
  },
  {
   "id": "MESSAGE173:072F",
   "jp": "ま…間に合った!\nこれを使われてはかなわん!",
   "en": "M-made it! Can't have\nthem using this!"
  },
  {
   "id": "MESSAGE173:0749",
   "jp": "これさえ手に入れば…\n百人力よ!",
   "en": "With this in hand...\nI'm a hundred strong!"
  },
  {
   "id": "MESSAGE173:075F",
   "jp": "あははっ!\n武器はもらったわ!",
   "en": "Ahaha!\nThe weapon is mine!"
  },
  {
   "id": "MESSAGE173:0771",
   "jp": "じゃーん、いっただきぃ~♪",
   "en": "Ta-daa! Yoink~!"
  },
  {
   "id": "MESSAGE173:077F",
   "jp": "クケケケ~ッ!",
   "en": "Kukekeke~!"
  },
  {
   "id": "MESSAGE173:0787",
   "jp": "こんなもの…\n使わせませんわよ?",
   "en": "A thing like this... I\nwon't let you use it~"
  },
  {
   "id": "MESSAGE173:0799",
   "jp": "上手くいきましたね…\nフフフ…",
   "en": "That went well...\nHeh heh heh..."
  },
  {
   "id": "MESSAGE173:07AB",
   "jp": "どうだっ!?",
   "en": "How's that!?"
  },
  {
   "id": "MESSAGE173:07B2",
   "jp": "占領したわ!",
   "en": "I've captured it!"
  },
  {
   "id": "MESSAGE173:07BB",
   "jp": "騎士の力\n思い知ったか!",
   "en": "Felt a knight's\npower yet!?"
  },
  {
   "id": "MESSAGE173:07CD",
   "jp": "やったわ…!",
   "en": "I did it...!"
  },
  {
   "id": "MESSAGE173:07D4",
   "jp": "ざまぁみやがれぃ!",
   "en": "Serves ya right!"
  },
  {
   "id": "MESSAGE173:07DE",
   "jp": "見事占領したよっ!",
   "en": "Captured, and nicely!"
  },
  {
   "id": "MESSAGE173:07EC",
   "jp": "思い知ったかい?",
   "en": "Learned your lesson?"
  },
  {
   "id": "MESSAGE173:07F7",
   "jp": "占領した…!",
   "en": "Captured...!"
  },
  {
   "id": "MESSAGE173:0800",
   "jp": "フン、手ごたえも無い…",
   "en": "Hmph, no challenge\nat all..."
  },
  {
   "id": "MESSAGE173:080E",
   "jp": "これさえ手に入れば…\n怖いものはないわね!",
   "en": "With this in hand...\nI fear nothing!"
  },
  {
   "id": "MESSAGE173:0827",
   "jp": "クケーッケッケッケ!",
   "en": "Kukeh! Kekekeke!"
  },
  {
   "id": "MESSAGE173:0832",
   "jp": "やった、占領したぞ!",
   "en": "Yes, we took it!"
  },
  {
   "id": "MESSAGE173:083F",
   "jp": "占領したわよ!",
   "en": "We've taken it!"
  }
 ]
}
