  {
   "id": "MESSAGE029:07B4",
   "jp": "グワォォォッグワォッ!",
   "en": "Grwaooo! Grwaoh!"
  },
  {
   "id": "MESSAGE029:07C0",
   "jp": "愚民どもが\n身の程を知れッ!",
   "en": "Foolish rabble...\nknow your place!"
  },
  {
   "id": "MESSAGE029:07D4",
   "jp": "馬鹿にしないでくださいな!",
   "en": "Please don't\nmock me, dear!"
  },
  {
   "id": "MESSAGE029:07E4",
   "jp": "自分の無力さを\n悟ったらどうです?",
   "en": "Why not accept\nyour powerlessness?"
  },
  {
   "id": "MESSAGE029:07FB",
   "jp": "受けて立つぜ!",
   "en": "Bring it on!"
  },
  {
   "id": "MESSAGE029:0805",
   "jp": "くらいなさいっ!",
   "en": "Take this!"
  },
  {
   "id": "MESSAGE029:080E",
   "jp": "お返しする!",
   "en": "Have it back!"
  },
  {
   "id": "MESSAGE029:0816",
   "jp": "お返しよっ!",
   "en": "Right back at you!"
  },
  {
   "id": "MESSAGE029:081E",
   "jp": "ちっ、やるじゃねぇか!",
   "en": "Tch, not bad!"
  },
  {
   "id": "MESSAGE029:082A",
   "jp": "負けないよッ!",
   "en": "I won't lose!"
  },
  {
   "id": "MESSAGE029:0833",
   "jp": "これでもくらっとけ!",
   "en": "Eat this!"
  },
  {
   "id": "MESSAGE029:083E",
   "jp": "これならどう?",
   "en": "How's this?"
  },
  {
   "id": "MESSAGE029:0846",
   "jp": "はあああッ!",
   "en": "Haaaah!"
  },
  {
   "id": "MESSAGE029:084D",
   "jp": "痛くないんだからー!",
   "en": "That didn't\nhurt at all!"
  },
  {
   "id": "MESSAGE029:0859",
   "jp": "度胸は認めてやろう!",
   "en": "I'll grant\nyou have guts!"
  },
  {
   "id": "MESSAGE029:0867",
   "jp": "クケケケケッ!",
   "en": "Kukekekeke!"
  },
  {
   "id": "MESSAGE029:086F",
   "jp": "ゴオォォォッ!",
   "en": "Gooooh!"
  },
  {
   "id": "MESSAGE029:0877",
   "jp": "お返しだ!",
   "en": "Payback!"
  },
  {
   "id": "MESSAGE029:087E",
   "jp": "そーれっ!",
   "en": "Hiyaaa!"
  }
 ]
