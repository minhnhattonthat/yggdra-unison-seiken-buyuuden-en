 "strings": [
  {
   "id": "MESSAGE029:0640",
   "jp": "これならどうだ!",
   "en": "How about this!"
  },
  {
   "id": "MESSAGE029:0649",
   "jp": "オレ様の剣にビビったか!?",
   "en": "The great me's blade\nscared ya, huh!?"
  },
  {
   "id": "MESSAGE029:0659",
   "jp": "俺だって戦えるんだ!",
   "en": "I can fight too!"
  },
  {
   "id": "MESSAGE029:0666",
   "jp": "寄らば、斬ります!",
   "en": "Come closer, and I\nshall strike!"
  },
  {
   "id": "MESSAGE029:0672",
   "jp": "貴様の攻撃はそれだけか?",
   "en": "Is that all\nyou've got?"
  },
  {
   "id": "MESSAGE029:0683",
   "jp": "フン、上等だ!",
   "en": "Hmph, bring it!"
  },
  {
   "id": "MESSAGE029:068D",
   "jp": "怖気づいたりしないわよ!",
   "en": "I won't lose\nmy nerve!"
  },
  {
   "id": "MESSAGE029:069C",
   "jp": "怯みはしない!",
   "en": "I will not falter!"
  },
  {
   "id": "MESSAGE029:06A5",
   "jp": "さあ、楽しませてくれよ!",
   "en": "C'mon, entertain me!"
  },
  {
   "id": "MESSAGE029:06B3",
   "jp": "むん!",
   "en": "Hngh!"
  },
  {
   "id": "MESSAGE029:06B7",
   "jp": "相手になろう!",
   "en": "I shall face you!"
  },
  {
   "id": "MESSAGE029:06C1",
   "jp": "負けないよーっ!",
   "en": "Nietzsche won't\nloooose!"
  },
  {
   "id": "MESSAGE029:06CB",
   "jp": "容赦はしないッ!",
   "en": "No mercy!"
  },
  {
   "id": "MESSAGE029:06D6",
   "jp": "お覚悟はよろしいですね?",
   "en": "Are you prepared?"
  },
  {
   "id": "MESSAGE029:06E5",
   "jp": "やられはしねーぜ!",
   "en": "I ain't goin'\ndown that easy!"
  },
  {
   "id": "MESSAGE029:06EF",
   "jp": "危ねえじゃねえかっ!",
   "en": "Hey, that's\ndangerous!"
  },
  {
   "id": "MESSAGE029:06FB",
   "jp": "お礼は倍返しだぞぉ!",
   "en": "I'll pay ya back\ndouble!"
  },
  {
   "id": "MESSAGE029:0709",
   "jp": "思い知らせてやるわい!",
   "en": "I'll teach ya\na lesson, heh!"
  },
  {
   "id": "MESSAGE029:0717",
   "jp": "もーっ、いったーい!",
   "en": "Hmph! Owwww!"
  },
  {
   "id": "MESSAGE029:0722",
   "jp": "痛いじゃない!",
   "en": "Hey, that hurt!"
  },
  {
   "id": "MESSAGE029:072B",
   "jp": "お返しいくぞ!",
   "en": "Here's payback!"
  },
  {
   "id": "MESSAGE029:0734",
   "jp": "何しやがる!",
   "en": "What the hell!?"
  },
  {
   "id": "MESSAGE029:073C",
   "jp": "…はぁっ!",
   "en": "...Haah!"
  },
  {
   "id": "MESSAGE029:0742",
   "jp": "かわしてみよ!",
   "en": "Dodge this!"
  },
  {
   "id": "MESSAGE029:074A",
   "jp": "本気で来なさい",
   "en": "Come at me\nfor real."
  },
  {
   "id": "MESSAGE029:0755",
   "jp": "目には目を!",
   "en": "An eye for an eye!"
  },
  {
   "id": "MESSAGE029:075E",
   "jp": "愚考きわまりないな!",
   "en": "How utterly foolish!"
  },
  {
   "id": "MESSAGE029:076B",
   "jp": "ろ、老人を\nいじめるのかっ!?",
   "en": "Y-you'd bully\nan old man!?"
  },
  {
   "id": "MESSAGE029:077D",
   "jp": "後悔するわよ!",
   "en": "You'll regret this!"
  },
  {
   "id": "MESSAGE029:0787",
   "jp": "本気出しなさいよ!",
   "en": "Get serious,\nwon't you!"
  },
  {
   "id": "MESSAGE029:0794",
   "jp": "お返しするわよっ!",
   "en": "Here's payback~!"
  },
  {
   "id": "MESSAGE029:079F",
   "jp": "クケックケックケッ!",
   "en": "Kukeh! Kukeh! Kukeh!"
