{
 "file": "MESSAGE060.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE060:04F0",
   "jp": "本当は戦いたくないんだが…",
   "en": "I really don't want\nto fight, but..."
  },
  {
   "id": "MESSAGE060:0501",
   "jp": "諦めた方が身のためだゼ",
   "en": "Give up if ya know\nwhat's good for ya."
  },
  {
   "id": "MESSAGE060:0510",
   "jp": "これは…戦いなんだ",
   "en": "This is... war."
  },
  {
   "id": "MESSAGE060:051B",
   "jp": "…譲れないものがあるんです",
   "en": "...There are things\nI cannot give up."
  },
  {
   "id": "MESSAGE060:052A",
   "jp": "出直してくるがいい",
   "en": "Go and try again\nanother day."
  },
  {
   "id": "MESSAGE060:0536",
   "jp": "詰めが甘いな!",
   "en": "Your finish is\nsloppy!"
  },
  {
   "id": "MESSAGE060:0540",
   "jp": "命は助けてあげるわ",
   "en": "I'll spare your life."
  },
  {
   "id": "MESSAGE060:054C",
   "jp": "抵抗はやめられよ!",
   "en": "I ask that you cease\nresisting!"
  },
  {
   "id": "MESSAGE060:0558",
   "jp": "これで満足か?　ああ?",
   "en": "That satisfy ya?\nHuh?!"
  },
  {
   "id": "MESSAGE060:0566",
   "jp": "そこまでじゃ",
   "en": "Enough, I say."
  },
  {
   "id": "MESSAGE060:056D",
   "jp": "信念は曲げられぬ!",
   "en": "I shall not bend my\nconvictions!"
  },
  {
   "id": "MESSAGE060:057A",
   "jp": "勝ったよ!",
   "en": "Nietzsche won!\nNietzsche won!"
  },
  {
   "id": "MESSAGE060:0581",
   "jp": "無駄なあがきはやめるんだな",
   "en": "Quit your useless\nstruggling."
  },
  {
   "id": "MESSAGE060:0591",
   "jp": "これ以上はおやめなさい",
   "en": "I beg you, go no\nfurther."
  },
  {
   "id": "MESSAGE060:059F",
   "jp": "悪いが、これは譲れねーんだ",
   "en": "Sorry, but I ain't\ngivin' this one up."
  },
  {
   "id": "MESSAGE060:05AF",
   "jp": "悪く思わないでくれよ!",
   "en": "No hard feelings,\nokay?!"
  },
  {
   "id": "MESSAGE060:05BD",
   "jp": "これも仕事なんでな!",
   "en": "It's all part\no' the job!"
  },
  {
   "id": "MESSAGE060:05CA",
   "jp": "ガハハハ!\n悪く思うなよ!",
   "en": "Gwahahaha!\nNo hard feelings!"
  },
  {
   "id": "MESSAGE060:05DA",
   "jp": "残念でした!",
   "en": "Too bad for you!"
  },
  {
   "id": "MESSAGE060:05E3",
   "jp": "そこまでにしなさい!",
   "en": "That's enough,\nyou hear?!"
  },
  {
   "id": "MESSAGE060:05EE",
   "jp": "平和な世界は\nすぐそこなんだ!",
   "en": "A world at peace is\nalmost within reach!"
  },
  {
   "id": "MESSAGE060:0602",
   "jp": "これも仕事だからな!",
   "en": "Hey, it's just\nbusiness!"
  },
  {
   "id": "MESSAGE060:060F",
   "jp": "任務…完了です……",
   "en": "Mission...\naccomplished..."
  },
  {
   "id": "MESSAGE060:061D",
   "jp": "無様だな…",
   "en": "Pathetic..."
  },
  {
   "id": "MESSAGE060:0625",
   "jp": "フフ…懺悔なさい",
   "en": "Fufu... Repent."
  },
  {
   "id": "MESSAGE060:0630",
   "jp": "後悔するがいい",
   "en": "You shall regret this."
  },
  {
   "id": "MESSAGE060:063A",
   "jp": "何と罪深い子羊たちでしょう",
   "en": "What sinful little\nlambs you are."
  },
  {
   "id": "MESSAGE060:064D",
   "jp": "こっ…これが実力じゃ!",
   "en": "Th-that's my true\nstrength, I tell ya!"
  },
  {
   "id": "MESSAGE060:065B",
   "jp": "あたしに勝負を挑むなんてね",
   "en": "To think you'd\nchallenge me, darling."
  },
  {
   "id": "MESSAGE060:066C",
   "jp": "まぁ、頑張った方ね!",
   "en": "Well, you did try\nyour best!"
  },
  {
   "id": "MESSAGE060:067A",
   "jp": "相手が悪かったわね?",
   "en": "Picked the wrong\nopponent, didn't ya?"
  },
  {
   "id": "MESSAGE060:0688",
   "jp": "クケーケケッ!",
   "en": "Kukeeekekeh!"
  },
  {
   "id": "MESSAGE060:0690",
   "jp": "グォォォォォッ!",
   "en": "Grooooogh!"
  },
  {
   "id": "MESSAGE060:0699",
   "jp": "グォォォォォッ!",
   "en": "Grooooogh!"
  },
  {
   "id": "MESSAGE060:06A2",
   "jp": "ククク、怯んだか?",
   "en": "Heh heh heh...\nDo you flinch?"
  },
  {
   "id": "MESSAGE060:06AD",
   "jp": "ここから先は\n手加減出来ませんわよ?",
   "en": "From here on, I can't\nhold back, dear."
  },
  {
   "id": "MESSAGE060:06C6",
   "jp": "この程度でしたか…",
   "en": "So this is all\nyou had..."
  },
  {
   "id": "MESSAGE060:06D2",
   "jp": "悪く思わないでくれ",
   "en": "No hard feelings."
  },
  {
   "id": "MESSAGE060:06DE",
   "jp": "悪く思わないでね",
   "en": "Don't take it\npersonally, okay?"
  }
 ]
}
