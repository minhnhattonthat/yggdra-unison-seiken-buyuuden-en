{
 "file": "MESSAGE212.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE212:04F0",
   "jp": "ふむ、なかなかよさそうな\n箱じゃないか",
   "en": ""
  },
  {
   "id": "MESSAGE212:0505",
   "jp": "ま、テキトーに持ち帰るか",
   "en": ""
  },
  {
   "id": "MESSAGE212:0514",
   "jp": "いかにもって感じの箱だよな",
   "en": ""
  },
  {
   "id": "MESSAGE212:0524",
   "jp": "きれいな箱ね。\nこれにしましょう",
   "en": ""
  },
  {
   "id": "MESSAGE212:0536",
   "jp": "それなりに収穫はあったな",
   "en": ""
  },
  {
   "id": "MESSAGE212:0545",
   "jp": "それなりの収穫だな\n私には縁の無いものだ",
   "en": ""
  },
  {
   "id": "MESSAGE212:055E",
   "jp": "なかなかいい品物って\n予感がするわ",
   "en": ""
  },
  {
   "id": "MESSAGE212:0574",
   "jp": "保存状態は\n良好のようですね…",
   "en": ""
  },
  {
   "id": "MESSAGE212:058A",
   "jp": "これなら悪かねぇだろ",
   "en": ""
  },
  {
   "id": "MESSAGE212:0596",
   "jp": "月の模様が\n彫りこまれているようじゃな",
   "en": ""
  },
  {
   "id": "MESSAGE212:05AE",
   "jp": "中身は神のみぞ知る…か",
   "en": ""
  },
  {
   "id": "MESSAGE212:05BD",
   "jp": "中はなんだろ?　\n早く開けたいな~",
   "en": ""
  },
  {
   "id": "MESSAGE212:05D2",
   "jp": "私の目に狂いは無いはずだ",
   "en": ""
  },
  {
   "id": "MESSAGE212:05E2",
   "jp": "神秘的な模様の箱ですね",
   "en": ""
  },
  {
   "id": "MESSAGE212:05F3",
   "jp": "この辺がよさそうだな",
   "en": ""
  },
  {
   "id": "MESSAGE212:05FF",
   "jp": "今すぐ開けてみたいけど、\nガマンガマン!",
   "en": ""
  },
  {
   "id": "MESSAGE212:0616",
   "jp": "ほっほー!　これだから\n盗︀賊稼業はやめられんわ!",
   "en": ""
  },
  {
   "id": "MESSAGE212:0633",
   "jp": "ガハハハ!\n収穫じゃ収穫じゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE212:0647",
   "jp": "いいものが\n入ってますよーに!",
   "en": ""
  },
  {
   "id": "MESSAGE212:0658",
   "jp": "まあまあの収穫かな?",
   "en": ""
  },
  {
   "id": "MESSAGE212:0665",
   "jp": "よし、今回はこれだ!\n…カンだけど",
   "en": ""
  },
  {
   "id": "MESSAGE212:0679",
   "jp": "オイラが選ぶのは…これだ!",
   "en": ""
  },
  {
   "id": "MESSAGE212:0688",
   "jp": "これに…しましょう",
   "en": ""
  },
  {
   "id": "MESSAGE212:0692",
   "jp": "これだな",
   "en": ""
  },
  {
   "id": "MESSAGE212:0697",
   "jp": "これがいいわ",
   "en": ""
  },
  {
   "id": "MESSAGE212:069E",
   "jp": "ふむ…この意匠、悪くないな",
   "en": ""
  },
  {
   "id": "MESSAGE212:06AF",
   "jp": "フッ、\nまあまあの価値はありそうだ",
   "en": ""
  },
  {
   "id": "MESSAGE212:06C3",
   "jp": "ひっ!　この箱、\n水に濡れているではないか!",
   "en": ""
  },
  {
   "id": "MESSAGE212:06DD",
   "jp": "ふうん…\nこれ、嫌いじゃないわ",
   "en": ""
  },
  {
   "id": "MESSAGE212:06EE",
   "jp": "あら、なかなかいいセンス\nしてるじゃない",
   "en": ""
  },
  {
   "id": "MESSAGE212:0703",
   "jp": "まあ、\nこの辺が妥当なラインよね~",
   "en": ""
  },
  {
   "id": "MESSAGE212:0718",
   "jp": "クケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE212:0720",
   "jp": "グオォォ!",
   "en": "Grooah!"
  },
  {
   "id": "MESSAGE212:0726",
   "jp": "グワオォォ!",
   "en": "Grwaoooh!"
  },
  {
   "id": "MESSAGE212:072D",
   "jp": "何かの足しにはなるであろう",
   "en": ""
  },
  {
   "id": "MESSAGE212:073D",
   "jp": "これまた渋い箱ですわね~",
   "en": ""
  },
  {
   "id": "MESSAGE212:074C",
   "jp": "まあ、私は中身にしか\n関心はありませんが…",
   "en": ""
  },
  {
   "id": "MESSAGE212:0766",
   "jp": "どれも同じに見えてきたぞ…",
   "en": ""
  },
  {
   "id": "MESSAGE212:0776",
   "jp": "外見は綺麗だけどね…",
   "en": ""
  }
 ]
}
