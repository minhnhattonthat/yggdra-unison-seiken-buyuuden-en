{
 "file": "MESSAGE019.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE019:04C0",
   "jp": "その勇気には感服するよ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:04D1",
   "jp": "土に還りやがれ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:04DC",
   "jp": "陛下、勝負です!",
   "en": ""
  },
  {
   "id": "MESSAGE019:04E8",
   "jp": "真剣勝負よ、デュラン!",
   "en": ""
  },
  {
   "id": "MESSAGE019:04F8",
   "jp": "陛下…失礼致します!",
   "en": ""
  },
  {
   "id": "MESSAGE019:0507",
   "jp": "陛下…失礼します!",
   "en": ""
  },
  {
   "id": "MESSAGE019:0514",
   "jp": "失礼しますっ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:051E",
   "jp": "数多の盗行…\n許す訳にはいかん!",
   "en": ""
  },
  {
   "id": "MESSAGE019:0534",
   "jp": "妹だろうが容赦はしねえッ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:0545",
   "jp": "エミリオ殿、\nお覚悟召されい!",
   "en": ""
  },
  {
   "id": "MESSAGE019:0559",
   "jp": "民を苦しめた罪は重い!",
   "en": ""
  },
  {
   "id": "MESSAGE019:0569",
   "jp": "…ニーチェ、本気だよ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:0577",
   "jp": "子供相手だろうが\n容赦はしない!",
   "en": ""
  },
  {
   "id": "MESSAGE019:058E",
   "jp": "遠慮はいりませんよ?",
   "en": ""
  },
  {
   "id": "MESSAGE019:059B",
   "jp": "キリエ、遠慮はいらねーぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:05AB",
   "jp": "姐さん、すまねえ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:05B6",
   "jp": "なんだ、おめぇか!",
   "en": ""
  },
  {
   "id": "MESSAGE019:05C0",
   "jp": "今日こそ決着をつけるぞい!",
   "en": ""
  },
  {
   "id": "MESSAGE019:05D2",
   "jp": "いくよ、王女!",
   "en": ""
  },
  {
   "id": "MESSAGE019:05DC",
   "jp": "アル、気を抜いちゃダメよ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:05EC",
   "jp": "あんたのことは知ってるぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:05FB",
   "jp": "どっかで見たことある顔だな",
   "en": ""
  },
  {
   "id": "MESSAGE019:060B",
   "jp": "無礼をお許しください…!",
   "en": ""
  },
  {
   "id": "MESSAGE019:061B",
   "jp": "参ります!",
   "en": ""
  },
  {
   "id": "MESSAGE019:0622",
   "jp": "…お覚悟を……!",
   "en": ""
  },
  {
   "id": "MESSAGE019:062D",
   "jp": "我を誰と心得るか!",
   "en": ""
  },
  {
   "id": "MESSAGE019:063B",
   "jp": "邪魔ばかりしおって!",
   "en": ""
  },
  {
   "id": "MESSAGE019:0648",
   "jp": "わ、わしは\n手加減できんのじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:065C",
   "jp": "お仕置きが必要みたいね!",
   "en": ""
  },
  {
   "id": "MESSAGE019:066D",
   "jp": "同じ魔導師として\n勝負を挑むわ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:0685",
   "jp": "な、何か怖そううな\nウンディーネね!?",
   "en": ""
  },
  {
   "id": "MESSAGE019:069B",
   "jp": "ケーッケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:06A5",
   "jp": "グォォォォォォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:06AF",
   "jp": "グワォォォォォォォッ!!!",
   "en": ""
  },
  {
   "id": "MESSAGE019:06BD",
   "jp": "貴様の力を見せてみろ!",
   "en": ""
  },
  {
   "id": "MESSAGE019:06CD",
   "jp": "その胸に飛び込ませて\n頂きますわよ!?",
   "en": ""
  },
  {
   "id": "MESSAGE019:06E5",
   "jp": "貴方の力…\n見せて貰いましょう……",
   "en": ""
  }
 ]
}
