{
 "file": "MESSAGE124.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE124:0480",
   "jp": "気乗りはしないが\nこれも命令だからな",
   "en": "I'm not keen, but\nthese are orders."
  },
  {
   "id": "MESSAGE124:0497",
   "jp": "この調子で\n進めりゃいいけどな…",
   "en": "Hope it keeps goin'\nlike this, y'know..."
  },
  {
   "id": "MESSAGE124:04AB",
   "jp": "やっと終わったな…",
   "en": "Finally over..."
  },
  {
   "id": "MESSAGE124:04B6",
   "jp": "制圧です",
   "en": "It is taken."
  },
  {
   "id": "MESSAGE124:04BD",
   "jp": "やるだけやったが…",
   "en": "I did all I could,\nbut..."
  },
  {
   "id": "MESSAGE124:04C7",
   "jp": "終わったか…",
   "en": "Is it over...?"
  },
  {
   "id": "MESSAGE124:04CF",
   "jp": "やっと終わったわね",
   "en": "It's finally over."
  },
  {
   "id": "MESSAGE124:04DA",
   "jp": "占領しましたが…",
   "en": "It is taken, but..."
  },
  {
   "id": "MESSAGE124:04E5",
   "jp": "この地は俺様が頂いたぜ!",
   "en": "This land belongs to\nthe great me now!"
  },
  {
   "id": "MESSAGE124:04F6",
   "jp": "制圧いたしましたが…",
   "en": "'Tis taken, yet..."
  },
  {
   "id": "MESSAGE124:0503",
   "jp": "占領しました",
   "en": "The land is taken."
  },
  {
   "id": "MESSAGE124:050C",
   "jp": "もう、いいよね?",
   "en": "That's enough, right?"
  },
  {
   "id": "MESSAGE124:0515",
   "jp": "まだ、続けるのか…?",
   "en": "Must this go on...?"
  },
  {
   "id": "MESSAGE124:0521",
   "jp": "これ以上の無益な戦いは…",
   "en": "No more needless\nfighting..."
  },
  {
   "id": "MESSAGE124:0533",
   "jp": "やれやれ、やっと終わったな",
   "en": "Jeez, finally over."
  },
  {
   "id": "MESSAGE124:0542",
   "jp": "何だか疲れたぜ…",
   "en": "Man, I'm beat..."
  },
  {
   "id": "MESSAGE124:054D",
   "jp": "…少し疲れたな",
   "en": "...I'm kinda tired."
  },
  {
   "id": "MESSAGE124:0557",
   "jp": "少し腹が減ったのう…",
   "en": "Gettin' a mite\nhungry, heh..."
  },
  {
   "id": "MESSAGE124:0565",
   "jp": "何だか疲れちゃった…",
   "en": "I'm sort of tired..."
  },
  {
   "id": "MESSAGE124:0572",
   "jp": "ウチも頑張ったけど…",
   "en": "I gave it my all,\nbut..."
  },
  {
   "id": "MESSAGE124:057F",
   "jp": "勝ったみたいだな…",
   "en": "Looks like we won..."
  },
  {
   "id": "MESSAGE124:058A",
   "jp": "やっと終わったぜ…",
   "en": "Finally done..."
  },
  {
   "id": "MESSAGE124:0595",
   "jp": "…制圧です",
   "en": "...It is taken."
  },
  {
   "id": "MESSAGE124:059D",
   "jp": "…終わったな",
   "en": "...It's over."
  },
  {
   "id": "MESSAGE124:05A5",
   "jp": "つまらない任務だったわ…",
   "en": "What a dull job..."
  },
  {
   "id": "MESSAGE124:05B4",
   "jp": "終わったな…",
   "en": "It's over..."
  },
  {
   "id": "MESSAGE124:05BC",
   "jp": "私に刃向かうとは愚かな…",
   "en": "Fools, to defy me..."
  },
  {
   "id": "MESSAGE124:05CC",
   "jp": "こんな思いはもう\nこりごりじゃ…!",
   "en": "I've had enough of\nthis, I tell you...!"
  },
  {
   "id": "MESSAGE124:05DF",
   "jp": "制圧したわよ",
   "en": "It's taken, darling."
  },
  {
   "id": "MESSAGE124:05E8",
   "jp": "やっと終わったわね…",
   "en": "Finally over, hm..."
  },
  {
   "id": "MESSAGE124:05F4",
   "jp": "死ぬかと思ったわー",
   "en": "I thought I'd die~"
  },
  {
   "id": "MESSAGE124:0600",
   "jp": "ケーッケッケッケ!",
   "en": "Keeh-kekekeh!"
  },
  {
   "id": "MESSAGE124:060A",
   "jp": "グォーッグォーッ!",
   "en": "Groah! Groah!"
  },
  {
   "id": "MESSAGE124:0614",
   "jp": "グワォーッグワォーッ!",
   "en": "Grwaah! Grwaah!"
  },
  {
   "id": "MESSAGE124:0620",
   "jp": "制圧だ",
   "en": "Taken."
  },
  {
   "id": "MESSAGE124:0626",
   "jp": "終わったのかしら…?",
   "en": "Is it over, I wonder?"
  },
  {
   "id": "MESSAGE124:0632",
   "jp": "私が出るまでも\nありませんでしたよ…",
   "en": "There was no need\nfor me to step in..."
  }
 ]
