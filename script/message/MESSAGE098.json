{
 "file": "MESSAGE098.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE098:04B0",
   "jp": "俺には勝てんさ",
   "en": ""
  },
  {
   "id": "MESSAGE098:04BA",
   "jp": "これで脅威は減ったな!",
   "en": ""
  },
  {
   "id": "MESSAGE098:04C9",
   "jp": "これ以上好きにはさせない!",
   "en": ""
  },
  {
   "id": "MESSAGE098:04DA",
   "jp": "敵に砲台は使わせません",
   "en": ""
  },
  {
   "id": "MESSAGE098:04EA",
   "jp": "これで敵の戦意も下がろう",
   "en": ""
  },
  {
   "id": "MESSAGE098:04FA",
   "jp": "これで敵の士気も下がろう",
   "en": ""
  },
  {
   "id": "MESSAGE098:050A",
   "jp": "これで砲台を使われることは\n無くなったわね…!",
   "en": ""
  },
  {
   "id": "MESSAGE098:0526",
   "jp": "これで敵も使えないだろう",
   "en": ""
  },
  {
   "id": "MESSAGE098:0535",
   "jp": "こんなものは必要ねえ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:0543",
   "jp": "敵の戦意を挫くのだ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:0552",
   "jp": "砲台を使わせてなるものか!",
   "en": ""
  },
  {
   "id": "MESSAGE098:0563",
   "jp": "使っちゃだめだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:056E",
   "jp": "どうやら間に合ったようだな",
   "en": ""
  },
  {
   "id": "MESSAGE098:057E",
   "jp": "敵に利用させるわけには\nまいりません",
   "en": ""
  },
  {
   "id": "MESSAGE098:0594",
   "jp": "こんなもの、\nジャマなだけだぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:05A5",
   "jp": "母ちゃんのためなら…",
   "en": ""
  },
  {
   "id": "MESSAGE098:05B1",
   "jp": "ブチ壊せ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:05B8",
   "jp": "これで連中も少しは\nやる気が失せたじゃろう",
   "en": ""
  },
  {
   "id": "MESSAGE098:05D3",
   "jp": "これで安心ね!",
   "en": ""
  },
  {
   "id": "MESSAGE098:05DD",
   "jp": "使われる前に壊しちゃえ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:05ED",
   "jp": "それ、ぶっ壊せ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:05F7",
   "jp": "オイラには必要ないもんな",
   "en": ""
  },
  {
   "id": "MESSAGE098:0606",
   "jp": "これなら、使えない…",
   "en": ""
  },
  {
   "id": "MESSAGE098:0612",
   "jp": "脅威のひとつは消したぞ",
   "en": ""
  },
  {
   "id": "MESSAGE098:0621",
   "jp": "手も足も出せないでしょう?",
   "en": ""
  },
  {
   "id": "MESSAGE098:0632",
   "jp": "このような無粋なもの…\n見たくも無いな!",
   "en": ""
  },
  {
   "id": "MESSAGE098:064B",
   "jp": "おお、何とまがまがしい…\nこんなものは、こうだ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:0665",
   "jp": "さ、先に壊してしまおう…",
   "en": ""
  },
  {
   "id": "MESSAGE098:0674",
   "jp": "撃たれるとウザいものね!",
   "en": ""
  },
  {
   "id": "MESSAGE098:0682",
   "jp": "もったいないけど、\n砲台はまた作ればいいわ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:069C",
   "jp": "こんなので撃たれたら\nたまんないもんね!",
   "en": ""
  },
  {
   "id": "MESSAGE098:06B2",
   "jp": "ケッケッケ!",
   "en": "Keh-keh-keh!"
  },
  {
   "id": "MESSAGE098:06B9",
   "jp": "グォッグォッグォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:06C4",
   "jp": "グワォッグワォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:06CE",
   "jp": "これで敵の戦意も失せよう…",
   "en": ""
  },
  {
   "id": "MESSAGE098:06E0",
   "jp": "これで二度と使うことは\n出来ませんわ",
   "en": ""
  },
  {
   "id": "MESSAGE098:06F8",
   "jp": "フフフ…どうです?\n戦意も失せたでしょう?",
   "en": ""
  },
  {
   "id": "MESSAGE098:0711",
   "jp": "徹底的に破壊するんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE098:0722",
   "jp": "好きにはさせない!",
   "en": ""
  }
 ]
}
