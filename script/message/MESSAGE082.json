{
 "file": "MESSAGE082.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE082:05F0",
   "jp": "こうでもしないと\n俺の気がすまないんでね",
   "en": "I couldn't let it go\nunless I did this."
  },
  {
   "id": "MESSAGE082:0607",
   "jp": "悪く思うなよな!",
   "en": "Don't take it\npersonal, y'know!"
  },
  {
   "id": "MESSAGE082:0612",
   "jp": "恨んでくれて構わないよ…",
   "en": "Go ahead\nand hate me..."
  },
  {
   "id": "MESSAGE082:0621",
   "jp": "一歩も退きません!\n相手が誰であろうとも…",
   "en": "I will not yield a step!\nNo matter who it is..."
  },
  {
   "id": "MESSAGE082:063D",
   "jp": "これも運命というものだ",
   "en": "This, too, is fate."
  },
  {
   "id": "MESSAGE082:064B",
   "jp": "負けを認めることだな",
   "en": "Admit your defeat."
  },
  {
   "id": "MESSAGE082:0658",
   "jp": "仕方ないの…\nこれは、戦いなんだから…",
   "en": "It can't be helped...\nThis is war, after all..."
  },
  {
   "id": "MESSAGE082:066F",
   "jp": "そこまでです",
   "en": "That is enough."
  },
  {
   "id": "MESSAGE082:0676",
   "jp": "俺様に逆らうんじゃねぇッ!",
   "en": "Don't ya dare\ncross me!"
  },
  {
   "id": "MESSAGE082:0687",
   "jp": "この勝負、頂いた",
   "en": "This match is mine."
  },
  {
   "id": "MESSAGE082:0693",
   "jp": "もう、降参して!",
   "en": "Come on, give up!"
  },
  {
   "id": "MESSAGE082:069E",
   "jp": "残念だったな…",
   "en": "Too bad..."
  },
  {
   "id": "MESSAGE082:06A8",
   "jp": "これが戦いなのです",
   "en": "This is what war is."
  },
  {
   "id": "MESSAGE082:06B3",
   "jp": "ダテに親分やってねーぜ!",
   "en": "I ain't boss for\nnothin'!"
  },
  {
   "id": "MESSAGE082:06C2",
   "jp": "これは男の戦いなんだっ!",
   "en": "This is a fight\nbetween men, see!"
  },
  {
   "id": "MESSAGE082:06D1",
   "jp": "恨みっこなしだぞぉ!",
   "en": "No hard feelin's,\nya hear!"
  },
  {
   "id": "MESSAGE082:06DD",
   "jp": "ワシを恨むなよ?",
   "en": "Don't hold it against\nme, eh?"
  },
  {
   "id": "MESSAGE082:06E7",
   "jp": "ボク、本気なんだから!",
   "en": "I'm totally serious,\nyou know!"
  },
  {
   "id": "MESSAGE082:06F5",
   "jp": "恨みっこなしよね?",
   "en": "No hard\nfeelings, okay?"
  },
  {
   "id": "MESSAGE082:0700",
   "jp": "ちょっと複雑な気分だな…",
   "en": "I've got kinda mixed\nfeelings about this..."
  },
  {
   "id": "MESSAGE082:0711",
   "jp": "邪魔してくれるなよ!",
   "en": "Don't get in my way!"
  },
  {
   "id": "MESSAGE082:071E",
   "jp": "…………",
   "en": "..."
  },
  {
   "id": "MESSAGE082:0723",
   "jp": "情けなどかけぬ",
   "en": "I show no mercy."
  },
  {
   "id": "MESSAGE082:072C",
   "jp": "フフ…お気の毒様",
   "en": "Fufu... how very\nsad for you."
  },
  {
   "id": "MESSAGE082:0738",
   "jp": "これが戦いというものだ…",
   "en": "This is what war is..."
  },
  {
   "id": "MESSAGE082:0746",
   "jp": "私が正しき道へと\n導いて差し上げましょう",
   "en": "Allow me to guide\nyou to the true path."
  },
  {
   "id": "MESSAGE082:0760",
   "jp": "か、神のご意思なんじゃ…\nわしのせいではない!",
   "en": "I-it was God's will...\nIt's not my fault!"
  },
  {
   "id": "MESSAGE082:077A",
   "jp": "残念だったわね",
   "en": "Too bad, darling."
  },
  {
   "id": "MESSAGE082:0784",
   "jp": "一応、手加減したわよ?",
   "en": "I did hold back,\nyou know?"
  },
  {
   "id": "MESSAGE082:0795",
   "jp": "残念でしたぁ~!",
   "en": "Too baaad~!"
  },
  {
   "id": "MESSAGE082:07A0",
   "jp": "ケケッ!",
   "en": "Kekeh!"
  },
  {
   "id": "MESSAGE082:07A5",
   "jp": "グォーン!",
   "en": "Groooan!"
  },
  {
   "id": "MESSAGE082:07AB",
   "jp": "グォーン!",
   "en": "Groooan!"
  },
  {
   "id": "MESSAGE082:07B1",
   "jp": "その罪、死を以って償え!",
   "en": "Atone for your\ncrime with death!"
  },
  {
   "id": "MESSAGE082:07C2",
   "jp": "ごめんなさいね~",
   "en": "I'm so sorry, dear~"
  },
  {
   "id": "MESSAGE082:07CB",
   "jp": "私の前からお消えなさい",
   "en": "Kindly vanish from\nmy sight."
  },
  {
   "id": "MESSAGE082:07D9",
   "jp": "裏切った罰ってやつだ",
   "en": "That's what ya get\nfor betrayin' us!"
  },
  {
   "id": "MESSAGE082:07E7",
   "jp": "相応の罰よ",
   "en": "A fitting punishment."
  },
  {
   "id": "MESSAGE082:07F0",
   "jp": "裏切り者は放っておけん!",
   "en": "I won't let a\ntraitor go!"
  },
  {
   "id": "MESSAGE082:0801",
   "jp": "裏切ったこと、後悔なさい!",
   "en": "Regret your betrayal!"
  },
  {
   "id": "MESSAGE082:0813",
   "jp": "へっ、せいせいするぜ!",
   "en": "Heh, good riddance!"
  },
  {
   "id": "MESSAGE082:081F",
   "jp": "あんたなんかに用は無いね!",
   "en": "We've got no\nuse for you!"
  },
  {
   "id": "MESSAGE082:082F",
   "jp": "裏切り者には罰を…ってね",
   "en": "Traitors get what's\ncoming... as they say."
  },
  {
   "id": "MESSAGE082:0840",
   "jp": "裏切り者には制裁を…",
   "en": "Punishment for\ntraitors..."
  },
  {
   "id": "MESSAGE082:0850",
   "jp": "フン、貴様には失望だ…",
   "en": "Hmph, you\ndisappoint me..."
  },
  {
   "id": "MESSAGE082:0860",
   "jp": "寝返ったりするからよ!",
   "en": "That's what you get\nfor switching sides!"
  },
  {
   "id": "MESSAGE082:086E",
   "jp": "裏切り者は失せろ",
   "en": "Get lost, traitor."
  },
  {
   "id": "MESSAGE082:087B",
   "jp": "クケーッケッケッケ!",
   "en": "Kukeh! Kekekeke!"
  },
  {
   "id": "MESSAGE082:0886",
   "jp": "グオアァァァッ!!",
   "en": "Gwoaaaagh!!"
  }
 ]
}
