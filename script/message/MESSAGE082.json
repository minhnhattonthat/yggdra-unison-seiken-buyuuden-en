{
 "file": "MESSAGE082.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE082:05F0",
   "jp": "こうでもしないと\n俺の気がすまないんでね",
   "en": ""
  },
  {
   "id": "MESSAGE082:0607",
   "jp": "悪く思うなよな!",
   "en": ""
  },
  {
   "id": "MESSAGE082:0612",
   "jp": "恨んでくれて構わないよ…",
   "en": ""
  },
  {
   "id": "MESSAGE082:0621",
   "jp": "一歩も退きません!\n相手が誰であろうとも…",
   "en": ""
  },
  {
   "id": "MESSAGE082:063D",
   "jp": "これも運命というものだ",
   "en": ""
  },
  {
   "id": "MESSAGE082:064B",
   "jp": "負けを認めることだな",
   "en": ""
  },
  {
   "id": "MESSAGE082:0658",
   "jp": "仕方ないの…\nこれは、戦いなんだから…",
   "en": ""
  },
  {
   "id": "MESSAGE082:066F",
   "jp": "そこまでです",
   "en": ""
  },
  {
   "id": "MESSAGE082:0676",
   "jp": "俺様に逆らうんじゃねぇッ!",
   "en": ""
  },
  {
   "id": "MESSAGE082:0687",
   "jp": "この勝負、頂いた",
   "en": ""
  },
  {
   "id": "MESSAGE082:0693",
   "jp": "もう、降参して!",
   "en": ""
  },
  {
   "id": "MESSAGE082:069E",
   "jp": "残念だったな…",
   "en": ""
  },
  {
   "id": "MESSAGE082:06A8",
   "jp": "これが戦いなのです",
   "en": ""
  },
  {
   "id": "MESSAGE082:06B3",
   "jp": "ダテに親分やってねーぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE082:06C2",
   "jp": "これは男の戦いなんだっ!",
   "en": ""
  },
  {
   "id": "MESSAGE082:06D1",
   "jp": "恨みっこなしだぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE082:06DD",
   "jp": "ワシを恨むなよ?",
   "en": ""
  },
  {
   "id": "MESSAGE082:06E7",
   "jp": "ボク、本気なんだから!",
   "en": ""
  },
  {
   "id": "MESSAGE082:06F5",
   "jp": "恨みっこなしよね?",
   "en": ""
  },
  {
   "id": "MESSAGE082:0700",
   "jp": "ちょっと複雑な気分だな…",
   "en": ""
  },
  {
   "id": "MESSAGE082:0711",
   "jp": "邪魔してくれるなよ!",
   "en": ""
  },
  {
   "id": "MESSAGE082:071E",
   "jp": "…………",
   "en": ""
  },
  {
   "id": "MESSAGE082:0723",
   "jp": "情けなどかけぬ",
   "en": ""
  },
  {
   "id": "MESSAGE082:072C",
   "jp": "フフ…お気の毒様",
   "en": ""
  },
  {
   "id": "MESSAGE082:0738",
   "jp": "これが戦いというものだ…",
   "en": ""
  },
  {
   "id": "MESSAGE082:0746",
   "jp": "私が正しき道へと\n導いて差し上げましょう",
   "en": ""
  },
  {
   "id": "MESSAGE082:0760",
   "jp": "か、神のご意思なんじゃ…\nわしのせいではない!",
   "en": ""
  },
  {
   "id": "MESSAGE082:077A",
   "jp": "残念だったわね",
   "en": ""
  },
  {
   "id": "MESSAGE082:0784",
   "jp": "一応、手加減したわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE082:0795",
   "jp": "残念でしたぁ~!",
   "en": ""
  },
  {
   "id": "MESSAGE082:07A0",
   "jp": "ケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE082:07A5",
   "jp": "グォーン!",
   "en": ""
  },
  {
   "id": "MESSAGE082:07AB",
   "jp": "グォーン!",
   "en": ""
  },
  {
   "id": "MESSAGE082:07B1",
   "jp": "その罪、死を以って償え!",
   "en": ""
  },
  {
   "id": "MESSAGE082:07C2",
   "jp": "ごめんなさいね~",
   "en": ""
  },
  {
   "id": "MESSAGE082:07CB",
   "jp": "私の前からお消えなさい",
   "en": ""
  },
  {
   "id": "MESSAGE082:07D9",
   "jp": "裏切った罰ってやつだ",
   "en": ""
  },
  {
   "id": "MESSAGE082:07E7",
   "jp": "相応の罰よ",
   "en": ""
  },
  {
   "id": "MESSAGE082:07F0",
   "jp": "裏切り者は放っておけん!",
   "en": ""
  },
  {
   "id": "MESSAGE082:0801",
   "jp": "裏切ったこと、後悔なさい!",
   "en": ""
  },
  {
   "id": "MESSAGE082:0813",
   "jp": "へっ、せいせいするぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE082:081F",
   "jp": "あんたなんかに用は無いね!",
   "en": ""
  },
  {
   "id": "MESSAGE082:082F",
   "jp": "裏切り者には罰を…ってね",
   "en": ""
  },
  {
   "id": "MESSAGE082:0840",
   "jp": "裏切り者には制裁を…",
   "en": ""
  },
  {
   "id": "MESSAGE082:0850",
   "jp": "フン、貴様には失望だ…",
   "en": ""
  },
  {
   "id": "MESSAGE082:0860",
   "jp": "寝返ったりするからよ!",
   "en": ""
  },
  {
   "id": "MESSAGE082:086E",
   "jp": "裏切り者は失せろ",
   "en": ""
  },
  {
   "id": "MESSAGE082:087B",
   "jp": "クケーッケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE082:0886",
   "jp": "グオアァァァッ!!",
   "en": ""
