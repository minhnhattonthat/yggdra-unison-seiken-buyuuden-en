{
 "file": "MESSAGE143.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE143:0240",
   "jp": "命を取ることはしません。\nどこへでもお行きなさい",
   "en": ""
  },
  {
   "id": "MESSAGE143:025B",
   "jp": "どこへなりと行くがいい",
   "en": ""
  },
  {
   "id": "MESSAGE143:0267",
   "jp": "釈放します。\n早々にここを去りなさい",
   "en": ""
  },
  {
   "id": "MESSAGE143:027F",
   "jp": "命は助けてやる。けど、\nここからは出てってもらうぜ",
   "en": ""
  },
  {
   "id": "MESSAGE143:029C",
   "jp": "命だけは助けてやるぞ\nとっとと消えやがれ!",
   "en": ""
  },
  {
   "id": "MESSAGE143:02B5",
   "jp": "ワシは寛大じゃからのう。\nホレ、さっさと消えるんじゃ",
   "en": ""
  },
  {
   "id": "MESSAGE143:02D3",
   "jp": "貴様に用は無い。\nさっさと出ていけ",
   "en": ""
  },
  {
   "id": "MESSAGE143:02EA",
   "jp": "で、出て行け!\n二度とわしの前に現れるな!",
   "en": ""
  },
  {
   "id": "MESSAGE143:0305",
   "jp": "あんたに用は無いの。\n出てって頂戴!",
   "en": ""
  },
  {
   "id": "MESSAGE143:031D",
   "jp": "あんたなんかいらない~\nどっか行って!",
   "en": ""
  },
  {
   "id": "MESSAGE143:0331",
   "jp": "殺す価値も無い…\nここからつまみ出せ!",
   "en": ""
  },
  {
   "id": "MESSAGE143:034A",
   "jp": "これも慈悲です。\n好きな所へ立ち去りなさい",
   "en": ""
  }
 ]
}
