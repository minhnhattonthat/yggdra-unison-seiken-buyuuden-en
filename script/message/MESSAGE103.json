 "strings": [
  {
   "id": "MESSAGE103:04B0",
   "jp": "立ち止まる訳には\nいかないんでね…",
   "en": ""
  },
  {
   "id": "MESSAGE103:04C5",
   "jp": "おらおら、進撃するゼ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:04D3",
   "jp": "邪魔な物は壊したぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:04E2",
   "jp": "聖剣で運命を切り開きます!",
   "en": ""
  },
  {
   "id": "MESSAGE103:04F6",
   "jp": "この程度では\n我らを止められんぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:050C",
   "jp": "こんなもので我らを\n防げると思うな!",
   "en": ""
  },
  {
   "id": "MESSAGE103:0522",
   "jp": "前進するわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:052C",
   "jp": "この勢いで進撃する!",
   "en": ""
  },
  {
   "id": "MESSAGE103:053A",
   "jp": "邪魔なんだよッ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:0545",
   "jp": "攻勢を崩すでないぞ",
   "en": ""
  },
  {
   "id": "MESSAGE103:0552",
   "jp": "通してもらおう!",
   "en": ""
  },
  {
   "id": "MESSAGE103:055C",
   "jp": "ぜんしーん!",
   "en": ""
  },
  {
   "id": "MESSAGE103:0563",
   "jp": "このまま突撃だッ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:056F",
   "jp": "このまま突破致しましょう",
   "en": ""
  },
  {
   "id": "MESSAGE103:057F",
   "jp": "邪魔な物は壊すに限るよな!",
   "en": ""
  },
  {
   "id": "MESSAGE103:0592",
   "jp": "この調子でバンバンいくぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:05A2",
   "jp": "山賊の力を見せてやるぞぉ!",
   "en": "I'll show ya the might\nof brigands!"
  },
  {
   "id": "MESSAGE103:05B4",
   "jp": "ガハハハ、気分がいいのう!",
   "en": ""
  },
  {
   "id": "MESSAGE103:05C4",
   "jp": "もうっ、生意気なのよ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:05D3",
   "jp": "邪魔なものは壊さなきゃね!",
   "en": ""
  },
  {
   "id": "MESSAGE103:05E4",
   "jp": "このまま一気に進むんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:05F4",
   "jp": "ひゃっほーい!\n突破するぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:0605",
   "jp": "防御を…崩します!",
   "en": ""
  },
  {
   "id": "MESSAGE103:0612",
   "jp": "邪魔だ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:0619",
   "jp": "このまま突破するわよ…",
   "en": ""
  },
  {
   "id": "MESSAGE103:0627",
   "jp": "柵を破壊!\n敵の防御を崩せ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:063D",
   "jp": "神の尖兵の邪魔などさせぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:064F",
   "jp": "じゃ、邪魔だから壊したぞ?",
   "en": ""
  },
  {
   "id": "MESSAGE103:0660",
   "jp": "みんな、この隙に総攻撃よ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:0672",
   "jp": "こんな物、いらないわね",
   "en": ""
  },
  {
   "id": "MESSAGE103:067F",
   "jp": "ぶっ壊して進むのよ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:068C",
   "jp": "ケーッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:0694",
   "jp": "グォッグォッグォッ!!",
   "en": "Gwoh-gwoh-gwoh!!"
  },
  {
   "id": "MESSAGE103:06A0",
   "jp": "グワォッグワォッグワォッ!",
   "en": "Grwah-grwah-grwah!"
  },
  {
   "id": "MESSAGE103:06AE",
   "jp": "邪魔をするなぁっ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:06BA",
   "jp": "ここは通らせて\n頂きますわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE103:06CC",
   "jp": "このようなもので\n私たちを止められると?",
   "en": ""
  },
  {
   "id": "MESSAGE103:06E2",
   "jp": "乗り越えるぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE103:06EC",
   "jp": "こんなもの、壊しちゃえッ!",
   "en": ""
  }
 ]
