{
 "file": "MESSAGE069.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE069:04F0",
   "jp": "やらなければやられる…\nそれが戦場の掟なんだ",
   "en": "Kill or be killed...\nThat's the law of war."
  },
  {
   "id": "MESSAGE069:050A",
   "jp": "敵将、討ち取ったゼ!",
   "en": "Enemy general's\ndone for!"
  },
  {
   "id": "MESSAGE069:0519",
   "jp": "や…やったぞ!",
   "en": "I-I did it!"
  },
  {
   "id": "MESSAGE069:0521",
   "jp": "討ち取ったわ…",
   "en": "I have slain them..."
  },
  {
   "id": "MESSAGE069:052B",
   "jp": "戦とは無常なものだ…",
   "en": "How merciless\nwar is..."
  },
  {
   "id": "MESSAGE069:0539",
   "jp": "終わったな…",
   "en": "It's over..."
  },
  {
   "id": "MESSAGE069:0541",
   "jp": "う…討ち取ったわ!",
   "en": "I-I took them down!"
  },
  {
   "id": "MESSAGE069:054D",
   "jp": "敵将討ち取りました",
   "en": "The enemy general\nhas been slain."
  },
  {
   "id": "MESSAGE069:055B",
   "jp": "クックック、気分がいいぜ!",
   "en": "Heh heh heh, this\nfeels good!"
  },
  {
   "id": "MESSAGE069:056B",
   "jp": "敵将、討ち取り申した",
   "en": "The enemy general\nhath been slain."
  },
  {
   "id": "MESSAGE069:057B",
   "jp": "これが戦いというものだ…",
   "en": "This is what war is..."
  },
  {
   "id": "MESSAGE069:0589",
   "jp": "負けないよ!",
   "en": "Nietzsche won't lose!"
  },
  {
   "id": "MESSAGE069:0591",
   "jp": "私に敵う者などいない!",
   "en": "None can match me!"
  },
  {
   "id": "MESSAGE069:059F",
   "jp": "お気の毒ですが…",
   "en": "I am sorry, but..."
  },
  {
   "id": "MESSAGE069:05AA",
   "jp": "へっ、おととい来やがれ!",
   "en": "Heh, get lost and\nstay lost!"
  },
  {
   "id": "MESSAGE069:05B8",
   "jp": "まぐれだとか言うなよなっ!",
   "en": "Don't you dare say\nit was a fluke!"
  },
  {
   "id": "MESSAGE069:05C7",
   "jp": "敵をブチのめしたぞぉ!",
   "en": "Smashed 'em to\nbits!"
  },
  {
   "id": "MESSAGE069:05D4",
   "jp": "ワシに怖いものなど無いわい",
   "en": "Nothin' scares\nthis old man!"
  },
  {
   "id": "MESSAGE069:05E4",
   "jp": "後悔したって遅いよ!",
   "en": "Too late for regrets!"
  },
  {
   "id": "MESSAGE069:05F2",
   "jp": "倒したよ!",
   "en": "Got 'em!"
  },
  {
   "id": "MESSAGE069:05F9",
   "jp": "僕の決心は揺るがない!",
   "en": "My resolve won't\nwaver!"
  },
  {
   "id": "MESSAGE069:0609",
   "jp": "恨みっこなしだぜ?",
   "en": "No hard feelin's,\nright?"
  },
  {
   "id": "MESSAGE069:0614",
   "jp": "任務…完了です",
   "en": "Mission...\naccomplished."
  },
  {
   "id": "MESSAGE069:0620",
   "jp": "任務完了",
   "en": "Mission complete."
  },
  {
   "id": "MESSAGE069:0629",
   "jp": "フフ…悪夢のお味はいかが?",
   "en": "Fufu... how does the\nnightmare taste?"
  },
  {
   "id": "MESSAGE069:063A",
   "jp": "罰を受けるがいい",
   "en": "Receive your\npunishment."
  },
  {
   "id": "MESSAGE069:0645",
   "jp": "御国を来たらせ給え…",
   "en": "Thy kingdom come..."
  },
  {
   "id": "MESSAGE069:0654",
   "jp": "か、勝った…",
   "en": "I-I won..."
  },
  {
   "id": "MESSAGE069:065C",
   "jp": "ちょっとやりすぎたかしら?",
   "en": "Did I overdo it a\nlittle, I wonder?"
  },
  {
   "id": "MESSAGE069:066A",
   "jp": "期待外れだったわね",
   "en": "What a letdown."
  },
  {
   "id": "MESSAGE069:0677",
   "jp": "次はよく相手を選ぶことね♪",
   "en": "Pick your fights\nbetter next time~!"
  },
  {
   "id": "MESSAGE069:0689",
   "jp": "ケケ、クケーケケケッ!",
   "en": "Keke, Kukeeekekekeh!"
  },
  {
   "id": "MESSAGE069:0695",
   "jp": "グォォォォーグォッ!",
   "en": "Grooooo- Groh!"
  },
  {
   "id": "MESSAGE069:06A0",
   "jp": "グワォォォォーグワォッ!",
   "en": "Grwaaaaa- Grwaoh!"
  },
  {
   "id": "MESSAGE069:06AD",
   "jp": "安らかに眠るがいい",
   "en": "Rest in peace."
  },
  {
   "id": "MESSAGE069:06B9",
   "jp": "あなたたちの武勇は\n忘れませんわ…",
   "en": "I shall never forget\nyour valor, dears..."
  },
  {
   "id": "MESSAGE069:06CE",
   "jp": "さあ、お消えなさい…",
   "en": "Now, fade away..."
  },
  {
   "id": "MESSAGE069:06DA",
   "jp": "敵将を討ち取った!",
   "en": "Enemy general slain!"
  },
  {
   "id": "MESSAGE069:06E8",
   "jp": "これでおしまい!",
   "en": "And that's that!"
  }
 ]
}
