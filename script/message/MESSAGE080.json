{
 "file": "MESSAGE080.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE080:04C0",
   "jp": "理想だけでは\n革命は起こせない…か",
   "en": ""
  },
  {
   "id": "MESSAGE080:04D7",
   "jp": "動きさえしなけりゃ\n怖かねぇゼ!",
   "en": ""
  },
  {
   "id": "MESSAGE080:04EA",
   "jp": "無礼をお許しくださいっ!",
   "en": ""
  },
  {
   "id": "MESSAGE080:04FA",
   "jp": "勝った…!?",
   "en": ""
  },
  {
   "id": "MESSAGE080:0502",
   "jp": "残念です、陛下…",
   "en": ""
  },
  {
   "id": "MESSAGE080:050E",
   "jp": "陛下…残念です",
   "en": ""
  },
  {
   "id": "MESSAGE080:0519",
   "jp": "か…勝ったの!?",
   "en": ""
  },
  {
   "id": "MESSAGE080:0523",
   "jp": "正義の刃に敵うはずは無い!",
   "en": ""
  },
  {
   "id": "MESSAGE080:0536",
   "jp": "命を取られなかっただけ\nマシと思え!",
   "en": ""
  },
  {
   "id": "MESSAGE080:054C",
   "jp": "勝負はつき申した",
   "en": ""
  },
  {
   "id": "MESSAGE080:0558",
   "jp": "相応の罰だ!",
   "en": ""
  },
  {
   "id": "MESSAGE080:0562",
   "jp": "ニーチェ、勝ったみたい…",
   "en": ""
  },
  {
   "id": "MESSAGE080:0570",
   "jp": "お前の覚悟はその程度か?",
   "en": ""
  },
  {
   "id": "MESSAGE080:0582",
   "jp": "想いとは\nときにはかないもの…",
   "en": ""
  },
  {
   "id": "MESSAGE080:0593",
   "jp": "気を抜いたら\nオレがやられちまうからな!",
   "en": ""
  },
  {
   "id": "MESSAGE080:05AA",
   "jp": "あ…姐さんに勝った!?",
   "en": ""
  },
  {
   "id": "MESSAGE080:05B8",
   "jp": "さーて、どうしてくれよう\nかのぉ?",
   "en": ""
  },
  {
   "id": "MESSAGE080:05CA",
   "jp": "ガハハハ!　さてさて\nどうしてくれようかのう?",
   "en": ""
  },
  {
   "id": "MESSAGE080:05E2",
   "jp": "王女なんて、名前だけね!",
   "en": ""
  },
  {
   "id": "MESSAGE080:05F3",
   "jp": "アンタには負けないよ、\n王女様!",
   "en": ""
  },
  {
   "id": "MESSAGE080:0608",
   "jp": "なかなかの腕前だったよ",
   "en": ""
  },
  {
   "id": "MESSAGE080:0616",
   "jp": "恐ろしいお子様も\nいたもんだぜ…",
   "en": ""
  },
  {
   "id": "MESSAGE080:062A",
   "jp": "ジルヴァ様…!!",
   "en": ""
  },
  {
   "id": "MESSAGE080:0634",
   "jp": "陛下…どうぞ安らかに",
   "en": ""
  },
  {
   "id": "MESSAGE080:0641",
   "jp": "申し訳ございません…",
   "en": ""
  },
  {
   "id": "MESSAGE080:064E",
   "jp": "安らかに眠るがいい",
   "en": ""
  },
  {
   "id": "MESSAGE080:065A",
   "jp": "これが神のご意思だ",
   "en": ""
  },
  {
   "id": "MESSAGE080:0666",
   "jp": "ア、アマレウス!\nわしを置いて逝くのか!?",
   "en": ""
  },
  {
   "id": "MESSAGE080:067E",
   "jp": "反抗期ってやつかしらね",
   "en": ""
  },
  {
   "id": "MESSAGE080:068D",
   "jp": "もっと頭を使ったら?",
   "en": ""
  },
  {
   "id": "MESSAGE080:069A",
   "jp": "乱暴なウンディーネねぇ…",
   "en": ""
  },
  {
   "id": "MESSAGE080:06A9",
   "jp": "クケッケケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE080:06B2",
   "jp": "グォォーグォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE080:06BB",
   "jp": "グワォォーグワォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE080:06C6",
   "jp": "聖剣の力はその程度か?",
   "en": ""
  },
  {
   "id": "MESSAGE080:06D7",
   "jp": "あなたのことは\nきっと忘れませんわ",
   "en": ""
  },
  {
   "id": "MESSAGE080:06EA",
   "jp": "焔帝の名が泣きますよ?\nフフフ…",
   "en": ""
  }
 ]
