{
 "file": "MESSAGE074.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE074:04F0",
   "jp": "くっ、俺の負けか…",
   "en": "Ngh, I lose..."
  },
  {
   "id": "MESSAGE074:04FC",
   "jp": "ふ、ふざけやがって…!",
   "en": "Y-ya gotta be\nkiddin' me...!"
  },
  {
   "id": "MESSAGE074:0508",
   "jp": "ダ…ダメか……",
   "en": "N-no good..."
  },
  {
   "id": "MESSAGE074:0510",
   "jp": "みんな、ごめんなさい…",
   "en": "Everyone, I am\nso sorry..."
  },
  {
   "id": "MESSAGE074:051C",
   "jp": "陛下…\nお許しください……",
   "en": "Your Majesty...\nplease forgive me..."
  },
  {
   "id": "MESSAGE074:052C",
   "jp": "陛下…\n申し訳…ございません",
   "en": "Your Majesty...\nI am... so sorry."
  },
  {
   "id": "MESSAGE074:053E",
   "jp": "くっ…絶対に許さないッ!",
   "en": "Ngh... I'll never\nforgive you!"
  },
  {
   "id": "MESSAGE074:054E",
   "jp": "姫様…申し訳ございません",
   "en": "Princess... I am\ndeeply sorry."
  },
  {
   "id": "MESSAGE074:055F",
   "jp": "カスがいきがりやがって…",
   "en": "Damn trash, actin'\nall tough..."
  },
  {
   "id": "MESSAGE074:056C",
   "jp": "拙者…遅れを取り申した",
   "en": "I... have been\nbested..."
  },
  {
   "id": "MESSAGE074:057D",
   "jp": "な…何たることだ……",
   "en": "Wh-what has\nhappened..."
  },
  {
   "id": "MESSAGE074:0589",
   "jp": "そんな~!",
   "en": "Nooo~!"
  },
  {
   "id": "MESSAGE074:058F",
   "jp": "たとえ、この命が\n果てようとも…",
   "en": "Even if my life\nshould end..."
  },
  {
   "id": "MESSAGE074:05A2",
   "jp": "わたくしは…\n長として失格ですね……",
   "en": "I have failed...\nas a leader..."
  },
  {
   "id": "MESSAGE074:05B8",
   "jp": "親分の面目丸つぶれだぜ…",
   "en": "So much for my\nrep as the boss..."
  },
  {
   "id": "MESSAGE074:05CA",
   "jp": "気合だけじゃ勝てねえのか…",
   "en": "Guts alone ain't\nenough to win...?"
  },
  {
   "id": "MESSAGE074:05DB",
   "jp": "こんな親分ですまねぇな…",
   "en": "Sorry I'm such a\nlousy boss..."
  },
  {
   "id": "MESSAGE074:05EA",
   "jp": "ぐっ、侮っておったわい…",
   "en": "Ngh, I underestimated\nya, sonny..."
  },
  {
   "id": "MESSAGE074:05F8",
   "jp": "許して、お兄様…",
   "en": "Forgive me,\nBig Brother..."
  },
  {
   "id": "MESSAGE074:0604",
   "jp": "ミラノ、ごめん!",
   "en": "Sorry, Milanor!"
  },
  {
   "id": "MESSAGE074:060D",
   "jp": "あとは頼んだよ…",
   "en": "I'm counting on\nyou for the rest..."
  },
  {
   "id": "MESSAGE074:0617",
   "jp": "やられた!",
   "en": "Got me!"
  },
  {
   "id": "MESSAGE074:061D",
   "jp": "…失敗……",
   "en": "...Failed..."
  },
  {
   "id": "MESSAGE074:0625",
   "jp": "くっ…私としたことが…",
   "en": "Tch... how\nunlike me..."
  },
  {
   "id": "MESSAGE074:0631",
   "jp": "任務…失敗するなんて……",
   "en": "To fail...\nmy mission..."
  },
  {
   "id": "MESSAGE074:0642",
   "jp": "くっ、こんなところで…",
   "en": "Tch, not here..."
  },
  {
   "id": "MESSAGE074:064E",
   "jp": "神よ、正しき裁きを…",
   "en": "O God, grant\nrighteous judgment..."
  },
  {
   "id": "MESSAGE074:065B",
   "jp": "ヒィィッ、助けてくれえ!",
   "en": "Eeeek! Help meee!"
  },
  {
   "id": "MESSAGE074:0669",
   "jp": "何負けてるのよ、あたし…!",
   "en": "What am I doing,\nlosing like this...!"
  },
  {
   "id": "MESSAGE074:0679",
   "jp": "何ですって…!?",
   "en": "Excuse me...?!"
  },
  {
   "id": "MESSAGE074:0683",
   "jp": "あい、されんだー!",
   "en": "Aye, surrendaaa!"
  },
  {
   "id": "MESSAGE074:068D",
   "jp": "ケ…ケケ~……!",
   "en": "Ke... Kekeh~..."
  },
  {
   "id": "MESSAGE074:0696",
   "jp": "グォ…グォォォ~……!",
   "en": "Gro... Grooo~...!"
  },
  {
   "id": "MESSAGE074:06A2",
   "jp": "グワォ…グワォォォ~……!",
   "en": "Grwao...\nGrwaooo~......!"
  },
  {
   "id": "MESSAGE074:06B0",
   "jp": "これが…力か……",
   "en": "So this... is power..."
  },
  {
   "id": "MESSAGE074:06BA",
   "jp": "あたくし…主婦としての\n自信が無くなりましたわ",
   "en": "My confidence as a\nhousewife... is gone."
  },
  {
   "id": "MESSAGE074:06D7",
   "jp": "何故、この私が…",
   "en": "Why would I, of\nall people..."
  },
  {
   "id": "MESSAGE074:06E2",
   "jp": "も、もうダメだ…",
   "en": "I-I'm done for..."
  },
  {
   "id": "MESSAGE074:06EB",
   "jp": "ええッ!?　うそ…",
   "en": "Wha?! No way..."
  }
 ]
}
