{
 "file": "MESSAGE179.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE179:0560",
   "jp": "ここを制圧しろ…\nそういう命令なんでね",
   "en": ""
  },
  {
   "id": "MESSAGE179:0578",
   "jp": "こいつは使えねぇゼ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0584",
   "jp": "ここは制圧した!\n抵抗するのを止めろ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:059D",
   "jp": "制圧したわ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:05A6",
   "jp": "ここは我が軍が制圧した!\n抵抗する者は容赦しないッ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:05CA",
   "jp": "ここは我が帝国が制圧した!\n抵抗する者は容赦しないッ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:05F0",
   "jp": "ここは渡さないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:05FB",
   "jp": "使わせはしない!",
   "en": "You will not use it!"
  },
  {
   "id": "MESSAGE179:0605",
   "jp": "貴様らには渡さねえ!",
   "en": "You ain't gettin' it!"
  },
  {
   "id": "MESSAGE179:0613",
   "jp": "このようなもの…\n使わせはせぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0625",
   "jp": "敵に渡しはしない!",
   "en": "The enemy won't have\nit!"
  },
  {
   "id": "MESSAGE179:0631",
   "jp": "ニーチェ、ここもらったよ?",
   "en": ""
  },
  {
   "id": "MESSAGE179:063F",
   "jp": "よし!　制圧したぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:064C",
   "jp": "敵に奪われる前に…\n制圧しましょう",
   "en": ""
  },
  {
   "id": "MESSAGE179:0663",
   "jp": "お前らに使わせて\nなるものかよ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0676",
   "jp": "おっと!\n使わせねぇでやんすよ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0688",
   "jp": "邪魔する者はどきやがれぇ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0699",
   "jp": "よし、ここは制圧したぞい",
   "en": ""
  },
  {
   "id": "MESSAGE179:06A8",
   "jp": "ここには寄らせないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:06B5",
   "jp": "よしっ!\nここは制圧したよ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:06C6",
   "jp": "使われる前に\n奪っちまおう!",
   "en": ""
  },
  {
   "id": "MESSAGE179:06D8",
   "jp": "先に頂いておくか…!",
   "en": ""
  },
  {
   "id": "MESSAGE179:06E5",
   "jp": "…確保しました!",
   "en": ""
  },
  {
   "id": "MESSAGE179:06F0",
   "jp": "貴様たちに渡しはしない!",
   "en": "We won't hand it\nover to you!"
  },
  {
   "id": "MESSAGE179:0700",
   "jp": "フフ…ここは渡さないわよ?",
   "en": "Fufu... I won't hand\nthis over, you know?"
  },
  {
   "id": "MESSAGE179:070F",
   "jp": "貴様らには渡さん!",
   "en": ""
  },
  {
   "id": "MESSAGE179:071C",
   "jp": "神のご意思だ!\nこの武器は我らが接収する!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0739",
   "jp": "ど、どうだ!?\nこれで使えまい?",
   "en": ""
  },
  {
   "id": "MESSAGE179:074B",
   "jp": "あんたたちには\n使わせないわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE179:075D",
   "jp": "貴方たちには\n渡さないわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:076F",
   "jp": "ゼーハー…\n間に合ったのれす…",
   "en": ""
  },
  {
   "id": "MESSAGE179:0781",
   "jp": "ケッケッケ!",
   "en": "Keh-keh-keh!"
  },
  {
   "id": "MESSAGE179:0788",
   "jp": "先手必勝ですわね!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0796",
   "jp": "これでもう使うことは\n出来ないでしょう。フフフ…",
   "en": "Now no one can use\nit. Heh heh heh..."
  },
  {
   "id": "MESSAGE179:07B2",
   "jp": "まいったか!?",
   "en": ""
  },
  {
   "id": "MESSAGE179:07BA",
   "jp": "思い知るがいいわ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:07C6",
   "jp": "このまま一気に\nカタをつけるぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:07D9",
   "jp": "降伏しなさい!",
   "en": ""
  },
  {
   "id": "MESSAGE179:07E3",
   "jp": "ざまぁみやがれぃ!\nヒャーッハッハッハ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:07F8",
   "jp": "こんなもの…\n使わせないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0808",
   "jp": "そうは問屋が卸さないさ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0818",
   "jp": "制圧した!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0820",
   "jp": "愚か者め…\n思い知ったか!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0832",
   "jp": "これは\n使わせないわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE179:0840",
   "jp": "ケッケッケ!",
   "en": "Keh-keh-keh!"
  },
  {
   "id": "MESSAGE179:0847",
   "jp": "先に奪ってしまえ!",
   "en": ""
  },
  {
   "id": "MESSAGE179:0853",
   "jp": "どう?　参った?",
   "en": ""
  }
 ]
}
