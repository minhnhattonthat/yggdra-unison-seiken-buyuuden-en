{
 "file": "MESSAGE142.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE142:0480",
   "jp": "誰かに支配されるのは\nもうこりごりなんでね…",
   "en": ""
  },
  {
   "id": "MESSAGE142:049A",
   "jp": "お断りだゼ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:04A2",
   "jp": "いやだ。\n俺は仲間を裏切りたくない",
   "en": ""
  },
  {
   "id": "MESSAGE142:04B9",
   "jp": "いいえ…お断りします",
   "en": ""
  },
  {
   "id": "MESSAGE142:04C5",
   "jp": "思い上がるのも\nいい加減にしろ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:04DA",
   "jp": "貴様、何様のつもりだ!?",
   "en": ""
  },
  {
   "id": "MESSAGE142:04EB",
   "jp": "イヤよ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:04F0",
   "jp": "私には騎士の誇りがある。\nお断りします",
   "en": ""
  },
  {
   "id": "MESSAGE142:0508",
   "jp": "俺様は誰にも支配されねぇ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:051B",
   "jp": "これ以上の問答など\n無用ですぞ",
   "en": ""
  },
  {
   "id": "MESSAGE142:0531",
   "jp": "私は聖騎士。\n軍門に下ることなどせぬ",
   "en": ""
  },
  {
   "id": "MESSAGE142:0549",
   "jp": "怖いからイヤ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:0552",
   "jp": "私を説得しても無駄だ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:0562",
   "jp": "何を言われても\n聞く気はありません",
   "en": ""
  },
  {
   "id": "MESSAGE142:0578",
   "jp": "けっ、出直してきやがれ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:0587",
   "jp": "断るっ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:058D",
   "jp": "命は悩しいが、お断りだ",
   "en": ""
  },
  {
   "id": "MESSAGE142:059C",
   "jp": "ワシは疲れた…\nもう戦はコリゴリじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:05B2",
   "jp": "あなたの言うことなんて\n聞かない!",
   "en": ""
  },
  {
   "id": "MESSAGE142:05C6",
   "jp": "悪いけど、お断りだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:05D4",
   "jp": "断る…と言ったら?",
   "en": ""
  },
  {
   "id": "MESSAGE142:05E0",
   "jp": "お前らと組む気はねぇよ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:05F0",
   "jp": "お断り…します",
   "en": ""
  },
  {
   "id": "MESSAGE142:05F9",
   "jp": "…断る",
   "en": ""
  },
  {
   "id": "MESSAGE142:05FE",
   "jp": "諦めなさい。フフ…",
   "en": ""
  },
  {
   "id": "MESSAGE142:0609",
   "jp": "フン…100年早い!",
   "en": ""
  },
  {
   "id": "MESSAGE142:0616",
   "jp": "無礼者が!\n私を誰と心得るか!",
   "en": ""
  },
  {
   "id": "MESSAGE142:062C",
   "jp": "す、すまんが\nわしゃ戦いが苦手でのう…",
   "en": ""
  },
  {
   "id": "MESSAGE142:0643",
   "jp": "あたしに指図しないで頂戴!",
   "en": ""
  },
  {
   "id": "MESSAGE142:0655",
   "jp": "貴方、何様のつもりかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE142:0667",
   "jp": "あっかんべーっだ!",
   "en": ""
  },
  {
   "id": "MESSAGE142:0671",
   "jp": "ケッ!!",
   "en": ""
  },
  {
   "id": "MESSAGE142:0676",
   "jp": "グォ~ン!!",
   "en": ""
  },
  {
   "id": "MESSAGE142:067D",
   "jp": "グォ~ン!!",
   "en": ""
  },
  {
   "id": "MESSAGE142:0684",
   "jp": "この俺を使いこなせる力量が\n貴様にあるのか?",
   "en": ""
  },
  {
   "id": "MESSAGE142:06A1",
   "jp": "あたくしにも主婦としての\nプライドがありますの",
   "en": ""
  },
  {
   "id": "MESSAGE142:06BB",
   "jp": "貴方たちには\n私は使いこなせないでしょう",
   "en": ""
  }
 ]
}
