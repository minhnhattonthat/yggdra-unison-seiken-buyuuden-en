{
 "file": "MESSAGE181.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE181:0560",
   "jp": "すまないが、こいつは\n渡せないんだ",
   "en": ""
  },
  {
   "id": "MESSAGE181:0573",
   "jp": "こいつを使わせるわけには\nいかねぇんだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:058A",
   "jp": "これも戦争なんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0596",
   "jp": "ここは私たちが\n制圧しました!",
   "en": ""
  },
  {
   "id": "MESSAGE181:05A8",
   "jp": "よし、ここの防御を\n固めるんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:05BC",
   "jp": "よし、ここの防御を\n固める!　急げッ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:05D4",
   "jp": "近付くと痛い目に遣うわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:05E7",
   "jp": "我らは引き下がりはしない!",
   "en": ""
  },
  {
   "id": "MESSAGE181:05F7",
   "jp": "どかねぇと命が幾つあっても\n足りなくなるぜ?",
   "en": ""
  },
  {
   "id": "MESSAGE181:0611",
   "jp": "渡しはせぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0619",
   "jp": "敵に利用される前に制圧だ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:062D",
   "jp": "隙あり~!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0634",
   "jp": "ここを制圧して…\n更に追撃をかけるぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:064D",
   "jp": "これで脅威は減りました",
   "en": ""
  },
  {
   "id": "MESSAGE181:065C",
   "jp": "使わせはしねーぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0667",
   "jp": "制圧したでやんすよ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0674",
   "jp": "うおりゃーッ!\nどうだぁ!?",
   "en": ""
  },
  {
   "id": "MESSAGE181:0683",
   "jp": "敵に渡っては困るからのう!\nガハハハ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:069A",
   "jp": "欲張りはダメなんだからね!",
   "en": "Being greedy is bad,\nyou know!"
  },
  {
   "id": "MESSAGE181:06AA",
   "jp": "ここはもう、使わせないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:06B9",
   "jp": "おっと、悪いけど\n僕らが頂くよ",
   "en": ""
  },
  {
   "id": "MESSAGE181:06CC",
   "jp": "おおっと!\nここはオイラがもらうぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:06DF",
   "jp": "制圧…完了しました",
   "en": ""
  },
  {
   "id": "MESSAGE181:06ED",
   "jp": "制圧した!",
   "en": ""
  },
  {
   "id": "MESSAGE181:06F5",
   "jp": "無駄よ…",
   "en": "It's no use..."
  },
  {
   "id": "MESSAGE181:06FC",
   "jp": "フッ…甘いな!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0705",
   "jp": "フハハハハ!\n神の力、恐れ入ったか?",
   "en": ""
  },
  {
   "id": "MESSAGE181:071B",
   "jp": "こんなものを使われては\nわしの命が危ない…!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0735",
   "jp": "あたしにかかれば\nこんなものよ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0746",
   "jp": "武器のイロハも分からない\nヤツに、渡しはしないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0764",
   "jp": "パメラ様、奪ったりィィィ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0774",
   "jp": "ケッケッケ!",
   "en": "Keh-keh-keh!"
  },
  {
   "id": "MESSAGE181:077B",
   "jp": "撃たれる前に…\n奪って差し上げますわね!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0795",
   "jp": "貴方たちには\n使わせませんよ。フフフ…",
   "en": ""
  },
  {
   "id": "MESSAGE181:07AC",
   "jp": "制圧したぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:07B5",
   "jp": "こんなもの…\n使わせないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:07C5",
   "jp": "制圧完了!",
   "en": ""
  },
  {
   "id": "MESSAGE181:07CF",
   "jp": "間に合ったみたいね?",
   "en": ""
  },
  {
   "id": "MESSAGE181:07DC",
   "jp": "制圧だぁ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:07E4",
   "jp": "今までのお返しよ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:07F0",
   "jp": "やった!\n制圧したぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:07FE",
   "jp": "早く降伏しないと\n被害が広がるわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE181:0817",
   "jp": "フン、話にならんな!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0823",
   "jp": "ちょろいちょろい!\n楽勝ね!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0834",
   "jp": "ケッケッケ!",
   "en": "Keh-keh-keh!"
  },
  {
   "id": "MESSAGE181:083B",
   "jp": "ここを取れば\n勝利は目の前だ!",
   "en": ""
  },
  {
   "id": "MESSAGE181:0850",
   "jp": "こんなもの…\n使わせはしないわ!",
   "en": ""
  }
 ]
}
