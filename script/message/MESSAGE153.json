{
 "file": "MESSAGE153.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE153:0480",
   "jp": "…そうか。失礼するよ",
   "en": ""
  },
  {
   "id": "MESSAGE153:048D",
   "jp": "縁があったらまた会おうゼ",
   "en": ""
  },
  {
   "id": "MESSAGE153:049C",
   "jp": "まあ、仕方ないか…",
   "en": ""
  },
  {
   "id": "MESSAGE153:04A8",
   "jp": "では、失礼します",
   "en": ""
  },
  {
   "id": "MESSAGE153:04B3",
   "jp": "では、さらばだ",
   "en": ""
  },
  {
   "id": "MESSAGE153:04BB",
   "jp": "フン…さらばだ",
   "en": ""
  },
  {
   "id": "MESSAGE153:04C3",
   "jp": "…分かったわ。じゃあね",
   "en": ""
  },
  {
   "id": "MESSAGE153:04D0",
   "jp": "それでは…失礼いたします",
   "en": ""
  },
  {
   "id": "MESSAGE153:04DF",
   "jp": "ああ、そうかい。あばよ",
   "en": ""
  },
  {
   "id": "MESSAGE153:04EB",
   "jp": "では失礼いたす",
   "en": ""
  },
  {
   "id": "MESSAGE153:04F5",
   "jp": "力及ばず…\n申し訳ございません",
   "en": ""
  },
  {
   "id": "MESSAGE153:0509",
   "jp": "そうなの…じゃあ\nニーチェ帰るね……",
   "en": ""
  },
  {
   "id": "MESSAGE153:051D",
   "jp": "縁が無かっただけの話だ。\nでは、さらばだ…",
   "en": ""
  },
  {
   "id": "MESSAGE153:0536",
   "jp": "…わかりました。\n失礼致します",
   "en": ""
  },
  {
   "id": "MESSAGE153:0549",
   "jp": "じゃあ、帰らせてもらうぜ",
   "en": ""
  },
  {
   "id": "MESSAGE153:0557",
   "jp": "ま、仕方ねえや。じゃあな!",
   "en": ""
  },
  {
   "id": "MESSAGE153:0567",
   "jp": "仕方ねぇな。また山賊家業に\n戻るとするか…",
   "en": ""
  },
  {
   "id": "MESSAGE153:0584",
   "jp": "人の下で働くのは\n柄じゃないからのう",
   "en": ""
  },
  {
   "id": "MESSAGE153:059A",
   "jp": "ふうん…\n後悔しても知らないから!",
   "en": ""
  },
  {
   "id": "MESSAGE153:05AF",
   "jp": "分かったよ。\nそれじゃあね",
   "en": ""
  },
  {
   "id": "MESSAGE153:05BE",
   "jp": "これで晴れて自由の身…か",
   "en": ""
  },
  {
   "id": "MESSAGE153:05CF",
   "jp": "そうか。じゃーな!",
   "en": ""
  },
  {
   "id": "MESSAGE153:05D9",
   "jp": "今まで…\nありがとうございました",
   "en": ""
  },
  {
   "id": "MESSAGE153:05EB",
   "jp": "…失礼する",
   "en": ""
  },
  {
   "id": "MESSAGE153:05F3",
   "jp": "フフ…じゃあね",
   "en": ""
  },
  {
   "id": "MESSAGE153:05FB",
   "jp": "フン、用済みということか…",
   "en": ""
  },
  {
   "id": "MESSAGE153:060B",
   "jp": "愚か者が…神の定めた道を\n間違えおったか!",
   "en": ""
  },
  {
   "id": "MESSAGE153:0627",
   "jp": "そ、そうか…\nでは仕方ないか……",
   "en": ""
  },
  {
   "id": "MESSAGE153:063A",
   "jp": "あら、そう…\n世話になったわね",
   "en": ""
  },
  {
   "id": "MESSAGE153:064C",
   "jp": "あら、そう…\n貴方のこと、見損なったわ",
   "en": ""
  },
  {
   "id": "MESSAGE153:0664",
   "jp": "グスン、じゃあね~",
   "en": ""
  },
  {
   "id": "MESSAGE153:066E",
   "jp": "クケッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE153:0674",
   "jp": "グォーッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE153:067B",
   "jp": "グワォーッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE153:0683",
   "jp": "元より長居する気は無い。\nさらばだ",
   "en": ""
  },
  {
   "id": "MESSAGE153:069A",
   "jp": "まだ主婦業、本領を\n発揮しておりませんのよ?",
   "en": ""
  },
  {
   "id": "MESSAGE153:06B8",
   "jp": "訳は聞かないでおきましょう",
   "en": ""
  }
 ]
}
