{
 "file": "MESSAGE048.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE048:0460",
   "jp": "あんたに罪は無いが\n帝国には借りがあるんでね…",
   "en": "Nothing personal, but\nI owe the Empire one..."
  },
  {
   "id": "MESSAGE048:047D",
   "jp": "悪く思うなよな!",
   "en": "Don't take it\npersonal, y'know!"
  },
  {
   "id": "MESSAGE048:0488",
   "jp": "勝った…",
   "en": "I won..."
  },
  {
   "id": "MESSAGE048:048E",
   "jp": "勝ったわ…",
   "en": "We have won..."
  },
  {
   "id": "MESSAGE048:0495",
   "jp": "無謀だな…",
   "en": "How reckless..."
  },
  {
   "id": "MESSAGE048:049D",
   "jp": "無謀なことを…",
   "en": "Such recklessness..."
  },
  {
   "id": "MESSAGE048:04A7",
   "jp": "勝ったのね…",
   "en": "So I won..."
  },
  {
   "id": "MESSAGE048:04AF",
   "jp": "撃破…しました",
   "en": "Enemy... defeated."
  },
  {
   "id": "MESSAGE048:04B9",
   "jp": "ザコがいきがりやがって…",
   "en": "Small fry actin' all\ntough..."
  },
  {
   "id": "MESSAGE048:04C6",
   "jp": "撃破…いたしましたぞ!",
   "en": "The foe... is\nvanquished!"
  },
  {
   "id": "MESSAGE048:04D4",
   "jp": "たおしたみたい…",
   "en": "Looks like Nietzsche\nbeat them..."
  },
  {
   "id": "MESSAGE048:04DD",
   "jp": "許せ…",
   "en": "Forgive me..."
  },
  {
   "id": "MESSAGE048:04E2",
   "jp": "安らかにお眠りなさい…",
   "en": "Rest in peace..."
  },
  {
   "id": "MESSAGE048:04F0",
   "jp": "俺だって退けねえんだ!",
   "en": "I can't back down\neither!"
  },
  {
   "id": "MESSAGE048:04FE",
   "jp": "これが、戦いなんだからね",
   "en": "This is what war is,\nyou know."
  },
  {
   "id": "MESSAGE048:050C",
   "jp": "退くなら今のうちだよ?",
   "en": "Better back off while\nya can!"
  },
  {
   "id": "MESSAGE048:051A",
   "jp": "ちょっと複雑な気分だけどな",
   "en": "Though I've got mixed\nfeelings about it."
  },
  {
   "id": "MESSAGE048:052C",
   "jp": "どけどけーぃ!",
   "en": "Outta the way!"
  },
  {
   "id": "MESSAGE048:0534",
   "jp": "…………",
   "en": ""
  },
  {
   "id": "MESSAGE048:0539",
   "jp": "これが戦いだ…",
   "en": "Such is battle..."
  },
  {
   "id": "MESSAGE048:0542",
   "jp": "ケガするわよ?",
   "en": "You'll get hurt, you\nknow?"
  },
  {
   "id": "MESSAGE048:054A",
   "jp": "許せ…",
   "en": "Forgive me..."
  },
  {
   "id": "MESSAGE048:054F",
   "jp": "去れ!",
   "en": "Depart!"
  },
  {
   "id": "MESSAGE048:0554",
   "jp": "か、勝ったんじゃな…",
   "en": "I-I won, did I..."
  },
  {
   "id": "MESSAGE048:0560",
   "jp": "無駄よ…\nあんたにあたしは倒せない…",
   "en": "It's useless...\nYou can't beat me..."
  },
  {
   "id": "MESSAGE048:0576",
   "jp": "おとなしくしてね?",
   "en": "Behave yourself,\nokay?"
  },
  {
   "id": "MESSAGE048:0580",
   "jp": "恨まないでね~",
   "en": "No hard feelings~"
  },
  {
   "id": "MESSAGE048:0589",
   "jp": "ケケケ…",
   "en": "Kekeke..."
  },
  {
   "id": "MESSAGE048:058E",
   "jp": "グォッ!",
   "en": "Groh!"
  },
  {
   "id": "MESSAGE048:0593",
   "jp": "グワォーッ!",
   "en": "Grwaooh!"
  },
  {
   "id": "MESSAGE048:059A",
   "jp": "俺には勝てんぞ",
   "en": "You can't beat me."
  },
  {
   "id": "MESSAGE048:05A4",
   "jp": "手加減しましたわよ?",
   "en": "I went easy on you,\ndear."
  },
  {
   "id": "MESSAGE048:05B2",
   "jp": "私に勝てるとでも\n思ったのですか?",
   "en": "Did you truly think\nyou could defeat me?"
  }
 ]
}
