{
 "file": "MESSAGE163.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE163:0480",
   "jp": "分かった。俺に任せときな",
   "en": "Got it. Leave it to me."
  },
  {
   "id": "MESSAGE163:0490",
   "jp": "じゃ、行ってくるゼ!",
   "en": "Later! I'm off, y'know!"
  },
  {
   "id": "MESSAGE163:049B",
   "jp": "それでは、調べてきます",
   "en": "Then I'll go\ncheck it out."
  },
  {
   "id": "MESSAGE163:04A8",
   "jp": "では、行ってまいります",
   "en": "Well then, I shall\nbe off."
  },
  {
   "id": "MESSAGE163:04B4",
   "jp": "私が行ってきてやろう",
   "en": "Fine. I shall\ngo for you."
  },
  {
   "id": "MESSAGE163:04BF",
   "jp": "フン…待っていろ",
   "en": "Hmph... Wait here."
  },
  {
   "id": "MESSAGE163:04C9",
   "jp": "じゃあ、行ってくるわ。\n待っててね",
   "en": "Well, I'm off.\nWait for me, okay?"
  },
  {
   "id": "MESSAGE163:04DC",
   "jp": "では、行って参ります!",
   "en": "Then I shall be off!"
  },
  {
   "id": "MESSAGE163:04E9",
   "jp": "財宝を根こそぎ奪ってくるぜ",
   "en": "I'll grab every last\nscrap of loot!"
  },
  {
   "id": "MESSAGE163:04FB",
   "jp": "御意。\nでは、行って参りましょう",
   "en": "As thou wilt.\nI shall be off, then."
  },
  {
   "id": "MESSAGE163:050F",
   "jp": "御意",
   "en": "As you will."
  },
  {
   "id": "MESSAGE163:0514",
   "jp": "ニーチェ、行ってくるね!",
   "en": "Nietzsche's off now!"
  },
  {
   "id": "MESSAGE163:0521",
   "jp": "そこで待っていろ",
   "en": "Wait there."
  },
  {
   "id": "MESSAGE163:052B",
   "jp": "では、まいりましょう",
   "en": "Then, let us go."
  },
  {
   "id": "MESSAGE163:0536",
   "jp": "オレに任せとけって!",
   "en": "Just leave it to me!"
  },
  {
   "id": "MESSAGE163:0542",
   "jp": "ちょっくら行ってきやす!",
   "en": "I'll go take a quick\nlook-see!"
  },
  {
   "id": "MESSAGE163:054F",
   "jp": "おう、行ってくるぞ",
   "en": "Aye, I'm headin' out!"
  },
  {
   "id": "MESSAGE163:0559",
   "jp": "うむ、行ってみるか",
   "en": "Hm, let's have\na look, eh."
  },
  {
   "id": "MESSAGE163:0563",
   "jp": "わかった。待っててね",
   "en": "Okay. Wait for me!"
  },
  {
   "id": "MESSAGE163:056F",
   "jp": "ウチ、行ってくるね!",
   "en": "Off I go, then!"
  },
  {
   "id": "MESSAGE163:057A",
   "jp": "OK、行ってくるよ",
   "en": "OK, I'm going."
  },
  {
   "id": "MESSAGE163:0584",
   "jp": "オイラが行ってくるぜ!",
   "en": "Yours truly's on it!"
  },
  {
   "id": "MESSAGE163:0590",
   "jp": "それでは…行って参ります",
   "en": "Then... I shall go."
  },
  {
   "id": "MESSAGE163:059E",
   "jp": "…待っていろ",
   "en": "...Wait here."
  },
  {
   "id": "MESSAGE163:05A6",
   "jp": "お任せを…",
   "en": "Leave it to me..."
  },
  {
   "id": "MESSAGE163:05AD",
   "jp": "私が見てきてやろう",
   "en": "I'll go see.\nConsider it a favor."
  },
  {
   "id": "MESSAGE163:05B8",
   "jp": "では、調べてこよう",
   "en": "Then I shall\ninvestigate."
  },
  {
   "id": "MESSAGE163:05C3",
   "jp": "では、行ってみようかの",
   "en": "Well, guess I'll\ngo see, eh."
  },
  {
   "id": "MESSAGE163:05CF",
   "jp": "行ってくるわね。\nあたしに任せて頂戴",
   "en": "I'm off, darling.\nLeave it to me!"
  },
  {
   "id": "MESSAGE163:05E5",
   "jp": "じゃあ、期待して待っててね",
   "en": "Then wait for me, and\nexpect great things~"
  },
  {
   "id": "MESSAGE163:05F6",
   "jp": "ははーい!",
   "en": "Okeydokey!"
  },
  {
   "id": "MESSAGE163:05FC",
   "jp": "クケックケッ!",
   "en": "Kukeh! Kukeh!"
  },
  {
   "id": "MESSAGE163:0604",
   "jp": "グォー!",
   "en": "Grooo!"
  },
  {
   "id": "MESSAGE163:0609",
   "jp": "グワォッグワォッ!",
   "en": "Grwaow! Grwaow!"
  },
  {
   "id": "MESSAGE163:0613",
   "jp": "俺が確かめてやろう",
   "en": "I'll see for myself."
  },
  {
   "id": "MESSAGE163:061F",
   "jp": "ちょっと見てきますわね!",
   "en": "I'll just pop over\nand look!"
  },
  {
   "id": "MESSAGE163:062D",
   "jp": "私が見て参りましょう",
   "en": "I shall go and see."
  }
 ]
}
