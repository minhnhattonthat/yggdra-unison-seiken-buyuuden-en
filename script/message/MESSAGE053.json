{
 "file": "MESSAGE053.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE053:04C0",
   "jp": "やれやれ…",
   "en": "Sheesh..."
  },
  {
   "id": "MESSAGE053:04C6",
   "jp": "金のためだ。悪く思うなよ!",
   "en": "It's for the money.\nNo hard feelin's!"
  },
  {
   "id": "MESSAGE053:04D7",
   "jp": "やった…",
   "en": "I did it..."
  },
  {
   "id": "MESSAGE053:04DC",
   "jp": "倒しました",
   "en": "I defeated them."
  },
  {
   "id": "MESSAGE053:04E3",
   "jp": "張り合いの無い…",
   "en": "No challenge at\nall..."
  },
  {
   "id": "MESSAGE053:04EF",
   "jp": "フン…張り合いの無い",
   "en": "Hmph... hardly a\nchallenge."
  },
  {
   "id": "MESSAGE053:04FD",
   "jp": "これも戦いなのね…",
   "en": "This is war too,\nisn't it..."
  },
  {
   "id": "MESSAGE053:0508",
   "jp": "…これも戦いなのだ",
   "en": "...Such is war."
  },
  {
   "id": "MESSAGE053:0513",
   "jp": "つまらねぇ仕事だぜ!",
   "en": "What a boring job!"
  },
  {
   "id": "MESSAGE053:0520",
   "jp": "まだ血を欲されるか…?",
   "en": "Dost thou thirst for\nmore blood...?"
  },
  {
   "id": "MESSAGE053:052E",
   "jp": "気分のいいものではないな…",
   "en": "This gives me no\npleasure..."
  },
  {
   "id": "MESSAGE053:053E",
   "jp": "うまくいったよ",
   "en": "Nietzsche did\ngood!"
  },
  {
   "id": "MESSAGE053:0546",
   "jp": "邪魔をするからだ…",
   "en": "That's what you get\nfor interfering..."
  },
  {
   "id": "MESSAGE053:0552",
   "jp": "これも戦争なのです",
   "en": "This, too, is war."
  },
  {
   "id": "MESSAGE053:055E",
   "jp": "ま、こんなもんだろ",
   "en": "Eh, that'll do."
  },
  {
   "id": "MESSAGE053:0568",
   "jp": "あまり気が乗りやせんが…",
   "en": "Ain't really feelin'\nit, but..."
  },
  {
   "id": "MESSAGE053:0577",
   "jp": "ザコを斬っても\n面白う無いのぉ…",
   "en": "Cuttin' down small\nfry ain't no fun..."
  },
  {
   "id": "MESSAGE053:058C",
   "jp": "これでいいかのう?",
   "en": "Will that do, eh?"
  },
  {
   "id": "MESSAGE053:0596",
   "jp": "ボクが戦う相手じゃないよ",
   "en": "You're not worth my\ntime!"
  },
  {
   "id": "MESSAGE053:05A6",
   "jp": "こんなもんかな?",
   "en": "That about does it?"
  },
  {
   "id": "MESSAGE053:05AF",
   "jp": "これでどうかな?",
   "en": "How about that?"
  },
  {
   "id": "MESSAGE053:05B8",
   "jp": "…ちょっと飽きてきたぞ",
   "en": "...Gettin' kinda\nbored."
  },
  {
   "id": "MESSAGE053:05C5",
   "jp": "辛いけど…これも任務……",
   "en": "It hurts... but it's\nmy mission......"
  },
  {
   "id": "MESSAGE053:05D5",
   "jp": "フン…",
   "en": "Hmph..."
  },
  {
   "id": "MESSAGE053:05D9",
   "jp": "つまらない人ね…",
   "en": "How dull you are..."
  },
  {
   "id": "MESSAGE053:05E3",
   "jp": "この程度か?",
   "en": "Is that all?"
  },
  {
   "id": "MESSAGE053:05EC",
   "jp": "ザコどもめ…",
   "en": "Rabble..."
  },
  {
   "id": "MESSAGE053:05F3",
   "jp": "わ、わしに近寄るでない!",
   "en": "S-stay away from\nthis old man!"
  },
  {
   "id": "MESSAGE053:0602",
   "jp": "あーあ、手のかかるヤツね",
   "en": "Ugh, what a\nhandful."
  },
  {
   "id": "MESSAGE053:0610",
   "jp": "なーんか\n燃えないのよね…",
   "en": "Somehow, I just\ncan't get fired up..."
  },
  {
   "id": "MESSAGE053:061F",
   "jp": "たおしたー",
   "en": "Got 'em~"
  },
  {
   "id": "MESSAGE053:0625",
   "jp": "ケケッ",
   "en": "Kekeh"
  },
  {
   "id": "MESSAGE053:0629",
   "jp": "グォーッ!",
   "en": "Groooh!"
  },
  {
   "id": "MESSAGE053:062F",
   "jp": "グワォーッ!",
   "en": "Grwaooh!"
  },
  {
   "id": "MESSAGE053:0636",
   "jp": "愚かな…",
   "en": "How foolish..."
  },
  {
   "id": "MESSAGE053:063C",
   "jp": "お気の毒ですけど…",
   "en": "I'm so sorry, but..."
  },
  {
   "id": "MESSAGE053:0648",
   "jp": "その程度では…\n本気を出すまでも無い…",
   "en": "At that level...\nI needn't even try..."
  }
 ]
}
