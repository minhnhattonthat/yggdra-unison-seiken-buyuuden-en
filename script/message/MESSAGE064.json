   "en": ""
  },
  {
   "id": "MESSAGE064:05CB",
   "jp": "王女なんかに負けないよーだ",
   "en": ""
  },
  {
   "id": "MESSAGE064:05DC",
   "jp": "やりすぎちゃったかもね…",
   "en": ""
  },
  {
   "id": "MESSAGE064:05E9",
   "jp": "僕も負けるわけには\nいかないんだ",
   "en": ""
  },
  {
   "id": "MESSAGE064:05FC",
   "jp": "油断してたら、こっちが\nやられちまうからな!",
   "en": ""
  },
  {
   "id": "MESSAGE064:0615",
   "jp": "ジルヴァ様…!!",
   "en": ""
  },
  {
   "id": "MESSAGE064:061F",
   "jp": "陛下、どうぞ安らかに…",
   "en": ""
  },
  {
   "id": "MESSAGE064:062D",
   "jp": "アマレウスを\nお許しください…",
   "en": ""
  },
  {
   "id": "MESSAGE064:063E",
   "jp": "安らかに眠るがいい",
   "en": ""
  },
  {
   "id": "MESSAGE064:064A",
   "jp": "地獄へ堕ちるが良い",
   "en": ""
  },
  {
   "id": "MESSAGE064:0658",
   "jp": "アマレウス!\n殺す気は無かったんじゃ!!",
   "en": ""
  },
  {
