 "strings": [
  {
   "id": "MESSAGE064:04C0",
   "jp": "革命の光、ここに潰える…か",
   "en": ""
  },
  {
   "id": "MESSAGE064:04D2",
   "jp": "生き返ったりしねぇよな…?",
   "en": ""
  },
  {
   "id": "MESSAGE064:04E2",
   "jp": "う…討ち取った…のか?",
   "en": ""
  },
  {
   "id": "MESSAGE064:04F0",
   "jp": "弱気になってはいけない…!",
   "en": ""
  },
  {
   "id": "MESSAGE064:0500",
   "jp": "陛下…お許しを……",
   "en": ""
  },
  {
   "id": "MESSAGE064:050C",
   "jp": "陛下…ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE064:0513",
   "jp": "え…討ち取っちゃったの!?",
   "en": ""
  },
  {
   "id": "MESSAGE064:0523",
   "jp": "敵将討ち取ったり!",
   "en": ""
  },
  {
   "id": "MESSAGE064:0531",
   "jp": "俺様の邪魔ばかりしやがって\nこのアマが!",
   "en": ""
  },
  {
   "id": "MESSAGE064:054A",
   "jp": "見事な散り様であった…",
   "en": ""
  },
  {
   "id": "MESSAGE064:055A",
   "jp": "運命には逆らえぬ",
   "en": ""
  },
  {
   "id": "MESSAGE064:0566",
   "jp": "ごめんね、許してね…",
   "en": ""
  },
  {
   "id": "MESSAGE064:0572",
   "jp": "これも運命だ…",
   "en": ""
  },
  {
   "id": "MESSAGE064:057C",
   "jp": "貴方の覚悟は見届けましたよ",
   "en": ""
  },
  {
   "id": "MESSAGE064:0590",
   "jp": "くそっ…手元が狂ったか!?",
   "en": ""
  },
  {
   "id": "MESSAGE064:05A1",
   "jp": "姐さん…ウソだろ……?",
   "en": ""
  },
  {
   "id": "MESSAGE064:05AE",
   "jp": "これも仕事なんでな!",
   "en": ""
  },
  {
   "id": "MESSAGE064:05BB",
