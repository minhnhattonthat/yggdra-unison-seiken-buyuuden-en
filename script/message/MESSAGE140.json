{
 "file": "MESSAGE140.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE140:0480",
   "jp": "帝国に一矢報いることが\nできるなら…共に行こう",
   "en": ""
  },
  {
   "id": "MESSAGE140:049E",
   "jp": "仕方ねぇ…協力するゼ",
   "en": ""
  },
  {
   "id": "MESSAGE140:04AD",
   "jp": "どうやら、俺に拒否権は\n無さそうだ…",
   "en": ""
  },
  {
   "id": "MESSAGE140:04C5",
   "jp": "…協力しましょう",
   "en": ""
  },
  {
   "id": "MESSAGE140:04D0",
   "jp": "くっ…\n運命には抗えんか……",
   "en": ""
  },
  {
   "id": "MESSAGE140:04E2",
   "jp": "くっ…\nこれも運命なのかもな……",
   "en": ""
  },
  {
   "id": "MESSAGE140:04F5",
   "jp": "そこまで言うなら…\n仕方ないわね",
   "en": ""
  },
  {
   "id": "MESSAGE140:0509",
   "jp": "…では、貴殿の正義とやらを\n見せてもらいましょう",
   "en": ""
  },
  {
   "id": "MESSAGE140:0527",
   "jp": "…俺様は俺様の好きなように\nやらせてもらうぜ。いいな?",
   "en": ""
  },
  {
   "id": "MESSAGE140:0548",
   "jp": "仕方あるまい…\n微力ながら力になり申す",
   "en": ""
  },
  {
   "id": "MESSAGE140:0562",
   "jp": "…貴殿の正義とやらを\n見定めさせてもらいましょう",
   "en": ""
  },
  {
   "id": "MESSAGE140:0581",
   "jp": "う~ん…\nじゃあ、お手伝いするよ…",
   "en": ""
  },
  {
   "id": "MESSAGE140:0595",
   "jp": "くっ…\n従うしか無いようだな",
   "en": ""
  },
  {
   "id": "MESSAGE140:05A6",
   "jp": "貴方の正義を\n拝見させてもらいましょう…",
   "en": ""
  },
  {
   "id": "MESSAGE140:05C1",
   "jp": "いいぜ…けど、お前の指図は\n受けねーからな",
   "en": ""
  },
  {
   "id": "MESSAGE140:05DB",
   "jp": "仕方ねえ…お供するぜ",
   "en": ""
  },
  {
   "id": "MESSAGE140:05E9",
   "jp": "分け前をくれるなら喜んで\n手を貸すぜぇ",
   "en": ""
  },
  {
   "id": "MESSAGE140:0602",
   "jp": "ワシの家業に目をつぶって\nくれるんなら、力を貸そう",
   "en": ""
  },
  {
   "id": "MESSAGE140:0621",
   "jp": "かまわないけど…\n言いなりにはならないから!",
   "en": ""
  },
  {
   "id": "MESSAGE140:0639",
   "jp": "アルのこと、助けてくれる?\nだったら仲間になるよ…",
   "en": ""
  },
  {
   "id": "MESSAGE140:0656",
   "jp": "まあ、いいけど…\nどうしてこうなるかな?",
   "en": ""
  },
  {
   "id": "MESSAGE140:066B",
   "jp": "オイラの力が必要ってか?\n分かったよ…",
   "en": ""
  },
  {
   "id": "MESSAGE140:0683",
   "jp": "分かり…ました……",
   "en": ""
  },
  {
   "id": "MESSAGE140:068E",
   "jp": "くっ…\n……承知した",
   "en": ""
  },
  {
   "id": "MESSAGE140:069B",
   "jp": "フフ…\n貴方に私が扱えるかしらね?",
   "en": ""
  },
  {
   "id": "MESSAGE140:06B0",
   "jp": "仕方あるまい…\n私の力を貸してやろう",
   "en": ""
  },
  {
   "id": "MESSAGE140:06C7",
   "jp": "この私に目をつけるとは\nなかなかのものだ…",
   "en": ""
  },
  {
   "id": "MESSAGE140:06DE",
   "jp": "生き延びるためじゃ…\n協力しよう……",
   "en": ""
  },
  {
   "id": "MESSAGE140:06F5",
   "jp": "ああもう、仕方ないわね…\n仲間になればいいんでしょ?",
   "en": ""
  },
  {
   "id": "MESSAGE140:0714",
   "jp": "…私の策が必要なのね?\n分かったわよ…",
   "en": ""
  },
  {
   "id": "MESSAGE140:072C",
   "jp": "仲間にしてくれるのね?",
   "en": ""
  },
  {
   "id": "MESSAGE140:073A",
   "jp": "クケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE140:0740",
   "jp": "グォォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE140:0746",
   "jp": "グワォォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE140:074D",
   "jp": "貴様の力とやらを\n見定めてやろう…",
   "en": ""
  },
  {
   "id": "MESSAGE140:0764",
   "jp": "あたくしを使いこなせる\nかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE140:0776",
   "jp": "仕方ありませんね。\n従いましょう…",
   "en": ""
  }
 ]
}
