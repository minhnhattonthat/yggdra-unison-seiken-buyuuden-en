{
 "file": "MESSAGE021.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE021:0640",
   "jp": "真剣勝負だ!",
   "en": "A true duel!"
  },
  {
   "id": "MESSAGE021:064B",
   "jp": "剣さばきには\n自信があるんだゼ!",
   "en": "I'm darn good with\na blade, y'know!"
  },
  {
   "id": "MESSAGE021:065F",
   "jp": "負けはしないぞ!",
   "en": "I won't lose!"
  },
  {
   "id": "MESSAGE021:0669",
   "jp": "覚悟してください!",
   "en": "Prepare yourself!"
  },
  {
   "id": "MESSAGE021:0675",
   "jp": "先んずれば人を制す!",
   "en": "Who strikes first,\nprevails!"
  },
  {
   "id": "MESSAGE021:0683",
   "jp": "遅い!　こちらからいくぞ!",
   "en": "Too slow! I'm coming\nat you!"
  },
  {
   "id": "MESSAGE021:0692",
   "jp": "貴方なんて怖くないわ!",
   "en": "I'm not afraid of you!"
  },
  {
   "id": "MESSAGE021:06A1",
   "jp": "敵をなぎ払う!　突撃!",
   "en": "Sweep the enemy\naside! Charge!"
  },
  {
   "id": "MESSAGE021:06B1",
   "jp": "クク、俺様の槍が防げるか?",
   "en": "Heh, think ya can\nstop my lance?"
  },
  {
   "id": "MESSAGE021:06C3",
   "jp": "いざ、勝負!",
   "en": "Have at thee!"
  },
  {
   "id": "MESSAGE021:06CC",
   "jp": "いざ尋常に勝負!",
   "en": "A fair and\nhonest duel!"
  },
  {
   "id": "MESSAGE021:06D9",
   "jp": "とつげーき!",
   "en": "Chaaarge!"
  },
  {
   "id": "MESSAGE021:06E0",
   "jp": "覚悟するんだ!",
   "en": "Brace yourself!"
  },
  {
   "id": "MESSAGE021:06EA",
   "jp": "こちらからまいります!",
   "en": "Allow me to begin!"
  },
  {
   "id": "MESSAGE021:06F6",
   "jp": "こっちからいくぜ!",
   "en": "I'm comin' at ya!"
  },
  {
   "id": "MESSAGE021:0700",
   "jp": "底力を見せてやるぞ!",
   "en": "I'll show ya what\nI'm made of!"
  },
  {
   "id": "MESSAGE021:070E",
   "jp": "ほっほー!　いくぞぉ!",
   "en": "Ho ho! Here I come!"
  },
  {
   "id": "MESSAGE021:071A",
   "jp": "ガハハハ!　くらえぃ!",
   "en": "Gwahahaha!\nTake that, eh!"
  },
  {
   "id": "MESSAGE021:0726",
   "jp": "くらいなさい!",
   "en": "Take this!"
  },
  {
   "id": "MESSAGE021:072E",
   "jp": "邪魔邪魔邪魔ーッ!",
   "en": "Move, move, move,\nmooove!"
  },
  {
   "id": "MESSAGE021:073E",
   "jp": "一気にカタをつけるぞ!",
   "en": "Let's end this in\none go!"
  },
  {
   "id": "MESSAGE021:074C",
   "jp": "お前に用はねーんだよっ!",
   "en": "I got no business\nwith you!"
  },
  {
   "id": "MESSAGE021:075B",
   "jp": "…いきます!",
   "en": "...Here I go!"
  },
  {
   "id": "MESSAGE021:0762",
   "jp": "沈むがいいッ!",
   "en": "Go down!"
  },
  {
   "id": "MESSAGE021:076B",
   "jp": "これはどうかしら?",
   "en": "How about this?"
  },
  {
   "id": "MESSAGE021:0775",
   "jp": "我が魔法を受けてみよ!",
   "en": "Taste my magic!"
  },
  {
   "id": "MESSAGE021:0785",
   "jp": "我が手で葬ってくれる!",
   "en": "I shall bury you\nwith my own hands!"
  },
  {
   "id": "MESSAGE021:0794",
   "jp": "と、突撃じゃあ!",
   "en": "Ch-charge, I say!"
  },
  {
   "id": "MESSAGE021:079F",
   "jp": "あんた、邪魔よ!",
   "en": "You're in my way!"
  },
  {
   "id": "MESSAGE021:07AA",
   "jp": "チャンスは逃さないわ!",
   "en": "I won't let this\nchance slip!"
  },
  {
   "id": "MESSAGE021:07B7",
   "jp": "パメラ様を怒らせると\n怖いわよ!?",
   "en": "Anger Pamela-sama\nand you'll be sorry!?"
  },
  {
   "id": "MESSAGE021:07CC",
   "jp": "ケケッ、クケケケーッ!",
   "en": "Kekeh, kukekekeeh!"
  },
  {
   "id": "MESSAGE021:07D8",
   "jp": "グォォォォォォォッ!",
   "en": "Grooooooogh!"
  },
  {
   "id": "MESSAGE021:07E3",
   "jp": "グワォォォォォォォッ!",
   "en": "Grwaooooooogh!"
  },
  {
   "id": "MESSAGE021:07EF",
   "jp": "覚悟はできているな?",
   "en": "Are you ready\nfor this?"
  },
  {
   "id": "MESSAGE021:07FC",
   "jp": "覚悟はよろしくって?",
   "en": "Are you ready, dear?"
  },
  {
   "id": "MESSAGE021:0809",
   "jp": "覚悟はよろしいですか?\nフフフ…",
   "en": "Are you prepared?\nHeh heh heh..."
  },
  {
   "id": "MESSAGE021:081C",
   "jp": "こっちからいくぜ!",
   "en": "I'm comin' at ya!"
  },
  {
   "id": "MESSAGE021:0826",
   "jp": "覚悟しなさい!",
   "en": "Prepare yourself!"
  },
  {
   "id": "MESSAGE021:0830",
   "jp": "全力でいくぞ!",
   "en": "Full force!"
  },
  {
   "id": "MESSAGE021:083A",
   "jp": "かかってらっしゃい!",
   "en": "Come and get it!"
  },
  {
   "id": "MESSAGE021:0845",
   "jp": "くらいやがれーっ!",
   "en": "Eat thiiis!"
  },
  {
   "id": "MESSAGE021:084F",
   "jp": "あたしが相手だ!",
   "en": "I'm your opponent!"
  },
  {
   "id": "MESSAGE021:085A",
   "jp": "相手してやるよ!",
   "en": "I'll take you on!"
  },
  {
   "id": "MESSAGE021:0865",
   "jp": "スキありっ!",
   "en": "An opening!"
  },
  {
   "id": "MESSAGE021:086C",
   "jp": "受けてみよ!",
   "en": "Withstand this!"
  },
  {
   "id": "MESSAGE021:0874",
   "jp": "手加減しないわよ!",
   "en": "I won't hold back!"
  },
  {
   "id": "MESSAGE021:0881",
   "jp": "我が刃を受けよ!",
   "en": "Feel my blade!"
  },
  {
   "id": "MESSAGE021:088D",
   "jp": "クケケケーッ!",
   "en": "Kukekekeeh!"
  },
  {
   "id": "MESSAGE021:0895",
   "jp": "グオォォォーッ!",
   "en": "Groooogh!"
  },
  {
   "id": "MESSAGE021:089E",
   "jp": "受けてみろ!",
   "en": "Take this!"
  },
  {
   "id": "MESSAGE021:08A6",
   "jp": "受けてみなさい!",
   "en": "Take this, if you can!"
  }
 ]
