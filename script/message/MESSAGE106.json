{
 "file": "MESSAGE106.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE106:0450",
   "jp": "ここで引き下がるのは\n不本意なんだが…",
   "en": "I hate to back down\nhere, but..."
  },
  {
   "id": "MESSAGE106:0468",
   "jp": "仕方ねぇ…一旦退くゼ!",
   "en": "No choice... fallin'\nback for now!"
  },
  {
   "id": "MESSAGE106:0479",
   "jp": "俺には…できない……",
   "en": "I can't... do it..."
  },
  {
   "id": "MESSAGE106:0485",
   "jp": "私は…\nどうすればよかったの……?",
   "en": "What... should I\nhave done...?"
  },
  {
   "id": "MESSAGE106:0497",
   "jp": "…くっ!",
   "en": "...Ngh!"
  },
  {
   "id": "MESSAGE106:049C",
   "jp": "くっ…!",
   "en": "Ngh...!"
  },
  {
   "id": "MESSAGE106:04A1",
   "jp": "やっぱり…ダメ……",
   "en": "It's... no good..."
  },
  {
   "id": "MESSAGE106:04AB",
   "jp": "くっ…だめか",
   "en": "Ngh... No good."
  },
  {
   "id": "MESSAGE106:04B2",
   "jp": "おのれ…覚えていろ……!",
   "en": "Damn you... I won't\nforget this...!"
  },
  {
   "id": "MESSAGE106:04C0",
   "jp": "体勢を立て直さねばなるまい",
   "en": "We must regroup\nour ranks."
  },
  {
   "id": "MESSAGE106:04D2",
   "jp": "せんじゅつてきてったい!",
   "en": "Tac-ti-cal retreat!"
  },
  {
   "id": "MESSAGE106:04DF",
   "jp": "一旦退くぞ…",
   "en": "Fall back for now..."
  },
  {
   "id": "MESSAGE106:04E9",
   "jp": "わたくしにはもう…水の民を\n名乗る資格はありません……",
   "en": "I am unworthy now to\nbe called water folk..."
  },
  {
   "id": "MESSAGE106:050B",
   "jp": "俺、もう戦えねえよ…",
   "en": "I can't fight no\nmore..."
  },
  {
   "id": "MESSAGE106:0518",
   "jp": "さすがはワシの子分どもだ…",
   "en": "That's my boys, all\nright..."
  },
  {
   "id": "MESSAGE106:0528",
   "jp": "ワシは…\n間違っていたのかのう……",
   "en": "Was I... wrong all\nalong, eh...?"
  },
  {
   "id": "MESSAGE106:053C",
   "jp": "どうしてこんなことに\nなっちゃったんだろう…",
   "en": "How did it come to\nthis...?"
  },
  {
   "id": "MESSAGE106:0553",
   "jp": "やっぱり、\nウチには無理だったよ…",
   "en": "I knew it... It was\ntoo much for me..."
  },
  {
   "id": "MESSAGE106:0567",
   "jp": "少し休ませてくれ…",
   "en": "Let me rest a bit..."
  },
  {
   "id": "MESSAGE106:0573",
   "jp": "くそ、引き上げるぞ!",
   "en": "Damn, we're pullin'\nout!"
  },
  {
   "id": "MESSAGE106:0580",
   "jp": "私、もうダメです…",
   "en": "I... can't go on..."
  },
  {
   "id": "MESSAGE106:058A",
   "jp": "くっ、このままでは…",
   "en": "Tch, at this rate..."
  },
  {
   "id": "MESSAGE106:0595",
   "jp": "私には、できないわ…",
   "en": "I can't do it..."
  },
  {
   "id": "MESSAGE106:05A0",
   "jp": "くっ…やはりだめか",
   "en": "Ngh... It's hopeless\nafter all."
  },
  {
   "id": "MESSAGE106:05AA",
   "jp": "神のご意思だ。\nここは一旦後退する!",
   "en": "It is God's will.\nWe fall back for now!"
  },
  {
   "id": "MESSAGE106:05C3",
   "jp": "もう嫌じゃ!\n嫌ったら嫌なんじゃあぁぁ!",
   "en": "No more! No means\nnooo, I tell you!"
  },
  {
   "id": "MESSAGE106:05DB",
   "jp": "総帥の名が聞いて呆れるわ…\nあたしも堕ちたものね……",
   "en": "Some head of house I\nam... I've fallen low..."
  },
  {
   "id": "MESSAGE106:05FC",
   "jp": "私の策が通じない…?",
   "en": "My strategy failed...?"
  },
  {
   "id": "MESSAGE106:0609",
   "jp": "さすがのパメラ様も\nちょっと罪悪感~…",
   "en": "Even Pamela-sama\nfeels a bit guilty~..."
  },
  {
   "id": "MESSAGE106:0621",
   "jp": "ケッ…ケッ……",
   "en": "Keh... keh..."
  },
  {
   "id": "MESSAGE106:0629",
   "jp": "グォォォ~ン……",
   "en": "Gwooooon..."
  },
  {
   "id": "MESSAGE106:0632",
   "jp": "グワォォォ~ン……",
   "en": "Grwaoooon..."
  },
  {
   "id": "MESSAGE106:063C",
   "jp": "体勢を立て直すぞ…!",
   "en": "We regroup...!"
  },
  {
   "id": "MESSAGE106:064B",
   "jp": "いったん退きますわよ!",
   "en": "We'll fall back for\nnow, dear!"
  },
  {
   "id": "MESSAGE106:0658",
   "jp": "仕方ありませんね。\n一旦退くことにしましょう",
   "en": "It cannot be helped.\nLet us withdraw."
  }
 ]
}
