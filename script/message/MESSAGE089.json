{
 "file": "MESSAGE089.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE089:04B0",
   "jp": "志は曲げられないんでね",
   "en": ""
  },
  {
   "id": "MESSAGE089:04BE",
   "jp": "これ以上は進ませねぇゼ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:04CE",
   "jp": "ここは俺たちの土地だ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:04DD",
   "jp": "この地から出て行きなさい!\n侵略などさせないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:04FA",
   "jp": "この地は渡さない!",
   "en": ""
  },
  {
   "id": "MESSAGE089:0506",
   "jp": "この地は我らのものだ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:0514",
   "jp": "ここから出てってよ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:0520",
   "jp": "これ以上進ませはしない!",
   "en": ""
  },
  {
   "id": "MESSAGE089:0530",
   "jp": "図に乗るんじゃねえッ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:053E",
   "jp": "ここを死守せよ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:0549",
   "jp": "私の目の黒いうちは\n通す訳にはいかぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:0561",
   "jp": "ここ、通さないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:056C",
   "jp": "お前たちの居場所は無い!",
   "en": ""
  },
  {
   "id": "MESSAGE089:057E",
   "jp": "ここは渡しませんよ?",
   "en": ""
  },
  {
   "id": "MESSAGE089:058A",
   "jp": "甘いんだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:0592",
   "jp": "ここから出ていけってば!",
   "en": ""
  },
  {
   "id": "MESSAGE089:05A0",
   "jp": "入ってきたらブチ殺すぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:05B0",
   "jp": "テメェらには渡さん!",
   "en": ""
  },
  {
   "id": "MESSAGE089:05BC",
   "jp": "絶対出てってもらうんだから",
   "en": ""
  },
  {
   "id": "MESSAGE089:05CD",
   "jp": "アンタには渡さないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:05DA",
   "jp": "一刻も早く出て行くんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:05EB",
   "jp": "ラッキー!\nおれさま占領!",
   "en": ""
  },
  {
   "id": "MESSAGE089:05FB",
   "jp": "…守ってみせます!",
   "en": ""
  },
  {
   "id": "MESSAGE089:0606",
   "jp": "ただでは通さんぞ?",
   "en": ""
  },
  {
   "id": "MESSAGE089:0611",
   "jp": "諦めてお帰りなさい…",
   "en": ""
  },
  {
   "id": "MESSAGE089:061E",
   "jp": "一歩たりとも退けんのだ",
   "en": ""
  },
  {
   "id": "MESSAGE089:062D",
   "jp": "神はかく申された!\nこの地を平定せよ、と!",
   "en": ""
  },
  {
   "id": "MESSAGE089:0647",
   "jp": "わしではない。\n神のご命令なのじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:065C",
   "jp": "嫌でも出てってもらうわ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:066B",
   "jp": "策がなってないわね!",
   "en": ""
  },
  {
   "id": "MESSAGE089:0677",
   "jp": "ウヒヒ♪\nいっただきぃ~♪",
   "en": ""
  },
  {
   "id": "MESSAGE089:0685",
   "jp": "クケケ~ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:068C",
   "jp": "グォォォォゥン!!",
   "en": ""
  },
  {
   "id": "MESSAGE089:0696",
   "jp": "グワォォォォゥン!!",
   "en": ""
  },
  {
   "id": "MESSAGE089:06A1",
   "jp": "貴様らの居場所は無い!",
   "en": ""
  },
  {
   "id": "MESSAGE089:06B3",
   "jp": "一番乗りですわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE089:06C0",
   "jp": "もう、諦めたらどうです?",
   "en": ""
  },
  {
   "id": "MESSAGE089:06CE",
   "jp": "さっそと出て行け!",
   "en": ""
  },
  {
   "id": "MESSAGE089:06D9",
   "jp": "近寄らないで!",
   "en": ""
  }
 ]
}
