{
 "file": "MESSAGE180.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE180:0560",
   "jp": "君たちに渡すわけには\nいかないんでね…",
   "en": ""
  },
  {
   "id": "MESSAGE180:0576",
   "jp": "敵に使われてたまるかよ!",
   "en": "Like hell the enemy's\nusin' this!"
  },
  {
   "id": "MESSAGE180:0585",
   "jp": "お前たちに渡すわけには\nいかないんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:059B",
   "jp": "ここは私たちが\n使わせてもらいます!",
   "en": ""
  },
  {
   "id": "MESSAGE180:05AF",
   "jp": "これ以上の抵抗は無駄だ!\n大人しく降伏しろッ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:05D1",
   "jp": "これ以上の抵抗は無駄だ!\n大人しく降伏するんだッ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:05F5",
   "jp": "ここから出てってよ!",
   "en": "Just get out of here!"
  },
  {
   "id": "MESSAGE180:0601",
   "jp": "敵に使われる前に制圧だ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:0613",
   "jp": "こんなものが無くたって\n俺様は負けねぇんだよ!",
   "en": "The great me don't\nneed junk like this!"
  },
  {
   "id": "MESSAGE180:062F",
   "jp": "これ以上好き勝手はさせぬ",
   "en": "No more shall I let\nthee run wild."
  },
  {
   "id": "MESSAGE180:0641",
   "jp": "よし、間に合った!",
   "en": "Good, just in time!"
  },
  {
   "id": "MESSAGE180:064D",
   "jp": "ニーチェ、\nここ、もらっちゃうよ?",
   "en": ""
  },
  {
   "id": "MESSAGE180:065F",
   "jp": "敵に利用などさせぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:066D",
   "jp": "貴方がたに渡しはしません",
   "en": "I shall not hand it to\nyou."
  },
  {
   "id": "MESSAGE180:067D",
   "jp": "お前らには使わせねーよ!",
   "en": "You guys ain't usin'\nthis!"
  },
  {
   "id": "MESSAGE180:068C",
   "jp": "ここは俺たちが\n頂くでやんす!",
   "en": ""
  },
  {
   "id": "MESSAGE180:069E",
   "jp": "使わせはせんぞぉ!\n使わせはぁー!",
   "en": ""
  },
  {
   "id": "MESSAGE180:06B2",
   "jp": "おらおら!　近付くヤツは\n脳天カチ割ってやるぞぃ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:06D1",
   "jp": "あなたたちになんか\nここは渡さないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:06E6",
   "jp": "こんなの使われたら\n後が面倒だからね!",
   "en": ""
  },
  {
   "id": "MESSAGE180:06FE",
   "jp": "こんな物騒なものは\n使わせないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:0713",
   "jp": "敵に使われるよりはマシだ!",
   "en": "Beats lettin' the\nenemy use it!"
  },
  {
   "id": "MESSAGE180:0723",
   "jp": "確保…完了しました",
   "en": ""
  },
  {
   "id": "MESSAGE180:0731",
   "jp": "…これで使えまい",
   "en": "...Now it's useless."
  },
  {
   "id": "MESSAGE180:073B",
   "jp": "諦めてお帰りなさい…",
   "en": "Give up and go\nhome..."
  },
  {
   "id": "MESSAGE180:0748",
   "jp": "貴様らに使わせるわけには\nいかない!",
   "en": ""
  },
  {
   "id": "MESSAGE180:075E",
   "jp": "異端者に使わせる\n武器など無い!",
   "en": "No weapon shall\nheretics wield!"
  },
  {
   "id": "MESSAGE180:0776",
   "jp": "て、敵には使わせんぞ?",
   "en": ""
  },
  {
   "id": "MESSAGE180:0784",
   "jp": "さぁて…覚悟を決めて頂戴!",
   "en": ""
  },
  {
   "id": "MESSAGE180:0797",
   "jp": "これを使う権利があるのは\n私だけよ!",
   "en": "Only I have the right\nto use this!"
  },
  {
   "id": "MESSAGE180:07AD",
   "jp": "うほっ!\n制圧成功!",
   "en": ""
  },
  {
   "id": "MESSAGE180:07BC",
   "jp": "ケッケッケ!",
   "en": "Keh-keh-keh!"
  },
  {
   "id": "MESSAGE180:07C3",
   "jp": "これで相手の戦意も\n下がりますわよ~♪",
   "en": "This should dampen\ntheir spirits, dear~!"
  },
  {
   "id": "MESSAGE180:07DB",
   "jp": "敵の手に渡す必要は\nありませんから…",
   "en": "No need to let it fall\ninto enemy hands..."
  },
  {
   "id": "MESSAGE180:07F3",
   "jp": "これで形勢逆転だぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:0802",
   "jp": "いい気味ね!",
   "en": ""
  },
  {
   "id": "MESSAGE180:080B",
   "jp": "この勢いで進撃だ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:0818",
   "jp": "まだ抵抗する気?",
   "en": ""
  },
  {
   "id": "MESSAGE180:0824",
   "jp": "俺たちの力\n思い知ったか!?",
   "en": ""
  },
  {
   "id": "MESSAGE180:0837",
   "jp": "容赦なんか\nしないんだから!",
   "en": ""
  },
  {
   "id": "MESSAGE180:0848",
   "jp": "戦争のやり方を\n教えてやるよ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:085C",
   "jp": "思い知りなさい!",
   "en": ""
  },
  {
   "id": "MESSAGE180:0867",
   "jp": "貴様らに使わせぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE180:0874",
   "jp": "このままいけば\n勝てるんじゃない?",
   "en": ""
  },
  {
   "id": "MESSAGE180:0887",
   "jp": "ケッケッケ!",
   "en": "Keh-keh-keh!"
  },
  {
   "id": "MESSAGE180:088E",
   "jp": "こいつは\n使わせない!",
   "en": ""
  },
  {
   "id": "MESSAGE180:089B",
   "jp": "大したことないわね!",
   "en": ""
  }
 ]
}
