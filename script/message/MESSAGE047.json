{
 "file": "MESSAGE047.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE047:04F0",
   "jp": "さあ、次の相手は誰だ?",
   "en": ""
  },
  {
   "id": "MESSAGE047:0500",
   "jp": "オレ様に勝てると\n思ってんのか?",
   "en": ""
  },
  {
   "id": "MESSAGE047:0514",
   "jp": "正義は勝つんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:0520",
   "jp": "正義は聖剣の下にあり!",
   "en": ""
  },
  {
   "id": "MESSAGE047:0530",
   "jp": "無駄なあがきだ",
   "en": ""
  },
  {
   "id": "MESSAGE047:053A",
   "jp": "我らの邪魔をするとは…",
   "en": ""
  },
  {
   "id": "MESSAGE047:0549",
   "jp": "どきなさい!",
   "en": ""
  },
  {
   "id": "MESSAGE047:0550",
   "jp": "よし、勝利はすぐそこだ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:055F",
   "jp": "俺様を誰だと思っている!?",
   "en": ""
  },
  {
   "id": "MESSAGE047:0571",
   "jp": "撃破!",
   "en": ""
  },
  {
   "id": "MESSAGE047:0577",
   "jp": "勝負にならんな",
   "en": ""
  },
  {
   "id": "MESSAGE047:0581",
   "jp": "やっつけたよ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:0589",
   "jp": "思い知ったか?",
   "en": ""
  },
  {
   "id": "MESSAGE047:0593",
   "jp": "手加減は致しません",
   "en": ""
  },
  {
   "id": "MESSAGE047:05A1",
   "jp": "このくらい余裕だぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:05AE",
   "jp": "俺、強いっしょ?",
   "en": ""
  },
  {
   "id": "MESSAGE047:05B9",
   "jp": "たまには親玉らしいとこも\n見せておかねぇとな!",
   "en": ""
  },
  {
   "id": "MESSAGE047:05D4",
   "jp": "ザコには負けんわい!",
   "en": ""
  },
  {
   "id": "MESSAGE047:05E0",
   "jp": "ボクは将軍なんだからね!",
   "en": ""
  },
  {
   "id": "MESSAGE047:05EF",
   "jp": "ウチらをなめないでよね!",
   "en": ""
  },
  {
   "id": "MESSAGE047:05FC",
   "jp": "負けてられないよ",
   "en": ""
  },
  {
   "id": "MESSAGE047:0606",
   "jp": "よっしゃ、このまま進むぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:0615",
   "jp": "…任務完了です",
   "en": ""
  },
  {
   "id": "MESSAGE047:0621",
   "jp": "邪魔だ…",
   "en": ""
  },
  {
   "id": "MESSAGE047:0628",
   "jp": "邪魔者は消えなさい…",
   "en": ""
  },
  {
   "id": "MESSAGE047:0637",
   "jp": "お前たちなどに\nかまっている暇は無い",
   "en": ""
  },
  {
   "id": "MESSAGE047:064D",
   "jp": "邪魔だ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:0654",
   "jp": "ど、どけっ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:065B",
   "jp": "無謀な輩もいたものね?",
   "en": ""
  },
  {
   "id": "MESSAGE047:066A",
   "jp": "無茶にもほどがあるわね",
   "en": ""
  },
  {
   "id": "MESSAGE047:0678",
   "jp": "パメラ様に挑むなんて\n無茶もいいとこねっ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:0692",
   "jp": "ケケケーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:0699",
   "jp": "グォォーーーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:06A2",
   "jp": "グワォーーーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:06AB",
   "jp": "邪魔をするなっ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:06B6",
   "jp": "邪魔しないでくださいな",
   "en": ""
  },
  {
   "id": "MESSAGE047:06C4",
   "jp": "邪魔をしないで欲しいですね\nフフフ…",
   "en": ""
  },
  {
   "id": "MESSAGE047:06DA",
   "jp": "撃破したぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE047:06E3",
   "jp": "邪魔しないで!",
   "en": ""
  }
 ]
}
