{
 "file": "MESSAGE047.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE047:04F0",
   "jp": "さあ、次の相手は誰だ?",
   "en": "Now, who's next?"
  },
  {
   "id": "MESSAGE047:0500",
   "jp": "オレ様に勝てると\n思ってんのか?",
   "en": "Ya think ya can beat\nthe great me?"
  },
  {
   "id": "MESSAGE047:0514",
   "jp": "正義は勝つんだ!",
   "en": "Justice prevails!"
  },
  {
   "id": "MESSAGE047:0520",
   "jp": "正義は聖剣の下にあり!",
   "en": "Justice lies with\nthe Holy Sword!"
  },
  {
   "id": "MESSAGE047:0530",
   "jp": "無駄なあがきだ",
   "en": "A futile struggle."
  },
  {
   "id": "MESSAGE047:053A",
   "jp": "我らの邪魔をするとは…",
   "en": "You dare stand in\nour way..."
  },
  {
   "id": "MESSAGE047:0549",
   "jp": "どきなさい!",
   "en": "Step aside!"
  },
  {
   "id": "MESSAGE047:0550",
   "jp": "よし、勝利はすぐそこだ!",
   "en": "Good. Victory is\nnear!"
  },
  {
   "id": "MESSAGE047:055F",
   "jp": "俺様を誰だと思っている!?",
   "en": "Who d'ya think the\ngreat me is?!"
  },
  {
   "id": "MESSAGE047:0571",
   "jp": "撃破!",
   "en": "Vanquished!"
  },
  {
   "id": "MESSAGE047:0577",
   "jp": "勝負にならんな",
   "en": "That was no contest."
  },
  {
   "id": "MESSAGE047:0581",
   "jp": "やっつけたよ!",
   "en": "Nietzsche beat\nthem!"
  },
  {
   "id": "MESSAGE047:0589",
   "jp": "思い知ったか?",
   "en": "Have you learned\nyour lesson?"
  },
  {
   "id": "MESSAGE047:0593",
   "jp": "手加減は致しません",
   "en": "I shall not hold\nback."
  },
  {
   "id": "MESSAGE047:05A1",
   "jp": "このくらい余裕だぜ!",
   "en": "Heh, that was a\ncakewalk!"
  },
  {
   "id": "MESSAGE047:05AE",
   "jp": "俺、強いっしょ?",
   "en": "I'm pretty strong,\nright?"
  },
  {
   "id": "MESSAGE047:05B9",
   "jp": "たまには親玉らしいとこも\n見せておかねぇとな!",
   "en": "Gotta act like the\nboss once in a while!"
  },
  {
   "id": "MESSAGE047:05D4",
   "jp": "ザコには負けんわい!",
   "en": "No small fry's\nbeatin' me, heh!"
  },
  {
   "id": "MESSAGE047:05E0",
   "jp": "ボクは将軍なんだからね!",
   "en": "I'm a general, you\nknow!"
  },
  {
   "id": "MESSAGE047:05EF",
   "jp": "ウチらをなめないでよね!",
   "en": "Don't mess with us,\nokay?!"
  },
  {
   "id": "MESSAGE047:05FC",
   "jp": "負けてられないよ",
   "en": "I can't afford to\nlose."
  },
  {
   "id": "MESSAGE047:0606",
   "jp": "よっしゃ、このまま進むぜ!",
   "en": "Alright, let's keep\nmovin'!"
  },
  {
   "id": "MESSAGE047:0615",
   "jp": "…任務完了です",
   "en": "...Mission complete."
  },
  {
   "id": "MESSAGE047:0621",
   "jp": "邪魔だ…",
   "en": "You're in the way..."
  },
  {
   "id": "MESSAGE047:0628",
   "jp": "邪魔者は消えなさい…",
   "en": "Pests should\nvanish..."
  },
  {
   "id": "MESSAGE047:0637",
   "jp": "お前たちなどに\nかまっている暇は無い",
   "en": "I have no time\nfor the likes of you."
  },
  {
   "id": "MESSAGE047:064D",
   "jp": "邪魔だ!",
   "en": "Out of my way!"
  },
  {
   "id": "MESSAGE047:0654",
   "jp": "ど、どけっ!",
   "en": "M-move aside!"
  },
  {
   "id": "MESSAGE047:065B",
   "jp": "無謀な輩もいたものね?",
   "en": "What a reckless lot,\nhm?"
  },
  {
   "id": "MESSAGE047:066A",
   "jp": "無茶にもほどがあるわね",
   "en": "That was way too\nreckless, you know."
  },
  {
   "id": "MESSAGE047:0678",
   "jp": "パメラ様に挑むなんて\n無茶もいいとこねっ!",
   "en": "Fight Pamela-sama?\nTalk about reckless!"
  },
  {
   "id": "MESSAGE047:0692",
   "jp": "ケケケーッ!",
   "en": "Kekekeeh!"
  },
  {
   "id": "MESSAGE047:0699",
   "jp": "グォォーーーッ!",
   "en": "Grooooooh!"
  },
  {
   "id": "MESSAGE047:06A2",
   "jp": "グワォーーーッ!",
   "en": "Grwaooooh!"
  },
  {
   "id": "MESSAGE047:06AB",
   "jp": "邪魔をするなっ!",
   "en": "Stay out of my way!"
  },
  {
   "id": "MESSAGE047:06B6",
   "jp": "邪魔しないでくださいな",
   "en": "Please don't get in\nthe way, dear."
  },
  {
   "id": "MESSAGE047:06C4",
   "jp": "邪魔をしないで欲しいですね\nフフフ…",
   "en": "I'd rather you not\ninterfere. Heh heh..."
  },
  {
   "id": "MESSAGE047:06DA",
   "jp": "撃破したぞ!",
   "en": "Enemy defeated!"
  },
  {
   "id": "MESSAGE047:06E3",
   "jp": "邪魔しないで!",
   "en": "Don't get in my way!"
  }
 ]
}
