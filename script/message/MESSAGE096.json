{
 "file": "MESSAGE096.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE096:04B0",
   "jp": "退いた方が身のためだ",
   "en": ""
  },
  {
   "id": "MESSAGE096:04BE",
   "jp": "敵に使われてたまるかよ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:04CD",
   "jp": "使わせるわけにはいかない!",
   "en": ""
  },
  {
   "id": "MESSAGE096:04DC",
   "jp": "貴方たちに渡すものですか",
   "en": ""
  },
  {
   "id": "MESSAGE096:04EC",
   "jp": "貴様に使わせてなるものか!",
   "en": ""
  },
  {
   "id": "MESSAGE096:04FD",
   "jp": "貴様には使わせん!",
   "en": ""
  },
  {
   "id": "MESSAGE096:050A",
   "jp": "よし!　壊したわ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:0515",
   "jp": "敵に使われる前に処分だ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:0527",
   "jp": "こんなものが無くたって\n俺様は負けねぇんだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:0543",
   "jp": "これ以上好き勝手はさせぬ",
   "en": ""
  },
  {
   "id": "MESSAGE096:0555",
   "jp": "よし、間に合った!",
   "en": ""
  },
  {
   "id": "MESSAGE096:0561",
   "jp": "こんなの、使われたら\n困っちゃうもんね!",
   "en": ""
  },
  {
   "id": "MESSAGE096:0578",
   "jp": "敵に利用される前に\n破壊するんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:0590",
   "jp": "貴方がたに渡しはしません",
   "en": ""
  },
  {
   "id": "MESSAGE096:05A0",
   "jp": "お前らには使わせねーよ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:05AF",
   "jp": "ぶっ壊せーっ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:05B8",
   "jp": "このっ、使わせはせんぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:05C7",
   "jp": "リサイクルできないくらい\nブチ壊してやったぞい",
   "en": ""
  },
  {
   "id": "MESSAGE096:05E0",
   "jp": "今のうちに壊しちゃうよ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:05EF",
   "jp": "こんなの残してたら\n後が面倒だからね!",
   "en": ""
  },
  {
   "id": "MESSAGE096:0607",
   "jp": "こんな物騒なものは\n壊しちまえ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:061B",
   "jp": "敵に使われるよりはマシだ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:062B",
   "jp": "砲台の破壊…完了しました",
   "en": ""
  },
  {
   "id": "MESSAGE096:063E",
   "jp": "…これで使えまい",
   "en": ""
  },
  {
   "id": "MESSAGE096:0648",
   "jp": "貴方たちには使わせないわ…",
   "en": ""
  },
  {
   "id": "MESSAGE096:0659",
   "jp": "渡してなるものか!",
   "en": ""
  },
  {
   "id": "MESSAGE096:0664",
   "jp": "異端者に使わせる\n武器など無い!",
   "en": ""
  },
  {
   "id": "MESSAGE096:067C",
   "jp": "こうすれば敵も使えまい…",
   "en": ""
  },
  {
   "id": "MESSAGE096:068B",
   "jp": "アンクじゃないなら\n用は無いわね!",
   "en": ""
  },
  {
   "id": "MESSAGE096:069F",
   "jp": "これを使う権利があるのは\n私だけよ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:06B5",
   "jp": "使われる前に壊すわよ~♪",
   "en": ""
  },
  {
   "id": "MESSAGE096:06C5",
   "jp": "ケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:06CC",
   "jp": "グォッグォッグォッ!!",
   "en": ""
  },
  {
   "id": "MESSAGE096:06D8",
   "jp": "グワォッグワォッグワォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:06E6",
   "jp": "敵の戦意を削ぐのだ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:06F5",
   "jp": "これで相手の戦意も\n下がりますわよ~♪",
   "en": ""
  },
  {
   "id": "MESSAGE096:070D",
   "jp": "敵の手に渡す必要は\nありませんから…",
   "en": ""
  },
  {
   "id": "MESSAGE096:0725",
   "jp": "破壊するんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE096:072F",
   "jp": "連中に渡すくらいなら…!",
   "en": ""
  }
 ]
}
