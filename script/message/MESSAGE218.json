{
 "file": "MESSAGE218.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE218:0240",
   "jp": "これでまた一歩…\n平和に近付いたのですね",
   "en": ""
  },
  {
   "id": "MESSAGE218:025B",
   "jp": "これで神の望まれた世界に\nまた一歩近付いたようだ",
   "en": ""
  },
  {
   "id": "MESSAGE218:027B",
   "jp": "どこまで行けば求める答えは\n得られるのかしら…?",
   "en": ""
  },
  {
   "id": "MESSAGE218:0297",
   "jp": "正直ここまで来れるとは\n思わなかったけどな!",
   "en": ""
  },
  {
   "id": "MESSAGE218:02B2",
   "jp": "ワシらの邪魔をする奴は\nぶっ飛ばしてやるぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE218:02CE",
   "jp": "上玉のいる国を\n占領したぞい!",
   "en": ""
  },
  {
   "id": "MESSAGE218:02E3",
   "jp": "見苦しい者たちなど\nこの世界には不用だ…",
   "en": ""
  },
  {
   "id": "MESSAGE218:02FF",
   "jp": "こ、これでまた\n収入が増えるのじゃな?",
   "en": ""
  },
  {
   "id": "MESSAGE218:0316",
   "jp": "まったく…\n魔力の無駄遣︀いだわ",
   "en": ""
  },
  {
   "id": "MESSAGE218:032B",
   "jp": "成金の国なんて\nさいならー!　だわさ",
   "en": ""
  },
  {
   "id": "MESSAGE218:0341",
   "jp": "俺に刃向かうとは…\n愚かな連中だ!",
   "en": ""
  },
  {
   "id": "MESSAGE218:0359",
   "jp": "フフフ…これで私の望みに\n一歩近づけたようですね…",
   "en": ""
  }
 ]
}
