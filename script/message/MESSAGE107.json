 "strings": [
  {
   "id": "MESSAGE107:0480",
   "jp": "…俺、帰っていい?",
   "en": ""
  },
  {
   "id": "MESSAGE107:048C",
   "jp": "絶対上手くいかねぇと\n思ってたんだよな…",
   "en": ""
  },
  {
   "id": "MESSAGE107:04A6",
   "jp": "このままでは…",
   "en": ""
  },
  {
   "id": "MESSAGE107:04AE",
   "jp": "勝機は無さそうね…",
   "en": ""
  },
  {
   "id": "MESSAGE107:04BB",
   "jp": "付き合ってられんな…",
   "en": ""
  },
  {
   "id": "MESSAGE107:04C8",
   "jp": "フン…付き合ってられんな",
   "en": ""
  },
  {
   "id": "MESSAGE107:04D7",
   "jp": "退かせてもらうわ…",
   "en": ""
  },
  {
   "id": "MESSAGE107:04E2",
   "jp": "体勢を立て直します",
   "en": ""
  },
  {
   "id": "MESSAGE107:04F0",
   "jp": "チッ、やってらんねえぜ…",
   "en": ""
  },
  {
   "id": "MESSAGE107:04FD",
   "jp": "…無用の殺生は好まぬ",
   "en": ""
  },
  {
   "id": "MESSAGE107:050D",
   "jp": "このような戦いに意味など…",
   "en": ""
  },
  {
   "id": "MESSAGE107:051E",
   "jp": "もうやだよ…",
   "en": "I don't wanna do this\nanymore..."
  },
  {
   "id": "MESSAGE107:0525",
   "jp": "このままでは危険だ…",
   "en": ""
  },
  {
   "id": "MESSAGE107:0532",
   "jp": "無謀な戦いですね…",
   "en": ""
  },
  {
   "id": "MESSAGE107:053F",
   "jp": "悪いな…\n抜けさせてもらうぜ",
   "en": ""
  },
  {
   "id": "MESSAGE107:0550",
   "jp": "やってらんねえ…",
   "en": ""
  },
  {
   "id": "MESSAGE107:0559",
   "jp": "ちっ…ケツまくって\n逃げるとするか!",
   "en": ""
  },
  {
   "id": "MESSAGE107:056D",
   "jp": "腰が痛いのう…",
   "en": ""
  },
  {
   "id": "MESSAGE107:0577",
   "jp": "ちょっと休むね…",
   "en": ""
  },
  {
   "id": "MESSAGE107:0581",
   "jp": "いち抜けた!",
   "en": ""
  },
  {
   "id": "MESSAGE107:0589",
   "jp": "だめだこりゃ…",
   "en": ""
  },
  {
   "id": "MESSAGE107:0591",
   "jp": "こりゃやべーぞ。\n命の方が大切だ",
   "en": ""
  },
  {
   "id": "MESSAGE107:05A6",
   "jp": "…すみません",
   "en": ""
  },
  {
   "id": "MESSAGE107:05AD",
   "jp": "分が悪いな…",
   "en": ""
  },
  {
   "id": "MESSAGE107:05B6",
   "jp": "やっていられないわね…",
   "en": ""
  },
  {
   "id": "MESSAGE107:05C2",
   "jp": "フン、付き合ってられんな…",
   "en": ""
  },
  {
   "id": "MESSAGE107:05D2",
   "jp": "こんな所で命を落とせるか!",
   "en": ""
  },
  {
   "id": "MESSAGE107:05E3",
   "jp": "ヒィィ!\nわしはもう駄目じゃあ!",
   "en": ""
  },
  {
   "id": "MESSAGE107:05F6",
   "jp": "足が痛くてやってらんない…",
   "en": ""
  },
  {
   "id": "MESSAGE107:0606",
   "jp": "ちょっと無謀すぎね…\n一旦退かせてもらうわ",
   "en": ""
  },
  {
   "id": "MESSAGE107:0621",
   "jp": "えーん、も~やだ~!",
   "en": ""
  },
  {
   "id": "MESSAGE107:062C",
   "jp": "ケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE107:0631",
   "jp": "…グォ",
   "en": ""
  },
  {
   "id": "MESSAGE107:0635",
   "jp": "…グワォ",
   "en": ""
  },
  {
   "id": "MESSAGE107:063A",
   "jp": "巻き返しを図るぞ。\n一時後退!",
   "en": ""
  },
  {
   "id": "MESSAGE107:0651",
   "jp": "退いた方が良さそうですわ",
   "en": ""
  },
  {
   "id": "MESSAGE107:0661",
   "jp": "このままでは何もかも\n失ってしまいますから…",
   "en": ""
  }
 ]
