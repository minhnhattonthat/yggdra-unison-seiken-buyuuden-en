{
 "file": "MESSAGE012.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE012:0480",
   "jp": "さあ、勝負といこうか!",
   "en": ""
  },
  {
   "id": "MESSAGE012:048E",
   "jp": "覚悟はできてるんだろうな?",
   "en": ""
  },
  {
   "id": "MESSAGE012:049E",
   "jp": "受けて立ってやる!",
   "en": ""
  },
  {
   "id": "MESSAGE012:04AA",
   "jp": "正義は聖剣と共にあります!",
   "en": ""
  },
  {
   "id": "MESSAGE012:04BD",
   "jp": "ならばかかってくるがいい!",
   "en": ""
  },
  {
   "id": "MESSAGE012:04CB",
   "jp": "フン、かかってくるがいい!",
   "en": ""
  },
  {
   "id": "MESSAGE012:04D9",
   "jp": "この地が欲しいなら\nあたしたちを倒すことね!",
   "en": ""
  },
  {
   "id": "MESSAGE012:04F3",
   "jp": "ここを渡す訳には\n参りません!",
   "en": ""
  },
  {
   "id": "MESSAGE012:0506",
   "jp": "ククッ…楽しませてくれよ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:0515",
   "jp": "ここを渡す訳には参らぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:0525",
   "jp": "我らも引き下がれぬ。\n受けて立とう!",
   "en": ""
  },
  {
   "id": "MESSAGE012:053C",
   "jp": "ジャマしないで!",
   "en": ""
  },
  {
   "id": "MESSAGE012:0545",
   "jp": "ここは我らの領土。\n侵す者は容赦しないッ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:0562",
   "jp": "どうしてもというのであれば\nお受け致しましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE012:057D",
   "jp": "かかってきやがれ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:0587",
   "jp": "コテンパンにしてやるぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:0594",
   "jp": "どれ、ひと暴れするぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:05A2",
   "jp": "さーて、仕事といくかのう!",
   "en": ""
  },
  {
   "id": "MESSAGE012:05B2",
   "jp": "追い返してやるんだから!",
   "en": ""
  },
  {
   "id": "MESSAGE012:05C1",
   "jp": "相手になってあげるよ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:05CF",
   "jp": "売られたケンカは\n買うしか無いな!",
   "en": ""
  },
  {
   "id": "MESSAGE012:05E4",
   "jp": "やんのか?　相手になるぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:05F4",
   "jp": "…勝負です!",
   "en": ""
  },
  {
   "id": "MESSAGE012:05FD",
   "jp": "さあ、勝負といこうか!",
   "en": ""
  },
  {
   "id": "MESSAGE012:060B",
   "jp": "フフ…覚悟はできていて?",
   "en": ""
  },
  {
   "id": "MESSAGE012:061A",
   "jp": "この私を倒せるとでも?\n返り討ちにしてくれる!",
   "en": ""
  },
  {
   "id": "MESSAGE012:0635",
   "jp": "我々に手を出すと\n神罰が下るぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:064B",
   "jp": "年寄りに手を上げるとは…\n神罰が下るぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE012:0666",
   "jp": "いいわよ、\nかかってらっしゃい!",
   "en": ""
  },
  {
   "id": "MESSAGE012:0677",
   "jp": "ふふっ、かかって来なさい!",
   "en": ""
  },
  {
   "id": "MESSAGE012:0686",
   "jp": "むっきーっ!\n討つべし!　討つべし!",
   "en": ""
  },
  {
   "id": "MESSAGE012:069B",
   "jp": "ケーケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:06A2",
   "jp": "グォォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:06A9",
   "jp": "グワォォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:06B1",
   "jp": "ちょうど相手が欲しかった\nところだ!",
   "en": ""
  },
  {
   "id": "MESSAGE012:06C7",
   "jp": "ケンカなら他所で\nやってくださらない?",
   "en": ""
  },
  {
   "id": "MESSAGE012:06DD",
   "jp": "良いでしょう。少しだけ…\n相手をしてあげましょう",
   "en": ""
  }
 ]
}
