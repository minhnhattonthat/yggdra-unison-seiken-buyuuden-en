{
 "file": "MESSAGE018.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE018:04C0",
   "jp": "焔帝、いざ勝負だ!",
   "en": "Flame Emperor,\nface me!"
  },
  {
   "id": "MESSAGE018:04CE",
   "jp": "よう、また会ったな!",
   "en": "Hey, we meet again!"
  },
  {
   "id": "MESSAGE018:04DA",
   "jp": "…モニカ!　勝負だ!",
   "en": "...Monica! Face me!"
  },
  {
   "id": "MESSAGE018:04E7",
   "jp": "ガルカーサ…\n…絶対に許さない!",
   "en": "Gulcasa...\nI'll never forgive you!"
  },
  {
   "id": "MESSAGE018:04FB",
   "jp": "ユグドラ!　お前を倒す!",
   "en": "Yggdra! I will\ndefeat you!"
  },
  {
   "id": "MESSAGE018:050A",
   "jp": "さあ、私を倒してみろ!",
   "en": "Come, try and\ndefeat me!"
  },
  {
   "id": "MESSAGE018:0517",
   "jp": "カナン、真剣勝負よ!",
   "en": "Canaan, this is\nfor real!"
  },
  {
   "id": "MESSAGE018:0526",
   "jp": "姫様、お覚悟…!",
   "en": "Princess, prepare\nyourself...!"
  },
  {
   "id": "MESSAGE018:0533",
   "jp": "その首頂くぜぇ!",
   "en": "Your head is mine!"
  },
  {
   "id": "MESSAGE018:053E",
   "jp": "参りますぞ、焔帝殿!",
   "en": "Have at thee,\nFlame Emperor!"
  },
  {
   "id": "MESSAGE018:054D",
   "jp": "勝負!",
   "en": "Have at you!"
  },
  {
   "id": "MESSAGE018:0553",
   "jp": "…ニーチェ、いきます!",
   "en": "...Nietzsche's\ncoming!"
  },
  {
   "id": "MESSAGE018:055F",
   "jp": "エメローネ様…\nお覚悟を!",
   "en": "Emelone-sama...\nprepare yourself!"
  },
  {
   "id": "MESSAGE018:0570",
   "jp": "いざ、勝負です!",
   "en": "Now, I challenge you!"
  },
  {
   "id": "MESSAGE018:057B",
   "jp": "今のオレたちは敵同士だ!",
   "en": "Right now, we're\nenemies!"
  },
  {
   "id": "MESSAGE018:058C",
   "jp": "親分、すまねえ!",
   "en": "Sorry, Boss!"
  },
  {
   "id": "MESSAGE018:0597",
   "jp": "抵抗するなよ、嬢ちゃん!",
   "en": "Don't fight it, missy!"
  },
  {
   "id": "MESSAGE018:05A7",
   "jp": "こ、これも試練なのかのう?",
   "en": "I-is this a trial\ntoo, eh?"
  },
  {
   "id": "MESSAGE018:05B7",
   "jp": "お兄様…勝負よ!",
   "en": "Big Brother...\nface me!"
  },
  {
   "id": "MESSAGE018:05C4",
   "jp": "どっちが強いか勝負だよ!",
   "en": "Let's see who's\nstronger!"
  },
  {
   "id": "MESSAGE018:05D4",
   "jp": "相手が誰でも\n手加減はしない!",
   "en": "Whoever it is,\nI won't hold back!"
  },
  {
   "id": "MESSAGE018:05EA",
   "jp": "一緒に来てもらうぜ、王女!",
   "en": "You're comin' with\nme, Princess!"
  },
  {
   "id": "MESSAGE018:05FD",
   "jp": "兄さん…勝負です!",
   "en": "Brother... I\nchallenge you!"
  },
  {
   "id": "MESSAGE018:060A",
   "jp": "エレナ、勝負だ!",
   "en": "Elena, face me!"
  },
  {
   "id": "MESSAGE018:0615",
   "jp": "噂は聞いているわよ…!",
   "en": "I've heard all about\nyou...!"
  },
  {
   "id": "MESSAGE018:0623",
   "jp": "貴様に構っている暇は無い!",
   "en": "I have no time to\nwaste on you!"
  },
  {
   "id": "MESSAGE018:0636",
   "jp": "貴様は用済みだ!",
   "en": "You have outlived\nyour usefulness!"
  },
  {
   "id": "MESSAGE018:0643",
   "jp": "わ、わしゃあ悪くない!",
   "en": "I-It's not my fault,\nI tell you!"
  },
  {
   "id": "MESSAGE018:0650",
   "jp": "どきなさいよバカ総帥!",
   "en": "Out of my way, you\nidiot commander!"
  },
  {
   "id": "MESSAGE018:065E",
   "jp": "焔帝と勝負できるなんてね!",
   "en": "A duel with the\nFlame Emperor? Fun!"
  },
  {
   "id": "MESSAGE018:0670",
   "jp": "ウンディーネ\nいっただきぃ~♪",
   "en": "An Undine!\nYoink~!"
  },
  {
   "id": "MESSAGE018:0680",
   "jp": "ケーッケッケッケ!?",
   "en": "Keeh-kekekeh!?"
  },
  {
   "id": "MESSAGE018:068B",
   "jp": "グォォォォォッ!",
   "en": "Grooooogh!"
  },
  {
   "id": "MESSAGE018:0694",
   "jp": "グワォォォォォォォーッ!",
   "en": "Grwaoooooooogh!"
  },
  {
   "id": "MESSAGE018:06A1",
   "jp": "妹とて容赦はしない!",
   "en": "Sister or not,\nI show no mercy!"
  },
  {
   "id": "MESSAGE018:06AF",
   "jp": "お爺様の代のお返しを\n今、しますわね~!",
   "en": "Here's payback from\nGrandfather's day~!"
  },
  {
   "id": "MESSAGE018:06C9",
   "jp": "力の差というものを…\n見せてあげましょう……",
   "en": "Let me show you...\nthe gap between us..."
  }
 ]
}
