{
 "file": "MESSAGE133.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE133:0480",
   "jp": "志を高く持つ者は\n強いということか…",
   "en": ""
  },
  {
   "id": "MESSAGE133:0498",
   "jp": "何の悪夢だ?　こりゃ…",
   "en": ""
  },
  {
   "id": "MESSAGE133:04A7",
   "jp": "皇帝…陛下……",
   "en": ""
  },
  {
   "id": "MESSAGE133:04B2",
   "jp": "どのような処遇にも\n甘んじましょう…",
   "en": ""
  },
  {
   "id": "MESSAGE133:04C8",
   "jp": "ユグドラ…\nふざけた真似を……ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE133:04DC",
   "jp": "ユグドラ…\nなめた真似を……ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE133:04EF",
   "jp": "覚悟、してます…",
   "en": ""
  },
  {
   "id": "MESSAGE133:04FA",
   "jp": "貴殿に従う気などない!",
   "en": ""
  },
  {
   "id": "MESSAGE133:050A",
   "jp": "エレナ…貴様\nふざけんじゃねえぞ…ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE133:0520",
   "jp": "お斬りなされ",
   "en": ""
  },
  {
   "id": "MESSAGE133:0528",
   "jp": "命など悩しくない\nさっさと斬れ!",
   "en": ""
  },
  {
   "id": "MESSAGE133:053C",
   "jp": "ごめんね…",
   "en": ""
  },
  {
   "id": "MESSAGE133:0542",
   "jp": "世も末だな…",
   "en": ""
  },
  {
   "id": "MESSAGE133:054B",
   "jp": "わたくしは敗れたのです。\nもはや言うことはありません",
   "en": ""
  },
  {
   "id": "MESSAGE133:0568",
   "jp": "ったく、大したもんだぜ…",
   "en": ""
  },
  {
   "id": "MESSAGE133:0576",
   "jp": "…姐さん……",
   "en": ""
  },
  {
   "id": "MESSAGE133:057E",
   "jp": "おめぇに捕まるたぁ\nワシも堕ちたもんだな",
   "en": ""
  },
  {
   "id": "MESSAGE133:0595",
   "jp": "目上の者に手を上げるのか?",
   "en": ""
  },
  {
   "id": "MESSAGE133:05A8",
   "jp": "何よ…ボクに何の用!?",
   "en": ""
  },
  {
   "id": "MESSAGE133:05B7",
   "jp": "好きにすればいいでしょ!",
   "en": ""
  },
  {
   "id": "MESSAGE133:05C5",
   "jp": "好きにすりゃいいさ",
   "en": ""
  },
  {
   "id": "MESSAGE133:05D0",
   "jp": "何でオイラがこんなガキに…",
   "en": ""
  },
  {
   "id": "MESSAGE133:05DF",
   "jp": "手を…下してください…",
   "en": ""
  },
  {
   "id": "MESSAGE133:05EC",
   "jp": "…どんな罰でもお受けします",
   "en": ""
  },
  {
   "id": "MESSAGE133:05FC",
   "jp": "ユベロン様…",
   "en": ""
  },
  {
   "id": "MESSAGE133:0604",
   "jp": "馬鹿げたことを…!",
   "en": ""
  },
  {
   "id": "MESSAGE133:0610",
   "jp": "神を畏れぬ愚か者め!\n放せ!",
   "en": ""
  },
  {
   "id": "MESSAGE133:0623",
   "jp": "わしとお前の仲じゃろう?\nい、命ばかりは…",
   "en": ""
  },
  {
   "id": "MESSAGE133:063C",
   "jp": "ありえないにも程があるわ…",
   "en": ""
  },
  {
   "id": "MESSAGE133:064B",
   "jp": "ついてないわぁ…",
   "en": ""
  },
  {
   "id": "MESSAGE133:0654",
   "jp": "あ~ん、ごめんなさ~い!",
   "en": ""
  },
  {
   "id": "MESSAGE133:0661",
   "jp": "クケ…!",
   "en": ""
  },
  {
   "id": "MESSAGE133:0666",
   "jp": "グォ…!?",
   "en": ""
  },
  {
   "id": "MESSAGE133:066C",
   "jp": "グワォ…!!",
   "en": ""
  },
  {
   "id": "MESSAGE133:0673",
   "jp": "貴様に捕らえられるとはな…",
   "en": ""
  },
  {
   "id": "MESSAGE133:0684",
   "jp": "あなたになら捕らえられても\n仕方ありませんわね",
   "en": ""
  },
  {
   "id": "MESSAGE133:069F",
   "jp": "こうして貴方に\nお会いできるとは…",
   "en": ""
  }
 ]
}
