  {
   "id": "MESSAGE126:0240",
   "jp": "みんな、無事みたいね",
   "en": "Everyone seems to\nbe safe."
  },
  {
   "id": "MESSAGE126:024D",
   "jp": "うむ、退けたか",
   "en": "Mm, we repelled\nthem."
  },
  {
   "id": "MESSAGE126:0256",
   "jp": "守るべき\n愛しい者たちのために",
   "en": "For the beloved ones\nI must protect."
  },
  {
   "id": "MESSAGE126:0269",
   "jp": "よーし、上出来だ!",
   "en": "Alright, nice work!"
  },
  {
   "id": "MESSAGE126:0276",
   "jp": "これが男の本気ってもんよ!",
   "en": "That's a real man\ngoin' all out!"
  },
  {
