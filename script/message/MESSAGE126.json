  },
  {
   "id": "MESSAGE126:02C6",
   "jp": "あはっ、\nさすがはパメラ様ね♪",
   "en": "Aha!\nThat's Pamela-sama!"
  },
  {
   "id": "MESSAGE126:02D7",
   "jp": "フン、他愛も無い!",
   "en": "Hmph. Child's play!"
  },
  {
   "id": "MESSAGE126:02E4",
   "jp": "拍子抜けでしたね。\nフフフ…",
