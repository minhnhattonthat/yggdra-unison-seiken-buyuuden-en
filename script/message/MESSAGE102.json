{
 "file": "MESSAGE102.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE102:04B0",
   "jp": "退いた方が身のためだ",
   "en": "You'd best fall back."
  },
  {
   "id": "MESSAGE102:04BE",
   "jp": "ここは通さねぇゼ!",
   "en": "Ya ain't passin'\nhere!"
  },
  {
   "id": "MESSAGE102:04C9",
   "jp": "ここは通さないぞ!",
   "en": "You won't get past!"
  },
  {
   "id": "MESSAGE102:04D4",
   "jp": "防御陣形を!",
   "en": "Defensive formation!"
  },
  {
   "id": "MESSAGE102:04DF",
   "jp": "通しはしない!",
   "en": "You shall not pass!"
  },
  {
   "id": "MESSAGE102:04E8",
   "jp": "ここは通さん!",
   "en": "None shall pass!"
  },
  {
   "id": "MESSAGE102:04F1",
   "jp": "絶対に通さない!",
   "en": "You'll never get by!"
  },
  {
   "id": "MESSAGE102:04FD",
   "jp": "我らが守りも強固なものと\nなろう!",
   "en": "Our defenses shall\nbe stronger for it!"
  },
  {
   "id": "MESSAGE102:0513",
   "jp": "こんなものでも\n無いよりゃマシだぜ!",
   "en": "Junk like this beats\nnothin', I guess!"
  },
  {
   "id": "MESSAGE102:0527",
   "jp": "鉄癖の守りを築くのだ!",
   "en": "Raise a wall of iron!"
  },
  {
   "id": "MESSAGE102:0537",
   "jp": "侵略など許さぬ!",
   "en": "I will not allow\ninvasion!"
  },
  {
   "id": "MESSAGE102:0543",
   "jp": "しっかり守るよ!",
   "en": "We'll guard it real\ngood!"
  },
  {
   "id": "MESSAGE102:054D",
   "jp": "防ぎきるんだ!",
   "en": "Hold them off!"
  },
  {
   "id": "MESSAGE102:0556",
   "jp": "防御陣形を!",
   "en": "Defensive formation!"
  },
  {
   "id": "MESSAGE102:0561",
   "jp": "陣地に入るぜ!",
   "en": "Movin' into position!"
  },
  {
   "id": "MESSAGE102:056C",
   "jp": "親分の命令だぜ!",
   "en": "Boss's orders!"
  },
  {
   "id": "MESSAGE102:0579",
   "jp": "たまにゃ守りも悪くねぇな!",
   "en": "Playin' defense ain't\nbad once in a while!"
  },
  {
   "id": "MESSAGE102:0589",
   "jp": "ここは通るべからず、じゃ!",
   "en": "No trespassin' here,\nsonny!"
  },
  {
   "id": "MESSAGE102:0598",
   "jp": "ここは通れないよーだ!",
   "en": "You can't get past,\nnyah!"
  },
  {
   "id": "MESSAGE102:05A5",
   "jp": "守りきってみせるよ!",
   "en": "I'll hold it, just\nwatch!"
  },
  {
   "id": "MESSAGE102:05B1",
   "jp": "残念でした!",
   "en": "Too bad for you!"
  },
  {
   "id": "MESSAGE102:05BA",
   "jp": "こりゃラッキーだぜ!",
   "en": "Now that's lucky!"
  },
  {
   "id": "MESSAGE102:05C5",
   "jp": "…行かせません",
   "en": "...You shall not pass."
  },
  {
   "id": "MESSAGE102:05CD",
   "jp": "防御の構えだ!",
   "en": "Defensive stance!"
  },
  {
   "id": "MESSAGE102:05D8",
   "jp": "こんな物、必要ないわ",
   "en": "I don't need such a\nthing."
  },
  {
   "id": "MESSAGE102:05E6",
   "jp": "フン、なめられたものだな!",
   "en": "Hmph. They take me\nlightly!"
  },
  {
   "id": "MESSAGE102:05F4",
   "jp": "神のお言葉だ!\nここを死守せよ!",
   "en": "God's word! Hold this\nplace to the end!"
  },
  {
   "id": "MESSAGE102:0609",
   "jp": "か、帰ってくれ!",
   "en": "G-go home, please!"
  },
  {
   "id": "MESSAGE102:0613",
   "jp": "ここで防ぐわよ!",
   "en": "We stop them here,\ndarling!"
  },
  {
   "id": "MESSAGE102:061D",
   "jp": "今は守備を固めるのが先ね!",
   "en": "Defense comes first\nfor now, hm?"
  },
  {
   "id": "MESSAGE102:0630",
   "jp": "野を越え山越え柵越えて~♪",
   "en": "Over hill, over dale,\nover fence we go~!"
  },
  {
   "id": "MESSAGE102:0644",
   "jp": "ケッケッケ!",
   "en": "Keh-keh-keh!"
  },
  {
   "id": "MESSAGE102:064B",
   "jp": "グォッグォッグォッ!",
   "en": "Gwoh! Gwoh! Gwoh!"
  },
  {
   "id": "MESSAGE102:0656",
   "jp": "グワォッグワォッ!",
   "en": "Grwaow! Grwaow!"
  },
  {
   "id": "MESSAGE102:0660",
   "jp": "これ以上は進ません!",
   "en": "You go no further!"
  },
  {
   "id": "MESSAGE102:066E",
   "jp": "さあ、もうひと頑張りですわ",
   "en": "Now, just a little\nmore effort, dear."
  },
  {
   "id": "MESSAGE102:067E",
   "jp": "ここに陣を敷きましょう",
   "en": "Let us make camp\nhere."
  },
  {
   "id": "MESSAGE102:068C",
   "jp": "先に制圧だ!",
   "en": "Take it first!"
  },
  {
   "id": "MESSAGE102:0696",
   "jp": "これ以上は進ませない!",
   "en": "You'll go no further!"
  }
 ]
}
