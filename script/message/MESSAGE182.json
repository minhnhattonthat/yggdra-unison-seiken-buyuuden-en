{
 "file": "MESSAGE182.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE182:0560",
   "jp": "退いた方が身のためだ",
   "en": ""
  },
  {
   "id": "MESSAGE182:056E",
   "jp": "これで脅威は減ったな!",
   "en": ""
  },
  {
   "id": "MESSAGE182:057D",
   "jp": "これで…\n少しは役に立てたのかな…?",
   "en": ""
  },
  {
   "id": "MESSAGE182:0593",
   "jp": "ここを使って一気に\n勝負を決めましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE182:05AE",
   "jp": "ここを渡しはしない!",
   "en": ""
  },
  {
   "id": "MESSAGE182:05BA",
   "jp": "ここは渡さぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:05C3",
   "jp": "これ以上あんたたちの\n好きにはさせないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:05DC",
   "jp": "ここは我らが頂く!",
   "en": ""
  },
  {
   "id": "MESSAGE182:05E8",
   "jp": "こんなもの、\n貴様らに使わせるかよ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:05FE",
   "jp": "敵の戦意を挫くのだ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:060D",
   "jp": "ここは使わせぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:0617",
   "jp": "ここ、渡さないよ?",
   "en": ""
  },
  {
   "id": "MESSAGE182:0622",
   "jp": "どうやら間に合ったようだな",
   "en": ""
  },
  {
   "id": "MESSAGE182:0632",
   "jp": "敵に利用させるわけには\nまいりません",
   "en": ""
  },
  {
   "id": "MESSAGE182:0648",
   "jp": "こいつは、オレたちが\nもらうぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:0659",
   "jp": "こいつは、俺たちが\nもらうでやんすよ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:066E",
   "jp": "制圧だぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:0677",
   "jp": "これで連中も少しは\nやる気が失せたじゃろう",
   "en": ""
  },
  {
   "id": "MESSAGE182:0692",
   "jp": "ここはボクたちのものだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:06A0",
   "jp": "使われる前に奪っちゃえ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:06B0",
   "jp": "やった、制圧したぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:06BD",
   "jp": "相手に使われたら\nやっかいだからな!",
   "en": ""
  },
  {
   "id": "MESSAGE182:06D3",
   "jp": "敵には、使わせない…",
   "en": ""
  },
  {
   "id": "MESSAGE182:06E0",
   "jp": "これで脅威は減った…!",
   "en": ""
  },
  {
   "id": "MESSAGE182:06EF",
   "jp": "痛い目に遣う前に\nお帰りなさい…",
   "en": ""
  },
  {
   "id": "MESSAGE182:0705",
   "jp": "これで戦いを有利に\n運べるな…",
   "en": ""
  },
  {
   "id": "MESSAGE182:0719",
   "jp": "おお、これぞ神の軍勢に\n相応しい武器だ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:0734",
   "jp": "ハァハァ…\nま、間に合ったようじゃな!",
   "en": ""
  },
  {
   "id": "MESSAGE182:074A",
   "jp": "撃たれるとウザいものね!\nだから、頂くわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE182:0763",
   "jp": "うふふ…\n私タイムの始まりよ?",
   "en": ""
  },
  {
   "id": "MESSAGE182:0774",
   "jp": "パメラ様、一番乗りィィィ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:0786",
   "jp": "ケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:078D",
   "jp": "貴方たちには\n使わせませんわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE182:07A1",
   "jp": "フフフ…どうです?\n戦意も失せたでしょう?",
   "en": ""
  },
  {
   "id": "MESSAGE182:07BA",
   "jp": "これでひと安心だな!",
   "en": ""
  },
  {
   "id": "MESSAGE182:07C7",
   "jp": "制圧したわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:07D1",
   "jp": "勝利は目前だぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:07DE",
   "jp": "これで反撃に\n出られるわね!",
   "en": ""
  },
  {
   "id": "MESSAGE182:07F0",
   "jp": "こんなもんに撃たれたら\nたまんねぇもんな!",
   "en": ""
  },
  {
   "id": "MESSAGE182:0807",
   "jp": "これ以上の抵抗は\n無意味よ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:081D",
   "jp": "この調子で\nガンガン行こうぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:082F",
   "jp": "抵抗する気も失せたでしょ?",
   "en": ""
  },
  {
   "id": "MESSAGE182:0841",
   "jp": "我らの勝利は目前だ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:0851",
   "jp": "こんなもの…\n使わせるわけにはいかないわ",
   "en": ""
  },
  {
   "id": "MESSAGE182:0867",
   "jp": "ケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:086E",
   "jp": "よし、制圧したぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE182:087A",
   "jp": "やった…制圧したわよ!",
   "en": ""
  }
 ]
}
