  {
   "id": "MESSAGE056:04C0",
   "jp": "あんたには…\n本当に世話になったよな?",
   "en": ""
  },
  {
   "id": "MESSAGE056:04D8",
   "jp": "けっ、身の程知らずが!",
   "en": ""
  },
  {
   "id": "MESSAGE056:04E7",
   "jp": "モニカ…\n中々の腕前だったよ",
   "en": ""
  },
  {
   "id": "MESSAGE056:04FA",
   "jp": "罰をお受けなさい!",
   "en": ""
  },
  {
   "id": "MESSAGE056:0506",
   "jp": "貴様は私が倒す!",
   "en": ""
  },
  {
   "id": "MESSAGE056:0512",
   "jp": "貴様になど負けはしない!",
   "en": ""
  },
  {
   "id": "MESSAGE056:0522",
   "jp": "あたしに負けてるようじゃ\nダメよ?",
   "en": ""
  },
  {
   "id": "MESSAGE056:0535",
   "jp": "敵将を…捕らえました",
   "en": ""
  },
  {
   "id": "MESSAGE056:0543",
   "jp": "ハッ…この程度か、焔帝殿?",
   "en": ""
  },
  {
   "id": "MESSAGE056:0556",
   "jp": "敵将を捕らえましたぞ",
   "en": ""
  },
  {
   "id": "MESSAGE056:0564",
   "jp": "勝負はあった。諦めよ",
   "en": ""
  },
  {
   "id": "MESSAGE056:0572",
   "jp": "女王様に勝った…",
   "en": ""
  },
  {
   "id": "MESSAGE056:057F",
   "jp": "エメローネ様!\n降伏してください!",
   "en": ""
  },
  {
   "id": "MESSAGE056:0594",
   "jp": "運命とは\nときに非情なもの…",
   "en": ""
  },
  {
   "id": "MESSAGE056:05A7",
   "jp": "まだまだ甘いな!\nオレが鍛えなおしてやるぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE056:05C0",
   "jp": "お…親分に勝った!?",
   "en": ""
  },
  {
   "id": "MESSAGE056:05CE",
   "jp": "静かにすりゃあ\n手荒にはせんぞ?",
   "en": ""
  },
  {
   "id": "MESSAGE056:05E2",
   "jp": "こいつぁ驚きだ!\n神様を倒したぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE056:05F8",
   "jp": "お兄様に勝ったの…?",
   "en": ""
  },
  {
   "id": "MESSAGE056:0606",
   "jp": "ウチ、強くなったでしょ?",
   "en": ""
  },
  {
   "id": "MESSAGE056:0614",
   "jp": "僕にも意地があるからね",
   "en": ""
  },
  {
   "id": "MESSAGE056:0623",
   "jp": "一攫千金は\n男のロマンだよな!",
   "en": ""
  },
  {
   "id": "MESSAGE056:0638",
   "jp": "兄さん…!",
   "en": ""
  },
  {
   "id": "MESSAGE056:063F",
   "jp": "まだまだ未熟だな…",
   "en": ""
  },
  {
   "id": "MESSAGE056:064B",
   "jp": "貧乏人はお呼びじゃないのよ",
   "en": ""
  },
  {
   "id": "MESSAGE056:065D",
   "jp": "己の非力さを思い知るがいい",
   "en": ""
  },
  {
   "id": "MESSAGE056:0670",
   "jp": "後のことは任せてもらおう",
   "en": ""
  },
  {
   "id": "MESSAGE056:067F",
   "jp": "わ…わしと神に\n逆らうからじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE056:0691",
   "jp": "あたしにひざまずくといいわ",
   "en": ""
  },
  {
   "id": "MESSAGE056:069F",
   "jp": "あら、こんなものなの?",
   "en": ""
  },
  {
   "id": "MESSAGE056:06AB",
