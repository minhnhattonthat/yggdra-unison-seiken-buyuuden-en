{
 "file": "MESSAGE151.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE151:0480",
   "jp": "力不足だったか…\n残念だが、失礼するよ",
   "en": ""
  },
  {
   "id": "MESSAGE151:049B",
   "jp": "そうか、残念だゼ…",
   "en": ""
  },
  {
   "id": "MESSAGE151:04A7",
   "jp": "残念ですが…失礼します",
   "en": ""
  },
  {
   "id": "MESSAGE151:04B7",
   "jp": "私…力不足だったのですね?",
   "en": ""
  },
  {
   "id": "MESSAGE151:04C8",
   "jp": "世話になったな…",
   "en": ""
  },
  {
   "id": "MESSAGE151:04D3",
   "jp": "そうか…仕方あるまい",
   "en": ""
  },
  {
   "id": "MESSAGE151:04E0",
   "jp": "一緒に行けなくて残念だわ…",
   "en": ""
  },
  {
   "id": "MESSAGE151:04F2",
   "jp": "お役に立てず…\n申し訳ありません",
   "en": ""
  },
  {
   "id": "MESSAGE151:0507",
   "jp": "なかなか楽しかったぜ。\nあばよ",
   "en": ""
  },
  {
   "id": "MESSAGE151:0518",
   "jp": "拙者の力が及ばなかったので\nありましょう",
   "en": ""
  },
  {
   "id": "MESSAGE151:0531",
   "jp": "これも神の定めた道…\n受け入れましょう",
   "en": ""
  },
  {
   "id": "MESSAGE151:0549",
   "jp": "ニーチェ何も悪いこと\nしてないのに…",
   "en": ""
  },
  {
   "id": "MESSAGE151:055E",
   "jp": "…仕方ない。私はここを\n去るとしよう。さらばだ",
   "en": ""
  },
  {
   "id": "MESSAGE151:0579",
   "jp": "…ご武運をお祈りします",
   "en": ""
  },
  {
   "id": "MESSAGE151:0588",
   "jp": "なかなか楽しかったぜ。\nまたな",
   "en": ""
  },
  {
   "id": "MESSAGE151:0599",
   "jp": "そうですか…わかりやした",
   "en": ""
  },
  {
   "id": "MESSAGE151:05A6",
   "jp": "ああ?　ワシじゃあ\n役に立たねぇってのか?",
   "en": ""
  },
  {
   "id": "MESSAGE151:05BE",
   "jp": "そうか…お主は\n心の狭い人間じゃのう",
   "en": ""
  },
  {
   "id": "MESSAGE151:05D6",
   "jp": "ボクじゃダメだったんだね…",
   "en": ""
  },
  {
   "id": "MESSAGE151:05E4",
   "jp": "ウチとのことは\n遊びだったって言うの?",
   "en": ""
  },
  {
   "id": "MESSAGE151:05FA",
   "jp": "革命は未だ成らずだぜ…",
   "en": ""
  },
  {
   "id": "MESSAGE151:060A",
   "jp": "マジかよ…オイラって\nそんなに役立たずかよ?",
   "en": ""
  },
  {
   "id": "MESSAGE151:0623",
   "jp": "今まで…\nお世話になりました……",
   "en": ""
  },
  {
   "id": "MESSAGE151:0637",
   "jp": "不要…ということか",
   "en": ""
  },
  {
   "id": "MESSAGE151:0643",
   "jp": "…そう。\nそれなら、仕方ないわ…",
   "en": ""
  },
  {
   "id": "MESSAGE151:0656",
   "jp": "私の役目は終わったか…",
   "en": ""
  },
  {
   "id": "MESSAGE151:0665",
   "jp": "何と信仰薄き者たちだ…\n後悔しても知らんぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE151:0685",
   "jp": "わ、わしを追い出すのか?\nこ、後悔するぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE151:06A0",
   "jp": "あら、そう…\n残念だけど、お別れね",
   "en": ""
  },
  {
   "id": "MESSAGE151:06B5",
   "jp": "私みたいな策士をみすみす\n逃がすなんてね!",
   "en": ""
  },
  {
   "id": "MESSAGE151:06CE",
   "jp": "ショック!\nパメラ様クビぃ!?",
   "en": ""
  },
  {
   "id": "MESSAGE151:06DF",
   "jp": "クケーッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE151:06E6",
   "jp": "グォーッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE151:06ED",
   "jp": "グワォーッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE151:06F5",
   "jp": "ククク…俺が怖くなったか?",
   "en": ""
  },
  {
   "id": "MESSAGE151:0705",
   "jp": "あたくしの何が\nいけなかったのかしら~?",
   "en": ""
  },
  {
   "id": "MESSAGE151:071B",
   "jp": "おやおや…\n私はもう、用済みですか?",
   "en": ""
  }
 ]
}
