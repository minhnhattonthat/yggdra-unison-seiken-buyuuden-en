{
 "file": "MESSAGE134.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE134:03E0",
   "jp": "罰して頂いて構いません…",
   "en": "You may punish me..."
  },
  {
   "id": "MESSAGE134:03F0",
   "jp": "貴方のお好きになさい",
   "en": "Do as you wish."
  },
  {
   "id": "MESSAGE134:03FE",
   "jp": "私の負けよ…",
   "en": "I lose..."
  },
  {
   "id": "MESSAGE134:0406",
   "jp": "姉さんの勝ちよ…",
   "en": "You win, Sister..."
  },
  {
   "id": "MESSAGE134:0411",
   "jp": "くっ…",
   "en": "Ngh..."
  },
  {
   "id": "MESSAGE134:0415",
   "jp": "敵の情けは受けん…",
   "en": "I accept no mercy\nfrom the enemy..."
  },
  {
   "id": "MESSAGE134:0422",
   "jp": "貴様…何のつもりだ!?",
   "en": "You... What's your\ngame!?"
  },
  {
   "id": "MESSAGE134:0431",
   "jp": "武人の情けじゃ\n早うお斬りなされ",
   "en": "Show a warrior's\nmercy: strike quickly."
  },
  {
   "id": "MESSAGE134:0447",
   "jp": "聖騎士は敵の情けなど\n受けぬ!",
   "en": "A Temple Knight\nwants no foe's mercy!"
  },
  {
   "id": "MESSAGE134:045D",
   "jp": "放して~っ!",
   "en": "Let me gooo!"
  },
  {
   "id": "MESSAGE134:0465",
   "jp": "お姫様に捕まっちまう\nなんてな…",
   "en": "Me, caught by the\nPrincess? Man..."
  },
  {
   "id": "MESSAGE134:0479",
   "jp": "何ちゅうこっちゃ…",
   "en": "What the hell..."
  },
  {
   "id": "MESSAGE134:0484",
   "jp": "金ピカ野郎が\nワシに何の用じゃ…",
   "en": "What's a gold-plated\npunk want with me..."
  },
  {
   "id": "MESSAGE134:049A",
   "jp": "女王様気取っちゃって\n何のつもりなの?",
   "en": "Playing queen, huh?\nWhat's your game?"
  },
  {
   "id": "MESSAGE134:04B4",
   "jp": "アルには手を出さないで!",
   "en": "Don't you touch Al!"
  },
  {
   "id": "MESSAGE134:04C3",
   "jp": "こんな奴に捕まるとはな…",
   "en": "Caught by the likes\nof this..."
  },
  {
   "id": "MESSAGE134:04D2",
   "jp": "覚悟は…できています……",
   "en": "I am... prepared......"
  },
  {
   "id": "MESSAGE134:04E1",
   "jp": "命は悩しくないわ…",
   "en": "My life means\nnothing to me..."
  },
  {
   "id": "MESSAGE134:04ED",
   "jp": "貴様は虫が好かん…!",
   "en": "I cannot stand you...!"
  },
  {
   "id": "MESSAGE134:04FC",
   "jp": "ふざけおって…\n何の真似だ!?",
   "en": "Impudence...\nWhat is this!?"
  },
  {
   "id": "MESSAGE134:050F",
   "jp": "わしが悪かった。\nは、反省しておるから…",
   "en": "It was my fault.\nI-I'm sorry, really..."
  },
  {
   "id": "MESSAGE134:0527",
   "jp": "一体何のつもり…!?",
   "en": "What's the meaning\nof this...!?"
  },
  {
   "id": "MESSAGE134:0535",
   "jp": "貴方…なかなかやるのね",
   "en": "You're... rather good,\naren't you?"
  },
  {
   "id": "MESSAGE134:0543",
   "jp": "ゆ、許してくらさい…",
   "en": "P-pwease\nforgive me..."
  },
  {
   "id": "MESSAGE134:054F",
   "jp": "クケ…",
   "en": "Kuke..."
  },
  {
   "id": "MESSAGE134:0553",
   "jp": "グォ…!!!",
   "en": "Grah...!!!"
  },
  {
   "id": "MESSAGE134:055A",
   "jp": "グワォ…",
   "en": "Grwao..."
  },
  {
   "id": "MESSAGE134:055F",
   "jp": "好きにして構わんぞ?",
   "en": "Do as you like."
  },
  {
   "id": "MESSAGE134:056C",
   "jp": "どうぞお好きなように\nなさってくださいな",
   "en": "Please, do as you\nlike, dear."
  },
  {
   "id": "MESSAGE134:0582",
   "jp": "さあ、どうするのですか?\n私を討ちますか?",
   "en": "Well, what will you\ndo? Strike me down?"
  }
 ]
}
