  {
   "id": "MESSAGE006:04B0",
   "jp": "何も見つけられなかった。\nすまない…",
   "en": ""
  },
  {
   "id": "MESSAGE006:04C5",
   "jp": "お宝は無かったゼ。\nすまねぇな…",
   "en": ""
  },
  {
   "id": "MESSAGE006:04D8",
   "jp": "残念ながら、\n何も見つかりませんでした…",
   "en": ""
  },
  {
   "id": "MESSAGE006:04F1",
   "jp": "何も発見できなかったわね…",
   "en": ""
  },
  {
   "id": "MESSAGE006:0502",
   "jp": "何も発見することは\nできませんでした",
   "en": ""
  },
  {
   "id": "MESSAGE006:0518",
   "jp": "何も見つけることは\nできませんでした",
   "en": ""
  },
  {
   "id": "MESSAGE006:052D",
   "jp": "ごめんなさいね。\n何も無かったわ",
   "en": ""
  },
  {
   "id": "MESSAGE006:0540",
   "jp": "何も見つかりませんでした…\nお許しください",
   "en": ""
  },
  {
   "id": "MESSAGE006:0559",
   "jp": "何もなかったぜ…\nチッ、しけてやがる",
   "en": ""
  },
  {
   "id": "MESSAGE006:056D",
   "jp": "…お詫び申す",
   "en": ""
  },
  {
   "id": "MESSAGE006:0576",
   "jp": "宝は無いようですね…",
   "en": ""
  },
  {
   "id": "MESSAGE006:0583",
   "jp": "ごめんね、何もなかったの",
   "en": ""
  },
  {
   "id": "MESSAGE006:0591",
   "jp": "申し訳ありません。\n何も見つけられませんでした",
   "en": ""
  },
  {
   "id": "MESSAGE006:05AD",
   "jp": "何も見つかりませんね…",
   "en": ""
  },
  {
   "id": "MESSAGE006:05BB",
   "jp": "あーあ、しけてんなぁ…",
   "en": ""
  },
  {
   "id": "MESSAGE006:05C7",
   "jp": "チカラ、及ばずであります!",
   "en": ""
  },
  {
   "id": "MESSAGE006:05D6",
   "jp": "宝のひとつもねぇなんてなぁ",
   "en": ""
  },
  {
   "id": "MESSAGE006:05E5",
   "jp": "何も無いとはのう…",
   "en": ""
  },
  {
   "id": "MESSAGE006:05F1",
   "jp": "ごめんね。\n次は絶対見つけてくるから!",
   "en": ""
  },
  {
   "id": "MESSAGE006:0609",
   "jp": "宝物はなかったよ。\nう~ん、ザンネン…",
   "en": ""
  },
  {
   "id": "MESSAGE006:061F",
   "jp": "大将、宝は無かったよ",
   "en": ""
  },
  {
   "id": "MESSAGE006:062E",
   "jp": "すまねえ。次に期待してくれ",
   "en": ""
  },
  {
   "id": "MESSAGE006:063F",
   "jp": "お役に立てませんでした…",
   "en": ""
  },
  {
   "id": "MESSAGE006:064E",
   "jp": "私が見つけられないとは…",
   "en": ""
  },
  {
   "id": "MESSAGE006:065C",
   "jp": "微力を尽くしましたが…",
   "en": ""
  },
  {
   "id": "MESSAGE006:066B",
   "jp": "価値のありそうなものは\n見当たらなかったな…",
   "en": ""
  },
  {
   "id": "MESSAGE006:0686",
   "jp": "神はこう言われた。\n心の中にこそ宝はある、と",
   "en": ""
  },
  {
   "id": "MESSAGE006:06A1",
   "jp": "う~む…無い所には\n無いもんじゃのう……",
   "en": ""
  },
  {
   "id": "MESSAGE006:06B9",
   "jp": "価値のありそうなものは\n無かったわ",
   "en": ""
  },
  {
   "id": "MESSAGE006:06CE",
   "jp": "駄目ね。見つからなかったわ",
   "en": ""
  },
  {
   "id": "MESSAGE006:06DF",
   "jp": "残念!　流石のパメラ様も\n何も見つけられなかったよ…",
   "en": ""
  },
  {
   "id": "MESSAGE006:0701",
   "jp": "ケケッケケケ…",
   "en": ""
  },
  {
   "id": "MESSAGE006:0709",
   "jp": "グォォ~ン…!",
   "en": ""
  },
  {
   "id": "MESSAGE006:0711",
   "jp": "グワォォ~ン…!",
   "en": ""
  },
  {
   "id": "MESSAGE006:071A",
   "jp": "何も見出せなかったようだ…",
   "en": ""
  },
  {
   "id": "MESSAGE006:072B",
   "jp": "ごめんなさいね~\n何も出ませんでしたわ",
   "en": ""
  },
  {
   "id": "MESSAGE006:0741",
   "jp": "徒労に終わったようですね…",
   "en": ""
  },
  {
   "id": "MESSAGE006:0752",
   "jp": "残念だけど、宝は無かったよ",
   "en": ""
  },
  {
   "id": "MESSAGE006:0764",
   "jp": "残念だけど、諦めてね",
   "en": ""
  }
 ]
