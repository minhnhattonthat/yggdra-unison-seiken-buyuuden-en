 "strings": [
  {
   "id": "MESSAGE129:0450",
   "jp": "因果応報ってやつさ。\nさあ、前に出てくれ",
   "en": ""
  },
  {
   "id": "MESSAGE129:046B",
   "jp": "捕虜を連れて来たゼ",
   "en": ""
  },
  {
   "id": "MESSAGE129:0479",
   "jp": "捕虜…です",
   "en": ""
  },
  {
   "id": "MESSAGE129:0481",
   "jp": "悪いようにはしません…\n前に出てください",
   "en": ""
  },
  {
   "id": "MESSAGE129:0499",
   "jp": "悪いようにはしない。\n抵抗は控えられよ",
   "en": ""
  },
  {
   "id": "MESSAGE129:04B1",
   "jp": "無駄だ。\n抵抗は控えられよ",
   "en": ""
  },
  {
   "id": "MESSAGE129:04C4",
   "jp": "連れて来たわよ…",
   "en": ""
  },
  {
   "id": "MESSAGE129:04CF",
   "jp": "手荒なことはしない。\n前に出てください",
   "en": ""
  },
  {
   "id": "MESSAGE129:04E7",
   "jp": "おらおら、前に出なっ!",
   "en": ""
  },
  {
   "id": "MESSAGE129:04F5",
   "jp": "敵将を連れて参った",
   "en": ""
  },
  {
   "id": "MESSAGE129:0503",
   "jp": "強そうな人、連れてきたよ",
   "en": ""
  },
  {
   "id": "MESSAGE129:0513",
   "jp": "敵将を捕らえたが…",
   "en": ""
  },
  {
   "id": "MESSAGE129:0520",
   "jp": "これもさだめです…\n受け入れなさい",
   "en": ""
  },
  {
   "id": "MESSAGE129:0534",
   "jp": "て…敵将を捕まえました!",
   "en": ""
  },
  {
   "id": "MESSAGE129:0544",
   "jp": "悪いようにはせん。\n前へ出ろい!",
   "en": ""
  },
  {
   "id": "MESSAGE129:0558",
   "jp": "これも守り神様の試練じゃ。\n諦めるんじゃのう",
   "en": ""
  },
  {
   "id": "MESSAGE129:0574",
   "jp": "…捕虜を連れてきたわ",
   "en": ""
  },
  {
   "id": "MESSAGE129:0582",
   "jp": "捕虜を連れてきたけど…",
   "en": ""
  },
  {
   "id": "MESSAGE129:0591",
   "jp": "悪いようにはしないよ",
   "en": ""
  },
  {
   "id": "MESSAGE129:059D",
   "jp": "ま、観念しろってこった!",
   "en": ""
  },
  {
   "id": "MESSAGE129:05AC",
   "jp": "捕虜を…連れて参りました…",
   "en": ""
  },
  {
   "id": "MESSAGE129:05BE",
   "jp": "おとなしくなさい",
   "en": ""
  },
  {
   "id": "MESSAGE129:05C7",
   "jp": "手荒なことはしないわ\n安心してちょうだい",
   "en": ""
  },
  {
   "id": "MESSAGE129:05E0",
   "jp": "前に出るんだ…!",
   "en": ""
  },
  {
   "id": "MESSAGE129:05EB",
   "jp": "愚か者め、悔い改めよ!",
   "en": ""
  },
  {
   "id": "MESSAGE129:05FB",
   "jp": "ほ、捕虜を連れてきたぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE129:060B",
   "jp": "悪いけど…前に出て頂戴",
   "en": ""
  },
  {
   "id": "MESSAGE129:061C",
   "jp": "ま、諦めなさいね",
   "en": ""
  },
  {
   "id": "MESSAGE129:0626",
   "jp": "大将、捕虜でーっす!",
   "en": ""
  },
  {
   "id": "MESSAGE129:0635",
   "jp": "クケケッ?",
   "en": ""
  },
  {
   "id": "MESSAGE129:063B",
   "jp": "グォォッ?",
   "en": ""
  },
  {
   "id": "MESSAGE129:0641",
   "jp": "グォォッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE129:0648",
   "jp": "覚悟を決めることだな…",
   "en": ""
  },
  {
   "id": "MESSAGE129:0657",
   "jp": "悪いようにはしませんわ~",
   "en": ""
  },
  {
   "id": "MESSAGE129:0665",
   "jp": "さて…如何なる処遇を\nすべきでしょうかねぇ……",
   "en": ""
