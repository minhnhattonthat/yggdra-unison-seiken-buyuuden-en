{
 "file": "MESSAGE063.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE063:04C0",
   "jp": "因果応報ってやつさ",
   "en": ""
  },
  {
   "id": "MESSAGE063:04CE",
   "jp": "おっと、少しやりすぎたか?",
   "en": ""
  },
  {
   "id": "MESSAGE063:04DD",
   "jp": "そ、そんな…\nモニカーッ!!",
   "en": ""
  },
  {
   "id": "MESSAGE063:04EC",
   "jp": "正義は聖剣の下にあり!",
   "en": ""
  },
  {
   "id": "MESSAGE063:04FC",
   "jp": "我らの痛みを知れ!",
   "en": ""
  },
  {
   "id": "MESSAGE063:0509",
   "jp": "我らの痛みを受けるがいい!",
   "en": ""
  },
  {
   "id": "MESSAGE063:051A",
   "jp": "カナン…うそでしょ……!?",
   "en": ""
  },
  {
   "id": "MESSAGE063:0528",
   "jp": "敵将…討ち取りました……",
   "en": ""
  },
  {
   "id": "MESSAGE063:0539",
   "jp": "力こそ全て…\n貴様の言葉だったよなぁ?",
   "en": ""
  },
  {
   "id": "MESSAGE063:0553",
   "jp": "敵将…討ち取り申した",
   "en": ""
  },
  {
   "id": "MESSAGE063:0563",
   "jp": "これもさだめというものだ",
   "en": ""
  },
  {
   "id": "MESSAGE063:0570",
   "jp": "女王様、ごめんなさい…",
   "en": ""
  },
  {
   "id": "MESSAGE063:057F",
   "jp": "エメローネ様…\nイシーヌを許してください",
   "en": ""
  },
  {
   "id": "MESSAGE063:0596",
   "jp": "これが…運命だと\nいうのですか?",
   "en": ""
  },
  {
   "id": "MESSAGE063:05A9",
   "jp": "…ばかやろう……ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE063:05B4",
   "jp": "そんな…ウソだろ、親分……",
   "en": ""
  },
  {
   "id": "MESSAGE063:05C4",
   "jp": "さすがにやりすぎたか?",
   "en": ""
  },
  {
   "id": "MESSAGE063:05D0",
   "jp": "何てこった!\n神様を殺しちまったぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE063:05E7",
   "jp": "え…\nお兄様、どうして……?",
   "en": ""
  },
  {
   "id": "MESSAGE063:05F8",
   "jp": "ちょっと、マジなの!?",
   "en": ""
  },
  {
   "id": "MESSAGE063:0604",
   "jp": "悪く思わないでくれな…",
   "en": ""
  },
  {
   "id": "MESSAGE063:0612",
   "jp": "恐ろしい女だったぜ",
   "en": ""
  },
  {
   "id": "MESSAGE063:061E",
   "jp": "兄さん…!!",
   "en": ""
  },
  {
   "id": "MESSAGE063:0626",
   "jp": "さらばだ、エレナ…",
   "en": ""
  },
  {
   "id": "MESSAGE063:0630",
   "jp": "永遠に…さようなら",
   "en": ""
  },
  {
   "id": "MESSAGE063:063C",
   "jp": "貴様は私には勝てん",
   "en": ""
  },
  {
   "id": "MESSAGE063:0649",
   "jp": "安心してあの世へ行くが良い",
   "en": ""
  },
  {
   "id": "MESSAGE063:065B",
   "jp": "お、愚か者め!",
   "en": ""
  },
  {
   "id": "MESSAGE063:0665",
   "jp": "負けを認めなさい",
   "en": ""
  },
  {
   "id": "MESSAGE063:0670",
   "jp": "もっと強いのかと\n思ってたんだけど…ね",
   "en": ""
  },
  {
   "id": "MESSAGE063:0686",
   "jp": "あう~、パメラ様の\nウンディーネが~!",
   "en": ""
  },
  {
   "id": "MESSAGE063:069B",
   "jp": "クケッ、ケーッケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE063:06A9",
   "jp": "グォォォォ!　グオァァァ!",
   "en": ""
  },
  {
   "id": "MESSAGE063:06B7",
   "jp": "グワォォォ!　グワァァァ!",
   "en": ""
  },
  {
   "id": "MESSAGE063:06C5",
   "jp": "死んで名を残すがいい…",
   "en": ""
  },
  {
   "id": "MESSAGE063:06D4",
   "jp": "軍神の名前…\nきっと忘れませんわ…",
   "en": ""
  },
  {
   "id": "MESSAGE063:06EA",
   "jp": "慚悔の念を抱いて…\n消えるが良いでしょう",
   "en": ""
  }
 ]
}
