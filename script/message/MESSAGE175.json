 "strings": [
  {
   "id": "MESSAGE175:0560",
   "jp": "これさえ押さえれば\n後は何とかなるだろう!",
   "en": ""
  },
  {
   "id": "MESSAGE175:0579",
   "jp": "こいつを占領しときゃ\n後は楽勝ってもんだゼ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:0595",
   "jp": "ここさえ押さえれば…\n後は何とかなる!",
   "en": ""
  },
  {
   "id": "MESSAGE175:05AC",
   "jp": "占領しました!",
   "en": ""
  },
  {
   "id": "MESSAGE175:05B6",
   "jp": "先に占領する!",
   "en": ""
  },
  {
   "id": "MESSAGE175:05C1",
   "jp": "先に占領だ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:05CB",
   "jp": "これで少しは有利になるわ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:05DC",
   "jp": "ここを占領すれば…\n勝ったようなものです!",
   "en": ""
  },
  {
   "id": "MESSAGE175:05F5",
   "jp": "目障りだ、どきやがれ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:0603",
   "jp": "これで敵の士気を\n下げることが出来よう",
   "en": ""
  },
  {
   "id": "MESSAGE175:061C",
   "jp": "ありがたい!\n頼りになる戦力だな!",
   "en": ""
  },
  {
   "id": "MESSAGE175:0631",
   "jp": "ここ、もらったー♪",
   "en": ""
  },
  {
   "id": "MESSAGE175:063B",
   "jp": "これを使えば…",
   "en": ""
  },
  {
   "id": "MESSAGE175:0644",
   "jp": "敵に奪われる前に…\n確保しましょう",
   "en": ""
  },
  {
   "id": "MESSAGE175:065B",
   "jp": "お先に頂くぜ?",
   "en": ""
  },
  {
   "id": "MESSAGE175:0665",
   "jp": "お先に頂くでやんすよ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:0673",
   "jp": "ここは頂いたぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:067E",
   "jp": "ここワシらが貰ったぞい!",
   "en": ""
  },
  {
   "id": "MESSAGE175:068C",
   "jp": "抵抗すると痛い目に\n遣うんだからね!",
   "en": ""
  },
  {
   "id": "MESSAGE175:06A4",
   "jp": "やっぱりこれがなくちゃね!\nエヘヘ♪",
   "en": ""
  },
  {
   "id": "MESSAGE175:06B7",
   "jp": "ここはもらった!",
   "en": ""
  },
  {
   "id": "MESSAGE175:06C0",
   "jp": "オイラに逆らうと\n痛い目を見るぜぃ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:06D7",
   "jp": "…入手成功です",
   "en": ""
  },
  {
   "id": "MESSAGE175:06E3",
   "jp": "ここは我らが頂く!",
   "en": ""
  },
  {
   "id": "MESSAGE175:06EF",
   "jp": "ここはもらったわよ…",
   "en": ""
  },
  {
   "id": "MESSAGE175:06FA",
   "jp": "フッ…この私を相手に\n隙を見せるとは……",
   "en": ""
  },
  {
   "id": "MESSAGE175:0713",
   "jp": "この武器によって神の威光は\n伝えられるであろう!",
   "en": ""
  },
  {
   "id": "MESSAGE175:0731",
   "jp": "こ、これはわしが預かる。\nでないと危険なのでな…",
   "en": ""
  },
  {
   "id": "MESSAGE175:074D",
   "jp": "意外と手ごたえ\n無かったわね?",
   "en": ""
  },
  {
   "id": "MESSAGE175:0761",
   "jp": "あははっ、これが無くちゃ\n始まらないわよね!",
   "en": ""
  },
  {
   "id": "MESSAGE175:077A",
   "jp": "ヒューヒューヒュー♪\nいっただきぃ~♪",
   "en": ""
  },
  {
   "id": "MESSAGE175:078E",
   "jp": "クケケ~ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:0795",
   "jp": "少しはお役に\n立てたかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE175:07A7",
   "jp": "利用出来るものは\n利用させて貰いますよ",
   "en": ""
  },
  {
   "id": "MESSAGE175:07C2",
   "jp": "占領したぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:07CB",
   "jp": "運が悪かったようね",
   "en": ""
  },
  {
   "id": "MESSAGE175:07D7",
   "jp": "我らの勝利だ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:07E2",
   "jp": "あっけないものね?",
   "en": ""
  },
  {
   "id": "MESSAGE175:07EC",
   "jp": "悪く思わないでくれよ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:07FA",
   "jp": "たいしたことないね!",
   "en": ""
  },
  {
   "id": "MESSAGE175:0805",
   "jp": "まいったかい?",
   "en": ""
  },
  {
   "id": "MESSAGE175:080D",
   "jp": "これも任務なのよ…",
   "en": ""
  },
  {
   "id": "MESSAGE175:0819",
   "jp": "この程度とは…",
   "en": ""
  },
  {
   "id": "MESSAGE175:0823",
   "jp": "意外とあっさり\nカタがついたわね!",
   "en": ""
  },
  {
   "id": "MESSAGE175:0837",
   "jp": "ケーケケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE175:083F",
   "jp": "よし!\nこれで優勢になったな!",
   "en": ""
  },
  {
   "id": "MESSAGE175:0851",
   "jp": "気の毒だけど…\nここは頂くわよ",
   "en": ""
  }
 ]
