{
 "file": "MESSAGE030.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE030:0640",
   "jp": "本気を出すしか無いな…!",
   "en": "Guess I have to\nget serious...!"
  },
  {
   "id": "MESSAGE030:0651",
   "jp": "へっ、\nやってくれるじゃねぇか!",
   "en": "Heh,\nnot bad, ya bastard!"
  },
  {
   "id": "MESSAGE030:0662",
   "jp": "相手になってやる!",
   "en": "I'll take you on!"
  },
  {
   "id": "MESSAGE030:066E",
   "jp": "負けません!",
   "en": "I will not lose!"
  },
  {
   "id": "MESSAGE030:0676",
   "jp": "話にならんな!",
   "en": "Pathetic!"
  },
  {
   "id": "MESSAGE030:067F",
   "jp": "私をなめるな!",
   "en": "Don't mock me!"
  },
  {
   "id": "MESSAGE030:0687",
   "jp": "これならどう!?",
   "en": "How about this!?"
  },
  {
   "id": "MESSAGE030:0690",
   "jp": "何の、これしき!",
   "en": "This is nothing!"
  },
  {
   "id": "MESSAGE030:069A",
   "jp": "お返しだぜぇ!",
   "en": "Here's payback!"
  },
  {
   "id": "MESSAGE030:06A3",
   "jp": "なかなかのお手並み",
   "en": "Thou art quite\nskilled."
  },
  {
   "id": "MESSAGE030:06AF",
   "jp": "これを受けられるか!?",
   "en": "Can you take this!?"
  },
  {
   "id": "MESSAGE030:06BC",
   "jp": "お返しだよーっ!",
   "en": "Take thaaat!"
  },
  {
   "id": "MESSAGE030:06C6",
   "jp": "こんなもので私を倒せると?",
   "en": "You think this\ncan defeat me?"
  },
  {
   "id": "MESSAGE030:06D5",
   "jp": "全力で応じましょう!",
   "en": "I shall answer with\nall my strength!"
  },
  {
   "id": "MESSAGE030:06E3",
   "jp": "おもしれぇ!\nお返しいくぜ!",
   "en": "Heh, fun!\nHere's payback!"
  },
  {
   "id": "MESSAGE030:06F3",
   "jp": "ひとりはみんなのためにー!",
   "en": "One for alllll!"
  },
  {
   "id": "MESSAGE030:0701",
   "jp": "ほ~れ受けてみろぉ!",
   "en": "Heeere, take this!"
  },
  {
   "id": "MESSAGE030:070D",
   "jp": "ただでは済まさんぞ!?",
   "en": "Ya won't get off\nlightly, sonny!"
  },
  {
   "id": "MESSAGE030:071A",
   "jp": "むかつくー!",
   "en": "So annoyiiing!"
  },
  {
   "id": "MESSAGE030:0721",
   "jp": "お礼参りだよっ!",
   "en": "Time for payback!"
  },
  {
   "id": "MESSAGE030:072C",
   "jp": "邪魔するなよ!",
   "en": "Out of my way!"
  },
  {
   "id": "MESSAGE030:0736",
   "jp": "このやろっ!",
   "en": "Why you...!"
  },
  {
   "id": "MESSAGE030:073D",
   "jp": "…負けられないんです!",
   "en": "...I cannot lose!"
  },
  {
   "id": "MESSAGE030:074A",
   "jp": "少しはできるようだな!",
   "en": "So you can\nfight a little."
  },
  {
   "id": "MESSAGE030:0757",
   "jp": "悪い子にはお仕置きよ…",
   "en": "Bad children\nget punished..."
  },
  {
   "id": "MESSAGE030:0767",
   "jp": "この私が怯むとでも?",
   "en": "You think I\nwould flinch?"
  },
  {
   "id": "MESSAGE030:0773",
   "jp": "神を畏れぬ異端者め!",
   "en": "Godless heretic!"
  },
  {
   "id": "MESSAGE030:0782",
   "jp": "どうしてわしを狙うんじゃ!",
   "en": "Wh-why is it always\nme you're after!?"
  },
  {
   "id": "MESSAGE030:0791",
   "jp": "消えなさい!",
   "en": "Disappear!"
  },
  {
   "id": "MESSAGE030:0799",
   "jp": "あははっ、くらいなさい!",
   "en": "Ahaha, take this!"
  },
  {
   "id": "MESSAGE030:07A6",
   "jp": "何よぉ、やる気ね!?",
   "en": "Whaaat, you\nwanna go!?"
  },
  {
   "id": "MESSAGE030:07B3",
   "jp": "クケックケックケッ!",
   "en": "Kukeh! Kukeh! Kukeh!"
  },
  {
   "id": "MESSAGE030:07BE",
   "jp": "グォォォッグォッ!",
   "en": "Groooh! Grohh!"
  },
  {
   "id": "MESSAGE030:07C8",
   "jp": "グワォォォッグワォッ!",
   "en": "Grwaooo! Grwaoh!"
  },
  {
   "id": "MESSAGE030:07D4",
   "jp": "どうやら死にたいようだな!",
   "en": "It seems you\nwish to die!"
  },
  {
   "id": "MESSAGE030:07E3",
   "jp": "あらあら~\nそんないけませんわ~!",
   "en": "Oh my, oh my~\nThat won't do~!"
  },
  {
   "id": "MESSAGE030:07F5",
   "jp": "如何に自分が無力なのかを…\n思い知るが良いでしょう",
   "en": "How powerless you\nare... learn it well."
  },
  {
   "id": "MESSAGE030:0818",
   "jp": "まだまだッ!",
   "en": "Not yet!"
  },
  {
   "id": "MESSAGE030:081F",
   "jp": "何の、これしき!",
   "en": "This is nothing!"
  },
  {
   "id": "MESSAGE030:0829",
   "jp": "騎士をなめるな!",
   "en": "Don't mock\na knight!"
  },
  {
   "id": "MESSAGE030:0834",
   "jp": "負けないわ!",
   "en": "I won't lose!"
  },
  {
   "id": "MESSAGE030:083C",
   "jp": "邪魔だって言ってんだろ!?",
   "en": "I said get out\nof my way!"
  },
  {
   "id": "MESSAGE030:084D",
   "jp": "お礼だよ、受け取りな!",
   "en": "A little thanks.\nTake it!"
  },
  {
   "id": "MESSAGE030:085C",
   "jp": "この、お返しするぜ!",
   "en": "Why you...\nHave it back!"
  },
  {
   "id": "MESSAGE030:0868",
   "jp": "反撃よ!",
   "en": "Counterattack!"
  },
  {
   "id": "MESSAGE030:086F",
   "jp": "甘い!",
   "en": "Not good enough!"
  },
  {
   "id": "MESSAGE030:0874",
   "jp": "せーの、それッ!",
   "en": "One, two... hyah!"
  },
  {
   "id": "MESSAGE030:087D",
   "jp": "死など恐れはしないッ!",
   "en": "I do not fear death!"
  },
  {
   "id": "MESSAGE030:088B",
   "jp": "クケックケッ!",
   "en": "Kukeh! Kukeh!"
  },
  {
   "id": "MESSAGE030:0893",
   "jp": "グォォーッ!",
   "en": "Grooogh!"
  },
  {
   "id": "MESSAGE030:089A",
   "jp": "なめるな!",
   "en": "Don't mock me!"
  },
  {
   "id": "MESSAGE030:08A0",
   "jp": "バカにしないで!",
   "en": "Don't make fun\nof me!"
  }
 ]
}
