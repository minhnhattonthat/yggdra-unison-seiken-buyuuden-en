 "strings": [
  {
   "id": "MESSAGE030:0640",
   "jp": "本気を出すしか無いな…!",
   "en": ""
  },
  {
   "id": "MESSAGE030:0651",
   "jp": "へっ、\nやってくれるじゃねぇか!",
   "en": ""
  },
  {
   "id": "MESSAGE030:0662",
   "jp": "相手になってやる!",
   "en": ""
  },
  {
   "id": "MESSAGE030:066E",
   "jp": "負けません!",
   "en": ""
  },
  {
   "id": "MESSAGE030:0676",
   "jp": "話にならんな!",
   "en": ""
  },
  {
   "id": "MESSAGE030:067F",
   "jp": "私をなめるな!",
   "en": ""
