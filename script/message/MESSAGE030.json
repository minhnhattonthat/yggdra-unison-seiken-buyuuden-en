  {
   "id": "MESSAGE030:06D5",
   "jp": "全力で応じましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE030:06E3",
   "jp": "おもしれぇ!\nお返しいくぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE030:06F3",
   "jp": "ひとりはみんなのためにー!",
   "en": ""
  },
  {
   "id": "MESSAGE030:0701",
   "jp": "ほ~れ受けてみろぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE030:070D",
