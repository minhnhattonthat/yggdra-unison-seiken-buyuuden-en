{
 "file": "MESSAGE150.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE150:0390",
   "jp": "解放してもらえるんだな?\nじゃあ、失礼するよ",
   "en": ""
  },
  {
   "id": "MESSAGE150:03AB",
   "jp": "世話になったな!\nあばよ!",
   "en": ""
  },
  {
   "id": "MESSAGE150:03BB",
   "jp": "お力になれず\n申し訳ありませんでした…",
   "en": ""
  },
  {
   "id": "MESSAGE150:03D2",
   "jp": "…お世話になりました\n帝国の勝利を願っています…",
   "en": ""
  },
  {
   "id": "MESSAGE150:03F2",
   "jp": "…お世話になりました\nこのご恩、忘れはしません…",
   "en": ""
  },
  {
   "id": "MESSAGE150:040F",
   "jp": "あたしじゃダメだったのね…",
   "en": ""
  },
  {
   "id": "MESSAGE150:041D",
   "jp": "姫様…\nどうかご武運を",
   "en": ""
  },
  {
   "id": "MESSAGE150:042D",
   "jp": "世話になったな。あばよ",
   "en": ""
  },
  {
   "id": "MESSAGE150:043B",
   "jp": "世話になり申した",
   "en": ""
  },
  {
   "id": "MESSAGE150:0447",
   "jp": "ニーチェじゃ\nダメだったのかなぁ…",
   "en": ""
  },
  {
   "id": "MESSAGE150:0459",
   "jp": "な、何故です?　私では\n力不足だったのですか!?",
   "en": ""
  },
  {
   "id": "MESSAGE150:0477",
   "jp": "親分…世話になりました!",
   "en": ""
  },
  {
   "id": "MESSAGE150:0488",
   "jp": "力になれなくて\nごめんなさい…",
   "en": ""
  },
  {
   "id": "MESSAGE150:0499",
   "jp": "ちょっと、ウチが何したって\nいうのよ!?",
   "en": ""
  },
  {
   "id": "MESSAGE150:04AF",
   "jp": "いいぜ。僕一人でも\n革命を成し遂げてやる!",
   "en": ""
  },
  {
   "id": "MESSAGE150:04CC",
   "jp": "何でだよ!?\n絶対納得いかねーよ!",
   "en": ""
  },
  {
   "id": "MESSAGE150:04E3",
   "jp": "お役に立てず\n申し訳ありませんでした…",
   "en": ""
  },
  {
   "id": "MESSAGE150:04FB",
   "jp": "…承知しました",
   "en": ""
  },
  {
   "id": "MESSAGE150:0505",
   "jp": "そんな…ユベロン様……",
   "en": ""
  },
  {
   "id": "MESSAGE150:0512",
   "jp": "な…何だと!?\nでくのぼうが生意気な…ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE150:052C",
   "jp": "し、信じられない…!\nこの私を捨てるなんて…",
   "en": ""
  },
  {
   "id": "MESSAGE150:0545",
   "jp": "ケケケケッ、クケーッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE150:0552",
   "jp": "グォーッ!?　グォ、グォ!",
   "en": ""
  },
  {
   "id": "MESSAGE150:0560",
   "jp": "グワァ…グオオォォォッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE150:056E",
   "jp": "そんな~\n専業主婦は要らないと?",
   "en": ""
  },
  {
   "id": "MESSAGE150:0584",
   "jp": "世話になったな",
   "en": ""
  },
  {
   "id": "MESSAGE150:058E",
   "jp": "お世話になりました",
   "en": ""
  }
 ]
}
