{
 "file": "MESSAGE105.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE105:0480",
   "jp": "敵の防御を崩すんだ!",
   "en": "Break their defense!"
  },
  {
   "id": "MESSAGE105:048F",
   "jp": "前進するゼ!",
   "en": "Movin' forward!"
  },
  {
   "id": "MESSAGE105:0498",
   "jp": "立ち止まりはしない!",
   "en": "We won't stop!"
  },
  {
   "id": "MESSAGE105:04A5",
   "jp": "このまま前進します!",
   "en": "We will press on!"
  },
  {
   "id": "MESSAGE105:04B2",
   "jp": "好機だ、行くぞ!",
   "en": "Our chance! Go!"
  },
  {
   "id": "MESSAGE105:04BD",
   "jp": "一気に勝負を決めるんだ!",
   "en": "Settle this in one\nstroke!"
  },
  {
   "id": "MESSAGE105:04CF",
   "jp": "邪魔な物は無くなったわ!",
   "en": "The obstacle is gone!"
  },
  {
   "id": "MESSAGE105:04E0",
   "jp": "このまま前進する!",
   "en": "We press forward!"
  },
  {
   "id": "MESSAGE105:04EC",
   "jp": "邪魔な物は壊しちまえ!",
   "en": "Smash whatever's in\nthe way!"
  },
  {
   "id": "MESSAGE105:04FC",
   "jp": "守りを固める時間は与えぬ",
   "en": "I'll give thee no time\nto fortify."
  },
  {
   "id": "MESSAGE105:050E",
   "jp": "突破だ!",
   "en": "Break through!"
  },
  {
   "id": "MESSAGE105:0515",
   "jp": "こんなの、壊しちゃえ!",
   "en": "Break this thing!"
  },
  {
   "id": "MESSAGE105:0522",
   "jp": "一気に殲滅だ!",
   "en": "Annihilate them!"
  },
  {
   "id": "MESSAGE105:052E",
   "jp": "前進します!",
   "en": "We advance!"
  },
  {
   "id": "MESSAGE105:0537",
   "jp": "邪魔だぜ!",
   "en": "Outta the way!"
  },
  {
   "id": "MESSAGE105:053F",
   "jp": "今のうちに攻めるぞ!",
   "en": "Attack while we can!"
  },
  {
   "id": "MESSAGE105:054C",
   "jp": "おりゃあ!\n攻め落とすぞぉ!",
   "en": "Raaah!\nTake 'em dooown!"
  },
  {
   "id": "MESSAGE105:055D",
   "jp": "ガハハハ!\nこのまま突撃じゃあ!",
   "en": "Gwahaha!\nCharge on, boys!"
  },
  {
   "id": "MESSAGE105:0570",
   "jp": "ええーいっ!",
   "en": "Eeeyaaah!"
  },
  {
   "id": "MESSAGE105:0577",
   "jp": "このまま突撃するよ!",
   "en": "Charging right in!"
  },
  {
   "id": "MESSAGE105:0584",
   "jp": "僕たちの思いは\n止められないぞ!",
   "en": "Our will can't be\nstopped!"
  },
  {
   "id": "MESSAGE105:0598",
   "jp": "ぶっ壊してでも前進するぜ!",
   "en": "I'll bust through if\nI gotta!"
  },
  {
   "id": "MESSAGE105:05A9",
   "jp": "…崩しました!",
   "en": "...Broken through!"
  },
  {
   "id": "MESSAGE105:05B2",
   "jp": "柵を破壊!",
   "en": "Barricade destroyed!"
  },
  {
   "id": "MESSAGE105:05BB",
   "jp": "進ませてもらうわよ",
   "en": "We'll be going\nthrough, dear."
  },
  {
   "id": "MESSAGE105:05C6",
   "jp": "防御を固める暇は与えん!",
   "en": "I'll give you no time\nto fortify!"
  },
  {
   "id": "MESSAGE105:05D8",
   "jp": "こんな物で神のご意思は\n曲げられぬぞ!",
   "en": "This cannot bend the\nwill of God!"
  },
  {
   "id": "MESSAGE105:05F0",
   "jp": "柵のひとつくらい壊したとて\nバチは当たるまいな…",
   "en": "Surely one barricade\nwon't damn me..."
  },
  {
   "id": "MESSAGE105:060C",
   "jp": "邪魔な物は壊すに限るわね!",
   "en": "Best to smash what's\nin the way, darling!"
  },
  {
   "id": "MESSAGE105:061F",
   "jp": "ああ、すっきりしたわ",
   "en": "Ahh, that felt good."
  },
  {
   "id": "MESSAGE105:062A",
   "jp": "壊したよ~ん♪",
   "en": "Smashed it~!"
  },
  {
   "id": "MESSAGE105:0633",
   "jp": "ケッケッケ!",
   "en": "Keh-keh-keh!"
  },
  {
   "id": "MESSAGE105:063A",
   "jp": "グォッグォッグォッ!",
   "en": "Gwoh! Gwoh! Gwoh!"
  },
  {
   "id": "MESSAGE105:0645",
   "jp": "グワォッグワォッグワォッ!",
   "en": "Grwah-grwah-grwah!"
  },
  {
   "id": "MESSAGE105:0653",
   "jp": "このようなもの…\n無駄だっ!",
   "en": "Such a thing...\nis futile!"
  },
  {
   "id": "MESSAGE105:0664",
   "jp": "もっと強い柵を用意なさいな",
   "en": "Do get a sturdier\nbarricade, dear."
  },
  {
   "id": "MESSAGE105:0676",
   "jp": "無駄な足掻きを…",
   "en": "Such futile\nstruggling..."
  }
 ]
}
