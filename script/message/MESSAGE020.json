{
 "file": "MESSAGE020.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE020:0410",
   "jp": "エミリオ殿、勝負です!",
   "en": ""
  },
  {
   "id": "MESSAGE020:041F",
   "jp": "こちらからいきます!",
   "en": ""
  },
  {
   "id": "MESSAGE020:042A",
   "jp": "勝負よ、アイギナ…!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0437",
   "jp": "姉さん、勝負…!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0443",
   "jp": "お互い手加減なしよ!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0452",
   "jp": "手合わせ、光栄に存じます!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0465",
   "jp": "むかつくんだよ、偽善者が!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0476",
   "jp": "王女、手合わせ願おう!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0487",
   "jp": "神を貶めた罰だ!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0492",
   "jp": "手加減、しないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE020:049F",
   "jp": "いくぜ、お姫様!",
   "en": ""
  },
  {
   "id": "MESSAGE020:04AA",
   "jp": "ワシの子分にしてやっても\nいいぞぉ?",
   "en": ""
  },
  {
   "id": "MESSAGE020:04BF",
   "jp": "おおっ、金目のものが\nいっぱいじゃのう!",
   "en": ""
  },
  {
   "id": "MESSAGE020:04D6",
   "jp": "なによ、\nあなた子供じゃない!",
   "en": ""
  },
  {
   "id": "MESSAGE020:04E8",
   "jp": "アンタにだけは\n負けないよっ!",
   "en": ""
  },
  {
   "id": "MESSAGE020:04F9",
   "jp": "決着つけてやるよ!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0505",
   "jp": "皇帝陛下…お許しください!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0517",
   "jp": "フフ…行きますわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE020:0522",
   "jp": "貴様、何者だ?",
   "en": ""
  },
  {
   "id": "MESSAGE020:052E",
   "jp": "私の手下となれ!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0538",
   "jp": "わ、わしに逆らうのか!?",
   "en": ""
  },
  {
   "id": "MESSAGE020:0546",
   "jp": "あんたには負けたくないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0555",
   "jp": "私の魔力に敵うかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE020:0564",
   "jp": "ちょっとオトナの\nウンディーネ、いっただきぃ",
   "en": ""
  },
  {
   "id": "MESSAGE020:057B",
   "jp": "ケケッ、クケケケーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0587",
   "jp": "グォォォォォォォッ!!!",
   "en": ""
  },
  {
   "id": "MESSAGE020:0594",
   "jp": "グワォォォォォォォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE020:05A0",
   "jp": "軍神よ、俺が相手だ!",
   "en": ""
  },
  {
   "id": "MESSAGE020:05AF",
   "jp": "あたくしの気持ち…\n受け止めてくださいな!",
   "en": ""
  },
  {
   "id": "MESSAGE020:05C9",
   "jp": "お姉さんの後を\n追わせてあげましょう…",
   "en": ""
  }
 ]
}
