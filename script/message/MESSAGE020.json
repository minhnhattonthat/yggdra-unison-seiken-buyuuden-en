{
 "file": "MESSAGE020.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE020:0410",
   "jp": "エミリオ殿、勝負です!",
   "en": "Emilia-dono,\nI challenge you!"
  },
  {
   "id": "MESSAGE020:041F",
   "jp": "こちらからいきます!",
   "en": "I shall strike first!"
  },
  {
   "id": "MESSAGE020:042A",
   "jp": "勝負よ、アイギナ…!",
   "en": "Face me, Aegina...!"
  },
  {
   "id": "MESSAGE020:0437",
   "jp": "姉さん、勝負…!",
   "en": "Sister... have at you!"
  },
  {
   "id": "MESSAGE020:0443",
   "jp": "お互い手加減なしよ!",
   "en": "No holding back,\neither of us!"
  },
  {
   "id": "MESSAGE020:0452",
   "jp": "手合わせ、光栄に存じます!",
   "en": "An honor to cross\nblades with you!"
  },
  {
   "id": "MESSAGE020:0465",
   "jp": "むかつくんだよ、偽善者が!",
   "en": "You make me sick,\nhypocrite!"
  },
  {
   "id": "MESSAGE020:0476",
   "jp": "王女、手合わせ願おう!",
   "en": "Princess, I would\nduel with thee!"
  },
  {
   "id": "MESSAGE020:0487",
   "jp": "神を貶めた罰だ!",
   "en": "Your punishment for\ndefiling God!"
  },
  {
   "id": "MESSAGE020:0492",
   "jp": "手加減、しないよ!",
   "en": "No holding back!"
  },
  {
   "id": "MESSAGE020:049F",
   "jp": "いくぜ、お姫様!",
   "en": "Here I come, Princess!"
  },
  {
   "id": "MESSAGE020:04AA",
   "jp": "ワシの子分にしてやっても\nいいぞぉ?",
   "en": "I could make ya one\no' my lackeys, eh?"
  },
  {
   "id": "MESSAGE020:04BF",
   "jp": "おおっ、金目のものが\nいっぱいじゃのう!",
   "en": "Ooh, lots o' loot on\nthis one, heh!"
  },
  {
   "id": "MESSAGE020:04D6",
   "jp": "なによ、\nあなた子供じゃない!",
   "en": "Hmph! Why,\nyou're just a kid!"
  },
  {
   "id": "MESSAGE020:04E8",
   "jp": "アンタにだけは\n負けないよっ!",
   "en": "You're the one I\nwon't lose to!"
  },
  {
   "id": "MESSAGE020:04F9",
   "jp": "決着つけてやるよ!",
   "en": "Let's settle this!"
  },
  {
   "id": "MESSAGE020:0505",
   "jp": "皇帝陛下…お許しください!",
   "en": "Your Majesty...\nplease forgive me!"
  },
  {
   "id": "MESSAGE020:0517",
   "jp": "フフ…行きますわよ?",
   "en": "Fufu... here I come,\nready?"
  },
  {
   "id": "MESSAGE020:0522",
   "jp": "貴様、何者だ?",
   "en": "And who might\nyou be?"
  },
  {
   "id": "MESSAGE020:052E",
   "jp": "私の手下となれ!",
   "en": "Become my servant!"
  },
  {
   "id": "MESSAGE020:0538",
   "jp": "わ、わしに逆らうのか!?",
   "en": "Wh-what!? You'd go\nagainst me, eh!?"
  },
  {
   "id": "MESSAGE020:0546",
   "jp": "あんたには負けたくないわ!",
   "en": "You're the last one\nI'd want to lose to!"
  },
  {
   "id": "MESSAGE020:0555",
   "jp": "私の魔力に敵うかしら?",
   "en": "Can you match my\nmagic, I wonder?"
  },
  {
   "id": "MESSAGE020:0564",
   "jp": "ちょっとオトナの\nウンディーネ、いっただきぃ",
   "en": "A kinda grown-up\nUndine, yoink~"
  },
  {
   "id": "MESSAGE020:057B",
   "jp": "ケケッ、クケケケーッ!",
   "en": "Kekeh, kukekekeeh!"
  },
  {
   "id": "MESSAGE020:0587",
   "jp": "グォォォォォォォッ!!!",
   "en": "Grooooooogh!!!"
  },
  {
   "id": "MESSAGE020:0594",
   "jp": "グワォォォォォォォッ!",
   "en": "Grwaooooooogh!"
  },
  {
   "id": "MESSAGE020:05A0",
   "jp": "軍神よ、俺が相手だ!",
   "en": "God of War!\nI am your opponent!"
  },
  {
   "id": "MESSAGE020:05AF",
   "jp": "あたくしの気持ち…\n受け止めてくださいな!",
   "en": "My feelings...\nplease accept them!"
  },
  {
   "id": "MESSAGE020:05C9",
   "jp": "お姉さんの後を\n追わせてあげましょう…",
   "en": "Allow me to send you\nafter your sister..."
  }
 ]
}
