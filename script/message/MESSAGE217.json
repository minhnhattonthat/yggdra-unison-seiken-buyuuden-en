{
 "file": "MESSAGE217.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE217:0240",
   "jp": "平和へ向けての大切な一歩。\n皆、一層奮励努力しましょう",
   "en": ""
  },
  {
   "id": "MESSAGE217:026A",
   "jp": "これ以上、治安の悪化を\n看過することは出来ぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE217:028C",
   "jp": "ここには大陸世界の知識が\n集まっていると聞きます",
   "en": ""
  },
  {
   "id": "MESSAGE217:02AD",
   "jp": "こいつらを倒せれば…\n願いは叶うってもんだぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE217:02C8",
   "jp": "ぬう…正義漠を\n気取りおって…",
   "en": ""
  },
  {
   "id": "MESSAGE217:02DD",
   "jp": "ここには上玉の領主が\nいると聞いたぞい?",
   "en": ""
  },
  {
   "id": "MESSAGE217:02F7",
   "jp": "本来ならば部下たちに\n任せたいところだが…",
   "en": ""
  },
  {
   "id": "MESSAGE217:0311",
   "jp": "す、少しでも収入を\n増やさねばならんのじゃ…",
   "en": ""
  },
  {
   "id": "MESSAGE217:032C",
   "jp": "何者なのか…\n気になるところね……",
   "en": ""
  },
  {
   "id": "MESSAGE217:0341",
   "jp": "ウィッチを侮辱するとは\n不届き者だわさ",
   "en": ""
  },
  {
   "id": "MESSAGE217:035A",
   "jp": "あの者を…このまま\n野放しにするなど出来ぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE217:0376",
   "jp": "さあ、神々への復讐のため\n生贄となって貰いましょう",
   "en": ""
  }
 ]
}
