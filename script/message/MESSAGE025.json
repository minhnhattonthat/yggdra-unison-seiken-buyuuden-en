   "en": "I'll return that!"
  },
  {
   "id": "MESSAGE025:050F",
   "jp": "お返ししますっ!",
   "en": "Take this in return!"
  },
  {
   "id": "MESSAGE025:0519",
   "jp": "貴殿にだけは負けられん!",
   "en": "To you, of all men,\nI cannot lose!"
  },
  {
   "id": "MESSAGE025:0529",
   "jp": "貴様に俺は超えられねぇッ!",
   "en": "You ain't ever\ngettin' past me!"
  },
  {
   "id": "MESSAGE025:053B",
   "jp": "その闘志\n褒めてつかわそう!",
   "en": "Thy fighting spirit\ndeserves my praise!"
  },
  {
   "id": "MESSAGE025:054D",
   "jp": "身勝手が許されると思うな!",
   "en": "Think not such\nselfishness goes free!"
  },
  {
   "id": "MESSAGE025:0560",
   "jp": "もう、逃げたりしない!",
   "en": "Nietzsche won't run\naway anymore!"
  },
  {
   "id": "MESSAGE025:056D",
   "jp": "真剣勝負だ!",
   "en": "A true duel!"
  },
  {
   "id": "MESSAGE025:0578",
   "jp": "さあ、わたくしが相手です",
   "en": "Now, I shall be\nyour opponent."
  },
  {
   "id": "MESSAGE025:0587",
   "jp": "おう、そうこなくっちゃな!",
   "en": "Yeah, that's more\nlike it!"
  },
  {
   "id": "MESSAGE025:0595",
   "jp": "姐さん、勝負ですっ!",
   "en": "Sis, I'm challengin'\nya!"
  },
  {
   "id": "MESSAGE025:05A3",
   "jp": "おめぇ、相変わらずだな!",
   "en": "Ya ain't changed\na bit!"
  },
  {
   "id": "MESSAGE025:05B2",
   "jp": "最近の若造はなっとらんのう",
   "en": "Kids these days got\nno manners, eh..."
  },
  {
   "id": "MESSAGE025:05C4",
   "jp": "子供扱いしないでよね!",
   "en": "Don't treat me like\na child!"
  },
  {
   "id": "MESSAGE025:05D3",
   "jp": "お返しだよっ!",
   "en": "Right back atcha!"
  },
  {
   "id": "MESSAGE025:05DC",
   "jp": "そりゃどうも!",
   "en": "Thanks a lot!"
  },
  {
   "id": "MESSAGE025:05E4",
   "jp": "うおっ、物騒なガキだな!",
   "en": "Whoa, what a\ndangerous brat!"
  },
  {
   "id": "MESSAGE025:05F3",
   "jp": "…はいっ!",
   "en": "...Yes!"
  },
  {
   "id": "MESSAGE025:05F9",
   "jp": "お返しします!",
   "en": "I'll return that!"
  },
  {
   "id": "MESSAGE025:0602",
   "jp": "私の番よ…",
   "en": "My turn..."
  },
  {
   "id": "MESSAGE025:0609",
   "jp": "今すぐ地に還してやろう!",
   "en": "I shall return you to\nthe earth at once!"
  },
  {
   "id": "MESSAGE025:0619",
   "jp": "くっ、ヘドが出る!",
   "en": "Ugh, you make\nme sick!"
  },
  {
   "id": "MESSAGE025:0624",
   "jp": "わ、わしに手を上げるのか!",
   "en": "Y-you'd raise a hand\nto me!? Me!?"
  },
  {
   "id": "MESSAGE025:0634",
   "jp": "主人の顔を忘れたの!?",
   "en": "Forgotten who your\nmistress is!?"
  },
  {
   "id": "MESSAGE025:0644",
   "jp": "力押しじゃ勝てないわよ?",
   "en": "Brute force won't\nwin this, you know?"
  },
  {
   "id": "MESSAGE025:0654",
   "jp": "力押しじゃ勝てないわよ~?",
   "en": "Brute force won't\nwin this, you know~?"
  },
  {
   "id": "MESSAGE025:0665",
   "jp": "クケックケケケッ!",
   "en": "Kukeh! Kukekekeh!"
  },
  {
   "id": "MESSAGE025:066F",
   "jp": "グォォッグォッ!",
   "en": "Grooh! Grohh!"
  },
  {
   "id": "MESSAGE025:0678",
   "jp": "グワォォォッグワォッ!!!",
   "en": "Grwaooo! Grwaoh!!!"
  },
  {
   "id": "MESSAGE025:0686",
   "jp": "フン、好都合だ!",
   "en": "Hmph, all the better!"
  },
  {
   "id": "MESSAGE025:0692",
   "jp": "お礼は倍返しですわよ!",
   "en": "I repay favors twice\nover, dear!"
  },
  {
   "id": "MESSAGE025:06A1",
   "jp": "それが貴方の本当の力\nなのですか?",
   "en": "Is that truly\nyour full power?"
  }
 ]
