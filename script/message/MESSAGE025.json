 "strings": [
  {
   "id": "MESSAGE025:04C0",
   "jp": "それは奇遇だな!",
   "en": "What a coincidence!"
  },
  {
   "id": "MESSAGE025:04CB",
   "jp": "カクカクしやがって\n気持ちわりぃんだよ!",
   "en": "Quit jerkin' around,\nit's creepy as hell!"
  },
  {
   "id": "MESSAGE025:04E2",
   "jp": "全力でいきますっ!",
   "en": "I'm giving it my all!"
  },
  {
   "id": "MESSAGE025:04EE",
   "jp": "受けて立ちましょう!",
   "en": "I accept your\nchallenge!"
  },
  {
   "id": "MESSAGE025:04FB",
   "jp": "お返し致します!",
   "en": "Allow me to\nreturn that!"
