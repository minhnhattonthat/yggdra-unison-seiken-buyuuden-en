  },
  {
   "id": "MESSAGE068:0668",
   "jp": "我らの罪をも許し給え…",
   "en": ""
  },
  {
   "id": "MESSAGE068:0678",
   "jp": "お前らが悪いんじゃ…",
   "en": ""
  },
  {
   "id": "MESSAGE068:0685",
   "jp": "あの世で後悔なさい",
   "en": ""
  },
  {
   "id": "MESSAGE068:0692",
