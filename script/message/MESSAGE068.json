{
 "file": "MESSAGE068.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE068:04F0",
   "jp": "手加減できるほど\n器用じゃないんでね…",
   "en": "I'm not deft enough\nto hold back..."
  },
  {
   "id": "MESSAGE068:0509",
   "jp": "おー、こりゃあ手柄だゼ!",
   "en": "Ooh, now that's a\nprize catch!"
  },
  {
   "id": "MESSAGE068:0518",
   "jp": "敵将を討ち取ったぞ!",
   "en": "I've slain the\nenemy general!"
  },
  {
   "id": "MESSAGE068:0527",
   "jp": "悲しみを終わらせるために…",
   "en": "To bring an end to\nall this sorrow..."
  },
  {
   "id": "MESSAGE068:0537",
   "jp": "己の浅はかさを呪うがいい",
   "en": "Curse your own\nfolly."
  },
  {
   "id": "MESSAGE068:0547",
   "jp": "この地で朽ち果てるがいい!",
   "en": "Rot away on\nthis soil!"
  },
  {
   "id": "MESSAGE068:0558",
   "jp": "いい気味だわ!",
   "en": "Serves you right!"
  },
  {
   "id": "MESSAGE068:0562",
   "jp": "討ち取りました!",
   "en": "I have slain the foe!"
  },
  {
   "id": "MESSAGE068:056D",
   "jp": "ハーハッハッハ!\nあの世で後悔するんだな!",
   "en": "Hahahaha! Regret\nit in the afterlife!"
  },
  {
   "id": "MESSAGE068:0586",
   "jp": "修行が足りんようじゃな",
   "en": "Thou needest more\ntraining, methinks."
  },
  {
   "id": "MESSAGE068:0594",
   "jp": "あの世で悔い改めよ",
   "en": "Repent in the\nafterlife."
  },
  {
   "id": "MESSAGE068:05A1",
   "jp": "ニーチェ、諦めないよ!",
   "en": "Nietzsche won't\ngive up!"
  },
  {
   "id": "MESSAGE068:05AE",
   "jp": "己の無知さを悔いるがいい",
   "en": "Regret your own\nignorance."
  },
  {
   "id": "MESSAGE068:05BF",
   "jp": "決着がついたようですね…",
   "en": "It seems this is\nsettled..."
  },
  {
   "id": "MESSAGE068:05CE",
   "jp": "へっ、すっきりしたぜ!",
   "en": "Heh, that felt good!"
  },
  {
   "id": "MESSAGE068:05DA",
   "jp": "ざまーみろってんだー!",
   "en": "Serves ya riiight!"
  },
  {
   "id": "MESSAGE068:05E6",
   "jp": "これでガッポリだぞぉ!",
   "en": "Now we're rakin'\nit in!"
  },
  {
   "id": "MESSAGE068:05F2",
   "jp": "何じゃ、\n思ったよりヤワだったのう?",
   "en": "What? Softer than\nI figured, eh?"
  },
  {
   "id": "MESSAGE068:0607",
   "jp": "いい気味よ!",
   "en": "Serves you right,\nhmph!"
  },
  {
   "id": "MESSAGE068:0610",
   "jp": "悪く思わないでよね!",
   "en": "No hard feelings,\nokay?!"
  },
  {
   "id": "MESSAGE068:061D",
   "jp": "悪者は許せないな!",
   "en": "I can't forgive\nvillains!"
  },
  {
   "id": "MESSAGE068:062A",
   "jp": "オイラはいつも本気だぜ!",
   "en": "I always go all out!"
  },
  {
   "id": "MESSAGE068:0639",
   "jp": "討ち取りました…",
   "en": "Target eliminated..."
  },
  {
   "id": "MESSAGE068:0644",
   "jp": "運命だ。諦めよ",
   "en": "It's fate.\nAccept it."
  },
  {
   "id": "MESSAGE068:064F",
   "jp": "愚か者には報いを…",
   "en": "Fools get what\nthey deserve..."
  },
  {
   "id": "MESSAGE068:065C",
   "jp": "その命を以て償え",
   "en": "Atone with your life."
  },
  {
   "id": "MESSAGE068:0668",
   "jp": "我らの罪をも許し給え…",
   "en": "And forgive us\nour sins..."
  },
  {
   "id": "MESSAGE068:0678",
   "jp": "お前らが悪いんじゃ…",
   "en": "It's your own fault,\nya hear..."
  },
  {
   "id": "MESSAGE068:0685",
   "jp": "あの世で後悔なさい",
   "en": "Regret it in the\nnext world, darling."
  },
  {
   "id": "MESSAGE068:0692",
   "jp": "やらなきゃやられる、\nそれが戦争よ",
   "en": "Kill or be killed,\nthat's war."
  },
  {
   "id": "MESSAGE068:06A6",
   "jp": "パメラ様に刃向かうからよ♪",
   "en": "That's for defying\nPamela-sama~!"
  },
  {
   "id": "MESSAGE068:06B7",
   "jp": "ケケ、クケーケケケケッ!",
   "en": "Keke,\nKukeeekekekekeh!"
  },
  {
   "id": "MESSAGE068:06C4",
   "jp": "グォォォォーグォッ!",
   "en": "Grooooo- Groh!"
  },
  {
   "id": "MESSAGE068:06CF",
   "jp": "グワォォォォーグワォッ!",
   "en": "Grwaaaaa- Grwaoh!"
  },
  {
   "id": "MESSAGE068:06DC",
   "jp": "身の程を知れッ!",
   "en": "Know your place!"
  },
  {
   "id": "MESSAGE068:06E8",
   "jp": "これも運命なのね…",
   "en": "This must be fate,\nthen..."
  },
  {
   "id": "MESSAGE068:06F4",
   "jp": "これ以上生き恥をさらす\n必要は無いでしょう…",
   "en": "No need to live on\nin further disgrace..."
  },
  {
   "id": "MESSAGE068:0712",
   "jp": "お前を野放しには\nしておけない!",
   "en": "I can't let you\nrun loose!"
  },
  {
   "id": "MESSAGE068:0726",
   "jp": "野放しにはしておけないの",
   "en": "I can't let you\nroam free."
  }
 ]
}
