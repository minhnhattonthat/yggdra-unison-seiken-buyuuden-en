  },
  {
   "id": "MESSAGE068:0607",
   "jp": "いい気味よ!",
   "en": ""
  },
  {
   "id": "MESSAGE068:0610",
   "jp": "悪く思わないでよね!",
   "en": ""
  },
  {
   "id": "MESSAGE068:061D",
   "jp": "悪者は許せないな!",
   "en": ""
  },
  {
   "id": "MESSAGE068:062A",
   "jp": "オイラはいつも本気だぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE068:0639",
   "jp": "討ち取りました…",
   "en": ""
  },
  {
   "id": "MESSAGE068:0644",
