  {
   "id": "MESSAGE068:04F0",
   "jp": "手加減できるほど\n器用じゃないんでね…",
   "en": ""
  },
  {
   "id": "MESSAGE068:0509",
   "jp": "おー、こりゃあ手柄だゼ!",
   "en": ""
  },
  {
