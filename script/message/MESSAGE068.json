   "en": ""
  },
  {
   "id": "MESSAGE068:05BF",
   "jp": "決着がついたようですね…",
   "en": ""
  },
  {
   "id": "MESSAGE068:05CE",
   "jp": "へっ、すっきりしたぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE068:05DA",
   "jp": "ざまーみろってんだー!",
   "en": ""
  },
  {
   "id": "MESSAGE068:05E6",
   "jp": "これでガッポリだぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE068:05F2",
   "jp": "何じゃ、\n思ったよりヤワだったのう?",
