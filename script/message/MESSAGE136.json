{
 "file": "MESSAGE136.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE136:0480",
   "jp": "魔剣士の名も地に堕ちたな…",
   "en": ""
  },
  {
   "id": "MESSAGE136:0494",
   "jp": "くっ…好きにしやがれ!",
   "en": ""
  },
  {
   "id": "MESSAGE136:04A1",
   "jp": "は…放せッ!",
   "en": ""
  },
  {
   "id": "MESSAGE136:04A9",
   "jp": "逃げも隠れもしません…",
   "en": ""
  },
  {
   "id": "MESSAGE136:04B7",
   "jp": "何という不覚…ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE136:04C4",
   "jp": "何という屈辱…ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE136:04D1",
   "jp": "あたしを捕らえて\nどうするつもりよ!?",
   "en": ""
  },
  {
   "id": "MESSAGE136:04E6",
   "jp": "もとより、命を捨てる覚悟…\nお斬りなさい",
   "en": ""
  },
  {
   "id": "MESSAGE136:0500",
   "jp": "ふざけんじゃねぇぞ…ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE136:050D",
   "jp": "さあ、首を持っていかれるが\nよい",
   "en": ""
  },
  {
   "id": "MESSAGE136:0520",
   "jp": "敵の情けは受けん…",
   "en": ""
  },
  {
   "id": "MESSAGE136:052D",
   "jp": "ニーチェ捕まえても\n何もいいことないよ?",
   "en": ""
  },
  {
   "id": "MESSAGE136:0544",
   "jp": "好きにするがいい!",
   "en": ""
  },
  {
   "id": "MESSAGE136:054F",
   "jp": "命乞いをするつもりは\nありませんよ",
   "en": ""
  },
  {
   "id": "MESSAGE136:0563",
   "jp": "まずいぜ、こりゃ…",
   "en": ""
  },
  {
   "id": "MESSAGE136:056D",
   "jp": "しくじったぜ…",
   "en": ""
  },
  {
   "id": "MESSAGE136:0575",
   "jp": "ワ、ワシが本気を出せば\nおめぇらくらい…",
   "en": ""
  },
  {
   "id": "MESSAGE136:058D",
   "jp": "は、反省しておるぞい。\nだから許してくれい…",
   "en": ""
  },
  {
   "id": "MESSAGE136:05A7",
   "jp": "ボクは降参なんて\nしないんだから…!",
   "en": ""
  },
  {
   "id": "MESSAGE136:05BC",
   "jp": "ウチもヤキが回ったみたいね",
   "en": ""
  },
  {
   "id": "MESSAGE136:05CB",
   "jp": "何だか嫌な予感がするよ…",
   "en": ""
  },
  {
   "id": "MESSAGE136:05DC",
   "jp": "ついてねぇなぁ…",
   "en": ""
  },
  {
   "id": "MESSAGE136:05E5",
   "jp": "…………",
   "en": ""
  },
  {
   "id": "MESSAGE136:05EA",
   "jp": "私も落ちぶれたものだな…",
   "en": ""
  },
  {
   "id": "MESSAGE136:05F8",
   "jp": "負けは負けよ…\n好きになさい",
   "en": ""
  },
  {
   "id": "MESSAGE136:060A",
   "jp": "くっ…放せ!",
   "en": ""
  },
  {
   "id": "MESSAGE136:0612",
   "jp": "神の使徒である私に\n何という真似を…!",
   "en": ""
  },
  {
   "id": "MESSAGE136:062B",
   "jp": "い、命ばかりは…",
   "en": ""
  },
  {
   "id": "MESSAGE136:0635",
   "jp": "一生の不覚だわ…",
   "en": ""
  },
  {
   "id": "MESSAGE136:0642",
   "jp": "…好きにすればいいわ",
   "en": ""
  },
  {
   "id": "MESSAGE136:064E",
   "jp": "こ、怖いよぅ~",
   "en": ""
  },
  {
   "id": "MESSAGE136:0657",
   "jp": "クケ…",
   "en": ""
  },
  {
   "id": "MESSAGE136:065B",
   "jp": "グォ…",
   "en": ""
  },
  {
   "id": "MESSAGE136:065F",
   "jp": "グワォ…",
   "en": ""
  },
  {
   "id": "MESSAGE136:0664",
   "jp": "俺の力が及ばなかった…\nただそれだけのことだ",
   "en": ""
  },
  {
   "id": "MESSAGE136:067E",
   "jp": "負けは負けですわ。\nお好きなようになさい",
   "en": ""
  },
  {
   "id": "MESSAGE136:0696",
   "jp": "どうぞ、お好きなように…",
   "en": ""
  }
 ]
}
