{
 "file": "MESSAGE169.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE169:0480",
   "jp": "俺の剣が役に立ったのなら\n幸いだよ",
   "en": ""
  },
  {
   "id": "MESSAGE169:0497",
   "jp": "オレ様に感謝しろよな!",
   "en": ""
  },
  {
   "id": "MESSAGE169:04A6",
   "jp": "天下統一、万歳!",
   "en": ""
  },
  {
   "id": "MESSAGE169:04B4",
   "jp": "おめでとうございます!",
   "en": ""
  },
  {
   "id": "MESSAGE169:04C0",
   "jp": "お前…\nなかなかやるな",
   "en": ""
  },
  {
   "id": "MESSAGE169:04CD",
   "jp": "ふむ…\nお前、なかなかやるな",
   "en": ""
  },
  {
   "id": "MESSAGE169:04DD",
   "jp": "あんたならできるって\n思ってたわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE169:04F1",
   "jp": "強き心は世界も動かす…か。\nおめでとうございます!",
   "en": ""
  },
  {
   "id": "MESSAGE169:0510",
   "jp": "フン…めでてえヤツだ",
   "en": ""
  },
  {
   "id": "MESSAGE169:051B",
   "jp": "うむ…あっぱれじゃ",
   "en": ""
  },
  {
   "id": "MESSAGE169:0525",
   "jp": "正しき世界の到来を\nお喜び申し上げます",
   "en": ""
  },
  {
   "id": "MESSAGE169:0541",
   "jp": "ニーチェも、頑張ったもん!",
   "en": ""
  },
  {
   "id": "MESSAGE169:0551",
   "jp": "貴様…見直してやっても\nいいぞ?",
   "en": ""
  },
  {
   "id": "MESSAGE169:0566",
   "jp": "貴方の手腕には\n感服致しました",
   "en": ""
  },
  {
   "id": "MESSAGE169:057D",
   "jp": "お前、やるじゃねーか!\n見直したぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE169:0593",
   "jp": "天下統一、マジっすか!?\nおめでとうごぜえやす!",
   "en": ""
  },
  {
   "id": "MESSAGE169:05AF",
   "jp": "ほっほー!　さすが、ワシが\n認めただけのことはあるな!",
   "en": ""
  },
  {
   "id": "MESSAGE169:05CC",
   "jp": "ほお、お主もなかなか\nやりおるのう!",
   "en": ""
  },
  {
   "id": "MESSAGE169:05E0",
   "jp": "すっごーい!\nちょっと見直しちゃった!",
   "en": ""
  },
  {
   "id": "MESSAGE169:05F6",
   "jp": "へえ…あんた、やるじゃん!",
   "en": ""
  },
  {
   "id": "MESSAGE169:0604",
   "jp": "あんたのおかげで\n革命を成し遂げられたよ!",
   "en": ""
  },
  {
   "id": "MESSAGE169:061E",
   "jp": "オイラをスカウトして\n正解だったよな!",
   "en": ""
  },
  {
   "id": "MESSAGE169:0634",
   "jp": "…おめでとうございます",
   "en": ""
  },
  {
   "id": "MESSAGE169:0640",
   "jp": "貴殿…見直したぞ",
   "en": ""
  },
  {
   "id": "MESSAGE169:064D",
   "jp": "フフ…認めてあげても\nいいわよ……",
   "en": ""
  },
  {
   "id": "MESSAGE169:0660",
   "jp": "貴様、やるではないか",
   "en": ""
  },
  {
   "id": "MESSAGE169:066D",
   "jp": "神のご加護の賜物ですぞ",
   "en": ""
  },
  {
   "id": "MESSAGE169:067D",
   "jp": "ゴージャスな生活は\n約束されたようなもんじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE169:0699",
   "jp": "案外やるのね、あんた!",
   "en": ""
  },
  {
   "id": "MESSAGE169:06A7",
   "jp": "これも想定範囲内よ。\nともあれ、おめでとう!",
   "en": ""
  },
  {
   "id": "MESSAGE169:06C3",
   "jp": "うほっ!?　おめでとー!",
   "en": ""
  },
  {
   "id": "MESSAGE169:06D0",
   "jp": "クケケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE169:06D7",
   "jp": "グオオォォォ!",
   "en": ""
  },
  {
   "id": "MESSAGE169:06DF",
   "jp": "グワオオォォォ!",
   "en": ""
  },
  {
   "id": "MESSAGE169:06E8",
   "jp": "この俺を使いこなすとは…\n面白いやつだ",
   "en": ""
  },
  {
   "id": "MESSAGE169:0700",
   "jp": "あなた…なかなか\nやりますわね",
   "en": ""
  },
  {
   "id": "MESSAGE169:0710",
   "jp": "このような運命も\n悪くはありませんね…",
   "en": ""
  }
 ]
}
