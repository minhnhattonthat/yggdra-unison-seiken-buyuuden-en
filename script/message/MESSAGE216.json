{
 "file": "MESSAGE216.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE216:0240",
   "jp": "大陸全土の平和のために…\n更なる勝利を目指しましょう",
   "en": ""
  },
  {
   "id": "MESSAGE216:0266",
   "jp": "この勝利を神に捧げよう!",
   "en": ""
  },
  {
   "id": "MESSAGE216:0276",
   "jp": "ここにも…わたくしが\n求める答えは無かった……",
   "en": ""
  },
  {
   "id": "MESSAGE216:0291",
   "jp": "ジャマなヤツらは\n蹴散らしたぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE216:02A4",
   "jp": "ほっほー!　目障りな連中を\n片付けたぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE216:02C0",
   "jp": "ワシらの神を信じぬ者は\n容赦せんぞい!",
   "en": ""
  },
  {
   "id": "MESSAGE216:02D8",
   "jp": "フッ…\n当然の結果だ……",
   "en": ""
  },
  {
   "id": "MESSAGE216:02E9",
   "jp": "ど、どうだ!?\n少しは思い知ったか!?",
   "en": ""
  },
  {
   "id": "MESSAGE216:0300",
   "jp": "まぁ、当然の結果ね。\n自慢するまでも無いわ…",
   "en": ""
  },
  {
   "id": "MESSAGE216:031E",
   "jp": "ここまで抵抗されるとは\n思わなかったんだわさ…",
   "en": ""
  },
  {
   "id": "MESSAGE216:0339",
   "jp": "後に残るは雑魚だけだ。\nこのまま一気に片付けるぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE216:035B",
   "jp": "思ったほどではありません\nでしたね…フフフ……",
   "en": ""
  }
 ]
}
