{
 "file": "MESSAGE059.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE059:03A0",
   "jp": "こうでもしないと\n俺の気がすまないんでね",
   "en": ""
  },
  {
   "id": "MESSAGE059:03B7",
   "jp": "抵抗しない方が身のためだゼ",
   "en": ""
  },
  {
   "id": "MESSAGE059:03C9",
   "jp": "故郷のみんな…ごめん",
   "en": ""
  },
  {
   "id": "MESSAGE059:03D6",
   "jp": "信じられるのは己の力のみ\n…か",
   "en": ""
  },
  {
   "id": "MESSAGE059:03E9",
   "jp": "信じられるのは己の力だけ\n…か",
   "en": ""
  },
  {
   "id": "MESSAGE059:03FC",
   "jp": "仕方ないの…\nこれは、戦いなんだから…",
   "en": ""
  },
  {
   "id": "MESSAGE059:0413",
   "jp": "これ以上の抵抗は無意味だ",
   "en": ""
  },
  {
   "id": "MESSAGE059:0427",
   "jp": "俺様に逆らうんじゃねぇッ!",
   "en": ""
  },
  {
   "id": "MESSAGE059:0438",
   "jp": "勝負あったようじゃな",
   "en": ""
  },
  {
   "id": "MESSAGE059:0445",
   "jp": "もう、降参して!",
   "en": ""
  },
  {
   "id": "MESSAGE059:0450",
   "jp": "抵抗はやめろ!",
   "en": ""
  },
  {
   "id": "MESSAGE059:045A",
   "jp": "これは男の戦いなんだっ!",
   "en": ""
  },
  {
   "id": "MESSAGE059:0469",
   "jp": "ボク、本気なんだから!",
   "en": ""
  },
  {
   "id": "MESSAGE059:0477",
   "jp": "降参しなよ!",
   "en": ""
  },
  {
   "id": "MESSAGE059:0480",
   "jp": "ちょっと複雑な気分だな…",
   "en": ""
  },
  {
   "id": "MESSAGE059:0491",
   "jp": "さーて、仕事仕事!",
   "en": ""
  },
  {
   "id": "MESSAGE059:049F",
   "jp": "…………",
   "en": ""
  },
  {
   "id": "MESSAGE059:04A4",
   "jp": "任務なのです",
   "en": ""
  },
  {
   "id": "MESSAGE059:04AD",
   "jp": "残念だったわね…",
   "en": ""
  },
  {
   "id": "MESSAGE059:04B8",
   "jp": "私が正しき道へと\n導いて差し上げましょう",
   "en": ""
  },
  {
   "id": "MESSAGE059:04D2",
   "jp": "一応、手加減したわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE059:04E3",
   "jp": "クケケケッ!",
   "en": ""
  },
  {
   "id": "MESSAGE059:04EA",
   "jp": "グォォォォォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE059:04F3",
   "jp": "グォォォォォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE059:04FC",
   "jp": "そこまでになさって\nくださいな",
   "en": ""
  }
 ]
}
