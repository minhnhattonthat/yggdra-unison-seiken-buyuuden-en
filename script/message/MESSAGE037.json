{
 "file": "MESSAGE037.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE037:04C0",
   "jp": "焔帝の名は\nダテじゃない…か……",
   "en": "So the Flame Emperor\nlives up to his name..."
  },
  {
   "id": "MESSAGE037:04D4",
   "jp": "くそっ、オレ様負け犬かよ…",
   "en": "Damn... the great me,\na sorry loser...?"
  },
  {
   "id": "MESSAGE037:04E5",
   "jp": "モニカ…\n強くなったんだな……",
   "en": "Monica... you've\ngotten strong......"
  },
  {
   "id": "MESSAGE037:04F6",
   "jp": "許さない…絶対に許さない…",
   "en": "I will never\nforgive you... never..."
  },
  {
   "id": "MESSAGE037:0508",
   "jp": "貴様にだけは…ユグドラッ!",
   "en": "Not to you, of\nall people... Yggdra!"
  },
  {
   "id": "MESSAGE037:0518",
   "jp": "ユグドラ、貴様…ッ!",
   "en": "Yggdra, you...!"
  },
  {
   "id": "MESSAGE037:0525",
   "jp": "カナンが無事なら…\nそれで……",
   "en": "If Canaan is safe...\nthat's enough......"
  },
  {
   "id": "MESSAGE037:0537",
   "jp": "ここで…\n倒れるわけには……!",
   "en": "I cannot...\nfall here......!"
  },
  {
   "id": "MESSAGE037:0548",
   "jp": "くっそおおぉぉぉッ!",
   "en": "Daaamn iiit!"
  },
  {
   "id": "MESSAGE037:0553",
   "jp": "悔いはありませぬぞ…",
   "en": "I regret naught..."
  },
  {
   "id": "MESSAGE037:055F",
   "jp": "おのれ、暗殺者め…",
   "en": "Curse you,\nassassin..."
  },
  {
   "id": "MESSAGE037:056C",
   "jp": "ニーチェの負け…",
   "en": "Nietzsche lost..."
  },
  {
   "id": "MESSAGE037:0576",
   "jp": "エメローネ様…",
   "en": "Emelone-sama..."
  },
  {
   "id": "MESSAGE037:057F",
   "jp": "貴方には…敵いませんね……",
   "en": "I am no match...\nfor you......"
  },
  {
   "id": "MESSAGE037:0590",
   "jp": "へへっ…いっちょまえに\n成長しやがって……",
   "en": "Heh... look at you,\nall grown up......"
  },
  {
   "id": "MESSAGE037:05A8",
   "jp": "親分、やっぱり強ぇや…",
   "en": "Boss, you're\nstrong as ever..."
  },
  {
   "id": "MESSAGE037:05B7",
   "jp": "何てぇお嬢ちゃんだ…",
   "en": "Some little missy\nyou are..."
  },
  {
   "id": "MESSAGE037:05C4",
   "jp": "流石は神様じゃ…",
   "en": "Truly a god,\nthat one, heh..."
  },
  {
   "id": "MESSAGE037:05D0",
   "jp": "お兄様には…\nかなわないわ……",
   "en": "I'm no match...\nfor Big Brother......"
  },
  {
   "id": "MESSAGE037:05E2",
   "jp": "ちょ…ちょっとは\n手加減しなさいよ!",
   "en": "H-hey... go a little\neasier on me!"
  },
  {
   "id": "MESSAGE037:05F8",
   "jp": "細腕のくせに\n大したもんだな…",
   "en": "For such skinny\narms, not bad..."
  },
  {
   "id": "MESSAGE037:060B",
   "jp": "くそ、オイラの賞金が…",
   "en": "Damn, my bounty..."
  },
  {
   "id": "MESSAGE037:0619",
   "jp": "兄さ…ん……",
   "en": "Broth...er......"
  },
  {
   "id": "MESSAGE037:0621",
   "jp": "見事だ…エレナ……",
   "en": "Well done...\nElena......"
  },
  {
   "id": "MESSAGE037:062D",
   "jp": "強いわね、貴方…",
   "en": "You're strong,\naren't you..."
  },
  {
   "id": "MESSAGE037:0639",
   "jp": "ふざけたことを…ッ!",
   "en": "Such insolence...!"
  },
  {
   "id": "MESSAGE037:0644",
   "jp": "この恩知らずが…!",
   "en": "You ingrate...!"
  },
  {
   "id": "MESSAGE037:0650",
   "jp": "ヒィィ!　やめてくれぇ!",
   "en": "Eeeek!\nStop it, pleeease!"
  },
  {
   "id": "MESSAGE037:065D",
   "jp": "絶対に認めないわよ…",
   "en": "I'll never\naccept this..."
  },
  {
   "id": "MESSAGE037:066B",
   "jp": "さ、さすがだわ…",
   "en": "I-impressive..."
  },
  {
   "id": "MESSAGE037:0674",
   "jp": "も~やだ~!",
   "en": "Ughhh, no fair~!"
  },
  {
   "id": "MESSAGE037:067B",
   "jp": "ク…クワァ……ァ…",
   "en": "Ku... Kwaaa......a..."
  },
  {
   "id": "MESSAGE037:0685",
   "jp": "グォ…グオァ……ァ…",
   "en": "Gro... Groaa......a..."
  },
  {
   "id": "MESSAGE037:0690",
   "jp": "グワォ…グワォォォ~……ッ",
   "en": "Grwao...\nGrwaooo~......!"
  },
  {
   "id": "MESSAGE037:069E",
   "jp": "さすがは我が妹だ…",
   "en": "As expected of\nmy sister..."
  },
  {
   "id": "MESSAGE037:06AA",
   "jp": "さすがは軍神ですわ…",
   "en": "The God of War,\nas expected, dear..."
  },
  {
   "id": "MESSAGE037:06B6",
   "jp": "まさかここまで\n力を持っていたとは…",
   "en": "I never imagined\nyou had such power..."
  }
 ]
}
