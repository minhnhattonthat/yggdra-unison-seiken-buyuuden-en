  },
  {
   "id": "MESSAGE037:057F",
   "jp": "貴方には…敵いませんね……",
   "en": ""
  },
  {
   "id": "MESSAGE037:0590",
   "jp": "へへっ…いっちょまえに\n成長しやがって……",
   "en": ""
  },
  {
   "id": "MESSAGE037:05A8",
   "jp": "親分、やっぱり強ぇや…",
