 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE093:0460",
   "jp": "砲台は俺たちがもらった!\n遠慮はしないぜ?",
   "en": "Cannon's ours! We\nwon't hold back, eh?"
  },
  {
   "id": "MESSAGE093:047B",
   "jp": "砲台を占領したゼ",
   "en": "Took the cannon,\ny'know."
  },
  {
   "id": "MESSAGE093:0488",
   "jp": "砲台は…もらった!",
   "en": "The cannon... is ours!"
  },
  {
   "id": "MESSAGE093:0494",
   "jp": "砲台は頂きます…!",
   "en": "I will take the\ncannon...!"
  },
  {
   "id": "MESSAGE093:04A1",
   "jp": "…砲台はもらった!",
   "en": "...The cannon is ours!"
  },
  {
   "id": "MESSAGE093:04AD",
   "jp": "…使わせてもらう!",
   "en": "...I'll make use of it!"
  },
  {
   "id": "MESSAGE093:04B8",
   "jp": "悪いけど、使わせてもらうわ",
   "en": "Sorry, but we're using\nthis."
  },
  {
   "id": "MESSAGE093:04C8",
   "jp": "砲台を確保しました",
   "en": "The cannon is\nsecured."
  },
  {
   "id": "MESSAGE093:04D6",
   "jp": "死にたいヤツは前に出な!",
   "en": ""
  },
  {
   "id": "MESSAGE093:04E6",
   "jp": "砲台を確保いたしましたぞ",
   "en": "I have secured the\ncannon, milord."
  },
  {
   "id": "MESSAGE093:04F7",
   "jp": "許せ…!",
   "en": "Forgive me...!"
  },
  {
   "id": "MESSAGE093:04FD",
   "jp": "砲台、もらっちゃうよ?",
   "en": "Nietzsche's taking\nthe cannon, okay?"
  },
  {
   "id": "MESSAGE093:050B",
   "jp": "砲台制圧だ",
   "en": "Cannon taken."
  },
  {
   "id": "MESSAGE093:0515",
   "jp": "ここを渡す訳には\nまいりません…!",
   "en": "I cannot hand this\nplace over...!"
  },
  {
   "id": "MESSAGE093:0529",
   "jp": "ほ…砲台制圧です!",
   "en": "C-cannon taken, sir!"
  },
  {
   "id": "MESSAGE093:0537",
   "jp": "こりゃあ元から\nワシのもんじゃあ!",
   "en": "This was mine to\nbegin with, ya hear!"
  },
  {
   "id": "MESSAGE093:054A",
   "jp": "すまんが、これは渡せんぞい",
   "en": "Sorry, sonny, can't\nhand this over!"
  },
  {
   "id": "MESSAGE093:0559",
   "jp": "みんな、抵抗しないで!",
   "en": "Everyone, don't\nresist!"
  },
  {
   "id": "MESSAGE093:0567",
   "jp": "悪いけど、これはもらうよ!",
   "en": "Sorry, but I'm takin'\nthis!"
  },
  {
   "id": "MESSAGE093:0576",
   "jp": "先に制圧するぞ!",
   "en": "We take it first!"
  },
  {
   "id": "MESSAGE093:0582",
   "jp": "砲台はオイラのもんだ!",
   "en": "The cannon's mine!"
  },
  {
   "id": "MESSAGE093:0590",
   "jp": "砲台…入手しました……",
   "en": "The cannon... has\nbeen obtained..."
  },
  {
   "id": "MESSAGE093:05A0",
   "jp": "砲台を奪取!",
   "en": "Cannon seized!"
  },
  {
   "id": "MESSAGE093:05AB",
   "jp": "使わせないわ…",
   "en": "I won't let you use it..."
  },
  {
   "id": "MESSAGE093:05B4",
   "jp": "砲台はもらうぞ…!",
   "en": "The cannon is mine...!"
  },
  {
   "id": "MESSAGE093:05C0",
   "jp": "神の尖兵たる我らにこそ\n相応しい武器だ!",
   "en": "A weapon fit only for\nus, God's vanguard!"
  },
  {
   "id": "MESSAGE093:05DC",
   "jp": "だ、誰にも渡さんぞ!",
   "en": "N-no one's getting\nthis!"
  },
  {
   "id": "MESSAGE093:05E9",
   "jp": "悪いけど、押さえさせて\nもらうわ…!",
   "en": "Sorry, darling, but I'll\nbe holding this...!"
  },
  {
   "id": "MESSAGE093:05FE",
   "jp": "うふふ…これは私にこそ\n相応しい武器!",
   "en": "Ufufu... A weapon\nworthy of me alone!"
  },
  {
   "id": "MESSAGE093:0616",
   "jp": "全てのものはパメラ様の\nもの~!",
   "en": "Everything belongs\nto Pamela-sama~!"
  },
  {
   "id": "MESSAGE093:0629",
   "jp": "クケ~ッ!",
   "en": "Kukeh~!"
  },
  {
   "id": "MESSAGE093:062F",
   "jp": "グォォォゥン!",
   "en": "Groooan!"
  },
  {
   "id": "MESSAGE093:0637",
   "jp": "グワォォォゥン!",
   "en": "Grwaaoon!"
  },
  {
   "id": "MESSAGE093:0640",
   "jp": "ここは押さえねばならん!",
   "en": "We must hold this\nplace!"
  },
  {
   "id": "MESSAGE093:064E",
   "jp": "手は抜きませんわ",
   "en": "I won't go easy on\nyou."
  },
  {
   "id": "MESSAGE093:0659",
   "jp": "これは私たちが\n頂くことにしますよ…",
   "en": "We'll be taking this\nfor ourselves..."
  }
 ]
