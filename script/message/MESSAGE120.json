 "strings": [
  {
   "id": "MESSAGE120:04B0",
   "jp": "悪いが、諦めてもらうよ",
   "en": ""
  },
  {
   "id": "MESSAGE120:04BE",
   "jp": "いい加減諦めるんだな!",
   "en": ""
  },
  {
   "id": "MESSAGE120:04CD",
   "jp": "観念するんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:04D7",
   "jp": "どうか諦めてください",
   "en": ""
  },
  {
   "id": "MESSAGE120:04E3",
   "jp": "我らの勝利だ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:04EE",
   "jp": "我らの勝利だ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:04F9",
   "jp": "終わったみたいね?",
   "en": ""
  },
  {
   "id": "MESSAGE120:0504",
   "jp": "無駄なことです。\nおやめなさい!",
   "en": ""
  },
  {
   "id": "MESSAGE120:0517",
   "jp": "クックック…\nチェックメイトだ",
   "en": ""
  },
  {
   "id": "MESSAGE120:0527",
   "jp": "我らの前にこのような\n抵抗など無意味じゃ",
   "en": ""
  },
  {
   "id": "MESSAGE120:0543",
   "jp": "無益な抵抗を…",
   "en": ""
  },
  {
   "id": "MESSAGE120:054F",
   "jp": "終わったみたいだよ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:055B",
   "jp": "要らぬ抵抗をするから…",
   "en": ""
  },
  {
   "id": "MESSAGE120:056A",
   "jp": "ここから出ておいきなさい",
   "en": ""
  },
  {
   "id": "MESSAGE120:0578",
   "jp": "とっとと\nここから出ていきな!",
   "en": ""
  },
  {
   "id": "MESSAGE120:0589",
   "jp": "これでどうだっ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:0592",
   "jp": "さて、お宝を頂くとするか!",
   "en": ""
  },
  {
   "id": "MESSAGE120:05A2",
   "jp": "さて、戦利品はどこじゃ?",
   "en": ""
  },
  {
   "id": "MESSAGE120:05B2",
   "jp": "よかった、\nみんなを守れたよ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:05C3",
   "jp": "よしっ、制圧したよ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:05D0",
   "jp": "これで分かっただろ?",
   "en": ""
  },
  {
   "id": "MESSAGE120:05DC",
   "jp": "ラッキー!\n制圧したぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:05EB",
   "jp": "…守りきりました",
   "en": ""
  },
  {
   "id": "MESSAGE120:05F5",
   "jp": "敵の拠点を制圧。\n任務完了",
   "en": ""
  },
  {
   "id": "MESSAGE120:060C",
   "jp": "逆らわないのなら\n優しくしてあげるわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE120:0623",
   "jp": "負けを認めることだ",
   "en": ""
  },
  {
   "id": "MESSAGE120:062F",
   "jp": "神に逆らうとは愚かな…",
   "en": ""
  },
  {
   "id": "MESSAGE120:063D",
   "jp": "か、改宗完了じゃあ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:064C",
   "jp": "害虫駆除ってやつね?",
   "en": ""
  },
  {
   "id": "MESSAGE120:065B",
   "jp": "さあ、覚悟はできたかしら?\nうふふ…",
   "en": ""
  },
  {
   "id": "MESSAGE120:0670",
   "jp": "パメラ様は強いでしょ?",
   "en": ""
  },
  {
   "id": "MESSAGE120:067E",
   "jp": "ケーッケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:0688",
   "jp": "グォーッグォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:0692",
   "jp": "グワォーッグワォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE120:069E",
   "jp": "フン、無駄なあがきを…",
   "en": ""
  },
  {
   "id": "MESSAGE120:06AC",
   "jp": "旗が無いので…振るものは\nエプロンでもいいかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE120:06C9",
   "jp": "最初から結果は分かって\nいましたよ?　フフフ…",
   "en": ""
  },
  {
   "id": "MESSAGE120:06E6",
   "jp": "勝ったな…",
   "en": ""
  },
  {
   "id": "MESSAGE120:06ED",
   "jp": "勝負あり!",
   "en": ""
  }
 ]
