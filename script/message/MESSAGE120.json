{
 "file": "MESSAGE120.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE120:04B0",
   "jp": "悪いが、諦めてもらうよ",
   "en": "Sorry, but you'll\nhave to give up."
  },
  {
   "id": "MESSAGE120:04BE",
   "jp": "いい加減諦めるんだな!",
   "en": "Just give up already!"
  },
  {
   "id": "MESSAGE120:04CD",
   "jp": "観念するんだ!",
   "en": "Give it up!"
  },
  {
   "id": "MESSAGE120:04D7",
   "jp": "どうか諦めてください",
   "en": "Please, surrender."
  },
  {
   "id": "MESSAGE120:04E3",
   "jp": "我らの勝利だ!",
   "en": "Victory is ours!"
  },
  {
   "id": "MESSAGE120:04EE",
   "jp": "我らの勝利だ!",
   "en": "Victory is ours!"
  },
  {
   "id": "MESSAGE120:04F9",
   "jp": "終わったみたいね?",
   "en": "Looks like it's over."
  },
  {
   "id": "MESSAGE120:0504",
   "jp": "無駄なことです。\nおやめなさい!",
   "en": "It is futile.\nDesist at once!"
  },
  {
   "id": "MESSAGE120:0517",
   "jp": "クックック…\nチェックメイトだ",
   "en": "Heh heh heh...\nCheckmate."
  },
  {
   "id": "MESSAGE120:0527",
   "jp": "我らの前にこのような\n抵抗など無意味じゃ",
   "en": "Before us, such\nresistance is in vain!"
  },
  {
   "id": "MESSAGE120:0543",
   "jp": "無益な抵抗を…",
   "en": "Such pointless\nresistance..."
  },
  {
   "id": "MESSAGE120:054F",
   "jp": "終わったみたいだよ!",
   "en": "Looks like it's over!"
  },
  {
   "id": "MESSAGE120:055B",
   "jp": "要らぬ抵抗をするから…",
   "en": "Needless resistance\nearns you this..."
  },
  {
   "id": "MESSAGE120:056A",
   "jp": "ここから出ておいきなさい",
   "en": "Please leave this\nplace."
  },
  {
   "id": "MESSAGE120:0578",
   "jp": "とっとと\nここから出ていきな!",
   "en": "Now get outta here!"
  },
  {
   "id": "MESSAGE120:0589",
   "jp": "これでどうだっ!",
   "en": "How's that!"
  },
  {
   "id": "MESSAGE120:0592",
   "jp": "さて、お宝を頂くとするか!",
   "en": "Now, time to grab\nthe loot!"
  },
  {
   "id": "MESSAGE120:05A2",
   "jp": "さて、戦利品はどこじゃ?",
   "en": "Now, where's the\nloot, eh?"
  },
  {
   "id": "MESSAGE120:05B2",
   "jp": "よかった、\nみんなを守れたよ!",
   "en": "Phew, I protected\neveryone!"
  },
  {
   "id": "MESSAGE120:05C3",
   "jp": "よしっ、制圧したよ!",
   "en": "Alright, it's ours!"
  },
  {
   "id": "MESSAGE120:05D0",
   "jp": "これで分かっただろ?",
   "en": "Get the picture now?"
  },
  {
   "id": "MESSAGE120:05DC",
   "jp": "ラッキー!\n制圧したぜ!",
   "en": "Lucky!\nThe place is mine!"
  },
  {
   "id": "MESSAGE120:05EB",
   "jp": "…守りきりました",
   "en": "...I held it."
  },
  {
   "id": "MESSAGE120:05F5",
   "jp": "敵の拠点を制圧。\n任務完了",
   "en": "Enemy base taken.\nMission complete."
  },
  {
   "id": "MESSAGE120:060C",
   "jp": "逆らわないのなら\n優しくしてあげるわよ?",
   "en": "Don't resist, and\nI'll be gentle, hm?"
  },
  {
   "id": "MESSAGE120:0623",
   "jp": "負けを認めることだ",
   "en": "Admit your defeat."
  },
  {
   "id": "MESSAGE120:062F",
   "jp": "神に逆らうとは愚かな…",
   "en": "Fools, to defy God..."
  },
  {
   "id": "MESSAGE120:063D",
   "jp": "か、改宗完了じゃあ!",
   "en": "C-conversion\ncomplete, I say!"
  },
  {
   "id": "MESSAGE120:064C",
   "jp": "害虫駆除ってやつね?",
   "en": "Pest control,\nwouldn't you say?"
  },
  {
   "id": "MESSAGE120:065B",
   "jp": "さあ、覚悟はできたかしら?\nうふふ…",
   "en": "Now, are you ready?\nUfufu..."
  },
  {
   "id": "MESSAGE120:0670",
   "jp": "パメラ様は強いでしょ?",
   "en": "Pamela-sama's tough,\nright?"
  },
  {
   "id": "MESSAGE120:067E",
   "jp": "ケーッケッケッケ!",
   "en": "Keeh-kekekeh!"
  },
  {
   "id": "MESSAGE120:0688",
   "jp": "グォーッグォーッ!",
   "en": "Groah! Groah!"
  },
  {
   "id": "MESSAGE120:0692",
   "jp": "グワォーッグワォーッ!",
   "en": "Grwaah! Grwaah!"
  },
  {
   "id": "MESSAGE120:069E",
   "jp": "フン、無駄なあがきを…",
   "en": "Hmph. Futile\nstruggling..."
  },
  {
   "id": "MESSAGE120:06AC",
   "jp": "旗が無いので…振るものは\nエプロンでもいいかしら?",
   "en": "No flag... May I wave\nmy apron instead?"
  },
  {
   "id": "MESSAGE120:06C9",
   "jp": "最初から結果は分かって\nいましたよ?　フフフ…",
   "en": "I knew the outcome\nall along. Heh heh..."
  },
  {
   "id": "MESSAGE120:06E6",
   "jp": "勝ったな…",
   "en": "We won..."
  },
  {
   "id": "MESSAGE120:06ED",
   "jp": "勝負あり!",
   "en": "Match over!"
  }
 ]
}
