{
 "file": "MESSAGE046.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE046:04F0",
   "jp": "ま…こんなもんだろ",
   "en": "Well... that'll do."
  },
  {
   "id": "MESSAGE046:04FA",
   "jp": "へっ、ザマねぇな!",
   "en": "Heh, serves ya right!"
  },
  {
   "id": "MESSAGE046:0504",
   "jp": "やったぞ!",
   "en": "I did it!"
  },
  {
   "id": "MESSAGE046:050A",
   "jp": "退けたわ!",
   "en": "We drove them back!"
  },
  {
   "id": "MESSAGE046:0511",
   "jp": "たわいもない…",
   "en": "Too easy..."
  },
  {
   "id": "MESSAGE046:0519",
   "jp": "ザコに用は無い",
   "en": "I've no use for\nsmall fry."
  },
  {
   "id": "MESSAGE046:0523",
   "jp": "こんなの、大したこと無いわ",
   "en": "That was nothing\nspecial."
  },
  {
   "id": "MESSAGE046:0533",
   "jp": "無駄です!",
   "en": "It is futile!"
  },
  {
   "id": "MESSAGE046:053B",
   "jp": "クズが…",
   "en": "Trash..."
  },
  {
   "id": "MESSAGE046:0540",
   "jp": "御免!",
   "en": "Forgive me!"
  },
  {
   "id": "MESSAGE046:0546",
   "jp": "悪には屈しない!",
   "en": "I shall not yield\nto evil!"
  },
  {
   "id": "MESSAGE046:0551",
   "jp": "やったぁ!",
   "en": "Yaaay!"
  },
  {
   "id": "MESSAGE046:0557",
   "jp": "未熟者め!",
   "en": "Unskilled fool!"
  },
  {
   "id": "MESSAGE046:0560",
   "jp": "抵抗はおやめなさい",
   "en": "Cease your\nresistance."
  },
  {
   "id": "MESSAGE046:056C",
   "jp": "いっちょあがり!",
   "en": "One down!"
  },
  {
   "id": "MESSAGE046:0575",
   "jp": "やりましたぜ、親分!",
   "en": "I did it, Boss!"
  },
  {
   "id": "MESSAGE046:0582",
   "jp": "野郎ども!\nこのまま突っ切るぞぉ!",
   "en": "Ya lugs!\nPlow through 'em!"
  },
  {
   "id": "MESSAGE046:0598",
   "jp": "ガハハハ!　楽勝楽勝!",
   "en": "Gwahahaha! Easy\npeasy!"
  },
  {
   "id": "MESSAGE046:05A8",
   "jp": "ボクの敵じゃないね!",
   "en": "You're no match\nfor me!"
  },
  {
   "id": "MESSAGE046:05B4",
   "jp": "ざっとこんな感じ?",
   "en": "How's that, huh?"
  },
  {
   "id": "MESSAGE046:05BF",
   "jp": "さあ、先を急ごうか",
   "en": "Now, let's hurry on."
  },
  {
   "id": "MESSAGE046:05CB",
   "jp": "邪魔してくれるなよ!",
   "en": "Don't get in my way!"
  },
  {
   "id": "MESSAGE046:05D8",
   "jp": "勝利…しました……",
   "en": "I have... won......"
  },
  {
   "id": "MESSAGE046:05E4",
   "jp": "フッ、たわいもない…",
   "en": "Hmph. Too easy..."
  },
  {
   "id": "MESSAGE046:05EF",
   "jp": "おどきなさい…",
   "en": "Step aside..."
  },
  {
   "id": "MESSAGE046:05F7",
   "jp": "格が違うのだ",
   "en": "You are beneath me."
  },
  {
   "id": "MESSAGE046:0600",
   "jp": "失せるがいい!",
   "en": "Begone!"
  },
  {
   "id": "MESSAGE046:0609",
   "jp": "よ、寄るな!",
   "en": "S-stay back!"
  },
  {
   "id": "MESSAGE046:0611",
   "jp": "ちょろいものね",
   "en": "That was a breeze."
  },
  {
   "id": "MESSAGE046:0619",
   "jp": "そんなにヤケドしたいの?",
   "en": "Want to get burned\nthat badly?"
  },
  {
   "id": "MESSAGE046:0626",
   "jp": "パメラ様は強いのよ!?",
   "en": "Pamela-sama is\nstrong, ya know!?"
  },
  {
   "id": "MESSAGE046:0634",
   "jp": "ケケケーッ!",
   "en": "Kekekeeh!"
  },
  {
   "id": "MESSAGE046:063B",
   "jp": "グォォーーーッ!",
   "en": "Grooooooh!"
  },
  {
   "id": "MESSAGE046:0644",
   "jp": "グワォォーーーッ!",
   "en": "Grwaoooooh!"
  },
  {
   "id": "MESSAGE046:064E",
   "jp": "ザコは引っ込んでいろ!",
   "en": "Out of my way,\nsmall fry!"
  },
  {
   "id": "MESSAGE046:065C",
   "jp": "あら、もうお仕舞いですの?",
   "en": "Oh my, finished\nalready?"
  },
  {
   "id": "MESSAGE046:066C",
   "jp": "目障りです…",
   "en": "You are an eyesore..."
  },
  {
   "id": "MESSAGE046:0675",
   "jp": "や、やった!",
   "en": "I-I did it!"
  },
  {
   "id": "MESSAGE046:067C",
   "jp": "どきなさい!",
   "en": "Step aside!"
  }
 ]
}
