{
 "file": "MESSAGE038.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE038:04C0",
   "jp": "その信念には負けたよ…",
   "en": "Your conviction\nbeat me..."
  },
  {
   "id": "MESSAGE038:04CF",
   "jp": "チクショウ…\nガイコツは苦手なんだよ……",
   "en": "Dammit...\nI hate skeletons......"
  },
  {
   "id": "MESSAGE038:04E6",
   "jp": "さすが…です",
   "en": "You are...\nimpressive."
  },
  {
   "id": "MESSAGE038:04ED",
   "jp": "さすがね、デュラン…",
   "en": "Well done,\nDurant..."
  },
  {
   "id": "MESSAGE038:04F8",
   "jp": "お見事…です",
   "en": "Splendid...\nwork."
  },
  {
   "id": "MESSAGE038:0501",
   "jp": "これが焔帝の力…か……",
   "en": "The Flame Emperor's\npower... so this is it..."
  },
  {
   "id": "MESSAGE038:0510",
   "jp": "当然…よね……",
   "en": "Of course...\nyou would......"
  },
  {
   "id": "MESSAGE038:051A",
   "jp": "志半ばだと…いうのに……",
   "en": "With my purpose\nstill unfulfilled......"
  },
  {
   "id": "MESSAGE038:0529",
   "jp": "エレナ…貴様ぁ……ッ!!",
   "en": "Elena...\nyou......!!"
  },
  {
   "id": "MESSAGE038:0538",
   "jp": "これが天賦の才能…か",
   "en": "So this is\nnatural genius..."
  },
  {
   "id": "MESSAGE038:0547",
   "jp": "こんな無様な…",
   "en": "How disgraceful..."
  },
  {
   "id": "MESSAGE038:0551",
   "jp": "力、入らないよ…",
   "en": "Nietzsche's got\nno strength left..."
  },
  {
   "id": "MESSAGE038:055C",
   "jp": "私がお前に負けるなど…ッ",
   "en": "That I would lose\nto you...!"
  },
  {
   "id": "MESSAGE038:056B",
   "jp": "わたくしの負け…ですね……",
   "en": "I have...\nlost......"
  },
  {
   "id": "MESSAGE038:057A",
   "jp": "キリエ、お前…\nやっぱり怪力だな……",
   "en": "Kylier, you...\nare one strong girl..."
  },
  {
   "id": "MESSAGE038:0590",
   "jp": "姐さん、やっぱり強ぇや…",
   "en": "Sis, you're\nstrong as ever..."
  },
  {
   "id": "MESSAGE038:059F",
   "jp": "恩を忘れおって…!",
   "en": "Forgettin' all\nI did for ya...!"
  },
  {
   "id": "MESSAGE038:05AB",
   "jp": "こ、こんな若造に…",
   "en": "B-beaten by\na whippersnapper..."
  },
  {
   "id": "MESSAGE038:05B7",
   "jp": "なんて乱暴な王女なの…",
   "en": "What a violent\nprincess..."
  },
  {
   "id": "MESSAGE038:05C7",
   "jp": "アンタにだけは\n負けたくなかったのに…",
   "en": "You're the last one\nI wanted to lose to..."
  },
  {
   "id": "MESSAGE038:05DC",
   "jp": "油断していたかもな…",
   "en": "Guess I got\ncareless..."
  },
  {
   "id": "MESSAGE038:05E9",
   "jp": "お、お前何者だ…!?",
   "en": "Wh-who the hell\nare you...!?"
  },
  {
   "id": "MESSAGE038:05F7",
   "jp": "ジルヴァ…様……",
   "en": "Zilva-sama......"
  },
  {
   "id": "MESSAGE038:0601",
   "jp": "さすがは…皇帝陛下……",
   "en": "Impressive...\nYour Majesty......"
  },
  {
   "id": "MESSAGE038:0610",
   "jp": "ユベロン様…私は……",
   "en": "Juvelon-sama...\nI......"
  },
  {
   "id": "MESSAGE038:061C",
   "jp": "創造者に逆らうなど…!",
   "en": "Defying your\ncreator...!"
  },
  {
   "id": "MESSAGE038:062C",
   "jp": "生意気なガキが…!",
   "en": "Insolent brat...!"
  },
  {
   "id": "MESSAGE038:0639",
   "jp": "な、何故じゃ!?",
   "en": "Wh-why!?"
  },
  {
   "id": "MESSAGE038:0644",
   "jp": "何て恩知らずな子なの…",
   "en": "What an\nungrateful child..."
  },
  {
   "id": "MESSAGE038:0654",
   "jp": "くっ、軽く見ていたわ…",
   "en": "Ugh, I took\nyou lightly..."
  },
  {
   "id": "MESSAGE038:0662",
   "jp": "ごめーん、許してぇ~!",
   "en": "Sorryyy,\nforgive meee~!"
  },
  {
   "id": "MESSAGE038:066F",
   "jp": "ク…ケケ~……",
   "en": "Ku... Kekeh~......"
  },
  {
   "id": "MESSAGE038:0677",
   "jp": "グォ…グォォ~……",
   "en": "Gro... Grooh~......"
  },
  {
   "id": "MESSAGE038:0681",
   "jp": "グワォ…グワォォォ~……!",
   "en": "Grwao...\nGrwaooo~......!"
  },
  {
   "id": "MESSAGE038:068F",
   "jp": "こ、この俺が\n倒されるなど…!",
   "en": "Th-that I would\nbe defeated...!"
  },
  {
   "id": "MESSAGE038:06A1",
   "jp": "あなたの胸の中で息絶える\nことが出来るのなら…",
   "en": "If I can breathe my\nlast in your arms..."
  },
  {
   "id": "MESSAGE038:06BF",
   "jp": "さすがは焔帝です…",
   "en": "Truly the\nFlame Emperor..."
  }
 ]
}
