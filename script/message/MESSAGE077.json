 "strings": [
  {
   "id": "MESSAGE077:04C0",
   "jp": "何やってるんだろ、俺…",
   "en": "What am I even\ndoing..."
  },
  {
   "id": "MESSAGE077:04CE",
   "jp": "イヤな予感が的中したゼ…",
   "en": "Knew I had a bad\nfeelin' 'bout this..."
  },
  {
   "id": "MESSAGE077:04DF",
   "jp": "やっぱりか…",
   "en": "I knew it..."
  },
  {
   "id": "MESSAGE077:04E6",
   "jp": "力が…入らない……",
   "en": "My strength...\nis gone......"
  },
  {
   "id": "MESSAGE077:04F2",
   "jp": "くうっ…!",
   "en": "Nngh...!"
  },
  {
   "id": "MESSAGE077:04F8",
   "jp": "ちっ…!",
   "en": "Tch...!"
  },
  {
   "id": "MESSAGE077:04FD",
   "jp": "やっぱり無理よ…",
   "en": "It's no use\nafter all..."
  },
  {
   "id": "MESSAGE077:0508",
   "jp": "正義の無い戦いなど…",
   "en": "A battle without\njustice..."
  },
  {
   "id": "MESSAGE077:0517",
   "jp": "な、なんだと…ッ!?",
   "en": "Wh-what?!"
  },
  {
   "id": "MESSAGE077:0522",
   "jp": "心に迷いがあったのか…?",
   "en": "Was there doubt in\nmy heart...?"
  },
  {
   "id": "MESSAGE077:0531",
   "jp": "な、何と…",
   "en": "Wh-what...?"
  },
  {
   "id": "MESSAGE077:0538",
   "jp": "やる気しないよ~…",
   "en": "I don't wanna~..."
  },
  {
   "id": "MESSAGE077:0543",
   "jp": "予想はしていたが…",
   "en": "I expected this,\nbut..."
  },
  {
   "id": "MESSAGE077:054F",
   "jp": "これ以上は…",
   "en": "No more..."
  },
  {
   "id": "MESSAGE077:0558",
   "jp": "やっぱり気分が乗らねーや…",
   "en": "Man, I just ain't\nfeelin' it..."
  },
  {
   "id": "MESSAGE077:0569",
   "jp": "もう帰りてえよ…",
   "en": "I wanna go home\nalready..."
  },
  {
   "id": "MESSAGE077:0573",
   "jp": "のわっ…何とぉ……",
   "en": "Nwaah... What the...!"
  },
  {
   "id": "MESSAGE077:057E",
   "jp": "今日は厄日じゃのう…",
   "en": "Today's just an\nunlucky day, eh..."
  },
  {
   "id": "MESSAGE077:058D",
   "jp": "もうやだよ…",
   "en": "I don't wanna do this\nanymore..."
  },
  {
   "id": "MESSAGE077:0594",
   "jp": "何てことなの…",
   "en": "How could this\nhappen..."
  },
  {
   "id": "MESSAGE077:059D",
   "jp": "こりゃあダメだな…",
   "en": "This is no good..."
  },
  {
   "id": "MESSAGE077:05A7",
   "jp": "アンラッキーだぜ…",
   "en": "Tough luck, man..."
  },
  {
   "id": "MESSAGE077:05B1",
   "jp": "もう…戦えない……",
   "en": "I can't... fight\nanymore..."
  },
  {
   "id": "MESSAGE077:05BC",
   "jp": "くっ…",
   "en": "Ngh..."
  },
  {
   "id": "MESSAGE077:05C0",
   "jp": "ああっ…",
   "en": ""
  },
  {
   "id": "MESSAGE077:05C5",
   "jp": "だめか…",
   "en": ""
  },
  {
   "id": "MESSAGE077:05CA",
   "jp": "じ、実にくだらん…!",
   "en": "H-how utterly\nabsurd...!"
  },
  {
   "id": "MESSAGE077:05D6",
   "jp": "や、やめてくれえ!",
   "en": "S-stop, I beg you!"
  },
  {
   "id": "MESSAGE077:05E0",
   "jp": "やってられないわよ…",
   "en": "I can't put up with\nthis!"
  },
  {
   "id": "MESSAGE077:05EB",
   "jp": "やる気しなかったのよ…",
   "en": "I just wasn't in the\nmood, you know..."
  },
  {
   "id": "MESSAGE077:05F8",
   "jp": "これはきっと悪い夢よぉ…",
   "en": "This has gotta be a\nbad dreeeam..."
  },
  {
   "id": "MESSAGE077:0607",
   "jp": "ケ…ケ~……",
   "en": "Ke... Keeh..."
  },
  {
   "id": "MESSAGE077:060E",
   "jp": "グォ…グォォォ~……",
   "en": ""
  },
  {
   "id": "MESSAGE077:0619",
   "jp": "グワォ…グワォォォ~……",
   "en": "Grwao...\nGrwaooo~......"
  },
  {
   "id": "MESSAGE077:0626",
   "jp": "しまった…!",
   "en": ""
  },
  {
   "id": "MESSAGE077:062D",
   "jp": "嫌ですわ、こんな…",
   "en": ""
  },
  {
   "id": "MESSAGE077:0638",
   "jp": "油断があったのですか…?\nこの私にも……",
   "en": "Was I careless...?\nEven I..."
  }
 ]
