{
 "file": "MESSAGE115.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE115:0480",
   "jp": "さて…どうしてくれようか",
   "en": ""
  },
  {
   "id": "MESSAGE115:048D",
   "jp": "口ほどにもねぇヤツらだゼ!",
   "en": ""
  },
  {
   "id": "MESSAGE115:049C",
   "jp": "拠点を…落としました",
   "en": ""
  },
  {
   "id": "MESSAGE115:04AA",
   "jp": "観念してください!",
   "en": ""
  },
  {
   "id": "MESSAGE115:04B6",
   "jp": "無様だな、ユグドラ!",
   "en": ""
  },
  {
   "id": "MESSAGE115:04C3",
   "jp": "無様なものだな、ユグドラ!",
   "en": ""
  },
  {
   "id": "MESSAGE115:04D3",
   "jp": "カナン…貴方の負けよ……",
   "en": ""
  },
  {
   "id": "MESSAGE115:04E3",
   "jp": "私には王国を守る義務が\nあるのです…",
   "en": ""
  },
  {
   "id": "MESSAGE115:04FB",
   "jp": "もう後はねえぜ、焔帝殿?",
   "en": ""
  },
  {
   "id": "MESSAGE115:050C",
   "jp": "手強い相手であった…",
   "en": ""
  },
  {
   "id": "MESSAGE115:051B",
   "jp": "さっさと立ち去れ。\nさすれば深追いはしない",
   "en": ""
  },
  {
   "id": "MESSAGE115:0535",
   "jp": "女王様、ごめんなさい…",
   "en": "My Queen...\nI'm so sorry..."
  },
  {
   "id": "MESSAGE115:0544",
   "jp": "エメローネ様…\n申し訳ございません",
   "en": ""
  },
  {
   "id": "MESSAGE115:0559",
   "jp": "貴方はよく戦いました…",
   "en": ""
  },
  {
   "id": "MESSAGE115:0568",
   "jp": "出直してくるんだな。\nいつでも相手してやるぜ?",
   "en": ""
  },
  {
   "id": "MESSAGE115:0584",
   "jp": "親分、すまねえっ!",
   "en": ""
  },
  {
   "id": "MESSAGE115:0590",
   "jp": "へっへ、\n賞金はワシらのもんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE115:05A3",
   "jp": "神をも屠る男!\nといったところかのう?",
   "en": ""
  },
  {
   "id": "MESSAGE115:05B9",
   "jp": "どうしたの…?　いつもの\nお兄様じゃないみたい…",
   "en": ""
  },
  {
   "id": "MESSAGE115:05D4",
   "jp": "ウチの方が上手だった\nみたいね?",
   "en": ""
  },
  {
   "id": "MESSAGE115:05E8",
   "jp": "ま、諦めてくれよな",
   "en": ""
  },
  {
   "id": "MESSAGE115:05F3",
   "jp": "一攫千金は\n男のロマンだよな!",
   "en": "Striking it rich is\na man's dream, eh!"
  },
  {
   "id": "MESSAGE115:0608",
   "jp": "兄さん…ごめんなさい",
   "en": ""
  },
  {
   "id": "MESSAGE115:0614",
   "jp": "勝負あったな…エレナ",
   "en": ""
  },
  {
   "id": "MESSAGE115:0621",
   "jp": "貴方、生意気なのよ…",
   "en": ""
  },
  {
   "id": "MESSAGE115:0631",
   "jp": "フン…まだ抗うか?",
   "en": ""
  },
  {
   "id": "MESSAGE115:063C",
   "jp": "私の時代が始まるのだ!",
   "en": ""
  },
  {
   "id": "MESSAGE115:064B",
   "jp": "わ、わしには神が\nついておる!",
   "en": ""
  },
  {
   "id": "MESSAGE115:065B",
   "jp": "あたしに従うなら\n悪いようにはしないわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE115:0673",
   "jp": "貴方、それでも皇帝なの?",
   "en": ""
  },
  {
   "id": "MESSAGE115:0684",
   "jp": "つ~かまえたっ!",
   "en": ""
  },
  {
   "id": "MESSAGE115:068D",
   "jp": "ケーッケッケッケ!!",
   "en": ""
  },
  {
   "id": "MESSAGE115:0698",
   "jp": "グォ!　グォォォォォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE115:06A6",
   "jp": "グワォーッグワォォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE115:06B3",
   "jp": "勝利を掴まねば\n意味は無いのだぞ?",
   "en": ""
  },
  {
   "id": "MESSAGE115:06CB",
   "jp": "少しは溜飲を下げて\n頂けたかしら~?",
   "en": ""
  },
  {
   "id": "MESSAGE115:06E2",
   "jp": "聖剣の力を以ってしても\nその程度でしたか…",
   "en": ""
  }
 ]
}
