{
 "file": "MESSAGE209.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE209:04C0",
   "jp": "欲をかくと\nロクなことが無いからな",
   "en": ""
  },
  {
   "id": "MESSAGE209:04D4",
   "jp": "こんなボロに宝が\n入ってるとは思えねぇが…",
   "en": ""
  },
  {
   "id": "MESSAGE209:04ED",
   "jp": "あ、ツギハギのあとがある…",
   "en": ""
  },
  {
   "id": "MESSAGE209:04FB",
   "jp": "この袋、穴が開いている\nようだけど…大丈夫かしら",
   "en": ""
  },
  {
   "id": "MESSAGE209:051A",
   "jp": "本当に、\nこの袋でよかったのか…?",
   "en": ""
  },
  {
   "id": "MESSAGE209:052F",
   "jp": "本当に、\nこの袋でいいのか…?",
   "en": ""
  },
  {
   "id": "MESSAGE209:0542",
   "jp": "これ、\n穴とか開いてないかしら…?",
   "en": ""
  },
  {
   "id": "MESSAGE209:0556",
   "jp": "この袋、なにやら\nすり切れているようですが…",
   "en": ""
  },
  {
   "id": "MESSAGE209:056F",
   "jp": "けっ、みすぼらしい袋だぜ",
   "en": ""
  },
  {
   "id": "MESSAGE209:057D",
   "jp": "これはまた、\n年季の入った代物じゃな",
   "en": ""
  },
  {
   "id": "MESSAGE209:0595",
   "jp": "…うーむ",
   "en": ""
  },
  {
   "id": "MESSAGE209:059A",
   "jp": "ニーチェ、この袋がいい♪",
   "en": ""
  },
  {
   "id": "MESSAGE209:05A8",
   "jp": "少々ほこりっぽいな…この袋",
   "en": ""
  },
  {
   "id": "MESSAGE209:05B9",
   "jp": "これにしておきましょう",
   "en": ""
  },
  {
   "id": "MESSAGE209:05C5",
   "jp": "ま、中身もどうせ\nガラクタだろうけどな…",
   "en": ""
  },
  {
   "id": "MESSAGE209:05DC",
   "jp": "何だか見慣れた袋だな…",
   "en": ""
  },
  {
   "id": "MESSAGE209:05EC",
   "jp": "案外、掘り出し物が\n入ってるかも知れねぇぞぉ?",
   "en": ""
  },
  {
   "id": "MESSAGE209:060B",
   "jp": "…ノーコメントじゃ",
   "en": ""
  },
  {
   "id": "MESSAGE209:0615",
   "jp": "こんな袋でいいのかなあ…",
   "en": ""
  },
  {
   "id": "MESSAGE209:0623",
   "jp": "なんかこれ…\nかびくさくない?",
   "en": ""
  },
  {
   "id": "MESSAGE209:0633",
   "jp": "まあ、\n何も無いよりはマシだろ",
   "en": ""
  },
  {
   "id": "MESSAGE209:0645",
   "jp": "見かけによらず、すっげぇ\n宝が入ってたりしてな!",
   "en": ""
  },
  {
   "id": "MESSAGE209:0661",
   "jp": "…………",
   "en": ""
  },
  {
   "id": "MESSAGE209:0666",
   "jp": "イチかバチか…",
   "en": ""
  },
  {
   "id": "MESSAGE209:066E",
   "jp": "…仕方ないわ……",
   "en": ""
  },
  {
   "id": "MESSAGE209:0679",
   "jp": "少々薄汚れているが…",
   "en": ""
  },
  {
   "id": "MESSAGE209:0688",
   "jp": "フン、何が神だ…",
   "en": ""
  },
  {
   "id": "MESSAGE209:0692",
   "jp": "うっ…この袋、\n汚れとるではないか!",
   "en": ""
  },
  {
   "id": "MESSAGE209:06A7",
   "jp": "ずいぶんと\nお粗末な袋だけど…",
   "en": ""
  },
  {
   "id": "MESSAGE209:06BA",
   "jp": "間違い無く、\n火器は期待できないわね…",
   "en": ""
  },
  {
   "id": "MESSAGE209:06D5",
   "jp": "薄汚れてるけど…見た目に\nだまされちゃいけないわ~",
   "en": ""
  },
  {
   "id": "MESSAGE209:06F3",
   "jp": "ケケッ…",
   "en": ""
  },
  {
   "id": "MESSAGE209:06F8",
   "jp": "…グォ?",
   "en": ""
  },
  {
   "id": "MESSAGE209:06FD",
   "jp": "…グワォ?",
   "en": ""
  },
  {
   "id": "MESSAGE209:0703",
   "jp": "…こんな場所で\n時間をつぶしている暇は無い",
   "en": ""
  },
  {
   "id": "MESSAGE209:071F",
   "jp": "あらあら、ずいぶんと\n質素な袋ですわね~",
   "en": ""
  },
  {
   "id": "MESSAGE209:0737",
   "jp": "フフフ…\nこれは何のゴミですか?",
   "en": ""
  }
 ]
}
