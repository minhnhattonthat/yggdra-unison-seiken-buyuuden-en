{
 "file": "MESSAGE135.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE135:0480",
   "jp": "くっ…覚悟を決めるしか\n無さそうだな……",
   "en": ""
  },
  {
   "id": "MESSAGE135:0499",
   "jp": "オレ様を殺しても\n何の得も無いゼ?",
   "en": ""
  },
  {
   "id": "MESSAGE135:04B0",
   "jp": "やめろ…放せッ!!",
   "en": ""
  },
  {
   "id": "MESSAGE135:04BB",
   "jp": "無礼な。は、放しなさい!",
   "en": ""
  },
  {
   "id": "MESSAGE135:04CB",
   "jp": "私に触れるな、\n無礼者がッ!",
   "en": ""
  },
  {
   "id": "MESSAGE135:04DE",
   "jp": "無礼者が…\n私に触れるなッ!",
   "en": ""
  },
  {
   "id": "MESSAGE135:04F1",
   "jp": "やめて!　放してよッ!",
   "en": ""
  },
  {
   "id": "MESSAGE135:04FE",
   "jp": "恥をさらす気などない!",
   "en": ""
  },
  {
   "id": "MESSAGE135:050C",
   "jp": "っざけんな!　放しやがれ!",
   "en": ""
  },
  {
   "id": "MESSAGE135:051B",
   "jp": "これ以上生き恥をさらすのは\n耐えられぬ",
   "en": ""
  },
  {
   "id": "MESSAGE135:0534",
   "jp": "我らは誇り高き聖騎士。\n降伏はせんぞ",
   "en": ""
  },
  {
   "id": "MESSAGE135:054F",
   "jp": "ニーチェ、食べても\nおいしくないよ~っ!?",
   "en": ""
  },
  {
   "id": "MESSAGE135:0566",
   "jp": "貴様に捕まるなど…ッ",
   "en": ""
  },
  {
   "id": "MESSAGE135:0574",
   "jp": "これ以上辱めを受ける\nいわれはありません",
   "en": ""
  },
  {
   "id": "MESSAGE135:058D",
   "jp": "てめぇ、何しやがる!\n放せ!",
   "en": ""
  },
  {
   "id": "MESSAGE135:059E",
   "jp": "このっ、放せよっ!",
   "en": ""
  },
  {
   "id": "MESSAGE135:05A9",
   "jp": "ワシをどうする気だ!?",
   "en": ""
  },
  {
   "id": "MESSAGE135:05B6",
   "jp": "た、助けてくれい…",
   "en": ""
  },
  {
   "id": "MESSAGE135:05C1",
   "jp": "やだっ、近寄らないでよ!",
   "en": ""
  },
  {
   "id": "MESSAGE135:05D0",
   "jp": "ウチのこと、どうする気よ?",
   "en": ""
  },
  {
   "id": "MESSAGE135:05DF",
   "jp": "まるで悪夢だよ…",
   "en": ""
  },
  {
   "id": "MESSAGE135:05EA",
   "jp": "アンラッキーにも\nほどがあるよなぁ…",
   "en": ""
  },
  {
   "id": "MESSAGE135:05FD",
   "jp": "…………!",
   "en": ""
  },
  {
   "id": "MESSAGE135:0603",
   "jp": "寄るな…ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE135:060B",
   "jp": "好きになさい…",
   "en": ""
  },
  {
   "id": "MESSAGE135:0614",
   "jp": "くっ…私に触れるな!",
   "en": ""
  },
  {
   "id": "MESSAGE135:0620",
   "jp": "異端者の言葉は聞こえんな",
   "en": ""
  },
  {
   "id": "MESSAGE135:0633",
   "jp": "頼む、許してくれ!\nわしゃ、死ぬのは嫌じゃあ!",
   "en": ""
  },
  {
   "id": "MESSAGE135:064F",
   "jp": "ちょっと、放しなさいよッ!",
   "en": ""
  },
  {
   "id": "MESSAGE135:065E",
   "jp": "まさか、貴方の前に\n膝を折ることになるなんて…",
   "en": ""
  },
  {
   "id": "MESSAGE135:067B",
   "jp": "は、反省してます…",
   "en": ""
  },
  {
   "id": "MESSAGE135:0687",
   "jp": "クケ…",
   "en": ""
  },
  {
   "id": "MESSAGE135:068B",
   "jp": "グォ…",
   "en": ""
  },
  {
   "id": "MESSAGE135:068F",
   "jp": "グワォ…",
   "en": "Grwao..."
  },
  {
   "id": "MESSAGE135:0694",
   "jp": "俺は誰にも従わぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE135:06A1",
   "jp": "あたくし、こう見えても\n頑固ですわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE135:06B8",
   "jp": "私を使いこなせると\n思っているのですか?",
   "en": ""
  }
 ]
}
