{
 "file": "MESSAGE146.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE146:0480",
   "jp": "アンタとは話が合いそうだが\n残念だよ…",
   "en": ""
  },
  {
   "id": "MESSAGE146:0498",
   "jp": "もうガイコツは\nこりごりだゼ…",
   "en": ""
  },
  {
   "id": "MESSAGE146:04A8",
   "jp": "情けをかけていただき\nありがとうございます…",
   "en": ""
  },
  {
   "id": "MESSAGE146:04C0",
   "jp": "さようなら、デュラン…",
   "en": ""
  },
  {
   "id": "MESSAGE146:04CC",
   "jp": "この屈辱を…\n永劫忘れはしない……!",
   "en": ""
  },
  {
   "id": "MESSAGE146:04E4",
   "jp": "必ず…必ずや\n貴様に後悔させてやる…!",
   "en": ""
  },
  {
   "id": "MESSAGE146:04FE",
   "jp": "逃がしてくださるのですね…\n…失礼します",
   "en": ""
  },
  {
   "id": "MESSAGE146:0516",
   "jp": "私を生かしておいたこと…\nきっと後悔するぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE146:0530",
   "jp": "これで済むと思うなよ…!",
   "en": ""
  },
  {
   "id": "MESSAGE146:053F",
   "jp": "…感謝申し上げます",
   "en": ""
  },
  {
   "id": "MESSAGE146:054D",
   "jp": "再戦の機会があれば…\n次は遅れを取らぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE146:0569",
   "jp": "じゃあ、ニーチェ行くね…",
   "en": ""
  },
  {
   "id": "MESSAGE146:0576",
   "jp": "この屈辱を忘れはしない…ッ",
   "en": ""
  },
  {
   "id": "MESSAGE146:0587",
   "jp": "お互い相容れないものは\nあるのですよ",
   "en": ""
  },
  {
   "id": "MESSAGE146:059D",
   "jp": "大した度胸だぜ…\nじゃあな",
   "en": ""
  },
  {
   "id": "MESSAGE146:05AE",
   "jp": "さらばです、姐さん…",
   "en": ""
  },
  {
   "id": "MESSAGE146:05BA",
   "jp": "次会った時は承知しねぇぞ…",
   "en": ""
  },
  {
   "id": "MESSAGE146:05CD",
   "jp": "ガハハハ!　命があれば\n贅沢は言わんぞい",
   "en": ""
  },
  {
   "id": "MESSAGE146:05E6",
   "jp": "何よっ、王女がえらそうに!",
   "en": ""
  },
  {
   "id": "MESSAGE146:05F7",
   "jp": "…フン、じゃあね!",
   "en": ""
  },
  {
   "id": "MESSAGE146:0601",
   "jp": "また会うこともあるかもな…",
   "en": ""
  },
  {
   "id": "MESSAGE146:0610",
   "jp": "な、生意気だぜ…!",
   "en": ""
  },
  {
   "id": "MESSAGE146:061D",
   "jp": "育てて頂いたご恩…\n忘れはしません……",
   "en": ""
  },
  {
   "id": "MESSAGE146:0635",
   "jp": "はっ…\n失礼します",
   "en": ""
  },
  {
   "id": "MESSAGE146:0641",
   "jp": "承知…いたしました\nさようなら、ユベロン様…",
   "en": ""
  },
  {
   "id": "MESSAGE146:065B",
   "jp": "傀儡が図に乗りおって…!",
   "en": ""
  },
  {
   "id": "MESSAGE146:066C",
   "jp": "くっ…異端者の情けなど……\n礼は言わぬぞ!?",
   "en": ""
  },
  {
   "id": "MESSAGE146:0689",
   "jp": "すまん、恩にきるぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE146:0695",
   "jp": "こんな恩知らずな子に\n育ってたなんてね…!",
   "en": ""
  },
  {
   "id": "MESSAGE146:06AF",
   "jp": "…貴方、私のこと\n馬鹿にしているでしょう?",
   "en": ""
  },
  {
   "id": "MESSAGE146:06C9",
   "jp": "らっきー♪",
   "en": ""
  },
  {
   "id": "MESSAGE146:06CF",
   "jp": "ク、クケッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE146:06D7",
   "jp": "グ、グォッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE146:06DF",
   "jp": "グワォッ!?　グワォォォ!",
   "en": ""
  },
  {
   "id": "MESSAGE146:06ED",
   "jp": "貴様…この屈辱は忘れぬ!\n覚えておくがいい!",
   "en": ""
  },
  {
   "id": "MESSAGE146:070A",
   "jp": "ご一緒出来なくて\n残念ですわ~",
   "en": ""
  },
  {
   "id": "MESSAGE146:0720",
   "jp": "貴方のことは…\n忘れませんよ?",
   "en": ""
  }
 ]
}
