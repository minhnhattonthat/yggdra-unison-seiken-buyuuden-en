{
 "file": "MESSAGE049.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE049:0490",
   "jp": "ま、大人しくするんだな",
   "en": "Well, just stay down."
  },
  {
   "id": "MESSAGE049:049E",
   "jp": "恨みっこなしだゼ?",
   "en": "No hard feelin's,\nya hear?"
  },
  {
   "id": "MESSAGE049:04A9",
   "jp": "倒したか…",
   "en": "Beat them..."
  },
  {
   "id": "MESSAGE049:04B0",
   "jp": "これが、戦争なの…",
   "en": "So this is... war..."
  },
  {
   "id": "MESSAGE049:04BC",
   "jp": "是非も無し…",
   "en": "It cannot be helped..."
  },
  {
   "id": "MESSAGE049:04C6",
   "jp": "因果なものだな…",
   "en": "A cruel twist of\nfate..."
  },
  {
   "id": "MESSAGE049:04D1",
   "jp": "後悔なんかしてないわ…!",
   "en": "I don't regret it...!"
  },
  {
   "id": "MESSAGE049:04E0",
   "jp": "撃破に成功しました…",
   "en": "I have defeated the\nenemy..."
  },
  {
   "id": "MESSAGE049:04EF",
   "jp": "カスどもに用はねぇ!",
   "en": "I got no use\nfor scum!"
  },
  {
   "id": "MESSAGE049:04FB",
   "jp": "撃破いたしましたが…",
   "en": "The foe is\nvanquished, and yet..."
  },
  {
   "id": "MESSAGE049:0508",
   "jp": "勝ったけど…",
   "en": "Nietzsche won, but..."
  },
  {
   "id": "MESSAGE049:0510",
   "jp": "悪く思わないでくれ…",
   "en": "Do not think\nill of me..."
  },
  {
   "id": "MESSAGE049:051D",
   "jp": "勝負ありましたね…",
   "en": "The match is\ndecided..."
  },
  {
   "id": "MESSAGE049:0529",
   "jp": "昨日の共は明日の敵…\nだったかな?",
   "en": "Friend yesterday, foe\ntomorrow... was it?"
  },
  {
   "id": "MESSAGE049:0541",
   "jp": "おめぇらもまだまだだな!",
   "en": "You whelps still got\na ways to go!"
  },
  {
   "id": "MESSAGE049:054E",
   "jp": "守り神様はワシの味方じゃ!",
   "en": "The guardian god's\non my side, heh!"
  },
  {
   "id": "MESSAGE049:0560",
   "jp": "ボクたち、今は敵同士だよ",
   "en": "We're enemies now,\nyou know."
  },
  {
   "id": "MESSAGE049:0571",
   "jp": "これでよかったのかな…?",
   "en": "Was this really\nright...?"
  },
  {
   "id": "MESSAGE049:057E",
   "jp": "振り返らないって決めたんだ",
   "en": "I decided not\nto look back."
  },
  {
   "id": "MESSAGE049:058F",
   "jp": "オイラのお通りだぜ!",
   "en": "Make way for me!"
  },
  {
   "id": "MESSAGE049:059B",
   "jp": "…これも任務なんです",
   "en": "...It is part of my\nmission."
  },
  {
   "id": "MESSAGE049:05A8",
   "jp": "道を空けてもらおう",
   "en": "Clear the way."
  },
  {
   "id": "MESSAGE049:05B4",
   "jp": "おイタは駄目よ?",
   "en": "No being\nnaughty, now."
  },
  {
   "id": "MESSAGE049:05BF",
   "jp": "負けられんのだ…",
   "en": "I cannot lose..."
  },
  {
   "id": "MESSAGE049:05C9",
   "jp": "どけ!",
   "en": "Move!"
  },
  {
   "id": "MESSAGE049:05CD",
   "jp": "し、死なずに済んだが…",
   "en": "W-well, I didn't die,\nbut..."
  },
  {
   "id": "MESSAGE049:05DB",
   "jp": "どうしてあんたを\n倒さなきゃいけないのよ…!",
   "en": "Why did I have to\nstrike you down...!"
  },
  {
   "id": "MESSAGE049:05F3",
   "jp": "抵抗しないでちょうだい",
   "en": "Don't resist,\nwill you?"
  },
  {
   "id": "MESSAGE049:0601",
   "jp": "残念だったわね~",
   "en": "Too bad for you~"
  },
  {
   "id": "MESSAGE049:060C",
   "jp": "ケケケ…",
   "en": "Kekeke..."
  },
  {
   "id": "MESSAGE049:0611",
   "jp": "グォッ!",
   "en": "Groh!"
  },
  {
   "id": "MESSAGE049:0616",
   "jp": "グワォーッ!",
   "en": "Grwaooh!"
  },
  {
   "id": "MESSAGE049:061D",
   "jp": "相手が悪かったな",
   "en": "You picked\nthe wrong foe."
  },
  {
   "id": "MESSAGE049:0629",
   "jp": "苦情は他の方に\nお願いしますわ~",
   "en": "Take complaints\nelsewhere, dear~"
  },
  {
   "id": "MESSAGE049:063F",
   "jp": "私の力をご存じないとは…",
   "en": "So you knew nothing\nof my power..."
  }
 ]
}
