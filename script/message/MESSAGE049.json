{
 "file": "MESSAGE049.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE049:0490",
   "jp": "ま、大人しくするんだな",
   "en": ""
  },
  {
   "id": "MESSAGE049:049E",
   "jp": "恨みっこなしだゼ?",
   "en": ""
  },
  {
   "id": "MESSAGE049:04A9",
   "jp": "倒したか…",
   "en": ""
  },
  {
   "id": "MESSAGE049:04B0",
   "jp": "これが、戦争なの…",
   "en": ""
  },
  {
   "id": "MESSAGE049:04BC",
   "jp": "是非も無し…",
   "en": ""
  },
  {
   "id": "MESSAGE049:04C6",
   "jp": "因果なものだな…",
   "en": ""
  },
  {
   "id": "MESSAGE049:04D1",
   "jp": "後悔なんかしてないわ…!",
   "en": ""
  },
  {
   "id": "MESSAGE049:04E0",
   "jp": "撃破に成功しました…",
   "en": ""
  },
  {
   "id": "MESSAGE049:04EF",
   "jp": "カスどもに用はねぇ!",
   "en": ""
  },
  {
   "id": "MESSAGE049:04FB",
   "jp": "撃破いたしましたが…",
   "en": ""
  },
  {
   "id": "MESSAGE049:0508",
   "jp": "勝ったけど…",
   "en": ""
  },
  {
   "id": "MESSAGE049:0510",
   "jp": "悪く思わないでくれ…",
   "en": ""
  },
  {
   "id": "MESSAGE049:051D",
   "jp": "勝負ありましたね…",
   "en": ""
  },
  {
   "id": "MESSAGE049:0529",
   "jp": "昨日の共は明日の敵…\nだったかな?",
   "en": ""
  },
  {
   "id": "MESSAGE049:0541",
   "jp": "おめぇらもまだまだだな!",
   "en": ""
  },
  {
   "id": "MESSAGE049:054E",
   "jp": "守り神様はワシの味方じゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE049:0560",
   "jp": "ボクたち、今は敵同士だよ",
   "en": ""
  },
  {
   "id": "MESSAGE049:0571",
   "jp": "これでよかったのかな…?",
   "en": ""
  },
  {
   "id": "MESSAGE049:057E",
   "jp": "振り返らないって決めたんだ",
   "en": ""
  },
  {
   "id": "MESSAGE049:058F",
   "jp": "オイラのお通りだぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE049:059B",
   "jp": "…これも任務なんです",
   "en": ""
  },
  {
   "id": "MESSAGE049:05A8",
   "jp": "道を空けてもらおう",
   "en": ""
  },
  {
   "id": "MESSAGE049:05B4",
   "jp": "おイタは駄目よ?",
   "en": ""
  },
  {
   "id": "MESSAGE049:05BF",
   "jp": "負けられんのだ…",
   "en": ""
  },
  {
   "id": "MESSAGE049:05C9",
   "jp": "どけ!",
   "en": ""
  },
  {
   "id": "MESSAGE049:05CD",
   "jp": "し、死なずに済んだが…",
   "en": ""
  },
  {
   "id": "MESSAGE049:05DB",
   "jp": "どうしてあんたを\n倒さなきゃいけないのよ…!",
   "en": ""
  },
  {
   "id": "MESSAGE049:05F3",
   "jp": "抵抗しないでちょうだい",
   "en": ""
  },
  {
   "id": "MESSAGE049:0601",
   "jp": "残念だったわね~",
   "en": ""
  },
  {
   "id": "MESSAGE049:060C",
   "jp": "ケケケ…",
   "en": ""
  },
  {
   "id": "MESSAGE049:0611",
   "jp": "グォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE049:0616",
   "jp": "グワォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE049:061D",
   "jp": "相手が悪かったな",
   "en": ""
  },
  {
   "id": "MESSAGE049:0629",
   "jp": "苦情は他の方に\nお願いしますわ~",
   "en": ""
  },
  {
   "id": "MESSAGE049:063F",
   "jp": "私の力をご存じないとは…",
   "en": ""
  }
 ]
}
