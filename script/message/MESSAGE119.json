{
 "file": "MESSAGE119.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE119:04B0",
   "jp": "こっちにも意地があるんでね",
   "en": ""
  },
  {
   "id": "MESSAGE119:04C0",
   "jp": "オレ様に不可能はねぇんだよ",
   "en": ""
  },
  {
   "id": "MESSAGE119:04D2",
   "jp": "やった、\n敵から守りきったぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE119:04E4",
   "jp": "聖剣の加護を信じましょう!",
   "en": ""
  },
  {
   "id": "MESSAGE119:04F7",
   "jp": "己が無力さを思い知るがいい",
   "en": ""
  },
  {
   "id": "MESSAGE119:050A",
   "jp": "己が無力さを思い知れ",
   "en": ""
  },
  {
   "id": "MESSAGE119:051A",
   "jp": "これでもう、\nあんたたちは何もできないわ",
   "en": ""
  },
  {
   "id": "MESSAGE119:0530",
   "jp": "出ていってもらおう!",
   "en": ""
  },
  {
   "id": "MESSAGE119:053C",
   "jp": "ククッ…逃がさねえぜ?",
   "en": ""
  },
  {
   "id": "MESSAGE119:0549",
   "jp": "もう少し骨のある連中かと\n思っておったぞ…",
   "en": ""
  },
  {
   "id": "MESSAGE119:0564",
   "jp": "攻略成功だ!",
   "en": ""
  },
  {
   "id": "MESSAGE119:056F",
   "jp": "少しは役に立てたかな?",
   "en": ""
  },
  {
   "id": "MESSAGE119:057E",
   "jp": "制圧したぞッ!",
   "en": ""
  },
  {
   "id": "MESSAGE119:0588",
   "jp": "信念の勝利といえましょう",
   "en": ""
  },
  {
   "id": "MESSAGE119:0599",
   "jp": "二度とここに\n来るんじゃねーぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE119:05AD",
   "jp": "何だ、たいしたことねえな!",
   "en": ""
  },
  {
   "id": "MESSAGE119:05BC",
   "jp": "まだブチのめし足りねぇが…",
   "en": ""
  },
  {
   "id": "MESSAGE119:05CB",
   "jp": "ガハハハ!\n無駄な努力じゃったのう!",
   "en": ""
  },
  {
   "id": "MESSAGE119:05E2",
   "jp": "何度攻めてきたって\n無駄だよ!",
   "en": ""
  },
  {
   "id": "MESSAGE119:05F7",
   "jp": "日頃の行いってやつかな?",
   "en": ""
  },
  {
   "id": "MESSAGE119:0606",
   "jp": "向かうところ敵なし!",
   "en": ""
  },
  {
   "id": "MESSAGE119:0613",
   "jp": "へっへーんだ!\n思い知ったか!",
   "en": ""
  },
  {
   "id": "MESSAGE119:0625",
   "jp": "…守り抜きました",
   "en": ""
  },
  {
   "id": "MESSAGE119:0630",
   "jp": "諦めよ",
   "en": ""
  },
  {
   "id": "MESSAGE119:0635",
   "jp": "フフ…無様なものね",
   "en": ""
  },
  {
   "id": "MESSAGE119:0641",
   "jp": "この私に勝てるとでも?",
   "en": ""
  },
  {
   "id": "MESSAGE119:064E",
   "jp": "神よ、感謝致します!",
   "en": ""
  },
  {
   "id": "MESSAGE119:065C",
   "jp": "や、やったぞ…!",
   "en": ""
  },
  {
   "id": "MESSAGE119:0665",
   "jp": "散々いきがってこの程度?",
   "en": ""
  },
  {
   "id": "MESSAGE119:0676",
   "jp": "威勢がいいのは\n口だけなのかしら?",
   "en": ""
  },
  {
   "id": "MESSAGE119:068B",
   "jp": "パメラ様、最強♪",
   "en": ""
  },
  {
   "id": "MESSAGE119:0697",
   "jp": "ケーッケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE119:06A1",
   "jp": "グォーッグォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE119:06AB",
   "jp": "グワォーッグワォーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE119:06B7",
   "jp": "身の程を知れッ!",
   "en": "Know your place!"
  },
  {
   "id": "MESSAGE119:06C3",
   "jp": "もう、お仕舞いですの?",
   "en": ""
  },
  {
   "id": "MESSAGE119:06D1",
   "jp": "分を弁えるべきですね…\nフフフ…",
   "en": ""
  },
  {
   "id": "MESSAGE119:06E4",
   "jp": "恐れいったか!",
   "en": ""
  },
  {
   "id": "MESSAGE119:06ED",
   "jp": "当然の報い、ってね",
   "en": ""
  }
 ]
}
