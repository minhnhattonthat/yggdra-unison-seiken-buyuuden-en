{
 "file": "MESSAGE097.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE097:04B0",
   "jp": "これを渡す訳にはいかないな",
   "en": "I can't let you\nhave this."
  },
  {
   "id": "MESSAGE097:04C0",
   "jp": "砲台は使わせねぇゼ!",
   "en": "Ya ain't usin' the\ncannon!"
  },
  {
   "id": "MESSAGE097:04CE",
   "jp": "砲台は渡さないぞ!",
   "en": "You won't get the\ncannon!"
  },
  {
   "id": "MESSAGE097:04DB",
   "jp": "これで砲台は使えないわ",
   "en": "Now the cannon is\nuseless."
  },
  {
   "id": "MESSAGE097:04EA",
   "jp": "これで使い物になるまい!",
   "en": "That should render it\nuseless!"
  },
  {
   "id": "MESSAGE097:04F9",
   "jp": "残念だったな!",
   "en": "Too bad!"
  },
  {
   "id": "MESSAGE097:0503",
   "jp": "こんなもの使われたら\nたまらないわ!",
   "en": "We can't have them\nusing this thing!"
  },
  {
   "id": "MESSAGE097:0517",
   "jp": "我らは引き下がりはしない!",
   "en": "We shall not yield!"
  },
  {
   "id": "MESSAGE097:0527",
   "jp": "まとめてブチ壊してやるぜ!",
   "en": "I'll smash it all to\npieces!"
  },
  {
   "id": "MESSAGE097:0536",
   "jp": "渡しはせぬ!",
   "en": "Thou shalt\nnot have it!"
  },
  {
   "id": "MESSAGE097:053E",
   "jp": "敵に利用される前に破壊だ!",
   "en": "Destroy it before the\nenemy can use it!"
  },
  {
   "id": "MESSAGE097:0552",
   "jp": "えいっ、壊しちゃえ!",
   "en": "Hyah! Break it!"
  },
  {
   "id": "MESSAGE097:055E",
   "jp": "破壊するんだ!",
   "en": "Destroy it!"
  },
  {
   "id": "MESSAGE097:0568",
   "jp": "これで脅威は減りました",
   "en": "That is one less\nthreat."
  },
  {
   "id": "MESSAGE097:0577",
   "jp": "使わせはしねーぜ!",
   "en": "No way you're usin'\nthis!"
  },
  {
   "id": "MESSAGE097:0582",
   "jp": "砲台は渡さねえぞ!",
   "en": "Ya ain't gettin' the\ncannon!"
  },
  {
   "id": "MESSAGE097:058F",
   "jp": "うおりゃーッ!",
   "en": "Raaaaagh!"
  },
  {
   "id": "MESSAGE097:0597",
   "jp": "敵に渡っては困るからのう!",
   "en": "Can't have the enemy\ngettin' it, eh!"
  },
  {
   "id": "MESSAGE097:05A8",
   "jp": "こんな危ないもの、\n壊しちゃえ!",
   "en": "Something this\ndangerous? Smash it!"
  },
  {
   "id": "MESSAGE097:05BB",
   "jp": "これで砲台は使えないよ!",
   "en": "Now the cannon's no\ngood to anyone!"
  },
  {
   "id": "MESSAGE097:05CB",
   "jp": "全く、物騒だよな!",
   "en": "Geez, what a nasty\nthing!"
  },
  {
   "id": "MESSAGE097:05D8",
   "jp": "おおっと危ねえ!",
   "en": "Whoa, that was\nclose!"
  },
  {
   "id": "MESSAGE097:05E2",
   "jp": "砲台…破壊しました",
   "en": "Cannon... destroyed."
  },
  {
   "id": "MESSAGE097:05F0",
   "jp": "砲台を破壊!",
   "en": "Cannon destroyed!"
  },
  {
   "id": "MESSAGE097:05FB",
   "jp": "まだやる気なの?",
   "en": "You still want more?"
  },
  {
   "id": "MESSAGE097:0605",
   "jp": "フン、甘いな!",
   "en": "Hmph. How naive!"
  },
  {
   "id": "MESSAGE097:060E",
   "jp": "このようなものがあるから\n争いが無くならんのだ!",
   "en": "Things like this are\nwhy war never ends!"
  },
  {
   "id": "MESSAGE097:0629",
   "jp": "こんなものを使われては\nわしの命が危ない…!",
   "en": "If they use this, my\nold neck's done for!"
  },
  {
   "id": "MESSAGE097:0643",
   "jp": "こんなもの壊しておしまい!",
   "en": "Smash this junk at\nonce, darling!"
  },
  {
   "id": "MESSAGE097:0652",
   "jp": "どうしても…\n壊さなきゃだめなのかしら",
   "en": "Must we really...\nbreak it, I wonder?"
  },
  {
   "id": "MESSAGE097:0667",
   "jp": "こんなの、ポーイ!",
   "en": "This thing? Buh-bye!"
  },
  {
   "id": "MESSAGE097:0671",
   "jp": "ケッケッケ!",
   "en": "Keh-keh-keh!"
  },
  {
   "id": "MESSAGE097:0678",
   "jp": "グォッグォッグォッ!",
   "en": "Gwoh! Gwoh! Gwoh!"
  },
  {
   "id": "MESSAGE097:0683",
   "jp": "グワォッグワォッ!",
   "en": "Grwaow! Grwaow!"
  },
  {
   "id": "MESSAGE097:068D",
   "jp": "使われるくらいなら\n破壊してしまえ!",
   "en": "Better destroyed\nthan used against us!"
  },
  {
   "id": "MESSAGE097:06A3",
   "jp": "撃たれるくらいなら…\n壊してしまいますわ!",
   "en": "Rather than be shot...\nI'll just break it, dear!"
  },
  {
   "id": "MESSAGE097:06BB",
   "jp": "こんなガラクタに\n用はありません…",
   "en": "I have no use for\nsuch junk..."
  },
  {
   "id": "MESSAGE097:06CE",
   "jp": "やっかいものを片付けろ!",
   "en": "Get rid of this\nnuisance!"
  },
  {
   "id": "MESSAGE097:06DD",
   "jp": "砲台は使わせない!",
   "en": "You won't use the\ncannon!"
  }
 ]
}
