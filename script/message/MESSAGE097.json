{
 "file": "MESSAGE097.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE097:04B0",
   "jp": "これを渡す訳にはいかないな",
   "en": ""
  },
  {
   "id": "MESSAGE097:04C0",
   "jp": "砲台は使わせねぇゼ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:04CE",
   "jp": "砲台は渡さないぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:04DB",
   "jp": "これで砲台は使えないわ",
   "en": ""
  },
  {
   "id": "MESSAGE097:04EA",
   "jp": "これで使い物になるまい!",
   "en": ""
  },
  {
   "id": "MESSAGE097:04F9",
   "jp": "残念だったな!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0503",
   "jp": "こんなもの使われたら\nたまらないわ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0517",
   "jp": "我らは引き下がりはしない!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0527",
   "jp": "まとめてブチ壊してやるぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0536",
   "jp": "渡しはせぬ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:053E",
   "jp": "敵に利用される前に破壊だ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0552",
   "jp": "えいっ、壊しちゃえ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:055E",
   "jp": "破壊するんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0568",
   "jp": "これで脅威は減りました",
   "en": ""
  },
  {
   "id": "MESSAGE097:0577",
   "jp": "使わせはしねーぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0582",
   "jp": "砲台は渡さねえぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:058F",
   "jp": "うおりゃーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0597",
   "jp": "敵に渡っては困るからのう!",
   "en": ""
  },
  {
   "id": "MESSAGE097:05A8",
   "jp": "こんな危ないもの、\n壊しちゃえ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:05BB",
   "jp": "これで砲台は使えないよ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:05CB",
   "jp": "全く、物騒だよな!",
   "en": ""
  },
  {
   "id": "MESSAGE097:05D8",
   "jp": "おおっと危ねえ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:05E2",
   "jp": "砲台…破壊しました",
   "en": ""
  },
  {
   "id": "MESSAGE097:05F0",
   "jp": "砲台を破壊!",
   "en": ""
  },
  {
   "id": "MESSAGE097:05FB",
   "jp": "まだやる気なの?",
   "en": ""
  },
  {
   "id": "MESSAGE097:0605",
   "jp": "フン、甘いな!",
   "en": ""
  },
  {
   "id": "MESSAGE097:060E",
   "jp": "このようなものがあるから\n争いが無くならんのだ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0629",
   "jp": "こんなものを使われては\nわしの命が危ない…!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0643",
   "jp": "こんなもの壊しておしまい!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0652",
   "jp": "どうしても…\n壊さなきゃだめなのかしら",
   "en": ""
  },
  {
   "id": "MESSAGE097:0667",
   "jp": "こんなの、ポーイ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0671",
   "jp": "ケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0678",
   "jp": "グォッグォッグォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:0683",
   "jp": "グワォッグワォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:068D",
   "jp": "使われるくらいなら\n破壊してしまえ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:06A3",
   "jp": "撃たれるくらいなら…\n壊してしまいますわ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:06BB",
   "jp": "こんなガラクタに\n用はありません…",
   "en": ""
  },
  {
   "id": "MESSAGE097:06CE",
   "jp": "やっかいものを片付けろ!",
   "en": ""
  },
  {
   "id": "MESSAGE097:06DD",
   "jp": "砲台は使わせない!",
   "en": ""
  }
 ]
}
