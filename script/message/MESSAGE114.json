{
 "file": "MESSAGE114.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE114:0240",
   "jp": "もう、時間は\n残されていないわ…",
   "en": "There is no time\nleft..."
  },
  {
   "id": "MESSAGE114:0254",
   "jp": "力及ばず…無念!",
   "en": "I fell short... Alas!"
  },
  {
   "id": "MESSAGE114:0261",
   "jp": "間に合わなかったようですね",
   "en": "It seems we were too\nlate."
  },
  {
   "id": "MESSAGE114:0271",
   "jp": "何てこった…!",
   "en": "Dammit all...!"
  },
  {
   "id": "MESSAGE114:027A",
   "jp": "ちっ…時間がかかり過ぎたか",
   "en": "Tch... took too damn\nlong, did I?"
  },
  {
   "id": "MESSAGE114:028B",
   "jp": "うぬう、時間切れじゃな…",
   "en": "Grr, outta time, eh..."
  },
  {
   "id": "MESSAGE114:029B",
   "jp": "くっ、何ということだ…!",
   "en": "Ngh, how can this\nbe...!"
  },
  {
   "id": "MESSAGE114:02A9",
   "jp": "わ、わしはもう耐えられん!\n逃げるぞ!",
   "en": "I-I can't take any\nmore! I'm runnin'!"
  },
  {
   "id": "MESSAGE114:02BF",
   "jp": "くっ、長引きすぎたわ…",
   "en": "Ugh, this dragged on\ntoo long..."
  },
  {
   "id": "MESSAGE114:02CD",
   "jp": "いやーん、タイムアップ!?",
   "en": "Eeek, time's up!?"
  },
  {
   "id": "MESSAGE114:02DB",
   "jp": "おのれ…時間切れかッ!",
   "en": "Curses... time's up!"
  },
  {
   "id": "MESSAGE114:02EA",
   "jp": "意外に手間取ったようです…",
   "en": "That took longer\nthan I expected..."
  }
 ]
}
