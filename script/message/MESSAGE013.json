{
 "file": "MESSAGE013.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE013:04B0",
   "jp": "ま、ほどほどにやるか",
   "en": "Well, let's not\noverdo it."
  },
  {
   "id": "MESSAGE013:04BB",
   "jp": "よっしゃ、行くゼ!",
   "en": "Alright, let's go!"
  },
  {
   "id": "MESSAGE013:04C5",
   "jp": "カナン、出撃します!",
   "en": "Canaan, heading out!"
  },
  {
   "id": "MESSAGE013:04D2",
   "jp": "この聖剣に正義を誓います!",
   "en": "By this Holy Sword,\nI vow justice!"
  },
  {
   "id": "MESSAGE013:04E5",
   "jp": "敵地を奪取!　いくぞ!",
   "en": "Seize their ground!\nForward!"
  },
  {
   "id": "MESSAGE013:04F5",
   "jp": "敵軍を殲滅!　いくぞ!",
   "en": "Wipe out the enemy!\nForward!"
  },
  {
   "id": "MESSAGE013:0505",
   "jp": "正々堂々、戦うわ!",
   "en": "I'll fight fair and\nsquare!"
  },
  {
   "id": "MESSAGE013:0514",
   "jp": "騎士デュラン参る!",
   "en": "Durant the knight\nadvances!"
  },
  {
   "id": "MESSAGE013:0521",
   "jp": "おらおら、いくぜぇ!",
   "en": "Outta my way!\nHere I come!"
  },
  {
   "id": "MESSAGE013:052C",
   "jp": "バルドゥス、参るぞ!",
   "en": "Baldus sets forth!"
  },
  {
   "id": "MESSAGE013:0538",
   "jp": "皆を守るために\nこの身はある!",
   "en": "I exist to protect\neveryone!"
  },
  {
   "id": "MESSAGE013:054B",
   "jp": "ニーチェ戦うよ!",
   "en": "Nietzsche will fight!"
  },
  {
   "id": "MESSAGE013:0555",
   "jp": "出陣だッ!",
   "en": "We march!"
  },
  {
   "id": "MESSAGE013:055D",
   "jp": "まいりましょう。\nわたくしたち一族のために!",
   "en": "Let us go.\nFor our people!"
  },
  {
   "id": "MESSAGE013:0576",
   "jp": "ガンガンいくぜ!",
   "en": "Let's hit 'em hard!"
  },
  {
   "id": "MESSAGE013:057F",
   "jp": "親分、見ててくだせえ!",
   "en": "Watch me, Boss!"
  },
  {
   "id": "MESSAGE013:058E",
   "jp": "おらおら、いくぞぉ!",
   "en": "Move it, move it!\nHere I come!"
  },
  {
   "id": "MESSAGE013:0599",
   "jp": "この時間が一番\nワクワクするのう!",
   "en": "This part always\ngets me fired up, eh!"
  },
  {
   "id": "MESSAGE013:05AF",
   "jp": "見ててね、お兄様!",
   "en": "Watch me,\nBig Brother!"
  },
  {
   "id": "MESSAGE013:05BC",
   "jp": "アル、いっくよー!",
   "en": "Al, here we gooo!"
  },
  {
   "id": "MESSAGE013:05C6",
   "jp": "僕の出番だな!?",
   "en": "My turn, is it!?"
  },
  {
   "id": "MESSAGE013:05D2",
   "jp": "よし、出陣するか!",
   "en": "Alright, let's\nmove out!"
  },
  {
   "id": "MESSAGE013:05DE",
   "jp": "任務を果たします!",
   "en": "I will fulfill my duty!"
  },
  {
   "id": "MESSAGE013:05EB",
   "jp": "出撃!",
   "en": "Move out!"
  },
  {
   "id": "MESSAGE013:05F1",
   "jp": "フフ…悪夢を見せてあげる…",
   "en": "Fufu... let me show\nyou a nightmare..."
  },
  {
   "id": "MESSAGE013:0602",
   "jp": "敵など恐れるに足らず!\n我に続け!",
   "en": "The enemy is nothing\nto fear! Follow me!"
  },
  {
   "id": "MESSAGE013:0619",
   "jp": "神を畏れぬ愚か者め!\n覚悟するが良い!",
   "en": "Godless fools!\nPrepare yourselves!"
  },
  {
   "id": "MESSAGE013:0633",
   "jp": "わしだって若い頃は\nそりゃ強かったもんじゃ…",
   "en": "In my youth, I was\nmighty strong, heh..."
  },
  {
   "id": "MESSAGE013:064D",
   "jp": "みんな、出撃するわよ!",
   "en": "Everyone, move out!"
  },
  {
   "id": "MESSAGE013:065B",
   "jp": "出撃するわよ!",
   "en": "Let's move out!"
  },
  {
   "id": "MESSAGE013:0665",
   "jp": "パメラ様は強いのよー!",
   "en": "Pamela-sama is\nstroooong!"
  },
  {
   "id": "MESSAGE013:0673",
   "jp": "ケケケケーケーケーッ!",
   "en": "Kekekeke-keh-keeeh!"
  },
  {
   "id": "MESSAGE013:067F",
   "jp": "グォォォーグォッ!",
   "en": "Groooo-groh!"
  },
  {
   "id": "MESSAGE013:0689",
   "jp": "グワォォォーグワォッ!",
   "en": "Grwaooo-grwaoh!"
  },
  {
   "id": "MESSAGE013:0695",
   "jp": "全軍出撃!",
   "en": "All forces, move out!"
  },
  {
   "id": "MESSAGE013:069F",
   "jp": "では、行きますわよ?",
   "en": "Shall we be off, then?"
  },
  {
   "id": "MESSAGE013:06AA",
   "jp": "愚かなる魂たちよ…\n出撃です!",
   "en": "Foolish souls...\nmove out."
  },
  {
   "id": "MESSAGE013:06BE",
   "jp": "よし!　出撃だ!",
   "en": "Right! Move out!"
  },
  {
   "id": "MESSAGE013:06C9",
   "jp": "行きます!",
   "en": "Here I go!"
  }
 ]
}
