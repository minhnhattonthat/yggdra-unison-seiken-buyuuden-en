{
 "file": "MESSAGE013.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE013:04B0",
   "jp": "ま、ほどほどにやるか",
   "en": ""
  },
  {
   "id": "MESSAGE013:04BB",
   "jp": "よっしゃ、行くゼ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:04C5",
   "jp": "カナン、出撃します!",
   "en": ""
  },
  {
   "id": "MESSAGE013:04D2",
   "jp": "この聖剣に正義を誓います!",
   "en": ""
  },
  {
   "id": "MESSAGE013:04E5",
   "jp": "敵地を奪取!　いくぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:04F5",
   "jp": "敵軍を殲滅!　いくぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0505",
   "jp": "正々堂々、戦うわ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0514",
   "jp": "騎士デュラン参る!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0521",
   "jp": "おらおら、いくぜぇ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:052C",
   "jp": "バルドゥス、参るぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0538",
   "jp": "皆を守るために\nこの身はある!",
   "en": ""
  },
  {
   "id": "MESSAGE013:054B",
   "jp": "ニーチェ戦うよ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0555",
   "jp": "出陣だッ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:055D",
   "jp": "まいりましょう。\nわたくしたち一族のために!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0576",
   "jp": "ガンガンいくぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:057F",
   "jp": "親分、見ててくだせえ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:058E",
   "jp": "おらおら、いくぞぉ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0599",
   "jp": "この時間が一番\nワクワクするのう!",
   "en": ""
  },
  {
   "id": "MESSAGE013:05AF",
   "jp": "見ててね、お兄様!",
   "en": ""
  },
  {
   "id": "MESSAGE013:05BC",
   "jp": "アル、いっくよー!",
   "en": ""
  },
  {
   "id": "MESSAGE013:05C6",
   "jp": "僕の出番だな!?",
   "en": ""
  },
  {
   "id": "MESSAGE013:05D2",
   "jp": "よし、出陣するか!",
   "en": ""
  },
  {
   "id": "MESSAGE013:05DE",
   "jp": "任務を果たします!",
   "en": ""
  },
  {
   "id": "MESSAGE013:05EB",
   "jp": "出撃!",
   "en": ""
  },
  {
   "id": "MESSAGE013:05F1",
   "jp": "フフ…悪夢を見せてあげる…",
   "en": ""
  },
  {
   "id": "MESSAGE013:0602",
   "jp": "敵など恐れるに足らず!\n我に続け!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0619",
   "jp": "神を畏れぬ愚か者め!\n覚悟するが良い!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0633",
   "jp": "わしだって若い頃は\nそりゃ強かったもんじゃ…",
   "en": ""
  },
  {
   "id": "MESSAGE013:064D",
   "jp": "みんな、出撃するわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:065B",
   "jp": "出撃するわよ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0665",
   "jp": "パメラ様は強いのよー!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0673",
   "jp": "ケケケケーケーケーッ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:067F",
   "jp": "グォォォーグォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0689",
   "jp": "グワォォォーグワォッ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:0695",
   "jp": "全軍出撃!",
   "en": ""
  },
  {
   "id": "MESSAGE013:069F",
   "jp": "では、行きますわよ?",
   "en": ""
  },
  {
   "id": "MESSAGE013:06AA",
   "jp": "愚かなる魂たちよ…\n出撃です!",
   "en": ""
  },
  {
   "id": "MESSAGE013:06BE",
   "jp": "よし!　出撃だ!",
   "en": ""
  },
  {
   "id": "MESSAGE013:06C9",
   "jp": "行きます!",
   "en": ""
  }
 ]
}
