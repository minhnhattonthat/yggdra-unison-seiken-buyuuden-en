{
 "file": "MESSAGE137.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE137:0240",
   "jp": "私たち王国軍は、\n貴方の力を必要としています",
   "en": ""
  },
  {
   "id": "MESSAGE137:025F",
   "jp": "来たるべき真の平和のため\n貴殿の力をお借りしたい",
   "en": ""
  },
  {
   "id": "MESSAGE137:0280",
   "jp": "わたくしたちは、\n貴方の力を必要としています",
   "en": ""
  },
  {
   "id": "MESSAGE137:029C",
   "jp": "お前を見込んで頼みがある。\nオレ達と一緒に来てほしい",
   "en": ""
  },
  {
   "id": "MESSAGE137:02BF",
   "jp": "おめぇ、見所があるな。\nワシの部下にならねぇか?",
   "en": ""
  },
  {
   "id": "MESSAGE137:02DB",
   "jp": "今なら間に合う。おめぇも\nドルト組に入るんじゃ!",
   "en": ""
  },
  {
   "id": "MESSAGE137:02F9",
   "jp": "貴様は我々が使ってやろう。\nどうだ?",
   "en": ""
  },
  {
   "id": "MESSAGE137:0311",
   "jp": "か、改宗するなら\n助けてやるぞ?",
   "en": ""
  },
  {
   "id": "MESSAGE137:0325",
   "jp": "そこのあんた。\nあたしに力を貸して頂戴",
   "en": ""
  },
  {
   "id": "MESSAGE137:033D",
   "jp": "あんた、パメラ様の手先に\nなりなさいっ!",
   "en": ""
  },
  {
   "id": "MESSAGE137:0355",
   "jp": "我が軍門に下れ!",
   "en": ""
  },
  {
   "id": "MESSAGE137:0361",
   "jp": "私の駒にしてあげましょう。\nどうです?",
   "en": ""
  }
 ]
}
