{
 "file": "MESSAGE152.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE152:0480",
   "jp": "これで自由になれるな…",
   "en": ""
  },
  {
   "id": "MESSAGE152:048E",
   "jp": "へっ、そうかよ。じゃあな!",
   "en": ""
  },
  {
   "id": "MESSAGE152:049C",
   "jp": "ここでお別れだな",
   "en": ""
  },
  {
   "id": "MESSAGE152:04A6",
   "jp": "そう、残念です…",
   "en": ""
  },
  {
   "id": "MESSAGE152:04B1",
   "jp": "こんな場所に用は無い…\nさらばだ!",
   "en": ""
  },
  {
   "id": "MESSAGE152:04C7",
   "jp": "私も出て行こうと\n思っていたところだ!",
   "en": ""
  },
  {
   "id": "MESSAGE152:04DD",
   "jp": "あ、そう…\nじゃあね",
   "en": ""
  },
  {
   "id": "MESSAGE152:04E8",
   "jp": "そうですか。承知しました",
   "en": ""
  },
  {
   "id": "MESSAGE152:04F7",
   "jp": "…あばよ",
   "en": ""
  },
  {
   "id": "MESSAGE152:04FC",
   "jp": "では、拙者はこれにて…",
   "en": ""
  },
  {
   "id": "MESSAGE152:050A",
   "jp": "承知しました",
   "en": ""
  },
  {
   "id": "MESSAGE152:0513",
   "jp": "もう、いいよ!",
   "en": ""
  },
  {
   "id": "MESSAGE152:051B",
   "jp": "貴様など、こちらから\n願い下げだ!",
   "en": ""
  },
  {
   "id": "MESSAGE152:0530",
   "jp": "では、失礼致します",
   "en": ""
  },
  {
   "id": "MESSAGE152:053D",
   "jp": "けっ、\nつきあってらんねーよ!",
   "en": ""
  },
  {
   "id": "MESSAGE152:054D",
   "jp": "こっちから出てってやるぜ!",
   "en": ""
  },
  {
   "id": "MESSAGE152:055C",
   "jp": "ま、縁が無かったってこった",
   "en": ""
  },
  {
   "id": "MESSAGE152:056C",
   "jp": "そうか。\nじゃあ、ワシは帰るぞい",
   "en": ""
  },
  {
   "id": "MESSAGE152:057E",
   "jp": "じゃあ、さよならね!",
   "en": ""
  },
  {
   "id": "MESSAGE152:0589",
   "jp": "そう、じゃあね!",
   "en": ""
  },
  {
   "id": "MESSAGE152:0592",
   "jp": "やっと解放されたな…",
   "en": ""
  },
  {
   "id": "MESSAGE152:059F",
   "jp": "バカにしやがって…",
   "en": ""
  },
  {
   "id": "MESSAGE152:05A9",
   "jp": "…はい",
   "en": ""
  },
  {
   "id": "MESSAGE152:05AD",
   "jp": "さらばだ…",
   "en": ""
  },
  {
   "id": "MESSAGE152:05B3",
   "jp": "私を使いこなせるのは\nユベロン様だけよ…",
   "en": ""
  },
  {
   "id": "MESSAGE152:05CA",
   "jp": "それは好都合だな。\nさらばだ",
   "en": ""
  },
  {
   "id": "MESSAGE152:05DC",
   "jp": "神をも信じぬ者たちとは\n組めぬ!　さらばだ!",
   "en": ""
  },
  {
   "id": "MESSAGE152:05F6",
   "jp": "こ、ここは性に合わん。\n他を当たるとしよう…",
   "en": ""
  },
  {
   "id": "MESSAGE152:0611",
   "jp": "あら、そう。せいせいするわ",
   "en": ""
  },
  {
   "id": "MESSAGE152:061F",
   "jp": "そう、世話になったわね!",
   "en": ""
  },
  {
   "id": "MESSAGE152:062E",
   "jp": "パメラ様を捨てるなんて…",
   "en": ""
  },
  {
   "id": "MESSAGE152:063D",
   "jp": "クケッ?",
   "en": ""
  },
  {
   "id": "MESSAGE152:0642",
   "jp": "グォーッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE152:0649",
   "jp": "グワォーッ!?",
   "en": ""
  },
  {
   "id": "MESSAGE152:0651",
   "jp": "貴様に俺は使いこなせん",
   "en": ""
  },
  {
   "id": "MESSAGE152:0661",
   "jp": "そうですの?\nでは、あたくしはこれで…",
   "en": ""
  },
  {
   "id": "MESSAGE152:0675",
   "jp": "そうですね。フフフ…\nそれが良いでしょう……",
   "en": ""
  }
 ]
}
