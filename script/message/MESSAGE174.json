{
 "file": "MESSAGE174.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE174:0560",
   "jp": "すまないが観念してもらうよ",
   "en": "Sorry, but give it up."
  },
  {
   "id": "MESSAGE174:0570",
   "jp": "悪く思わないでくれよ!",
   "en": "No hard feelings,\nokay?!"
  },
  {
   "id": "MESSAGE174:057E",
   "jp": "正義は俺たちにあるんだ!",
   "en": "Justice is on our side!"
  },
  {
   "id": "MESSAGE174:058E",
   "jp": "お願い、抵抗しないで…!",
   "en": "Please, do not\nresist...!"
  },
  {
   "id": "MESSAGE174:059E",
   "jp": "占領する…!",
   "en": "I shall take it...!"
  },
  {
   "id": "MESSAGE174:05A7",
   "jp": "占領だ…!",
   "en": "It's ours...!"
  },
  {
   "id": "MESSAGE174:05AF",
   "jp": "ここをおさえれば\n有利になるはずよ…",
   "en": "Taking this should\ngive us the edge..."
  },
  {
   "id": "MESSAGE174:05C4",
   "jp": "ここは押さえさせてもらう!",
   "en": "We shall secure this!"
  },
  {
   "id": "MESSAGE174:05D3",
   "jp": "守りに入ると俺様には\n勝てないぜ?",
   "en": "Defense won't beat\nthe great me, y'know?"
  },
  {
   "id": "MESSAGE174:05EA",
   "jp": "ここを奪うことで\n力を削ぐことが出来る…",
   "en": "Seizing this shall\nsap their strength..."
  },
  {
   "id": "MESSAGE174:0604",
   "jp": "許せ…!",
   "en": "Forgive me...!"
  },
  {
   "id": "MESSAGE174:060A",
   "jp": "ここ、もらっちゃうよ?",
   "en": "I'm taking this, 'kay?"
  },
  {
   "id": "MESSAGE174:0616",
   "jp": "よし!　占領したぞ!",
   "en": "Good! It is ours!"
  },
  {
   "id": "MESSAGE174:0623",
   "jp": "手加減は致しませんよ?",
   "en": "I shall show no\nmercy."
  },
  {
   "id": "MESSAGE174:0633",
   "jp": "使わせてたまるかよ!",
   "en": "Like I'd let ya use it!"
  },
  {
   "id": "MESSAGE174:063F",
   "jp": "使わせないでやんすよ!",
   "en": "Ya ain't usin' it, nope!"
  },
  {
   "id": "MESSAGE174:064C",
   "jp": "こりゃあ元から\nワシらのもんじゃあ!",
   "en": "This was ours\nall along, see!"
  },
  {
   "id": "MESSAGE174:0660",
   "jp": "ガハハハ!\nここは頂いた!",
   "en": "Gahahaha!\nThis is ours!"
  },
  {
   "id": "MESSAGE174:066F",
   "jp": "みんな、抵抗しないで!",
   "en": "Everyone, don't\nresist!"
  },
  {
   "id": "MESSAGE174:067D",
   "jp": "悪いけど、ここはもらうよ!",
   "en": "Sorry, but I'm takin'\nthis!"
  },
  {
   "id": "MESSAGE174:068C",
   "jp": "先に制圧するぞ!",
   "en": "We take it first!"
  },
  {
   "id": "MESSAGE174:0698",
   "jp": "ここはオイラのもんだ!",
   "en": "This is all mine!"
  },
  {
   "id": "MESSAGE174:06A4",
   "jp": "…入手しました……",
   "en": "...Acquired..."
  },
  {
   "id": "MESSAGE174:06B0",
   "jp": "奪取成功!",
   "en": "Seized!"
  },
  {
   "id": "MESSAGE174:06BA",
   "jp": "フフ…悪く思わないでね……",
   "en": "Fufu... Don't take it\npersonally..."
  },
  {
   "id": "MESSAGE174:06CA",
   "jp": "占領した!",
   "en": "Taken!"
  },
  {
   "id": "MESSAGE174:06D2",
   "jp": "神の尖兵たる我らにこそ\n使う資格があるのだ!",
   "en": "We, God's vanguard,\nalone may use this!"
  },
  {
   "id": "MESSAGE174:06EF",
   "jp": "だ、誰にも渡さんぞ!",
   "en": "N-no one's getting\nthis!"
  },
  {
   "id": "MESSAGE174:06FC",
   "jp": "悪いけど、押さえさせて\nもらうわ…!",
   "en": "Sorry, darling, but I'll\nbe holding this...!"
  },
  {
   "id": "MESSAGE174:0711",
   "jp": "うふふ…これは私にこそ\n相応しい武器!",
   "en": "Ufufu... A weapon\nworthy of me alone!"
  },
  {
   "id": "MESSAGE174:0729",
   "jp": "全てのものはパメラ様の\nもの~!",
   "en": "Everything belongs\nto Pamela-sama~!"
  },
  {
   "id": "MESSAGE174:073C",
   "jp": "クケ~ッ!",
   "en": "Kukeh~!"
  },
  {
   "id": "MESSAGE174:0742",
   "jp": "手は抜きませんわ",
   "en": "I won't go easy on\nyou."
  },
  {
   "id": "MESSAGE174:074D",
   "jp": "これは私たちが\n頂くことにしますよ…",
   "en": "We'll be taking this\nfor ourselves..."
  },
  {
   "id": "MESSAGE174:0761",
   "jp": "昨日の友は\n明日の敵ってな!",
   "en": "Yesterday's friend is\ntomorrow's foe, eh!"
  },
  {
   "id": "MESSAGE174:0776",
   "jp": "勝負あったわね",
   "en": "That settles it."
  },
  {
   "id": "MESSAGE174:0780",
   "jp": "勝負あり!",
   "en": "Match over!"
  },
  {
   "id": "MESSAGE174:0788",
   "jp": "悪く思わないでね",
   "en": "Don't take it\npersonally, okay?"
  },
  {
   "id": "MESSAGE174:0793",
   "jp": "諦めるんだな!",
   "en": "Give it up!"
  },
  {
   "id": "MESSAGE174:079C",
   "jp": "我ながら上出来っ!",
   "en": "Nicely done, if I say\nso!"
  },
  {
   "id": "MESSAGE174:07AA",
   "jp": "慎重に進まなくちゃな!",
   "en": "Gotta advance\ncarefully!"
  },
  {
   "id": "MESSAGE174:07B9",
   "jp": "恨みっこなしよ?",
   "en": "No hard feelings,\nokay?"
  },
  {
   "id": "MESSAGE174:07C3",
   "jp": "全く、話にならんな",
   "en": "Honestly, not even\nclose."
  },
  {
   "id": "MESSAGE174:07CF",
   "jp": "悪く思わないでよね",
   "en": "Don't hold it against\nme."
  },
  {
   "id": "MESSAGE174:07DB",
   "jp": "ケーッケッケッケ!",
   "en": "Keeh-kekekeh!"
  },
  {
   "id": "MESSAGE174:07E5",
   "jp": "悪く思わないでくれよ。\nこれも戦争なんだ…",
   "en": "No hard feelings, eh?\nThis is war..."
  },
  {
   "id": "MESSAGE174:07FF",
   "jp": "これも任務だから…\n悪く思わないでね",
   "en": "It's my duty...\nDon't hate me, okay?"
  }
 ]
}
