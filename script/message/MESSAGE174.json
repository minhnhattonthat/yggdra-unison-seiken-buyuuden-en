{
 "file": "MESSAGE174.BIN",
 "font": "mes",
 "strings": [
  {
   "id": "MESSAGE174:0560",
   "jp": "すまないが観念してもらうよ",
   "en": ""
  },
  {
   "id": "MESSAGE174:0570",
   "jp": "悪く思わないでくれよ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:057E",
   "jp": "正義は俺たちにあるんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:058E",
   "jp": "お願い、抵抗しないで…!",
   "en": ""
  },
  {
   "id": "MESSAGE174:059E",
   "jp": "占領する…!",
   "en": ""
  },
  {
   "id": "MESSAGE174:05A7",
   "jp": "占領だ…!",
   "en": ""
  },
  {
   "id": "MESSAGE174:05AF",
   "jp": "ここをおさえれば\n有利になるはずよ…",
   "en": ""
  },
  {
   "id": "MESSAGE174:05C4",
   "jp": "ここは押さえさせてもらう!",
   "en": ""
  },
  {
   "id": "MESSAGE174:05D3",
   "jp": "守りに入ると俺様には\n勝てないぜ?",
   "en": ""
  },
  {
   "id": "MESSAGE174:05EA",
   "jp": "ここを奪うことで\n力を削ぐことが出来る…",
   "en": ""
  },
  {
   "id": "MESSAGE174:0604",
   "jp": "許せ…!",
   "en": ""
  },
  {
   "id": "MESSAGE174:060A",
   "jp": "ここ、もらっちゃうよ?",
   "en": ""
  },
  {
   "id": "MESSAGE174:0616",
   "jp": "よし!　占領したぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:0623",
   "jp": "手加減は致しませんよ?",
   "en": ""
  },
  {
   "id": "MESSAGE174:0633",
   "jp": "使わせてたまるかよ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:063F",
   "jp": "使わせないでやんすよ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:064C",
   "jp": "こりゃあ元から\nワシらのもんじゃあ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:0660",
   "jp": "ガハハハ!\nここは頂いた!",
   "en": ""
  },
  {
   "id": "MESSAGE174:066F",
   "jp": "みんな、抵抗しないで!",
   "en": ""
  },
  {
   "id": "MESSAGE174:067D",
   "jp": "悪いけど、ここはもらうよ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:068C",
   "jp": "先に制圧するぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:0698",
   "jp": "ここはオイラのもんだ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:06A4",
   "jp": "…入手しました……",
   "en": ""
  },
  {
   "id": "MESSAGE174:06B0",
   "jp": "奪取成功!",
   "en": ""
  },
  {
   "id": "MESSAGE174:06BA",
   "jp": "フフ…悪く思わないでね……",
   "en": ""
  },
  {
   "id": "MESSAGE174:06CA",
   "jp": "占領した!",
   "en": ""
  },
  {
   "id": "MESSAGE174:06D2",
   "jp": "神の尖兵たる我らにこそ\n使う資格があるのだ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:06EF",
   "jp": "だ、誰にも渡さんぞ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:06FC",
   "jp": "悪いけど、押さえさせて\nもらうわ…!",
   "en": ""
  },
  {
   "id": "MESSAGE174:0711",
   "jp": "うふふ…これは私にこそ\n相応しい武器!",
   "en": ""
  },
  {
   "id": "MESSAGE174:0729",
   "jp": "全てのものはパメラ様の\nもの~!",
   "en": ""
  },
  {
   "id": "MESSAGE174:073C",
   "jp": "クケ~ッ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:0742",
   "jp": "手は抜きませんわ",
   "en": ""
  },
  {
   "id": "MESSAGE174:074D",
   "jp": "これは私たちが\n頂くことにしますよ…",
   "en": ""
  },
  {
   "id": "MESSAGE174:0761",
   "jp": "昨日の友は\n明日の敵ってな!",
   "en": ""
  },
  {
   "id": "MESSAGE174:0776",
   "jp": "勝負あったわね",
   "en": ""
  },
  {
   "id": "MESSAGE174:0780",
   "jp": "勝負あり!",
   "en": ""
  },
  {
   "id": "MESSAGE174:0788",
   "jp": "悪く思わないでね",
   "en": ""
  },
  {
   "id": "MESSAGE174:0793",
   "jp": "諦めるんだな!",
   "en": ""
  },
  {
   "id": "MESSAGE174:079C",
   "jp": "我ながら上出来っ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:07AA",
   "jp": "慎重に進まなくちゃな!",
   "en": ""
  },
  {
   "id": "MESSAGE174:07B9",
   "jp": "恨みっこなしよ?",
   "en": ""
  },
  {
   "id": "MESSAGE174:07C3",
   "jp": "全く、話にならんな",
   "en": ""
  },
  {
   "id": "MESSAGE174:07CF",
   "jp": "悪く思わないでよね",
   "en": ""
  },
  {
   "id": "MESSAGE174:07DB",
   "jp": "ケーッケッケッケ!",
   "en": ""
  },
  {
   "id": "MESSAGE174:07E5",
   "jp": "悪く思わないでくれよ。\nこれも戦争なんだ…",
   "en": ""
  },
  {
   "id": "MESSAGE174:07FF",
   "jp": "これも任務だから…\n悪く思わないでね",
   "en": ""
  }
 ]
}
