{
 "file": "EDMES11.BIN",
 "font": "end",
 "strings": [
  {
   "id": "EDMES11:009C",
   "jp": "みそっかすニーチェ",
   "en": ""
  },
  {
   "id": "EDMES11:00A6",
   "jp": "引きこもりニーチェ",
   "en": ""
  },
  {
   "id": "EDMES11:00B1",
   "jp": "やるときはやるよニーチェ",
   "en": ""
  },
  {
   "id": "EDMES11:00BE",
   "jp": "少女戦士ニーチェ",
   "en": ""
  },
  {
   "id": "EDMES11:00CB",
   "jp": "水神の使いニーチェ",
   "en": ""
  },
  {
   "id": "EDMES11:00D8",
   "jp": "水の守護神ニーチェ",
   "en": ""
  },
  {
   "id": "EDMES11:00E6",
   "jp": "そのあまりにも戦場に不似合いな\n少女の存在に敵は驚き呆れ\n戦意を喪失したという…",
   "en": ""
  },
  {
   "id": "EDMES11:011E",
   "jp": "戦場にて数多くの弱点を露呈した彼女は\n己の能力の低さを恥じ入り、\n以後家を出ることはなかったという…",
   "en": ""
  },
  {
   "id": "EDMES11:0165",
   "jp": "その後彼女はアイテム回収以外にも\n役割を見出し、自分の能力を\n如何なく発揮できるようになった…",
   "en": ""
  },
  {
   "id": "EDMES11:01A8",
   "jp": "その愛くるしくも勇ましい姿を見た\n兵士たちは皆、勇気を奮い起こし\n進んで前線に赴いたという…",
   "en": ""
  },
  {
   "id": "EDMES11:01E6",
   "jp": "幼い容貌に秘められた天賦の才能を\n目の当たりにした兵士たちは\n皆一様に膝をついたという…",
   "en": ""
  },
  {
   "id": "EDMES11:0223",
   "jp": "そのあどけない容姿の中に\n多くの者たちは水の神の存在を\n感じ取り、畏れたという…",
   "en": ""
  }
 ]
}
