{
 "file": "EDMES22.BIN",
 "font": "end",
 "strings": [
  {
   "id": "EDMES22:009C",
   "jp": "なきむしエレナ",
   "en": ""
  },
  {
   "id": "EDMES22:00A4",
   "jp": "よわむしエレナ",
   "en": ""
  },
  {
   "id": "EDMES22:00AC",
   "jp": "さんぴんエレナ",
   "en": ""
  },
  {
   "id": "EDMES22:00B4",
   "jp": "撫子戦士エレナ",
   "en": ""
  },
  {
   "id": "EDMES22:00C0",
   "jp": "悲壮なる暗殺者エレナ",
   "en": ""
  },
  {
   "id": "EDMES22:00D0",
   "jp": "正義の刺客エレナ",
   "en": ""
  },
  {
   "id": "EDMES22:00DD",
   "jp": "気が弱く、人見知りも激しく\nいつも泣きべそをかいていた彼女は\nやがて役立たずのレッテルを貼られて\nしまったという…",
   "en": ""
  },
  {
   "id": "EDMES22:0123",
   "jp": "おっかなびっくり戦う彼女に、心優しい\n上官ですら次第に苦言を呈するように\nなり、やがて彼女に多くを期待する者は\n誰もいなくなったという…",
   "en": ""
  },
  {
   "id": "EDMES22:017B",
   "jp": "常に誰かの後ろについて戦っていた\n彼女は、ついに人の上に立つことは\n無かったそうだ…",
   "en": ""
  },
  {
   "id": "EDMES22:01B0",
   "jp": "必死に戦うその健気な姿に心打たれた\n男たちは、皆一様に彼女をお嫁さんに\nしたがったという…",
   "en": ""
  },
  {
   "id": "EDMES22:01ED",
   "jp": "重い宿命を背負いながらも強く生きる\n彼女に畏敬の念を抱く者は後を\n絶たなかったという…",
   "en": ""
  },
  {
   "id": "EDMES22:0229",
   "jp": "曲がったことには加担しない彼女の\n公明正大な姿勢は多くの兵士たちの\n模範になったという…",
   "en": ""
  }
 ]
}
