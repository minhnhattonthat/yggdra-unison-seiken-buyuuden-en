{
 "file": "EDMES20.BIN",
 "font": "end",
 "strings": [
  {
   "id": "EDMES20:009C",
   "jp": "ぶちクルス",
   "en": ""
  },
  {
   "id": "EDMES20:00A2",
   "jp": "今頃反抗期クルス",
   "en": ""
  },
  {
   "id": "EDMES20:00B0",
   "jp": "孤独の闘士クルス",
   "en": ""
  },
  {
   "id": "EDMES20:00BD",
   "jp": "革命の闘士クルス",
   "en": ""
  },
  {
   "id": "EDMES20:00CA",
   "jp": "革命家クルス",
   "en": ""
  },
  {
   "id": "EDMES20:00D4",
   "jp": "伝説の革命家クルス",
   "en": ""
  },
  {
   "id": "EDMES20:00E3",
   "jp": "分もわきまえず、何かにつけて反抗する\nその態度により友達を失った彼の生涯は\n孤独だったという…",
   "en": ""
  },
  {
   "id": "EDMES20:0120",
   "jp": "ひたすら体制に順ずることなく反抗的に\n生きた彼は、誰からも賛同を得られず\n寂しい余生を送ったという…",
   "en": ""
  },
  {
   "id": "EDMES20:0163",
   "jp": "体制に従わない彼の生き様は、後に\n孤独の闘士としてその名を歴史に刻む\nことになるのだった…",
   "en": ""
  },
  {
   "id": "EDMES20:01A0",
   "jp": "どのような苦難が訪れようとも\n決して圧制者に屈しないその彼の姿は\n多くの権力者の瞳に焼きついたという…",
   "en": ""
  },
  {
   "id": "EDMES20:01E4",
   "jp": "後に彼の思想と闘志は多くの革命家たちの\n範となり、賞賛され、その名は長く\n歴史に残ったという…",
   "en": ""
  },
  {
   "id": "EDMES20:0226",
   "jp": "革命の闘士である彼の情熱はやがて\n伝説となり、その名は後世まで\n語り継がれたという…",
   "en": ""
  }
 ]
}
