  {
   "id": "EDMES15:009C",
   "jp": "怠け者コブン",
   "en": ""
  },
  {
   "id": "EDMES15:00A5",
   "jp": "うっかり者コブン",
   "en": ""
  },
  {
   "id": "EDMES15:00AF",
   "jp": "兵卒コブン",
   "en": ""
  },
  {
   "id": "EDMES15:00B7",
   "jp": "古参兵コブン",
   "en": ""
  },
  {
   "id": "EDMES15:00C1",
   "jp": "腹心のコブン",
   "en": ""
  },
  {
   "id": "EDMES15:00CA",
   "jp": "元帥コブン",
   "en": ""
  },
  {
   "id": "EDMES15:00D2",
   "jp": "もって生まれたサボリ癖︀のために\n彼は厄介ごとに巻き込まれるのを嫌がり\nその能力が生かされることは無かった…",
   "en": ""
  },
  {
   "id": "EDMES15:0114",
   "jp": "肝心な時にドジを踏むその性格のため\n彼は仲間たちからの信用を失い\n以降前線に出ることは無かったという…",
   "en": ""
  },
  {
   "id": "EDMES15:0159",
   "jp": "長い時間をかけた教育が功を寿し、\n彼がやっと使い物になるようになった\n頃には既に戦いは終わり、彼の出番は\n無かったという…",
   "en": ""
  },
  {
   "id": "EDMES15:01A9",
   "jp": "日頃の努力が実り、頼り甲斐のある\n部下として皆から認められた彼の地位は\nやがて不動のものとなった…",
   "en": ""
  },
  {
   "id": "EDMES15:01EC",
   "jp": "いよいよ頭角を現した彼は\n腹心のコブンとしてのその地位を\n以後ずっと不動のものとした…",
   "en": ""
  },
  {
   "id": "EDMES15:0224",
   "jp": "彼こそはコブンの中のコブンだと\n褒め称えられたが、所詮コブンである\nことに変りは無かった…",
   "en": ""
  }
 ]
}
