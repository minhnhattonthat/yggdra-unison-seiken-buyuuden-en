   "jp": "放蕩少女キリエ",
   "en": ""
  },
  {
   "id": "EDMES19:00B0",
   "jp": "風来坊のキリエ",
   "en": ""
  },
  {
   "id": "EDMES19:00BB",
   "jp": "流︀浪の戦士キリエ",
   "en": ""
  },
  {
   "id": "EDMES19:00C8",
   "jp": "天翔る戦士キリエ",
   "en": ""
  },
  {
   "id": "EDMES19:00D5",
   "jp": "天空の制者キリエ",
   "en": ""
  },
  {
   "id": "EDMES19:00E2",
   "jp": "局︀で風を切る彼女の生き方は\nおおよそ軍隊などの組織には向かず、\n生涯をはみ出し者として過ごしたという…",
   "en": ""
  },
  {
   "id": "EDMES19:0127",
   "jp": "気に入らないことがあればすぐに\n戦線を離脱する彼女は仲間からも\n見放され、孤独な人生を送ったという…",
   "en": ""
  },
  {
   "id": "EDMES19:016B",
   "jp": "諸国を漫遊し続けた彼女は多くの知己を\n得たが、その代わり安住の地を得ることは\n無かったという…",
   "en": ""
  },
  {
   "id": "EDMES19:01AC",
   "jp": "行く先々で人助けをする彼女の存在は\nやがて語り伝えられ、多くの人々の\n心に焼き付けられたという…",
   "en": ""
  },
  {
   "id": "EDMES19:01EE",
   "jp": "天翔る勇敢な彼女の姿は見る者を\n勇気付け、士気を盛り返した兵士たちは\n皆生還を果たしたという…",
   "en": ""
  },
  {
   "id": "EDMES19:0234",
   "jp": "天空を征する者は世界を制する…\nその数々の戦を勝利に導く彼女の名は\n歴史に刻まれたのだった…",
   "en": ""
  }
 ]
}
