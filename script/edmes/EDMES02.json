{
 "file": "EDMES02.BIN",
 "font": "end",
 "strings": [
  {
   "id": "EDMES02:009C",
   "jp": "勇者を夢見た一般人カナン",
   "en": ""
  },
  {
   "id": "EDMES02:00B0",
   "jp": "へっぽこ勇者カナン",
   "en": ""
  },
  {
   "id": "EDMES02:00BC",
   "jp": "駆け出し勇者カナン",
   "en": ""
  },
  {
   "id": "EDMES02:00CA",
   "jp": "努力の勇者カナン",
   "en": ""
  },
  {
   "id": "EDMES02:00D7",
   "jp": "選ばれし勇者カナン",
   "en": ""
  },
  {
   "id": "EDMES02:00E3",
   "jp": "伝説の勇者カナン",
   "en": ""
  },
  {
   "id": "EDMES02:00F0",
   "jp": "剣の腕に伸び悩みを感じた彼は\nやがて軍を抜け、以後一般人として\n平穏な日々を送ったという…",
   "en": ""
  },
  {
   "id": "EDMES02:0130",
   "jp": "軍隊の厳しさを痛感した彼は\nその後軍を抜け、民間人となり\n静かな余生を送ったという…",
   "en": ""
  },
  {
   "id": "EDMES02:016B",
   "jp": "才は並ながら剣術に目覚めた彼は\n民間人に戻ってからも剣の修行を続け\nそれなりの腕前になったという…",
   "en": ""
  },
  {
   "id": "EDMES02:01AE",
   "jp": "戦いの中で弛まぬ修行を続けた彼は\n人間的にも磨きがかかり\n以後も優れた軍人としての日々を\n送ったという…",
   "en": ""
  },
  {
   "id": "EDMES02:01F6",
   "jp": "戦いの中でその才能を開花させた彼は\n各地で輝かしい戦績を上げ続け\n百年に一人の逸材と賞賛されたという…",
   "en": ""
  },
  {
   "id": "EDMES02:0240",
   "jp": "類稀なる剣の才能に恵まれた彼は\n何者をも寄せ付けぬ力を発揮し\n剣聖の再臨と謳われたという…",
   "en": ""
  }
 ]
}
