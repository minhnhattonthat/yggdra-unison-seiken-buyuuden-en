 "strings": [
  {
   "id": "EDMES18:009C",
   "jp": "未熟姫エミリオ",
   "en": ""
  },
  {
   "id": "EDMES18:00A7",
   "jp": "卑屈姫エミリオ",
   "en": ""
  },
  {
   "id": "EDMES18:00B2",
   "jp": "美しき兄妹愛エミリオ",
   "en": ""
  },
  {
   "id": "EDMES18:00C1",
   "jp": "孤高のエミリオ",
   "en": ""
  },
  {
   "id": "EDMES18:00CB",
   "jp": "神童エミリオ",
   "en": ""
  },
  {
   "id": "EDMES18:00D4",
   "jp": "紅き神童エミリオ",
   "en": ""
  },
  {
   "id": "EDMES18:00E0",
   "jp": "まだ幼く、右も左も分からない彼女は\n度々道に迷ってしまい、戦場に到達する\nことは無かったという…",
   "en": ""
  },
  {
   "id": "EDMES18:0120",
   "jp": "気が向かないと戦場に赴かない彼女は\nその気まぐれな態度により\n不名誉な綽名を授かるのだった…",
   "en": ""
  },
  {
   "id": "EDMES18:015F",
   "jp": "ひたすら兄を目指して頑張るその健気な\n姿を見て、心打たれた者も少なくは\n無かったという…",
   "en": ""
  },
  {
   "id": "EDMES18:019A",
   "jp": "若くして大成した彼女は、軍務に忙しく\n同い年の友達もできず、生涯孤独だった\nという…",
   "en": ""
  },
  {
   "id": "EDMES18:01D5",
   "jp": "歳に似合わぬ類稀な力を発揮する彼女は\n敵味方を問わず多くの者たちから\n神童と崇められ、畏れられたという…",
   "en": ""
  },
  {
   "id": "EDMES18:021E",
   "jp": "彼女の通った後は草木も絶え果て\n地は朱に染まると、多くの者たちから\n恐れられたという…",
   "en": ""
  }
 ]
}
