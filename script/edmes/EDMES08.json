 "strings": [
  {
   "id": "EDMES08:009C",
   "jp": "チンピラ騎士レオン",
   "en": ""
  },
  {
   "id": "EDMES08:00A8",
   "jp": "暴れん坊騎士レオン",
   "en": ""
  },
  {
   "id": "EDMES08:00B6",
   "jp": "暴力騎士レオン",
   "en": ""
  },
  {
   "id": "EDMES08:00C2",
   "jp": "黒い旋風レオン",
   "en": ""
  },
  {
   "id": "EDMES08:00CD",
   "jp": "漆黒の魔王レオン",
   "en": ""
  },
  {
   "id": "EDMES08:00DA",
   "jp": "生殺与奪の悪魔レオン",
   "en": ""
  },
  {
   "id": "EDMES08:00EB",
   "jp": "かねてよりその口の悪さに定評のあった\n彼は、そのあまりの口の悪さから\n自らの地位を不動のものとした…",
   "en": ""
  },
  {
   "id": "EDMES08:012A",
   "jp": "常に争いごとを最上の糧とする彼は\n現状の生活には満足できず\n更なる戦乱を求めて旅立ったという…",
   "en": ""
  },
  {
   "id": "EDMES08:016C",
   "jp": "部下にまで容赦の無い暴力を振るった\n彼は、大勢の者の恨みを買ったのか\nその後何処かで闇討ちにあって\n果てたという…",
   "en": ""
  },
  {
   "id": "EDMES08:01BA",
   "jp": "彼のその恐るべき槍の一撃は\n長きに渡り語り継がれた…\n黒い疾風という名を伴って…",
   "en": ""
  },
  {
   "id": "EDMES08:01F1",
   "jp": "あたかも死神のような彼の姿を\n見た者は、誰一人として\n生還することは無かったという…",
   "en": ""
  },
  {
   "id": "EDMES08:0228",
   "jp": "焔帝の「力こそ全て」の言葉の下に\n彼はその全知全能を振るって\n更なる暴虐を尽くしたという…",
   "en": ""
  }
 ]
}
