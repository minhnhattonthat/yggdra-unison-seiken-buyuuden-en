{
 "file": "EDMES31.BIN",
 "font": "end",
 "strings": [
  {
   "id": "EDMES31:009C",
   "jp": "虚心のシモベ",
   "en": ""
  },
  {
   "id": "EDMES31:00A5",
   "jp": "無心のシモベ",
   "en": ""
  },
  {
   "id": "EDMES31:00AE",
   "jp": "歓心のシモベ",
   "en": ""
  },
  {
   "id": "EDMES31:00B7",
   "jp": "心強いシモベ",
   "en": ""
  },
  {
   "id": "EDMES31:00C0",
   "jp": "頼りになるシモベ",
   "en": ""
  },
  {
   "id": "EDMES31:00CA",
   "jp": "忠実なるシモベ",
   "en": ""
  },
  {
   "id": "EDMES31:00D4",
   "jp": "何を言っているのか、何を考えているのか\nまるで分からない彼を信用できる者は\n誰もいなかったという…",
   "en": ""
  },
  {
   "id": "EDMES31:0110",
   "jp": "何を欲しているのか理解できない彼を\n誰もが気味悪がり、いつしか周囲には\n誰もいなくなっていたという…",
   "en": ""
  },
  {
   "id": "EDMES31:014F",
   "jp": "いつも嬉しそうな彼を見て\n何を喜んでいるのか分からない人々は\n皆気味悪がり、近付かないように\nしていたという…",
   "en": ""
  },
  {
   "id": "EDMES31:0195",
   "jp": "見た目は気味悪いが、いざという時に\n心強い存在となる彼は徐々に皆の信頼を\n勝ち取っていくのだった…",
   "en": ""
  },
  {
   "id": "EDMES31:01D9",
   "jp": "見た目は気味悪いが、一旦仲間にして\nみると意外と頼りになることが分かり\nその後彼には友達もできたという…",
   "en": ""
  },
  {
   "id": "EDMES31:021F",
   "jp": "見た目はともかく、言われたことを\nきちんとこなす彼はやがて\nロズウェルからの信頼を得たという…",
   "en": ""
  }
 ]
}
