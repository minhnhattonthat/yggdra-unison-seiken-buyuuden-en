 "strings": [
  {
   "id": "EDMES06:009C",
   "jp": "無鉄砲少女モニカ",
   "en": ""
  },
  {
   "id": "EDMES06:00AA",
   "jp": "薄幸の村娘モニカ",
   "en": ""
  },
  {
   "id": "EDMES06:00B7",
   "jp": "勇敢なる村娘モニカ",
   "en": ""
  },
  {
   "id": "EDMES06:00C5",
   "jp": "戦場の聖女モニカ",
   "en": ""
  },
  {
   "id": "EDMES06:00D2",
   "jp": "勝利の女神モニカ",
   "en": ""
  },
  {
   "id": "EDMES06:00DF",
   "jp": "民兵の英雄モニカ",
   "en": ""
  },
  {
   "id": "EDMES06:00EC",
   "jp": "常識を覆す彼女の無茶苦茶な戦いぶりは\n敵のみならず、味方の度肝も抜いた\nそうだ…",
   "en": ""
  },
  {
   "id": "EDMES06:0125",
   "jp": "己の人生も省みずに不慣れな軍人の道を\n歩んだその可憐な少女の姿に\n人々は涙したという…",
   "en": ""
  },
  {
   "id": "EDMES06:0163",
   "jp": "己の安全を省みぬ無謀なまでの\n彼女の勇気が周囲を勇気付ける\nこともあったという…",
   "en": ""
  },
  {
   "id": "EDMES06:019B",
   "jp": "その決して逆境︀にも挫けることのない\n彼女の強き精神が仲間たちを励まし\n皆を勇気付ける原動力となったという…",
   "en": ""
  },
  {
   "id": "EDMES06:01E4",
   "jp": "多くの勝利に貢献したことから\n戦の女神として彼女の名は後世まで\n轟いたという…",
   "en": ""
  },
  {
   "id": "EDMES06:021A",
   "jp": "民兵の出身でありながら、多くの戦を\n戦い抜いた彼女は帝国の民たちから\n英雄として崇められたのだった…",
   "en": ""
  }
 ]
}
