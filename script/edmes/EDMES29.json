 "strings": [
  {
   "id": "EDMES29:009C",
   "jp": "鈍才策士ユーディ",
   "en": ""
  },
  {
   "id": "EDMES29:00A9",
   "jp": "凡才策士ユーディ",
   "en": ""
  },
  {
   "id": "EDMES29:00B6",
   "jp": "天才策士ユーディ",
   "en": ""
  },
  {
   "id": "EDMES29:00C3",
   "jp": "鬼才の参謀ユーディ",
   "en": ""
  },
  {
   "id": "EDMES29:00D1",
   "jp": "稀代の大参謀ユーディ",
   "en": ""
  },
  {
   "id": "EDMES29:00E1",
   "jp": "不世出の大参謀ユーディ",
   "en": ""
  },
  {
   "id": "EDMES29:00F3",
   "jp": "彼女の打ち出す数々の迷戦略は\n敵味方区別無しに多くの者を惑わせ\n常に戦場は混乱を極めたという…",
   "en": ""
  },
  {
   "id": "EDMES29:013B",
   "jp": "策よりも重火器の扱いに秀でた彼女は\n国の誰よりも重火器に精通していたため\n以後砲撃手として名を馳せたという…",
   "en": ""
  },
  {
   "id": "EDMES29:0188",
   "jp": "火砲の運用に長けた彼女は\nその意表を突いた戦術により、やがて\n名参謀と呼ばれるようになった…",
   "en": ""
  },
  {
   "id": "EDMES29:01C7",
   "jp": "火砲を利用した斬新な戦略を次々に\n生み出す彼女は、希代の戦略家として\nその名を歴史に残したのだった…",
   "en": ""
  },
  {
   "id": "EDMES29:0211",
   "jp": "次々に繰り出される彼女の奇策と\n砲列の凄まじい火力の前に\nあらゆる敵がひれ伏したという…",
   "en": ""
  },
  {
   "id": "EDMES29:024E",
   "jp": "彼女が指揮する怒涛の砲撃の前には\n無傷でいられる軍隊も、\n形を留める城砦も無かったという…",
   "en": ""
  }
 ]
}
